[
  {"id": 1, "src_sha256": "0e5d4849994bc4b98ed2711844215e4db2b07f55858a14c4bf097a046ee0afcc", "zh": "一小股灼熱的酸液噴濺，傷害一名敵人。"},
  {"id": 2, "src_sha256": "d3b01773157e9c955b6f09c2dff0de740d1e153dabec0027c5e3e42bb51ad507", "zh": "以{{Magic}}提升隊伍的護甲值並增加命中目標的機會。威力等級只延長法術持續時間，不影響效果強度。"},
  {"id": 3, "src_sha256": "782570a62d7ac016815dcb35fba6f83af912b32ee18eb0ec2fc7ecb2cdf0042e", "zh": "嘗試以{{Magic}}影響 NPC，使其對隊伍更為友善。"},
  {"id": 4, "src_sha256": "d06605957f20dba56d6b9276cb0edc8e4b22f84db1329156071fa51f02a351d2", "zh": "一陣刺骨寒風，傷害單一生物。"},
  {"id": 5, "src_sha256": "d5ef2d2a25730ab8c8c711cf63622210db9473f3f96db9adb49607b568a2c5f7", "zh": "一道跳動的電火花電擊一名敵人。"},
  {"id": 6, "src_sha256": "efdfc19a4866b3cb0bb37afe41c824098c2e54c27cfe1c40020cd36bdc35c7e3", "zh": "以{{Magic}}撫平單一角色的傷勢。"},
  {"id": 7, "src_sha256": "2116f1ebc366162e28cb19b1e4a05a6395e59d39f065f7b336ee199f940c0145", "zh": "惱人的刺激物覆蓋施法者前方的敵人，削弱其攻擊與防禦能力。"},
  {"id": 8, "src_sha256": "2bf5e7e9e4f0ecdfa4a5334928117a4fe4dff3fb6e441fdbc71d491f60ab1834", "zh": "一團小小的火球照亮隊伍周遭，持續整整一天。照明範圍取決於威力等級。"},
  {"id": 9, "src_sha256": "d5d0a447fd0e74871f3bc8b095f527629895968845bf2c9110e705b123a6e919", "zh": "對一名對手造成{{Magic}}傷害。"},
  {"id": 10, "src_sha256": "16c2d93381678b466899967770c2b6e6c24441177d9ef3eedeb3b08405ac6886", "zh": "一小股精神能量衝擊傷害一名對手，可能使其瘋狂。"},
  {"id": 11, "src_sha256": "92a04ffecc02b8e8d31f11f2c445a862ef40796d691281fc57ca3b6c0e14be78", "zh": "使生命體液凝固，令一名對手動彈不得。麻痺持續時間取決於威力等級。"},
  {"id": 12, "src_sha256": "ff771fd5a7a93275d25a04d4f98895ba4d80ce4566d0e0383659ad1a54bae728", "zh": "使一群對手安然入睡，無法攻擊或防禦。沉睡者若在睡夢中受傷，很可能會醒來。"},
  {"id": 13, "src_sha256": "093d0375d496531835026a08dec9caa2cf8e46d68e14ef0869b8807e74c43006", "zh": "一股振奮的能量為單一目標恢復部分耐力。"},
  {"id": 14, "src_sha256": "62df2f513e62e24f397fc48fdf0fd26beb193d71b5f02efaaf20a28facf29fdd", "zh": "擾亂一群生物的心智，使其陷入恐懼而削弱戰力，極端情況下甚至會完全昏迷。受驚的對手可能畏縮不前或驚恐逃竄。"},
  {"id": 15, "src_sha256": "b3b87c91ce42ae7e78da3dd818e8f465835d0b5f6c5885fbe7ccd213c923073d", "zh": "目標位置迸發出刺目強光，使受影響的對手失明而無助。"},
  {"id": 16, "src_sha256": "5a7b7ff8e9b08a1fe9b7fa36318367541fdced181dd0d0bbb336cf1360beaeab", "zh": "嘗試治療一名角色的輕微狀態：恐懼、睡著、失明、噁心與刺癢。"},
  {"id": 17, "src_sha256": "da07a348006ec23503a5e4bf774e728248a125b08c2fb65ec58734a35992477a", "zh": "增強全隊成員的{{Senses}}，讓他們輕易發現隱藏的物品或不尋常之處。威力等級只延長法術持續時間，不影響效果強度。"},
  {"id": 18, "src_sha256": "1ab8795d95e9a4b63fe8348db85c941e30351cb00cf9a0455f79579fe0d690f5", "zh": "提升{{Locks & Traps}}技能，增加辨識陷阱構造的機會，並改善解除陷阱的成果。"},
  {"id": 19, "src_sha256": "9390e49bd0f4333f9746b1be99591b840a82afd2bfdf8fe52f0ce02b267642de", "zh": "賦予目標向附近對手噴吐錐形灼熱酸霧的能力。威力等級只延長法術持續時間，不影響效果強度。"},
  {"id": 20, "src_sha256": "a41cb93e551e1eca75732dd11bfed97e8367a9fcd10134a2585ce042e3490064", "zh": "以{{Magic}}強化全隊成員命中目標及穿透對手護甲的能力。"},
  {"id": 21, "src_sha256": "d2b3765e752b1490b65d1d1bb36036ae649c2e5b2f6bf30dacb735e6594721ba", "zh": "召喚守護天使，吸收針對受保護角色的任何攻擊傷害。守護天使吸收的傷害量取決於威力等級。"},
  {"id": 22, "src_sha256": "3154f7246bbb980f94d5524e8407ae62330e60ccc29870f9a564ad346ea9eeb8", "zh": "{{Divine}}的液體灼燒不死生物與惡魔類的邪惡生物。"},
  {"id": 23, "src_sha256": "ce055e50522b1bf96df684d70c8587df8c508b35e2df9e55a30185db8f6d5712", "zh": "嘗試揭露未鑑定物品的真實面貌。威力等級會自動依物品的複雜程度調整。"},
  {"id": 24, "src_sha256": "31101e6e198cb5fa5b6b78c8c839197262db418c6829b94f88495d6c9d612025", "zh": "一股錯亂的精神能量衝擊，試圖使一群生物陷入瘋狂。"},
  {"id": 25, "src_sha256": "bdac8d18c76fc9ca298c2c555b7ac7ab74e38c1e5133fd202302c9d42756456b", "zh": "威力小而強大的{{Magic}}能量飛彈，傷害施法者前方的對手。"},
  {"id": 26, "src_sha256": "74ca81fd28f66d52d497c00afebc2a85d0bddb3346c9f8897327df6c032edbdf", "zh": "在隊伍周圍形成一道濃稠空氣構成的{{Magic}}護盾，可能偏折射向單一角色的非{{Magic}}投射物。對針對全隊的吐息攻擊毫無防護。"},
  {"id": 27, "src_sha256": "75c83a1f6bd59d0d0cc408f7cd702440f3b7af5cedfca7e1fca44880c4628307", "zh": "受保護的成員周身浮現一件閃耀利刃織成的斗篷，任何攻擊他的敵人都會受傷。"},
  {"id": 28, "src_sha256": "e529e84566547ef6c488ab1c9e549ab69b030febd6429c194927275ff9de0f26", "zh": "一道尖銳的高頻音波錐，傷害施法者前方的對手。"},
  {"id": 29, "src_sha256": "49ea86ee5853940be0aedaeb2251aef98a484d4a995980d11b7c29691b3fbe3b", "zh": "以一群敵人為目標，試圖降低其移動{{Speed}}，使其更難防禦、更容易被擊中。"},
  {"id": 30, "src_sha256": "29f32560d0a3d06ce4e074de3f000957a2f076a5f863eb44c4bd5ea1012ff0bf", "zh": "響亮到令人痛苦的巨響，音量之大可能使對手昏迷或嚇得麻木。"},
  {"id": 31, "src_sha256": "61ab6b8a427f3505d5e2334cfa6f44ee32081afb26eb15b506fb2edacbd55d7e", "zh": "呈錐形射出黏稠的蛛網，可能束縛施放方向上的敵人。"},
  {"id": 32, "src_sha256": "bb0da49280233596acc1d92d1059ee1ce76b3c26f3f4185f8181df2aec937a6d", "zh": "在隊伍周圍形成{{Magic}}護甲，提升其護甲值。"},
  {"id": 33, "src_sha256": "0625267d4eaa2c21887d549c1d197ba544127f9484e164eb609584939610ff86", "zh": "細微的偽裝使你更難被發現，被對手察覺時彷彿憑空出現。擬態在戰鬥中無效。"},
  {"id": 34, "src_sha256": "f2fc4b410b42d1bf0b7050b3d5baacaed22e062ae9eb702595b6a495bb13cba5", "zh": "嘗試治療一名角色的行動不能狀態：麻痺與被網住。"},
  {"id": 35, "src_sha256": "45f4b821847448a16b9059b1b7e8250c0bd3ef7de8cbe7e89b3814bba4a13b7a", "zh": "嘗試治療一名角色的中毒。"},
  {"id": 36, "src_sha256": "d43e3158dfd5fbf3ca0089c2b4b38dc3ece00755680eb641a538f065e7b042bf", "zh": "熾烈的火球灼燒爆炸點範圍內的對手。"},
  {"id": 37, "src_sha256": "14466caafe12a49dca65728f993f32f83aec452f939cb75f1d27143716d76dc1", "zh": "嘗試將一群怪物牢牢凍結，使其麻痺。"},
  {"id": 38, "src_sha256": "c34c664d529e1b88a3a620560c12441e038c5769cd2c2e90745d58770bd8f914", "zh": "閃爍的光芒形成誘人的陷阱，吸引敵對的對手不由自主地朝它前進。對中立或友善的對象無效。"},
  {"id": 39, "src_sha256": "76501a6e6ec2f0cf751a788af8bdfb6dd19b3a8f87741b95b51c55d7cd22f24c", "zh": "以{{Magic}}嘗試將鎖的鎖簧固定在開啟位置。受影響的鎖簧數量取決於威力等級。施法者同一時間只能維持一次此法術。施放於有陷阱的寶箱時，會嘗試開啟寶箱並繞過陷阱。"},
  {"id": 40, "src_sha256": "c654173d524da4cc74979d24251ca0e79720b85f5c055b4faa64d8059c21b3b1", "zh": "提升隊伍對全部 6 個領域{{Magic}}的抗性。"},
  {"id": 41, "src_sha256": "aae56de213f1ad3a24ca376754940bf15e73d3db32f46cb0fb6da3fbac2e3882", "zh": "嘗試以{{Magic}}從 NPC 的腦中抽取思緒。"},
  {"id": 42, "src_sha256": "0f43453c8b9f56badab090b551d315e3f1451cb6cb67a07d95091dcba9925e3f", "zh": "惡臭襲擊目標區域範圍內的對手，痛苦地灼燒其肺部，可能造成噁心或昏迷。"},
  {"id": 43, "src_sha256": "8eb3a58ecef47cff4e33a7557f62b4c0e27676690aad81c953193778cfad661a", "zh": "一道熾烈的精神力爆發，自施法者前方呈錐形擴散，灼燒範圍內生物的大腦。"},
  {"id": 44, "src_sha256": "7e619386801ac1b852ee3fb3446ad550767402d5f649c8f09fbc2f3a15788578", "zh": "一股振奮的能量為全隊成員恢復部分耐力。"},
  {"id": 45, "src_sha256": "621628162a07f28f9d868fca027f3ba0c0a78339478d8fc51669447f4676a055", "zh": "幽靈看門犬向隊伍示警來襲的怪物，喚醒沉睡的成員，降低被奇襲的機率。威力等級只延長法術持續時間，不影響效果強度。"},
  {"id": 46, "src_sha256": "64681682952d8959b7038c02c30a827227d425a81a18db073d153cac0c991af3", "zh": "使受影響生物周圍的空氣凝滯，阻斷聲波傳遞，使其無法施放需出聲的{{Magic}}。"},
  {"id": 47, "src_sha256": "5d230f0cd6fda737fe497e2cbb1963e4a189f8d37aef914cebb193bcd9a6f91a", "zh": "一股石旋風自施法者前方呈錐形噴出碎石彈幕，傷害多個目標。"},
  {"id": 48, "src_sha256": "8a6a45f1fe26c523540ff24363217a4e31ed764d45ef82d26873814f233de154", "zh": "一團酸雲飄過目標區域內的敵人，持續造成傷害。"},
  {"id": 49, "src_sha256": "c8088d8dc5f4bd840af00a84d994b8e667fd4df5cd6892866ac6233852b15e3f", "zh": "使生物的護甲變薄、皮膚變軟，讓{{Weaponry}}更容易穿透。"},
  {"id": 50, "src_sha256": "d297ca886b9cbc2b05ec22953dc642d23508eb370aae5b9f5da8500249be9e77", "zh": "一塊巨石從天而降，壓扁單一對手。"},
  {"id": 51, "src_sha256": "26deea7a228f75d599ccc791cbc90c4853aacc862d52860123e4e3fc60cd9427", "zh": "嘗試治療一名染病的角色。"},
  {"id": 52, "src_sha256": "3459af1a3eacf84998f9aabc9d6718cc65f7890a200184f4e7b346f03ec54e20", "zh": "精神能量的絲線鞭笞施法者前方的敵人，造成傷害。"},
  {"id": 53, "src_sha256": "fae741be568ce11439fac382e9a4b8e51bb2da2c05ba92b65696cdd10e075152", "zh": "提升隊伍對來自{{Earth}}、{{Air}}、{{Fire}}與{{Water}}領域元素{{Magic}}的抗性。"},
  {"id": 54, "src_sha256": "9b3b6f7a505db7c641cbe534918c780f1acffe036fefa4d674cc2713648f4ec1", "zh": "任何對受附魔角色施放的{{Magic}}攻擊都會被複製並{{Reflextion}}回原施法者。每次{{Reflextion}}，附魔的{{Strength}}都會減弱。"},
  {"id": 55, "src_sha256": "200508a21de60125f61c6dbcb0c8611dcd5b9380c07c8cbd560c49d3c11b5e33", "zh": "不穩定的混合材料爆炸，傷害爆炸點範圍內的對手。"},
  {"id": 56, "src_sha256": "8f61cb202028529dc31b3f75223b2f4b644ba3334ee4c02685cb3c83ffeeaa4d", "zh": "賜予全隊成員額外的能量以加快行動，抵銷減速的效果。"},
  {"id": 57, "src_sha256": "752b162bcf59a9ed776bbe7fc9aac06d80b5e6df17b98f6d0f831f7adbfe8464", "zh": "冰冷的冰球炸成一陣刺痛的碎片，傷害爆炸點範圍內的對手。"},
  {"id": 58, "src_sha256": "a88fb146f060d92f78437a4e10fcfc23b1174fa3dbf218aa209108e851c53be6", "zh": "若成功，{{Divine}}的干預將使單一角色卸除所有已裝備的受詛咒物品。"},
  {"id": 59, "src_sha256": "1cedebeadbbc5e96e42f054e9d2e5fa0ffdc93d9e22edfe2897be3b9ac3f7395", "zh": "提升隊伍對{{Divine}}與{{Mental}}領域{{Magic}}的抗性。"},
  {"id": 60, "src_sha256": "dedcab1357c03b1a2807c1e637dec9f6f97c8d22f2cba06e239ea2f7457f063c", "zh": "呼喚{{Earth}}、{{Air}}、{{Fire}}與{{Water}}領域，從其中一個領域召來元素生物為隊伍作戰。每名施法者同一時間只能維持一隻元素生物。"},
  {"id": 61, "src_sha256": "d9498768ba8c106bac26ce37cb24859fc434563e40ee5717e36fc072b08b8254", "zh": "賦予單一目標英勇的能量爆發，提升命中率與對敵傷害，並加快{{Speed}}、提升護甲值。"},
  {"id": 62, "src_sha256": "7d92bb43cf87c59fca08be1f82ca2b5e577e92cb2f175db39c714f4d483b0579", "zh": "以一圈防護火環包圍隊伍，灼燒任何試圖靠近的對手。"},
  {"id": 63, "src_sha256": "23fcfff4697dac57e47d77bffefe4bf921b3c77de92d054b9877b4d517e8180d", "zh": "旋轉的龍捲風在施法者前方的生物之間開出一條毀滅之路。"},
  {"id": 64, "src_sha256": "2514eeb0da6931a1859743e0968ae6e2d25fa7bc1a327cc0e5df474479e9cfcf", "zh": "以{{Magic}}向隊伍揭露生物、其他存在與物品的位置。威力等級只延長法術持續時間，不影響效果強度。"},
  {"id": 65, "src_sha256": "73cb3ff7fd60ea5dbfbfa9147c211297678c2b685d73d02361048eb3a549bc52", "zh": "堅硬如岩的外殼大幅提升受保護目標的護甲值，並吸收突破防禦的部分攻擊傷害。"},
  {"id": 66, "src_sha256": "8057e4fe565082747b9003cc467f9562e1307ff91f563985c16481b6eeb78f38", "zh": "蒸發維繫生命的體液，對單一對手造成嚴重傷害。"},
  {"id": 67, "src_sha256": "23e3136eca21ce1f9f244171cd7eb7e36f5ca2a879f2c84d4c9cda0401962a53", "zh": "嘗試瞬間凍結附近所有對手，使其麻痺。"},
  {"id": 68, "src_sha256": "b66dc397a89e6c8461b2fbd8ba6ea9bbec437327af4f869015630eebd24253c3", "zh": "以{{Magic}}撫平全隊成員的傷勢。"},
  {"id": 69, "src_sha256": "f1d976fefbe5691f29e0a295919ad98802175f957b64e88359a91e84acb34d17", "zh": "一團厄運的烏雲籠罩受影響區域內的對手，詛咒其一切表現。"},
  {"id": 70, "src_sha256": "e5abe8b2fc1fd4daba41273bb56de950b262980631aefcaa1d1b0412e555eee5", "zh": "嘗試即死單一對手。"},
  {"id": 71, "src_sha256": "aac7209fd850d7b1b55096372e591866a1e9ee30255185bba1c3e0c7339cade4", "zh": "一道精神能量衝擊灼燒一群對手的大腦，造成傷害，並可能使其瘋狂。"},
  {"id": 72, "src_sha256": "a2064ee76e2a91b44dc981d9ebc41a193999e2e172ed4b6e90211958ed194999", "zh": "嘗試淨化空氣中的一切毒素，解除殘留毒雲造成的持續效果。"},
  {"id": 73, "src_sha256": "31dc7e7526452507f904d62a2ebae46e0df1ea9a75dd6450e12e9e70ea0acce1", "zh": "將隊伍送回施法角色的個人傳送門位置。"},
  {"id": 74, "src_sha256": "9d238d8bff2baf5e252272388aa8cf1b7fe1b9384cfd745fa4780ea96a497e49", "zh": "嘗試使瘋狂或倒戈的角色恢復理智。"},
  {"id": 75, "src_sha256": "73f6a79d92fca096578d891fb7908622b53346c51d9d88453d93dc900309ecc8", "zh": "為施法角色設定個人傳送門位置，非戰鬥時可用返回傳送門返回。"},
  {"id": 76, "src_sha256": "715f6a548e19bcc074bc18713d05c01835ca40e41f5c80b1080e48ed55e5ca10", "zh": "毒雲降臨目標區域，使對手傷口流膿，並可能造成噁心、中毒或昏迷。"},
  {"id": 77, "src_sha256": "56d5072a103182d5072b0b25953fbe1177e4686f402efad8b7cfb24f2195aaa4", "zh": "{{Divine}}能量對附近所有不死、惡魔或被召喚的生物造成劇烈傷害。"},
  {"id": 78, "src_sha256": "4a424c55481b20d2345836667789184e99f3422eab92695c6dc01875ab88b0e2", "zh": "一陣旋轉的風雪包裹施法者前方的對手，造成傷害並可能使其失明。"},
  {"id": 79, "src_sha256": "b6b126505af52984b9f332385cff966f6503efaa08b5fc5c740b4b24900b5d43", "zh": "痛苦地提高單一敵人的體內溫度；該敵人若被殺死，會猛烈爆炸，灼傷任何不幸站在附近的對手。"},
  {"id": 80, "src_sha256": "7b87bee52913ca1ee2fa769187f9e94421c0c516180cee9a54734b393069cd62", "zh": "一團雲霧籠罩目標對手，在效果持續期間不斷削減其生命、耐力與魔力。"},
  {"id": 81, "src_sha256": "723c2ad2db2f2a58097edce18ed297440a1e056c6c2ce5f1833e31805e87c904", "zh": "一片橫掃的燃燒餘燼之雲降臨目標對手，造成持續灼傷。"},
  {"id": 82, "src_sha256": "f1241290d93a4f9cf9645dbc083bde1d546494dfc4856b2ee8f351d1fa066e0b", "zh": "嘗試吸取單一對手的生命力，並將奪來的生命能量轉移給傷勢最重的隊員。"},
  {"id": 83, "src_sha256": "17da2d5d7b0647786565c6aca380754f3949d0f003b75db599b4e3d7ba3dfa79", "zh": "電能長矛痛苦地灼燒施法者前方的對手。"},
  {"id": 84, "src_sha256": "983b4a9c18ddfa3b215bffbf68e7daf9daf947b72cc68e339da9d2c3754abb8e", "zh": "嘗試吸取單一對手的生命力，並將奪來的生命能量轉化為魔力，交給最需要魔力的隊員。"},
  {"id": 85, "src_sha256": "1fbb6a1586ae644754ae5efc17977e2a6987b3bbc392ed285eb93d4fb3792926", "zh": "空氣本身爆發出猛烈的喧囂，至少使附近的對手恐懼，並可能使其瘋狂。"},
  {"id": 86, "src_sha256": "f2d8c3737ed55081ed2e6462e6d860e1c4c9772db0898c08a607ed24b89abcf2", "zh": "幽靈雷射射向施法者前方的對手，造成各種狀態或痛苦的傷害。"},
  {"id": 87, "src_sha256": "d69ec29dddba30f5854a1b82eb4c99d65c316eb6c29faa2c93fc48fc65b1253e", "zh": "改變地面本身的成分，形成流沙，試圖吞噬爆炸點範圍內的目標。"},
  {"id": 88, "src_sha256": "eef110600eecfd1b27298b2371e166fa96796bf929ec9b81953fecc51b2e1361", "zh": "嘗試使死亡的角色復活。"},
  {"id": 89, "src_sha256": "697235f8c137d1dbf4569bce0dae28a233f0a6488ce00c09377f54c6af088107", "zh": "嘗試改變一名對手的忠誠，使其倒戈為隊伍作戰。"},
  {"id": 90, "src_sha256": "4d7636f483d83c911212147ae7e664c8cfb3eb8d3f64efa133dce6ab3c7534bf", "zh": "嘗試吞噬附近所有生物周圍的空氣，成功時使其立即窒息。"},
  {"id": 91, "src_sha256": "ef6ce4e308b9f941e48301a6d193d3cc1c412f343b262272e8935723e004ba9a", "zh": "一道強大的精神能量衝擊使一名對手的大腦液化；若其倖存，很可能徹底瘋狂。"},
  {"id": 92, "src_sha256": "90953f6b70394bb87cdb307b916ae6f844136c48d150fb3325cbbd12b740d0f1", "zh": "一股精神能量如重錘般砸向單一目標，造成嚴重傷害，並可能使其昏迷。"},
  {"id": 93, "src_sha256": "b7dd6799215631365bf77b96043f1be9b3fd008cc6ff0dab202bfe8d42303f91", "zh": "一團黑色死亡之雲籠罩對手，在雲的效果持續期間，他們不斷面臨即死的可能。"},
  {"id": 94, "src_sha256": "9081a8b566461628b7953c17753a7dae7860a9aef8336c7ddc6bfefcd027eef1", "zh": "嘗試對附近每一名對手降下即死。"},
  {"id": 95, "src_sha256": "5c6734d918c50a1e11ba183c9a8a2bfa9a17f99725099fd579e790c27b930f27", "zh": "猛烈的地動對周遭區域內每一名對手造成嚴重傷害。"},
  {"id": 96, "src_sha256": "9d5396c3353d1a7e8419c6b8052a54f6738e5c93893e5f13a78bf8afd32a9db4", "zh": "流星雨自天而降，對周遭區域內所有對手造成痛苦的傷口。"},
  {"id": 97, "src_sha256": "dcbe20f7a04f5d6112feab68be09275bdacb86feaf328692227a9187c9f46cd4", "zh": "可怕的能量湧動熔化周遭區域內所有生物的大腦，造成劇烈傷害。"},
  {"id": 98, "src_sha256": "73e6a5e219cfa460b394632328adf42d9b33156d0fa9c008da4bfec56d560ad7", "zh": "強烈的焚燒之力自施法者向外擴散，重創周遭區域內所有敵人。"},
  {"id": 99, "src_sha256": "3fc58f4174e6cc54eb54cbbb37ce2badced21de01a97f7e2802efbf97c8c0682", "zh": "一圈幽靈火焰自施法者向外擴散，對周遭區域內所有對手造成各種狀態或痛苦的傷害。"},
  {"id": 100, "src_sha256": "8a523111ae15c9063ea944ecd3b4eed2549828fdfa4d926b2dde37c2b2368959", "zh": "強效的治癒香膏撫平傷口，並解除單一目標除死亡與被吸取之外的所有狀態。"},
  {"id": 101, "src_sha256": "562fbdc1f8f30b6b233b20f880d2bb14c862639ee2b70971d322f482fbe4b98b", "zh": "極端的潮汐之力壓平施法者前方的對手，造成極大傷害。"}
]

[
  {"id": 0, "src_sha256": "29fd56a523a11eac75254ef9323df423fcbd4a2eb982071ae98024ac8c9801e7", "zh": "行。別指望我廢話。 "},
  {"id": 1, "src_sha256": "0be3df68a707cdf95b52bb59cd0611c8085fb3aff9ee4343072dedd35dc959ee", "zh": "很好。 "},
  {"id": 2, "src_sha256": "6b0d3187ac602a274a45601d1d20413889915498dab148b6c08e1a2b2a57723f", "zh": "受傷了。 "},
  {"id": 3, "src_sha256": "ee0c60b775091ef27519bad2a771733fe9440514df9701d23c2edb33af255e51", "zh": "傷得……不輕。 "},
  {"id": 4, "src_sha256": "8358c6680e422b9e90cfae98f7e09f3870ab756994d754172b957bab2f130b43", "zh": "得歇一下。 "},
  {"id": 5, "src_sha256": "bc0c59bcedc46157d144e63b377b1b87b344b111a682b281f9f8383990c523c4", "zh": "病了。大概自己能治。 "},
  {"id": 6, "src_sha256": "478af56dd8500f0bf60cb86b2187f4302ea225ee71e3ed78dd209d977556f658", "zh": "不太對勁。 "},
  {"id": 7, "src_sha256": "631731e485ec7ffb16635222126e87d50ad685c4d85291399e670e91490d669c", "zh": "看不見。 "},
  {"id": 8, "src_sha256": "b3699fabd0743f8111100e36af3dd50d59a403e747440f5bd96f90f6ad4d8993", "zh": "太重了。 "},
  {"id": 9, "src_sha256": "d9cec0b6e8ba179a09cd65dbc8f96f1ea408017cba51ed6ac6e162eb1540ba7b", "zh": "硬得跟木板一樣。 "},
  {"id": 10, "src_sha256": "41329ceb3e1b848f2417351e10f07403673c5c06e77bd18274778651f88e1159", "zh": "嗯。 "},
  {"id": 11, "src_sha256": "a499fbe0666f79682ec4c6f078d6cf7de0ead889039814fe3da64f0392b84110", "zh": "真不舒服。 "},
  {"id": 12, "src_sha256": "52064f3b26ea46dda37a11dcbb4f15dfebee49322a24b6db365fd04989c38612", "zh": "謝了。領情。 "},
  {"id": 13, "src_sha256": "02b3e31bdd82ba7fc2c68af5deb9ff01dad2034cd5f4a707ed500ee1924db50d", "zh": "不妙。 "},
  {"id": 14, "src_sha256": "d82dcf9e1a4e4c59a4e1b3b766c28ff8c74c5746900b0dd387684fff15bf1e93", "zh": "還是清靜最好。 "},
  {"id": 15, "src_sha256": "f5c83b84ab0c02dd53afb20806719b647aa0447b7850bf53b254d6de1c3a4126", "zh": "你們這幫人只要肯閉嘴，其實也沒那麼糟。 "},
  {"id": 16, "src_sha256": "181ae4eae80ef9d5f9ab41a18cae61b0ec6e397fc13d1ba57c969093643ecf7e", "zh": "抱歉。 "},
  {"id": 17, "src_sha256": "7dabd0c45bac9ed4a034d67a0d10bc69abcd46620b8d4605f938802378d505aa", "zh": "小心點。 "},
  {"id": 18, "src_sha256": "faa1b189c14aa8eef19fdfe689e2b1ba3e058f3330c0c6f5f7ce462e4365f73d", "zh": "他死了。 "},
  {"id": 19, "src_sha256": "9d6fe205f0e1a376b970791429cc4ad99edc778d55d7bd38db0479ed08543a47", "zh": "她死了。 "},
  {"id": 20, "src_sha256": "75b8ba856028d530447d9992d3eff01d7c7a9e2452c44abcd0ed17e346cefd2a", "zh": "埋了，還是救活？ "},
  {"id": 21, "src_sha256": "a1ddd0cbcc2e9d574675c822642ea715c94908ba2899d1730377234360bb5aaf", "zh": "沒剩幾個了。 "},
  {"id": 22, "src_sha256": "ae984feb620b62d9e1fc0738c3a2f865b245851701609e463781708693cdcbd0", "zh": "終於。清靜了。 "},
  {"id": 23, "src_sha256": "fbdcaa0874c9e7945266e50121ef82cebdc929f6a8887bebf5644b3ff6eb96d0", "zh": "看那邊。 "},
  {"id": 24, "src_sha256": "7a3a4146aac143d0ad71cdc73d9d1baa93c5f6c76330de2aa88af8b4a65e0cdc", "zh": "有東西。 "},
  {"id": 25, "src_sha256": "d2b3b17930afa712dc28aa31fa66fa15366c4f69ada8f9fd2f01a9cfb3766a87", "zh": "有陷阱。 "},
  {"id": 26, "src_sha256": "6ae57ed2a0a4090c3c3184d85b099ab212dc5bb4e5762b71c9e975e888d612bf", "zh": "有東西藏著。 "},
  {"id": 27, "src_sha256": "658f798a9d726d39fb023b9dc141f559c16856a98be97106ea9a0102fb9b4467", "zh": "這裡看起來不安全。 "},
  {"id": 28, "src_sha256": "48ff8508187618b7729043dd0529e2ea9b52369e2785ea2198d40edee3dc9aa4", "zh": "我受傷了。 "},
  {"id": 29, "src_sha256": "fde7bc0488e11fd02a366421c04024450149c38e14ff433c2e438dc9f023da93", "zh": "這些傢伙不成問題。 "},
  {"id": 30, "src_sha256": "4aaac495fd40e1096067abde488ee46eaf1e46b6ba51c11a7604b8b7964abcb4", "zh": "我準備好了。 "},
  {"id": 31, "src_sha256": "306f240e5d2322e910a9bbd7c901d085bf3e9c3113786d6f0a89af5c4d43de9b", "zh": "這些得有人幫忙。 "},
  {"id": 32, "src_sha256": "cfb67fdd05a6c5d165fb23fb6b0f42eb2af6d002d4d2f1441faefeb55c4ef6f7", "zh": "我需要目標。 "},
  {"id": 33, "src_sha256": "a894f34d3850101bbeba770ae3992c3d0f1ef47351b8baf2b2d086b6dea8ce07", "zh": "人真多。 "},
  {"id": 34, "src_sha256": "96f9afef584bdb9500ef167dec418f91fd604e447ee13768708d8646970a9cf7", "zh": "沒打中我。 "},
  {"id": 35, "src_sha256": "03aaff58c0e576c9aa8a70d92bf063efb97ab5d1e26ed65352a2258f59abb397", "zh": "好。走吧。 "},
  {"id": 36, "src_sha256": "54aad8d1afa97c451f5518fb44945aa44cd29016f8bf3ea5ce7dbddc6d41eaf8", "zh": "很好。走吧。 "},
  {"id": 37, "src_sha256": "f78b2d02248f258329b1378ea767940c28d02e38bf2a08b452d0ed8b88aa7d7d", "zh": "絕種了。 "},
  {"id": 38, "src_sha256": "c8142f36328c4f252b6a7952bf0cac48a3f0bb00a703576695d907350ecc338c", "zh": "該死。又來人了。 "},
  {"id": 39, "src_sha256": "7014c94349747b8b084d33950659ad74f23a75a5446a28fcfb2b52103a84e0fc", "zh": "我需要更多彈藥。 "},
  {"id": 40, "src_sha256": "e5efc6343ef6b2293729078153de2fbc0b10eb8fb5e9e44302fa5a75dba296bf", "zh": "看來有人走了。我這邊更寬敞了。 "},
  {"id": 41, "src_sha256": "6a7eb35a8ac7b67aacb1647fde88f277a15947ea10bf4b2675181d4e78718820", "zh": "安靜的地方。不過都顧好自己的背後。 "},
  {"id": 42, "src_sha256": "baa00047c3239195d8ab4b9851dcc37af1979ba8129c45733cf679600b28024a", "zh": "所以我們有這個圍欄，想幹嘛都行，對吧？我只有一個要求。我要我自己的荒島。 "},
  {"id": 43, "src_sha256": "1f625c6a406bbf7a228b91a96e6813cb9c28e4dc81ec2b92c2aa421fb5205281", "zh": "不賴。 "},
  {"id": 44, "src_sha256": "db681ae254a2c882eaa696080c5d338571dfdfb65ba80de1c19f37ec426b5ee6", "zh": "我不指望誰幫忙，但那個 Rapax 惡魔——她對我動了手腳。某種{{Magic}}。我要是走出這裡，就死定了。就這麼簡單。我們得回去。 "},
  {"id": 45, "src_sha256": "c1bfca50541bbad1ee6747cc763419fcccb3fe521f856958815daec58aeab22d", "zh": "我感覺得到她……就在附近。準備好。 "},
  {"id": 46, "src_sha256": "17e2de1ebedbbd3c72a70ae2f866afed22e630e36f241e35f6a0812c5e0c1f25", "zh": "不錯。那些 Rattkin 一定挺機靈。 "},
  {"id": 47, "src_sha256": "1ed997658b676483eb63e9a91c6ff9482d4bbcbd15ef178ed60d1b5d18ede2e0", "zh": "原來就是為了這玩意兒鬧了這麼大一場。 "},
  {"id": 48, "src_sha256": "19e63a116321974ac43dd051b7dee019207f2b18c12ecd3a831b69a319c3143b", "zh": "好。我拿到了，但我不想帶著它在這兒待著。我們不用跟 Mook 打。 "},
  {"id": 49, "src_sha256": "eee1c278c03bbb0862cd84e00108d1522526ad87f157fdd6ce4d09f87877fbb6", "zh": "Chaos。哼。看起來沒多混亂嘛。話說回來，我也不打算去招惹它。 "},
  {"id": 50, "src_sha256": "ac691aca4b43e3eb23acd824f1ed3e82512a83d61fac40ee9142ddc62080714a", "zh": "這可是壞消息。 "},
  {"id": 51, "src_sha256": "1dc934cab777fd3f455d38a57bd9e66b7879b35a7c33a50bae679f1b251ec2c6", "zh": "我得走了。過一陣子回來。這是 Mook 的事。 "},
  {"id": 52, "src_sha256": "2de88756da7f711622f3e496aff0db24273012c66e320501124e032dd9e5852c", "zh": "我不會問你們有沒有想我，不過 Mook 那裡有個很有意思的裝置。要弄到手，得靠你們幫忙。 "},
  {"id": 53, "src_sha256": "f8f5cc8eee9e19001eef640ad382df2876ec428d387de16e79dd0fae42e36429", "zh": "辦不到。 "},
  {"id": 54, "src_sha256": "e0355f1006684f6fe0895ef206bf6b7032d2d0dd5b4dc3569a0d1fffc10b121a", "zh": "別信。 "},
  {"id": 55, "src_sha256": "1cbeb9fa4092d3ee3a5cec659b10b923f038f370db992b92dede78fb4d554504", "zh": "不錯。 "},
  {"id": 56, "src_sha256": "1cbeb9fa4092d3ee3a5cec659b10b923f038f370db992b92dede78fb4d554504", "zh": "不錯。 "},
  {"id": 57, "src_sha256": "6d5d833ff7ffadc6dfabb6a83160287942cbcbab4732cbadcc1743862a3d1382", "zh": "是 Vi。 "},
  {"id": 58, "src_sha256": "1ee4bc6b6d137ae7c67fcf2364912c54f073ba7280f148fd8f973e46f331e12d", "zh": "我們逃掉了。 "},
  {"id": 59, "src_sha256": "9f3e5431ece7bb19b89a430d1b0606b0f3848e75805e6963d933cac97b178691", "zh": "所以他跟 Rapax 聯手了？不意外。 "},
  {"id": 60, "src_sha256": "6976adc5a992b6179b1fa3274bbf5af7b0c07fe591b84f0acc3d47f66c6901ce", "zh": "我看他像是快要散架了。 "},
  {"id": 61, "src_sha256": "bb624230b8187384223c652dec8ae629f8a924a6eb1bbf0be8b830569e617a23", "zh": "好翅膀。 "},
  {"id": 62, "src_sha256": "2ec6d320a5974be57d342025516e92e55184057fd84e61b9a708675362093a10", "zh": "好槍法。 "},
  {"id": 63, "src_sha256": "96a946d60e33c0c06bdffd36533d77f38c94a548791d9f6eadcc7e1869d39da8", "zh": "我真替他們高興。這下他們大概會閉嘴了。 "},
  {"id": 64, "src_sha256": "b45532836c6f2f98183f0c2d3eae4368fb5c6883360dbff6f96bbcb4f8704f6d", "zh": "情況不妙。 "},
  {"id": 65, "src_sha256": "577b381b0f22b611f6eb284e036a8f53307a79bcff5a0f43f11f7c85102fb360", "zh": "那件事搞定了。 "},
  {"id": 66, "src_sha256": "41554e408bfe6a0f20ca3c78ce0a433a7cba86fb30bca1a6e08b5942b9b51954", "zh": "我倒希望這就是真正的 Astral Dominae。 "},
  {"id": 67, "src_sha256": "b7d2dc0ad9c5271c22fe5ad55651aafd4d1418911a9e70784f3bba6a0ba380e3", "zh": "有生物。 "},
  {"id": 68, "src_sha256": "be55c9d156d7d3ddbbd0af137c7298961be7ef9b8b0e8c30c8838f4761c50b7f", "zh": "有人來了。 "},
  {"id": 84, "src_sha256": "2587e174d8f8b380399b2a6619689b8739c4e1533c235e6204ad4e02fa36cefa", "zh": "好一點了。 "},
  {"id": 85, "src_sha256": "c203b80d59457ce251e3beb588167492f825f52244f15767d3ebb331f863df1e", "zh": "好多了。 "},
  {"id": 121, "src_sha256": "b482990835f9fac2f14b9b9499eab8df66f09c308e87b5a27c79349142cd8046", "zh": "以一隻蟲來說，不賴。 "},
  {"id": 123, "src_sha256": "75e6dd7b92cc0b017c64173c677227bf337cb75e22cebf702fcfefaaba30b3da", "zh": "他要是真那麼聰明，怎麼會死了？ "},
  {"id": 126, "src_sha256": "151097a91ee11d9a5491cc0cff0ee471bd99d57e6459d8d28fc294bbfd9e8af6", "zh": "我想跟他單挑。 "},
  {"id": 129, "src_sha256": "ab5df9a0a86d00073b8cd176f978c080d4808478442a9bd01429d473ac134d42", "zh": "好，我們墜毀了。現在說這個也沒用。問題是，接下來怎麼辦？ "},
  {"id": 130, "src_sha256": "f484cb418615f9dc561bb7e4f64adbf0f1a0bab898baf047a1a51d60591e6abc", "zh": "不知道這是幹嘛的？ "},
  {"id": 131, "src_sha256": "9e8450c177a8cacfaaed197900d1fcd6cb55553c0699aeadba9eaaef06a6c4ac", "zh": "我覺得好多了。殺了那個惡魔，想必解了我身上的咒。 "},
  {"id": 132, "src_sha256": "a243b75aee58678fb8495aabb00d26dc86619079ddfaac1633c65609579de334", "zh": "拿到 Helm 了。接下來呢？ "},
  {"id": 133, "src_sha256": "e77ae373eeb08e93495f77a40670cbac2db12bc01e15427056090e347f85111c", "zh": "沒人在。這地方是空的。 "},
  {"id": 137, "src_sha256": "e5a75a6afa7cbd2def834529b16a4a78a70d8128434423f8bd63b4ac60f2e638", "zh": "看，有間房子。 "},
  {"id": 139, "src_sha256": "14c9eff5636e1f8a2ffbc83b9f657d29f5ec805837780bf7142535cc680a850f", "zh": "看那些雕像。擺在那裡一定有原因。 "},
  {"id": 145, "src_sha256": "46a6d80f2570c86ec846bf09991160b3549594a7741bd9606913d084236264f1", "zh": "所以我現在成了 Templar Rapax。真棒。 "}
]

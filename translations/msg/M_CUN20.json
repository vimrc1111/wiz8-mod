[
  {"id": 0, "src_sha256": "c63ebf24095cc367e395268fa140034399836df28592fc11ece5c819a557e680", "zh": "有你需要的事？我做。只是，不要寫下來。 "},
  {"id": 1, "src_sha256": "a5e3814e1054b2523f1099cf1eb9718eebbdf5ad0e405d3373532bbb0d1e272b", "zh": "我很快要變大師了！你看著！ "},
  {"id": 2, "src_sha256": "efb44360713586d3a4b4abc146b3014167addb35c654355c30f93f58d15c3302", "zh": "我的血！到處都是！！ "},
  {"id": 3, "src_sha256": "8fafd3a9d1456d0be75b278ca16e26abe02ed1e3154fc7097b027acd5807be54", "zh": "我需要幫忙……我不想死。 "},
  {"id": 4, "src_sha256": "02a4e31d634a5661d7f6561343468a2bd04db0b89e3984e682ca123e3ec42146", "zh": "我腿很累。我想躺下。 "},
  {"id": 5, "src_sha256": "92c4dda0337f82bc6c566a6fc083af26b84e2a2e50a244beb8828f8f410cd77f", "zh": "欸欸……我不太好。 "},
  {"id": 6, "src_sha256": "b51c04f9528d85621f28705b7e3e8c1fa19c5f1bb0bac7ffe7dcf84df6b958cb", "zh": "是疾病，對不對？ "},
  {"id": 7, "src_sha256": "64de9f0f2d91a45c224e11b1efc86bc4ff8afa1f1222494f40d3dbaae9f4c2ac", "zh": "光啊！ "},
  {"id": 8, "src_sha256": "99c791672f13853671b93fd1eb5633477e6c0a24bc6462b9d6cb2612f477f901", "zh": "不是我的工作。我不背那麼多。 "},
  {"id": 9, "src_sha256": "67c45f4a03a4cc57597575c773118fa6931296df029538cfa2c21f92c942d286", "zh": "我的腿，我的手，斷了！ "},
  {"id": 10, "src_sha256": "6378dee5c3354abf33d050d82773b005a6b4a5852ed7fe6c888079a04a53c7e4", "zh": "那也是我說的。 "},
  {"id": 11, "src_sha256": "7dfa00bee6e45b3cf60b1334811dbd7757caacf4be258f7f6eb471d1d3c572e2", "zh": "你從沒說會這樣……我要求以後給我最好的東西。 "},
  {"id": 12, "src_sha256": "ae987854766106a52051c95ff1810ad45d89e5b7f01c520ca494f25a79234619", "zh": "我欠你一個人情，以後還。 "},
  {"id": 13, "src_sha256": "646a89f467b7f6943db5ba61d0b8e541edb8964767911ab1c6962fd9a8f6dff1", "zh": "好。我們跟他們說，事情發生時我們不在附近。 "},
  {"id": 14, "src_sha256": "ea90a72adcbeee8209ef7a559eff1f45653b7dbdb9ba885e9cd5014851a855aa", "zh": "別這樣。浪費時間。 "},
  {"id": 15, "src_sha256": "ccd9dbef56553b99e3e933f7b988e9af8575f50c48ce12154b9f714ae6ecb4c9", "zh": "誰碰我？我把你的手剁掉！ "},
  {"id": 16, "src_sha256": "d839c71c868ed7f9d871deeb7d3ac755be088814b7722aa7be176bbf402404aa", "zh": "我道歉！我搞砸了。 "},
  {"id": 17, "src_sha256": "3d49e7f2279b5e14f021bffc70ffa4bac0399d940d3abc82f28e2b3d4cf9c4d0", "zh": "住手！我們是你的朋友！ "},
  {"id": 18, "src_sha256": "376f89bbaa536b4ef80300ec4d855ca8270b2fe1275941034083dde1e58e0444", "zh": "這樣不好。我們要把他活著帶回去！他是我的朋友。 "},
  {"id": 19, "src_sha256": "f99cf5e34e282c0d542868ff62b9b5e261154f3fa8b0bd1937399dd21b5cb5e2", "zh": "她那麼年輕！那麼漂亮！那麼、那麼死了。 "},
  {"id": 20, "src_sha256": "d524d0cc0191088cbea6d25b08bf3350340848b251a4fbdb1655a3145bcb6e6c", "zh": "我們說是 Dark Savant 殺的。他們會相信。 "},
  {"id": 21, "src_sha256": "677754bd207a61ad952621d81dfa0aa2285e2bb071ca0a7b3225cd2297f8c3d6", "zh": "這不能接受！我的朋友，他們死了！ "},
  {"id": 22, "src_sha256": "1d03f2800d7c3831741218105293f90202a1d589dde261e443fbc1511c9b4b76", "zh": "我換到怪物那邊。我不想死，也不想。 "},
  {"id": 23, "src_sha256": "76babb929bb0156fc39b897c5ccb5a173010f7e6bf0e4370538c67b4e74ab6df", "zh": "我找到這些！ "},
  {"id": 24, "src_sha256": "3456d576d07337406c863919ea43b5f42dc78b752edb211a8cf647e1f5622487", "zh": "給我的東西！ "},
  {"id": 25, "src_sha256": "ffec457ddad0f294ce9e318490a4a27d2efe75930547fe1b6a90f77b1a5e916e", "zh": "我不想碰陷阱！ "},
  {"id": 26, "src_sha256": "be03560c95670d3ad09e8b57a0588ad673b0786bab9d7564ba91934c08d35ba2", "zh": "哈！沒東西躲得過我…… "},
  {"id": 27, "src_sha256": "a348f5f96e415f3758fab8b116b7fc804401216d4a93194b50e45b4160732b78", "zh": "危險在空氣裡。很濃。 "},
  {"id": 28, "src_sha256": "ddc4ea53bd1d0ef3e470b1184241b190af0b555282eaac0aaee464d3d31269e8", "zh": "我受傷了。 "},
  {"id": 29, "src_sha256": "ea518e1cea572f57e2fcf0158c38463524a2920308c3c95584e6973c5e432215", "zh": "這種戰鬥很簡單！ "},
  {"id": 30, "src_sha256": "c6cf8751d34c945b2b2af97893ac972e215a77b68bde9139f0b44226f06731f8", "zh": "我把他們全殺光！ "},
  {"id": 31, "src_sha256": "7f4b5d732be2ef170d17a39297a57d24a06d2bc2ca6e1e61103b6b5ceb78cd42", "zh": "我等。你先攻擊…… "},
  {"id": 32, "src_sha256": "6c5b44f9bae16f103e839d45ccad53c5dbd83a6a0df746ab09f8def7ab14ba3a", "zh": "我殺哪一個？ "},
  {"id": 33, "src_sha256": "aa82fc2b030ff7f419e9b97472c7dffdef64cab4d51b8faf82a06fffd4f515cd", "zh": "到處都是怪物！ "},
  {"id": 34, "src_sha256": "740f36573bdcb3201d4d3c7aaa83dd8d74ceedf4176bcad40a44d4bf5c3ab7b4", "zh": "太險了！ "},
  {"id": 35, "src_sha256": "6f366122321095742427139a4bee5331514821841ffa926d1bb7c1516f66b84a", "zh": "我們贏。沒什麼…… "},
  {"id": 36, "src_sha256": "242584a141c37810198ec9d485301b5b17acb97d207de1b55b0a35c3cd181fa5", "zh": "我殺你不是巧合，Savant。我們初次見面，你在我眼裡看到你的死亡印記是我的命運……現在實現了！ "},
  {"id": 37, "src_sha256": "0324ae6afcf33736d4d54a95ade38eab0278f763e31c9bc36d619430849a804f", "zh": "這裡面應該有錢賺給我。 "},
  {"id": 38, "src_sha256": "c2c3b8f4b4f51683b7ef278aebb08f9b5da4736e9d98fdebbf4f00c889edcd65", "zh": "我不信那個人。 "},
  {"id": 39, "src_sha256": "916ccef56d039be91a5a0201fa4199a3460e107b78dc844dc3ebced6d8d9d5e9", "zh": "沒東西可射！ "},
  {"id": 40, "src_sha256": "36be83f9c862b78d8254e22953f8ef1fa0d0a1ce765666d5fc7f3ba212af376a", "zh": "有人不見了！我來找痕跡。 "},
  {"id": 41, "src_sha256": "326de7ac6212576df249b8f18e5361f0048b2ad7f3ca70ffbe2c91eb175b5e80", "zh": "就是這裡！Cosmic Circle。我們避開 Dark Savant，對吧？最好。而且，嗯，我想要這支筆當紀念品，好嗎？ "},
  {"id": 42, "src_sha256": "0ee46a34a0b367280edd7a97965d9c0baa840d04dbc477e266fd2abbea886634", "zh": "你們先去看看。為表達感謝，我來替我們開始新宇宙。我知道我在做什麼。不用擔心。 "},
  {"id": 43, "src_sha256": "d5facecb1869a1b1ab208dcc7e773a495d4a8a042bf5c6cde2990c97bbbfe0bd", "zh": "不是你想的那樣！她是很好的女孩。 "},
  {"id": 44, "src_sha256": "7a86e5179d1637190f5cc3ad67dc5c28cc5fcba26ece206a6ae0c8282463fd29", "zh": "喔，喔……等等。我聽到腦袋裡有聲音說我要死！是詛咒！是那個 Rapax 女人！跟我來，我們殺她。拜託？她誘惑我，不是我的錯！ "},
  {"id": 45, "src_sha256": "b13a5fdc40126122f73ced45955b34ea479ed52b36d9f6603d14b8395448e833", "zh": "她就在附近！是她的香水味。我永遠忘不了。你先去，殺了她。我不想再見她。 "},
  {"id": 46, "src_sha256": "3e8011b4a6fa837685d658de5784397b8d1bd702425f44a90d9ae1f6c844bf21", "zh": "感謝鼠人，我們有這個！我如果不跟你們，我就跟他們走！他們是男人，呃，老鼠，有遠見的！ "},
  {"id": 47, "src_sha256": "23ebbef9386992102c1597b5756e16d3b2e0b531a7f3ad0ee246d79dd18dc056", "zh": "知識？誰想知道全部？有趣的就那麼一點，有趣的東西我全都已經知道！比如 Dark Savant。他想要這個，他拿不到！嘿嘿。 "},
  {"id": 48, "src_sha256": "9778b87d50c86cd07b659a6b98d295b61792f6fdcfd48e61850c75bb08796c2c", "zh": "這不是給這種手拿的東西！好，現在我們把它弄出去，趁 Mook 還沒發現我的傑作。 "},
  {"id": 49, "src_sha256": "a8b3a3df48c80281d99b56f6a40803f6d882d583bb3842f74f0f3586aadc7482", "zh": "Callisto Device！是混沌，對不對？我不想留著。我們混沌已經夠多了。 "},
  {"id": 50, "src_sha256": "5c10f28d4dbe54c7650f6c1772f127857b8e88a0df8e39f856a30f9f4f7522a0", "zh": "所以事情對我們更糟。這不稀奇。 "},
  {"id": 51, "src_sha256": "dd07eac7e10cf57d390ca5cda2c7cbd4fc52618c0597326cab0d17104507a9f9", "zh": "我看到我的兄弟好開心！你這次准我，對不對？我想在這裡過夜。我查看這個據點，早上向你報告。 "},
  {"id": 52, "src_sha256": "c1df4022ca932529fde1980e53d6d3217ae538ab01fddbb0089f6626f87cad09", "zh": "你讓我留下來，很好。Mook 有我們在找的裝置。我說出來不覺得難過。畢竟，他們只是遠房親戚。 "},
  {"id": 53, "src_sha256": "00fbccd28ba46c97877932e9123c2aede140d0f35fdd3ff324ab545e1c571d3d", "zh": "這不是我能做的事。 "},
  {"id": 54, "src_sha256": "dd24f6924779a1871a5d7df725e46b3d4804f5696b636ca56bc1a53f7c7fbc1e", "zh": "連怎麼說謊都不會！ "},
  {"id": 55, "src_sha256": "9086859e3efadeb15aab0145a8c77a3f7bf735331ad245f2b55dfa5167a89dfd", "zh": "我想把這個加進我的私人收藏。 "},
  {"id": 56, "src_sha256": "6d73e45259846fb9a6f442987071d3ccfd0948ae1ca2fd92ae320204bf052669", "zh": "你看到怎麼做了嗎？ "},
  {"id": 57, "src_sha256": "d7e773006e495d8e3b15315865eb42a90d3e3ef14d03a75d96b60ae59d05aac2", "zh": "是 Vi…… "},
  {"id": 58, "src_sha256": "88ae1c350750ab59f78a381492b9771dd0d4807a7da47d2027aaabea6c0e1ca3", "zh": "我們逃掉了！ "},
  {"id": 59, "src_sha256": "2d2b2c79f518c56bac26339c7f7e64416c74bca19b071768ee159bcfa18aac6f", "zh": "Dark Savant 跟 Rapax 結盟？這對我們不好！也許我們告訴 Rapax，Dark Savant 其實是 Trynnie，他們就不認他。或者吃掉他。對吧？ "},
  {"id": 60, "src_sha256": "b788d917c500e7ca949dcf99ddeaaf0a5170d6e9c21ffc29b84c7d7353f2301b", "zh": "那是 Dark Savant！我說我們安靜快速走另一個方向。我現在不想死。 "},
  {"id": 61, "src_sha256": "5a18446a5d191f55740c2adafffe354522ec8d3512d7dcfe59326de1bd70049a", "zh": "這個惡魔 Bela，他對這座 Forge 知道有趣的事。我們跟他做朋友，好不好？他的肌肉，也派得上用場。 "},
  {"id": 62, "src_sha256": "45ee4b9f57936cf3af1121115699f4919e35cb22f2aca418920d33d1202175c5", "zh": "如果 Dark Savant 不在船上，問我們發生什麼事，我們說是意外。我們本來要射的是 Umpani。 "},
  {"id": 63, "src_sha256": "4ab3dbd3dda9ee07ac8d26718a6336d4694f55dff14ea9262b59004672b32315", "zh": "T'Rang 和 Umpani 之間的和平，如果他們放下手上的傢伙，我們就拿走，好不好？ "},
  {"id": 64, "src_sha256": "94777441614e8fe74fb0838aa88fcb9f54f0cba4ff7889674afeabfdb1910ffd", "zh": "喔不。死了？表示有麻煩！我們裝作很高興他們死。可以騙過兇手。 "},
  {"id": 65, "src_sha256": "154e3f17df1295e56a7c8f05cf2349431600db41a858db5dc697a3c988c78ec7", "zh": "任務完成。我的錢呢？ "},
  {"id": 66, "src_sha256": "64d1b2df52bf933ee169a403ba9902ab5129730f8bc2d44abe14b11ad4e90376", "zh": "這是 Dark Savant 丟掉的東西。他為什麼不要？我看是完美的 Astral Dominae。也許他改變心意，決定讓我們贏。 "},
  {"id": 67, "src_sha256": "1cd374e2f4ef20f3a9cb34a503d86f569e5c71edc37ceaa9db19ab2a3755a3d2", "zh": "看！有東西來！ "},
  {"id": 68, "src_sha256": "e8d19470a2549ef30294752ea7fb35b29b2b183e57711e425990a3d5e5a7d11e", "zh": "來了！這邊！ "},
  {"id": 84, "src_sha256": "dcbcb43e5de8783888c0622ad154cd6905f56ec1a14cc38274804dae653fd38e", "zh": "有好一點。 "},
  {"id": 85, "src_sha256": "f96597ba23053f414315d53e91b6383818ac9bebd2ed3db7c0f792e03ba7666a", "zh": "好很多。 "},
  {"id": 121, "src_sha256": "523fd2471a5b1e3447fb0b4204da6684efc7ac4bc3b0db2d1884d32061e318c8", "zh": "我想也許我們可以信任他。 "},
  {"id": 122, "src_sha256": "3934b67af3e71d9b77ba35d956c0b67f83a12b7bcd06d2da146e746cefb729ad", "zh": "他是很有幫助的人。 "},
  {"id": 124, "src_sha256": "f8843cc510a77fc35c5f824500f99d86b38b7807b911739e786df66116a4ec68", "zh": "Cosmic Lords 的使者？誰會相信這種事？ "},
  {"id": 127, "src_sha256": "2a4b18bb2d417160128b6d83768fff2234c3cb6ee79a4938044ca80a891e3a71", "zh": "他是聰明人，但我們在他身邊要很小心。 "},
  {"id": 129, "src_sha256": "80abdd5ff06974d6926ff0518e7a00c727de4bfbbd25e78f05fcc23f4a6fcdcf", "zh": "所以我們墜毀在這裡。我們就盡量過好。第一件事，我們探索。 "},
  {"id": 130, "src_sha256": "57d34e7c7410ced9eff92dca330dded33c78e40926399b16573b5ef983c2450a", "zh": "你覺得這是做什麼用的？ "},
  {"id": 131, "src_sha256": "156a96c244f25d5a741e009e9337cac5e7478d8bab685ab62b739eceb247bcc3", "zh": "我腦袋裡的聲音，現在不見了。她的咒語破了。 "},
  {"id": 132, "src_sha256": "a98d16bad8f5ff042453bc94ddefb4a3548172683e2ad89407ac20cefc9ae05c", "zh": "我們現在有 Helm，很簡單的工作。我們接下來去哪？去他們說的那個 Marten 嗎？ "},
  {"id": 134, "src_sha256": "f66db7c7eaeb4cdd798baa17206632e070e88439a63f6c1bc1a1dcd747e5f1fe", "zh": "這就是他們說的塔。Dark Savant 的塔。 "},
  {"id": 137, "src_sha256": "c17e841244fbe8f116f07a29e3f4853d8932141e38dfd51b1ddf6976089fb9df", "zh": "誰會在沼澤蓋房子？你問我，他們瘋了。 "},
  {"id": 139, "src_sha256": "2b9652ba14cfbc30fe9423eccefc5875fa432af972333020978de97c2440694c", "zh": "看，看那些雕像。每一座朝不同方向。我想這有意義。 "},
  {"id": 141, "src_sha256": "a8ca0f989ca167de5c7b6f556b9c95d24dabc8671f6bec757c5e7bc5fbb01b6a", "zh": "你確定要在這裡游泳？看那些巨大的骨頭。也許那樣的東西還在游。 "}
]

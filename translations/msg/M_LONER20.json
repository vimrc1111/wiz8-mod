[
  {"id": 0, "src_sha256": "bb4b9db46ba1c8fa38255b7e4f4cdc7553d59833abcbd2182a2360bfa33c6d60", "zh": "當然。反正我正想幹點瘋狂又魯莽的事。 "},
  {"id": 1, "src_sha256": "50f2399ae031928246f4f796bae289beb0d8ed68c64ac96555f660d0d09f3040", "zh": "真刺激。我想我有進步了。 "},
  {"id": 2, "src_sha256": "6bcee7ff6131c4a8ca65c50de47153109e02cb9b517524f2f258dbd41243ee50", "zh": "哎唷。 "},
  {"id": 3, "src_sha256": "d035739f3214e4185cc6af506c6a4dd0f9228515d256aa162c59292f16cd292b", "zh": "哎——唷—— "},
  {"id": 4, "src_sha256": "4b35bfc766eb90bc43dab3f47466dbb6b9cc7ca201d3e450005e0467f80bac54", "zh": "哈欠。 "},
  {"id": 5, "src_sha256": "6d9659a72d2c23b1cf63b6bcd7269eacb6cd196ff2fff27d830e5d45c157274c", "zh": "我……病得很重。 "},
  {"id": 6, "src_sha256": "b47b04fc5a61908a9803dd0e5c7042c25fb97f9c6f8bed688e2549a0ffcd52cf", "zh": "突然生病了。 "},
  {"id": 7, "src_sha256": "af43e9109eef6bff55b37b94a1769bab0ecbf9d688154732d322d42a02d4b10c", "zh": "糟糕。視力沒了。 "},
  {"id": 8, "src_sha256": "9f900a4d1c952774e4faa3b0b300251c29c55042ee1428f65a0ec3d3eecf4ccd", "zh": "這可能就是壓垮駱駝的最後一根稻草。先跟你們說一聲。 "},
  {"id": 9, "src_sha256": "86e4bf1ad149680ff3d3128ef2732b1b6906e92869252b2c002aed77086c920d", "zh": "我……動不了了。 "},
  {"id": 10, "src_sha256": "5e92144db96074a95880d8e37087e0aea1e1f699331e86b70d39815bb07512fb", "zh": "我想你也一樣。 "},
  {"id": 11, "src_sha256": "b8f85a7522426511007fc53adcb5e89906d8c73643edcde149601eb3e9ad003e", "zh": "我大概得去做個心理治療才能走出來。 "},
  {"id": 12, "src_sha256": "042c5ad5f9e7ae4e7df607014bae00311c4e565473e15eb37b9bb97f08e7d8f8", "zh": "另一邊……被高估得很厲害。 "},
  {"id": 13, "src_sha256": "b17ab536aaec0fdf2cedefa260fe1d37a7c028065bb63915a4c3ad6f4a9b41dd", "zh": "真是悲劇。我自己一個人還比較好。 "},
  {"id": 14, "src_sha256": "7ee1d47b3abef78c37adde7586557224d324c62f9008c82b677661f12d4729e7", "zh": "我敢說我能把你們全部解決。 "},
  {"id": 15, "src_sha256": "102c0389ec53672b7f3217662bbabfea93720e2d67ba722dbe0c0e5a08c31894", "zh": "什麼？我沒在聽。 "},
  {"id": 16, "src_sha256": "1cf709dc7faf04a3c1637431ac66dc572bb0ea50969584eda45ae913c174f8f4", "zh": "我是故意的。 "},
  {"id": 17, "src_sha256": "9df25fc43b4463b8c7f01bdd45f48a25585ddb28c2871bacebbf27c4dbb45d78", "zh": "我們主要是在威脅我們自己。 "},
  {"id": 18, "src_sha256": "4fcf2188650ab7d60a3cd83f1418dd40c77d59a1708e4c18455a4464c1912d38", "zh": "噢，不。真浪費。 "},
  {"id": 19, "src_sha256": "b646463bdf5ec9e7a261b9acad29d23a2d3014a410618852dc2371d9e3cb3a67", "zh": "我悲傷得難受。噢。 "},
  {"id": 20, "src_sha256": "bc619fa78cd173139d34afb6bcdce78dd10641abfbcdb6d52ecdb2d1f7d62390", "zh": "我在想……我們好像有義務，你知道的，讓他們活著。 "},
  {"id": 21, "src_sha256": "b830bdd47069f2c522345eb949627bf4f4bbe48a1ae867dee94eba1e693d6889", "zh": "這是個徵兆。不是好徵兆。老實說，我就大膽講了，這是壞徵兆。 "},
  {"id": 22, "src_sha256": "dfd03f2cff7fdd9b6e0a4fc55e8f8afa3912021cceb0f664413dd8b58b8d4359", "zh": "無意冒犯，但這已經沒救了。 "},
  {"id": 23, "src_sha256": "155967e647b7ecee34f279d204b62903350780b0e9a52d600b0a79a2c0a84b41", "zh": "有個落單的東西。 "},
  {"id": 24, "src_sha256": "1addbe82f1a4d1f8397a67eec6446763164e4f5ab508c707e8f6c5c165265ce6", "zh": "撿起來。 "},
  {"id": 25, "src_sha256": "c34993383d83597cdc9a7165aec58140d1bc529e4845ca45514c09edef8762e1", "zh": "這裡有個很危險的陷阱。 "},
  {"id": 26, "src_sha256": "842708d8f06787726f064488c06cd063d7ad741d0e5c10b938189ab5b279af05", "zh": "嗯。這裡有點不對勁。 "},
  {"id": 27, "src_sha256": "1777f421394ae89d03e126eaa5a2c1b633d6f6e4c438e18c371caa96beace0d8", "zh": "這地方讓我毛骨悚然。 "},
  {"id": 28, "src_sha256": "0dea0c1643ded1d592a48a762fe9d0c5acb2dcaf14c21daed89309e0c80d280b", "zh": "唔。 "},
  {"id": 29, "src_sha256": "156a725843a509ffcfd0040014e72cf70954aa7540121283dce99a78af490d72", "zh": "這是一個人就能搞定的活。 "},
  {"id": 30, "src_sha256": "4122e44ad98436e55395b306b4630006b1c30b4ebbe416f5ab23cd4d67c35838", "zh": "我殺心燃燒。 "},
  {"id": 31, "src_sha256": "91995d45000a6f2646d09a0eb0eeec92d908969266b4e86d3a3c8114d662ae40", "zh": "這……有麻煩了。 "},
  {"id": 32, "src_sha256": "933b0a09adad8122801ca7e8df003bcde581d64b4f1c7be4647d1a63c9fef4ff", "zh": "給我指個方向。 "},
  {"id": 33, "src_sha256": "ce6defc47ed5c80bcf48866c1a4be3500ec4b4c18b18c5d517f26616a60742f7", "zh": "他們一直來……一直來。我開始有壓力了。 "},
  {"id": 34, "src_sha256": "3073e8e30f80f5b48a2d7fa70fd4e12715c61bf1d07785d7ec897ebb5a921904", "zh": "噢。差點中了。 "},
  {"id": 35, "src_sha256": "2e6ffb89aa29ad31a818eb010186f777b198a47f3e70ad6049e263a0e9e86037", "zh": "我還活著。 "},
  {"id": 36, "src_sha256": "31490ec5d6953855ed4f14e5cc13f587eb6a28dd770d0ca92354c1297ce0f665", "zh": "殺了 Dark Savant。這是我最偉大的成就之一。要不是太俗氣，我真想把他的頭做成標本掛在牆上。 "},
  {"id": 37, "src_sha256": "803c38ebba06418d1558d3f753a1eb583837b09c1487d2cc97d3f5e40f82f678", "zh": "那一擊意義重大。 "},
  {"id": 38, "src_sha256": "ce296b94396e3650acb0a173b24cb688d30f8633ba0b121970ff351f79325b7d", "zh": "噢，不。又來人了。 "},
  {"id": 39, "src_sha256": "8a31e772fe66eaa378520133d0e04750b705ef8dfaad3b7f6b251cf2e7ba19f3", "zh": "噢，不。彈藥用完了。 "},
  {"id": 40, "src_sha256": "7cc13881149371aa0f82855076e6392ce43cd274a2ec111d966642540ecc222a", "zh": "糟糕。有人溜了。 "},
  {"id": 41, "src_sha256": "8b1c06609e4ab2a1d4c271588236389d3d704fd3570cbecfcea0040e44a237a7", "zh": "我……非常興奮。這就是 Cosmic Circle。當然，Dark Savant 剛好也在這裡。這是壞處。 "},
  {"id": 42, "src_sha256": "b05d7b424eaa004604624b58de60556aced2dd4b240954f48a1b7398a6610ba0", "zh": "我……樂壞了。我們贏了。我覺得只要我們用點心，就能弄出一個還過得去的宇宙。 "},
  {"id": 43, "src_sha256": "a01ea2ce4522dffd31c974a217409bec48d9960753b996a215c3d4c50a7d05ef", "zh": "呃，我得多出去走走。也許她也該。很難說。 "},
  {"id": 44, "src_sha256": "ea29f8787d23c1b021ccc9989bd6db8823669deea40a199b60a504c215d5cad9", "zh": "我有個，呃……很嚴重的問題。你們記得我跟那個 Rapax 女人的約會嗎？當時挺瘋狂的，現在越來越瘋狂了。她說我離不開她，不過所有女人都這樣跟我說。但如果我現在的感覺能說明什麼，我想這個是玩真的。也許我們該回去，跟她，呃，開個小會。 "},
  {"id": 45, "src_sha256": "ce2b1a9631f2a0a5256728ef9fdb590017ca750ccfaf3754749baa19e1161426", "zh": "我……呃，確定她就在這附近。她的香水味很難不注意到。 "},
  {"id": 46, "src_sha256": "fa7821ec397c8821dc0fbf15ae773fd190cca21fec4f62c6a1c01bdb04b36d7a", "zh": "Rattkin 加上眾神做的裝置，會得到什麼？利潤。就是利潤。 "},
  {"id": 47, "src_sha256": "f482fb325a958865f2277b5e9332472bea1c56914641b51c8583fb2cb1d3f976", "zh": "要是我像 Marten 那樣什麼都知道，我就會知道別把這東西交給我。我想在它把我變成殭屍之前，趕緊到 Ascension Peak。 "},
  {"id": 48, "src_sha256": "fc36b7b532f1e8cac299f6b2f9c60440ba15eeeb9f08b3120ecd31cfa0b77065", "zh": "好。別太興奮。我拿到了。現在也許我們該趕快離開，免得惹上 Mook 的麻煩。 "},
  {"id": 49, "src_sha256": "71922e98502f842882469c4650e6c65a8e64008978dc55dec998a20266913bee", "zh": "Chaos。哇呼。好了，我們可別拿這東西冒險。我想在它失控之前把它送到 Ascension Peak。 "},
  {"id": 50, "src_sha256": "2b26cef6edbb45add839edf5cda106c4a2f5afcb2b60f715634b609c1adf7cfc", "zh": "我們有更多樂子了。 "},
  {"id": 51, "src_sha256": "6b962f6f31143cb885eab1f5d0df78ada3dfe245c47cf19872e0d5c274099cdd", "zh": "這聽起來可能有敵意，不過……我要走了。我是 Mook，他們也是，而且我不會攔你去探望家人。你們知道我的。我很重視人。 "},
  {"id": 52, "src_sha256": "01063c1099d3439956300d49393b8917b31c3a692ba3bbbe291868e9c7f1c704", "zh": "這趟拜訪很愉快。我還得說一下，Mook 那裡有東西。看起來很重要。我當然很興奮。也許我們晚點該去查查。 "},
  {"id": 53, "src_sha256": "d0cfc8d17810ee7f761d9cc87396a4cb1ca0a83cc3c185f993dfb77c9470d241", "zh": "我……辦不到。 "},
  {"id": 54, "src_sha256": "8a553c98076c1dbf8e6a7a3ae047bf9016266c6997cceb522cb872ff2642c83a", "zh": "人會說謊。 "},
  {"id": 55, "src_sha256": "298bd23dda23db4df30f064f86ed6ec59f70d60112e96f061b36047dd442f75c", "zh": "了不起的標本。 "},
  {"id": 56, "src_sha256": "5a3b03efa45c533a64e74b3cc8841d5abb9602dec1312492cdc80b21fb9a342f", "zh": "我真是太開心了。 "},
  {"id": 57, "src_sha256": "a74f777fba7a09917ae50a0b0ea5c9130fdaed28c673d3ef1a2cf608cd2f81a4", "zh": "Vi。 "},
  {"id": 58, "src_sha256": "c6d8e648b5074b0f7af278b1ce3302c4efbd2352a6dd77bff52f1bfe336d07a2", "zh": "為什麼要走？我本來可以收拾他們的。 "},
  {"id": 59, "src_sha256": "97926d59af0de4351ea82269dfa1ecbf64561f956e93572fa40324e3a6ed28da", "zh": "科學界都知道，兩種腐蝕劑混在一起，大多會爆炸。希望 Dark Savant 和 Rapax 就是這樣。我們就拚命祈禱吧。 "},
  {"id": 60, "src_sha256": "5f4658d0ac4b5745c1a4f55f8ebfe835648d948af9674dcf0bbcdfb4f783c1d1", "zh": "那個 Savant 就跟 Vi 形容的一樣。差點把我嚇得靴子都掉了。我當時都準備跑了。 "},
  {"id": 61, "src_sha256": "d005e4c53edfb6a65083ca1c53315b121f2c5836aa942739da7796b2c601b41f", "zh": "他看起來不是我想惹毛的人。我想他說什麼我們就照做，尤其是那座熔爐的事。 "},
  {"id": 62, "src_sha256": "2dfa644a342bd89d9aa096e7acfd31bd2d133aca70120965c7fa1ec4947c8f58", "zh": "萬一 Dark Savant 剛好不在船上，我們就跟他說那是流星雨，我們真的、真的很遺憾他的船被打中了。 "},
  {"id": 63, "src_sha256": "fcd08f45e6ffb7d1e1262c5cf576d57263445d321fdc6196047079960367bcd3", "zh": "和平與愛。多美好。我開心得都想當和諧的工具了。 "},
  {"id": 64, "src_sha256": "7f5ce47904141a6626dab8604d2b6f94ef6eb8ac300c06469b41867d0f2812b1", "zh": "嗯……假設他們沒有互相殺死對方，我想有麻煩在外面亂跑了。 "},
  {"id": 65, "src_sha256": "ea75bdd2f6797625ecbc01489124347ee87cb358602dbc789d02ead858119c09", "zh": "對。任務完成。 "},
  {"id": 66, "src_sha256": "321d3ae2bdf8a8468644b97c1ef2d3eb63238569f5f7f1b785da0422fd1d2027", "zh": "廉價的仿製品。難怪 Dark Savant 不想要。 "},
  {"id": 67, "src_sha256": "f9fb46bcff991feb7bf19c2787d68295e6303c72c547eedad67dcdda34aa6a6b", "zh": "看這邊。好兇猛。 "},
  {"id": 68, "src_sha256": "b5c79e05da8c96531c6c13ef440830926b41808653f636dbdd9d335c1dc623e3", "zh": "看。它可能會殺了我們。 "},
  {"id": 84, "src_sha256": "34c4143482028b26fb12c8bd637d498afa58f757852810c33e48bbe2082b47a1", "zh": "有進步了。 "},
  {"id": 85, "src_sha256": "20b0e7d5c9c9df487f1b69800a10828ab9362763557616be39108edc42762b18", "zh": "我覺得好多了。 "},
  {"id": 120, "src_sha256": "1e98b70d75f0f20a0c03545e2ffecb0d45794435ca82e910fa0f0e7704f1ab5a", "zh": "好人。我真喜歡他的制服。 "},
  {"id": 125, "src_sha256": "143bc66097dd60fe2d8ca5df9e0c3ca9908887a65191f12d527a11746eb31db9", "zh": "我從沒見過更體面的政治家。 "},
  {"id": 127, "src_sha256": "ecdce49f30dd293adfb3f00b9bdc7000c8edf521ecc19e488aa27f808ad52a49", "zh": "我肯定他是個完全正當的生意人。 "},
  {"id": 129, "src_sha256": "2ce52d1df9e4bc61b784b7feb552e7ddc2668ce940c6cf4c6d792930cbbc2f9a", "zh": "在遙遠的星球上墜機。再也沒有回家的希望。這才叫好玩。 "},
  {"id": 130, "src_sha256": "7cf751d63e40ea8d227781297f4d5f7007184d707250d81a7f7d6388fa30905a", "zh": "你覺得這是幹嘛的？肯定很刺激。 "},
  {"id": 131, "src_sha256": "dc7480e16645e2f6d8349481786c316f7b96584ee8ce133b0a8b6ffc489dda0b", "zh": "我的熱戀結束了。唉，算了。往好處想，我的病也好了。 "},
  {"id": 132, "src_sha256": "eb08957d9e61f64630ee36d931f3301ad4fc6c3b6090f29460d101301235a45b", "zh": "拿到 Helm 了。有附配套的鞋子嗎？ "},
  {"id": 135, "src_sha256": "d180de6ff1b421a7be5731908a6dfeba34b100ab312686627d111c3a619a24e2", "zh": "嘿，又一個 Savant 的{{Android}}。這個看起來壞了。也許他的備用零件快用完了。 "},
  {"id": 138, "src_sha256": "bea2e44829036cb606a28c462ed196a496ccb025207d58288d43bf88f1c3a070", "zh": "岩漿。一秒鐘就能把你燒成灰。 "},
  {"id": 140, "src_sha256": "9e1b6f3f86b69b9dd550689fa9fd0c282f37c760518b69d7d537d1db499578f4", "zh": "這星球正需要這個。全自動 T'Rang 販賣機。 "},
  {"id": 145, "src_sha256": "baf5a34805c94dfcb6e99efa663dca3bf7d37cfb2d52e184415b3b790b3487d2", "zh": "所以我現在成了 Templar Rapax。我童年的夢想全都實現了。 "}
]

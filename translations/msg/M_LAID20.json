[
  {"id": 0, "src_sha256": "a09bcc28352fbe83b0bc0dca666984a54f5e3d960803f98e7d7a8287435ac689", "zh": "誰能使濁水變清？讓水靜止，它自會澄清。 "},
  {"id": 1, "src_sha256": "79bade56afe0d718060aef2504f0c5e2824aedc643d299ca3da152f8e34a6de3", "zh": "經驗是最好的老師。 "},
  {"id": 2, "src_sha256": "51b7593109ede1c43f36d713c7b15cc90d62413452ee8bc1972287a826651698", "zh": "我不會被區區皮肉傷分心。 "},
  {"id": 3, "src_sha256": "57bc38f4caa0a5da434b451caa68ea53d247e26124aad1ed47e71267b049816d", "zh": "……生命之力正在流逝…… "},
  {"id": 4, "src_sha256": "85ab2d2c723a46d1882471c69425c6c0aee2cc75a91236017a1169978cebff16", "zh": "即使是覺悟之人，也總要休息。 "},
  {"id": 5, "src_sha256": "6edc284c04603e503fdebafb25f409c6b1ad75727837b85a2101ccbfd7ed0d5b", "zh": "我感到生命之氣失衡了。 "},
  {"id": 6, "src_sha256": "9ba63af64ac551f655c5db5c285642096c818ce9163837d1c1f3cf3d84ce1aa0", "zh": "我內心的平衡被擾亂了。 "},
  {"id": 7, "src_sha256": "51e3da154e717dfcd4155ef0745be6716b9fa42933e4391b911b06c903ea68b7", "zh": "我的視線被遮蔽了。 "},
  {"id": 8, "src_sha256": "06c20220ecdb48a744d3ce248af171a62fb511880d221fadce55e9c493a4f29f", "zh": "負重者行不遠。 "},
  {"id": 9, "src_sha256": "bf08ca85cfd0ad3b9e229a544bc7705e44cdb14809d6e4a1a8bc349dfbf12690", "zh": "我動彈不得。 "},
  {"id": 10, "src_sha256": "c7f0c8ab29001d1eac15517a8ebe49332a4c6cb0027965789d700499022c05e1", "zh": "我們心意相通。 "},
  {"id": 11, "src_sha256": "8e598767025cf8557cf7afafcd63cabd20aafa98b69ca24f89ae26c5a49bc5a4", "zh": "玉不琢，不成器；人不經磨練，不成材。 "},
  {"id": 12, "src_sha256": "8161e17febfe849d13e5c29652e05d0c7ebb71aff963646519efcd1595eacb69", "zh": "生與死不過是同一枚銅板的兩面。不過，我很高興能回到這一面。 "},
  {"id": 13, "src_sha256": "23d76db4bfd4e797c35630aedc1275dbef7284f55b1ef93f97dbc0bccab1ac0d", "zh": "平衡被打破了。這不該發生。 "},
  {"id": 14, "src_sha256": "ddc31250f2d9b9d3cab60d314e69fc8d17fd1f6e127f150a3cae42d0cf84417d", "zh": "時間比黃金更珍貴，因為再多的黃金也買不回逝去的時間。 "},
  {"id": 15, "src_sha256": "b4d85ed2638cb4fbec31b315df532d170cc027e839898b4414524e57de2dc456", "zh": "打破沉默的人，毀掉了最珍貴的禮物。 "},
  {"id": 16, "src_sha256": "03969bdc280774495ce7f9933af606d566416284e3314e825fd0ed45db736701", "zh": "抱歉。我讓自己分心了。 "},
  {"id": 17, "src_sha256": "a3c01b96ca18c36d34139ade58035dfd8849269ed382f037ab9952e591e76d8c", "zh": "能避開面前敵人的長矛，卻避不開同伴從背後的一擊。 "},
  {"id": 18, "src_sha256": "b8b69c46534b937c4378b9ab98936480e8ced3d3360ad5bbef8699f9de6df7f8", "zh": "死亡不過是最後的旅程。 "},
  {"id": 19, "src_sha256": "fad8b0c4f18850aed19b88d39d725329f7018d5e4ff7bc3e1d94694626fb30b4", "zh": "她已離開這個世界。 "},
  {"id": 20, "src_sha256": "d553bb4a537e0116d64517ea2f7509cfd09e28cfa7d1fb71535c4b70a73a3de2", "zh": "我們的人數越來越少了。 "},
  {"id": 21, "src_sha256": "b44eeafb4cb19eaed7163a11ad966f3e6755f148f201d1ae393f3465fd716d03", "zh": "少數人仍能完成多數人做不到的事。 "},
  {"id": 22, "src_sha256": "ff06ded2e640e7b068b9f1fbe7d4e8871a4b82541285f4971a3fc49e61d91f4b", "zh": "到頭來，人終究得獨自面對死亡。 "},
  {"id": 23, "src_sha256": "f583601c8e6604f5d36228154b84133ef30c662859166c74a798a8a67e9d4663", "zh": "看那裡。 "},
  {"id": 24, "src_sha256": "0a6f79ac677829feac3210b92ece4022b1fbbf279cd82a55639572ee1674e0db", "zh": "我看到東西了。 "},
  {"id": 25, "src_sha256": "eadca4ebd2584474d6bd6d02c004eeddcf0254f83c9725fe7b135e5c64db8159", "zh": "他們留了些蜜蜂，等我們伸手取蜜時叮我們。 "},
  {"id": 26, "src_sha256": "68878ad0e167187a227ff801a54504683a4c7ec8e2a0235aa9c1f8d5839f65c2", "zh": "我感覺到有東西藏著。 "},
  {"id": 27, "src_sha256": "c2ac2a62ae6c26a49bfe12ee09d905821302e5e643bb85582b8e2e04a0619d79", "zh": "危險在此像野草般滋長。 "},
  {"id": 28, "src_sha256": "779dd581204d9db5fe739593499a7d550db2be165f98adcf515da1fd63517239", "zh": "我的身體受了傷，但心依然清明。 "},
  {"id": 29, "src_sha256": "df1369aa584ec789be84ee9572832a673c8f721d2862f9bd8e410da1a8ab974d", "zh": "簡單的任務。 "},
  {"id": 30, "src_sha256": "16f9352a5b5ad1d4d6c653252110de8a20394cfe0e4e8a4faa91f538c4b2a21b", "zh": "值得一戰的對手。 "},
  {"id": 31, "src_sha256": "f92398f99dfe4b7d086bb096445d1c1a0b971d8522d565d10bcd3e33b404b229", "zh": "一場大戰在等著我們。 "},
  {"id": 32, "src_sha256": "030e3e923b870ed20c058ef45eb8336feb0c54e1c0b98e437f1ae9f68cec4a0b", "zh": "接下來我該瞄準誰？ "},
  {"id": 33, "src_sha256": "09b0c21b59f89e57259bfbf653c8238703b53d67c9814e0c535328891b5946aa", "zh": "反對的浪潮正在升高。 "},
  {"id": 34, "src_sha256": "92b0f593068fa04416265d6d7627ba2de75f8ad597f698eff6ab6d97c7d71829", "zh": "今天不行。 "},
  {"id": 35, "src_sha256": "be1aa6df101c124b6524606345cbcebf3ef7679b6e7614e27586d4f4e099bd41", "zh": "我們的意志獲勝了。 "},
  {"id": 36, "src_sha256": "c48dc0cd0877511e05cec21cf3717ec39a56957c04fb79a9feafdc33cdca8462", "zh": "尋求暴力與混亂的人，通常也會找到它。Dark Savant 便是如此。 "},
  {"id": 37, "src_sha256": "c85331d9a1531e2eb9d50650ad83755b613e35b160f3838c0b32b980a7b8d2e8", "zh": "知彼知己，百戰不殆。 "},
  {"id": 38, "src_sha256": "7d27b66c1f562f421f211a96385fc3fff1343011b32ecab2b5fecb8a1b81f4a3", "zh": "那是誰？ "},
  {"id": 39, "src_sha256": "97f4533c4be54f6333fbfc08af99594445c5b8877811927fb006945c5042fd95", "zh": "我沒有飛彈了。 "},
  {"id": 40, "src_sha256": "a20f41d092ff92941d2d4c69204b9ec17ccc63d3bd124c0b8c61de70aa5c1215", "zh": "我們的圓環破了。有一位不見了。 "},
  {"id": 41, "src_sha256": "888989d3cdb9ac9ba1907373b3529de4814928e25156a9ea3457b7c1d54ae4f7", "zh": "Dark Savant 就在這個 Cosmic Circle 的某處。人總會在秩序之中發現衝突暗藏其間。 "},
  {"id": 42, "src_sha256": "64a0d70ca9d334cfed220a2f86f0f54e21ed370f71a0c4f511ec0a040306a44c", "zh": "我們必須明智地運用這份新威力。因為有言道：有求必應，夢想反而可能破滅。 "},
  {"id": 43, "src_sha256": "558fe2cfe4065b435e195db8be6a16d00d67d2501fd0a649865906f7a9fad68a", "zh": "我覺得自己像一隻撲進火焰的飛蛾。 "},
  {"id": 44, "src_sha256": "f0cf340768cc28dcc4e52d11a1fe1458075d1f9a565fda6cf73b1d8a954b2bd8", "zh": "我的靈魂被那女魔頭俘虜了。只要 Al-Sedexus 還活著，我就無法離開這裡。所以看來，不是我們永遠留在此地，就是那女魔頭必須死。 "},
  {"id": 45, "src_sha256": "40e71a0d811ed1ac1a925f92e959b80b460feb1972e925b6da34097ea554ec5b", "zh": "Al-Sedexus 就在附近。衝突無可避免，那就坦然擁抱它吧。 "},
  {"id": 46, "src_sha256": "c6d4ff0cf39bcdad3b952d707bc0c40b2a73b9bd2b88ff4da737a85d7d3103ac", "zh": "Rattkin 竟然擁有這個，真奇怪。不過許多人握有生命之力，卻不配擁有。 "},
  {"id": 47, "src_sha256": "d6bb2f8abfff9eeaa5745aa937ca3ce2e7e07ab50c56338ccd85bfabef0a465d", "zh": "擁有全部的知識固然好，但擁有一點點智慧更好。 "},
  {"id": 48, "src_sha256": "6cae7499802742627d885d93890a36e9dc6447a54d2aab4acc436748db19a9aa", "zh": "這個裝置現在是我們的了。我們在 Mook 阻撓之前離開吧。 "},
  {"id": 49, "src_sha256": "64635caa9b16543fdf8e99e5d6918880d64bc9d3a9c34d3e557664fe3f737428", "zh": "畏懼變化的人，終將被變化毀滅。 "},
  {"id": 50, "src_sha256": "16fc26b0363b8e8fbe4f899f5acae64ed59575e5f60653b21cefa53b62d007bc", "zh": "我們被捲入了一場無法逃避的大衝突。 "},
  {"id": 51, "src_sha256": "039f68f769fa5a7cc721dc499ff23f58069d03871378845573d9b5c99b183af1", "zh": "請稍等。Mook 邀請我與他們同住，我已答應。有時，人必須離開朋友去幫助家人。不過，我很快就會回來。 "},
  {"id": 52, "src_sha256": "d5ef95d3b3d5ac2ebb63bafa717e94c7855740dbea9d4bdfe12d55d803d5aae6", "zh": "我很高興回到朋友身邊。我帶來了消息。Mook 發現了一件非常不尋常的物品。我相信那就是 Chaos Moliri。 "},
  {"id": 53, "src_sha256": "1ad2e5d50eb5814b61e9404ff6616271443d2305c5484031d9ec513b893c2bce", "zh": "不可能。 "},
  {"id": 54, "src_sha256": "a9685f940cb7458fdb5d3b8a11b242b64cc11013122649ce6cc6437da11f4ef9", "zh": "謊言就像臭鼬，隔得老遠就能聞到它來。 "},
  {"id": 55, "src_sha256": "0c67cbf3e4240d9d217848638c77de351c2daa8c5cec4485cfe46814e3ca2ad8", "zh": "相當不凡。 "},
  {"id": 56, "src_sha256": "966436ee14c801d5495857790fb32c0b5f221902cc6203ab9a18f65235239830", "zh": "那一個再也不會困擾我們了。 "},
  {"id": 57, "src_sha256": "1189f909f9fcb57a2c651a56c362c49145b9bc3112aa9425989009e40989b602", "zh": "我看見了 Vitalia。 "},
  {"id": 58, "src_sha256": "f694dba1e59aaddb62e9c925a5a1af60c7247dd7774433b5cba18afcc7802e7b", "zh": "智者知道何時該逃。 "},
  {"id": 59, "src_sha256": "f952b96bdfb82a7670c1baf1552924c6c3ae43a8f159ef17267390197390e274", "zh": "這個聯盟只意味著這個世界會有更多衝突。 "},
  {"id": 60, "src_sha256": "cff3218c4b77b58a2a65ffe082456243d07ed2ed626462a77c8e86d1010024f4", "zh": "無法在心中找到平靜的人，會向周遭的人開戰。這個 Dark Savant 便是如此。 "},
  {"id": 61, "src_sha256": "20555786bef3a4f183e3392e12b1a02584a87b660b0e711dbc27d17dc548c52b", "zh": "一個極強大的存在。然而奇怪的是，他竟對 Cosmic Lords 與他們的鍛造爐如此了解。 "},
  {"id": 62, "src_sha256": "a18d979119342114cca43c87204da96445c8fadd0dee7f545734bb43e40c47c7", "zh": "很好。然而，奪走了馬，並不等於除掉了騎士。Dark Savant 或許仍然活著。 "},
  {"id": 63, "src_sha256": "05884755e02ca8ebc43a65ed98e5007842c92af63b6e22564511acd99acaef08", "zh": "很好。沒有和平，什麼事都無法完成。 "},
  {"id": 64, "src_sha256": "be2101be6b29564ff3da07648886c73382312881ac2cbbc433640f2fde6e152a", "zh": "這些人急著尋找自己的命運。看來，命運先找到了他們。 "},
  {"id": 65, "src_sha256": "fac0686aa48fdb9bbc58b7ff72f0e601ccbd352fa63929b9ca79d643d4243dab", "zh": "我們的任務完成了。 "},
  {"id": 66, "src_sha256": "21264936d69a3137be579b4df8a09f44d89df8c06fd23d208cda269aedd27bf4", "zh": "這一定是贗品。我感覺不到真正的 Astral Dominae 應有的生命之力。 "},
  {"id": 67, "src_sha256": "e0dd9139f4ef8a6865194df5a26a1628e447087f541353f0f2a93ba1727c8836", "zh": "有東西在動。 "},
  {"id": 68, "src_sha256": "3e63c3886712748d321e5bb03170fa03178bba83e94ab652b6e5ebac58e2e3f6", "zh": "我感覺到有動靜。 "},
  {"id": 84, "src_sha256": "d83786ec0703ad33a86d202e17df36401352b8e43bebc876815c713400d224c0", "zh": "那股失衡已經消失了。 "},
  {"id": 85, "src_sha256": "75d4bad89c303b3634004e192b27c2614d1be16582ca3ccae8ece226d62717c7", "zh": "我內心的平衡回來了。 "},
  {"id": 120, "src_sha256": "7d561f51232031bf864922653b33910d097578d3bfaf2085e080efb45ade4fc5", "zh": "我在他身上感受到強大的力氣。但願他的智慧與力氣相當。 "},
  {"id": 125, "src_sha256": "52c2adaabffc394185b44a7a1f59af36f260fb7c43456e24da25aa96cdde3cc6", "zh": "Trynnie 不該被輕視。我在他們身上感受到強大的精神力。 "},
  {"id": 126, "src_sha256": "bba2fe1d1f010f36dfa08b2c59beac129b398c0c332e23ce3a0e2ac0cfd1405f", "zh": "我在他身上只感覺到仇恨。 "},
  {"id": 129, "src_sha256": "e5e45673643e959f8f0130a179f16e4a92624865591601b0495001aad56eee50", "zh": "這次不幸的墜毀實在出乎意料。然而，機會往往伴隨厄運而來。當它降臨時，我們必須做好準備把握住。 "},
  {"id": 130, "src_sha256": "e822aceb24110ade1720ee0f33ce8c4ef9f81ec78e2682b025dca2c68abac42c", "zh": "某種裝置。我想它是有些用處的。 "},
  {"id": 131, "src_sha256": "d5266a8131c476f605f3c0731243f1624df37ab049daa07779c4cc3f159bb89a", "zh": "惡魔已除，我內心的平衡已經恢復。我不再受 Al-Sedexus 的詛咒所苦。 "},
  {"id": 132, "src_sha256": "d6dfe20d070189f186fd5a3d1d7d4c09449fb3575d1b7ddaa922607337d379df", "zh": "我們拿到 Helm 了。但願它賜予智慧，也賜予寧靜。 "},
  {"id": 134, "src_sha256": "4bbcd28a4ef7ab47af5b4e5330ad76e2dec7b13ff95075d5a23f3645dac1cbfc", "zh": "我感覺到 Savant 的存在。這一定就是他的塔。 "},
  {"id": 137, "src_sha256": "c91342a3065b8cbccc9379501ac2685cd9d99bf5175c04e0f980bd5734fefe0e", "zh": "荒野中的一間屋子。 "},
  {"id": 139, "src_sha256": "04c53c26344df5fcddb46d9b07b5e1be2169c4fe61e28e659ef79ba4dae3752c", "zh": "看前方的雕像。它們無疑指向我們的命運。 "},
  {"id": 145, "src_sha256": "c62838fba1f9ae70b7dad5d7d2e83800835b24795c25602d292639e30eb19301", "zh": "誰能預測命運的走向？好人往往必須披上惡人的外衣，才能抵達目標。 "}
]

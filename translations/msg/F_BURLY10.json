[
  {"id": 0, "src_sha256": "0cbcdaf3193e769c622f854b680158131245c6f756692290eb2c5a1a982b9dd2", "zh": "好吧，等我擠完牛奶、閹完公牛，我就加入你們。 "},
  {"id": 1, "src_sha256": "52d8bc0f610cd3a163c2fb8b7d5b31c5c37af80ea39c0b497eaa3a243fbc32ec", "zh": "太好了，我變強壯了。 "},
  {"id": 2, "src_sha256": "c8139dc4dfbe409edd6f6849b3320f4fc0c4122f2af49079942a9677d294b741", "zh": "我好像受了一點傷。 "},
  {"id": 3, "src_sha256": "9f760ce7847e88071abce7db95ebf1762c6a078e43438c5f548f0abcc93179cc", "zh": "我傷得很重。 "},
  {"id": 4, "src_sha256": "523ac538bf151bebc96146f25e3dc9454de13ecc843b527317f95cfbab49db25", "zh": "也許我們可以睡了吧？我好累。 "},
  {"id": 5, "src_sha256": "c9127f0ced3e636378853b755a4e3c9d655552944b9870518bfe9577d7f16bbc", "zh": "我覺得不太對勁。 "},
  {"id": 6, "src_sha256": "15317ab1ab1c4514525e5c40fc46e30f8b97fbf38a4cdc90cb68f36f8ed498c5", "zh": "我想我身體可能有什麼問題。 "},
  {"id": 7, "src_sha256": "0d4b7b5b313a5064bbfdad2db4c4912299c12cf7e48b81f6cc19faf1e38a6765", "zh": "我什麼都看不見！ "},
  {"id": 8, "src_sha256": "dcbba4e89d51a8e2eaad130bde59cd106274afe536e610ad212629c3da4da880", "zh": "這有一點重，你知道的。 "},
  {"id": 9, "src_sha256": "3a652a7d2750e9830f2e8dcbe68ff52f8a8f86c17d777e224823c321e66ad6b3", "zh": "我像冰柱一樣凍住了。 "},
  {"id": 10, "src_sha256": "317884f661da0c1985115054581f078965769b8763a34788162b13d907fa622b", "zh": "我也這麼想。 "},
  {"id": 11, "src_sha256": "2a07eea5eb6dceb3d607788c9fe1033e252f70dd9370e5f29b4961f764fae1c9", "zh": "這差不多跟爸爸叫我打掃豬圈那次一樣糟。 "},
  {"id": 12, "src_sha256": "a39b7b8e2347bf21d6ba6a9b7c8006a8a5ae23af5b22cfccf38f52b2fe4b3d19", "zh": "謝謝你們！我好高興回來了。 "},
  {"id": 13, "src_sha256": "a39781519c77a8efdede861fe13e262002c02ab4d0ae9443d9a737c78867917f", "zh": "太可怕了。也許我們可以做點什麼？ "},
  {"id": 14, "src_sha256": "5df33c7029c9cc85bfee9f88233aa2a524521792ace6dc245adb5ddba81f1550", "zh": "這裡好熱。現在我好想脫掉衣服，跳進涼涼的峽灣游泳。 "},
  {"id": 15, "src_sha256": "b91db9f99a5d4733340eb557047cfb846c27bb7593899fde13b74bc42a4c7bc8", "zh": "有人想摔角嗎？我村子裡的男生都被我打趴了。 "},
  {"id": 16, "src_sha256": "1fc42e128ab01223523ae1197a25d4c2bc56f9c92be40fbf0cf401350b2dc6ab", "zh": "哎呀，我真笨手笨腳！ "},
  {"id": 17, "src_sha256": "68c6177aa8b492e76bda43f12cbf9b397d24090564e5692868107405971a5a67", "zh": "請你注意一下那東西對著哪裡。 "},
  {"id": 18, "src_sha256": "75b60f7694175a1091ffdea2d4bc8c1a276e875d8bedbc1eef901da3262a2e99", "zh": "好難過。他是個好心的小個子。 "},
  {"id": 19, "src_sha256": "e005983947fc5fd861873fc21456d3ca6adf05ebb2c07c674c0f2fc556a1cbc6", "zh": "她不見了！怎麼會這樣？ "},
  {"id": 20, "src_sha256": "88359c03542c87283ace11614ab298da7d284319c976c8a7af39c395d96a8070", "zh": "看來我們的客人沒撐過去。 "},
  {"id": 21, "src_sha256": "5c074c791f147f9c6a8ca4d884e700aefc45614a4508b7787f76e2544de2616d", "zh": "繼續打。他們沒那麼厲害。 "},
  {"id": 22, "src_sha256": "5df92ed9581f4e9726817e4526397c4b5ddc7b23219e7b63edc97c9ebd5e00ec", "zh": "我好希望現在回到農場跟爸爸在一起！ "},
  {"id": 23, "src_sha256": "305783db60de08a631a2d75b135d041382f13ac1ab283d5931a866791fccced7", "zh": "你看那個！ "},
  {"id": 24, "src_sha256": "0a6f79ac677829feac3210b92ece4022b1fbbf279cd82a55639572ee1674e0db", "zh": "我看到了什麼。 "},
  {"id": 25, "src_sha256": "b0a71a309713465705cc35895bfb59f703a59cba3452b60d3752d54121634862", "zh": "我想這可能很危險。 "},
  {"id": 26, "src_sha256": "d9de3d5f3e0d881c26a866c4378172e8ba2096abe3759e67b20b0b4e761a2a23", "zh": "我發現了一個祕密。 "},
  {"id": 27, "src_sha256": "3372333ec2bd6bf7ec70a1d4668529c1fb1315c0261e09a23d77e1719c79ba2b", "zh": "我覺得這裡不對勁。 "},
  {"id": 28, "src_sha256": "17f8c54046e7b4179746653fc31c5049c558a292acf45af48b48c650277f2a12", "zh": "我好痛，請幫幫我！ "},
  {"id": 29, "src_sha256": "3869d7fd5daa65569708c08af4725952811414437bee93367202b82044454dd9", "zh": "贏下這場仗，會像在牛身上找蒼蠅一樣容易。 "},
  {"id": 30, "src_sha256": "56cc51ba87582654965fd75abb88227c0a4d202d8b54481247d8ac40de844744", "zh": "好吧。大家準備好要打了嗎？ "},
  {"id": 31, "src_sha256": "e6a3f51a1ba1ad2ff8d003ccb3a408724d477511034dce4529b2e590b7117901", "zh": "這場仗我想會稍微難一點。 "},
  {"id": 32, "src_sha256": "63081eef695f87e56536fa1e93bc4ce865ef8e1fb98ab33be5b64bc2ffaa9a0c", "zh": "接下來我該跟誰打？ "},
  {"id": 33, "src_sha256": "e99ee0d13d2a73205504767641f7795c4a44c45dcb08b34e121961f6c414c668", "zh": "這些東西到處都是！ "},
  {"id": 34, "src_sha256": "f29d27c9c8f9427a443e4f7390158b478e7f3c8dc786a1cb2354814c5d1cc557", "zh": "你打偏了。差一點就是差很多。 "},
  {"id": 35, "src_sha256": "f95613d0d13bf774af8e1f9b43b676cfeb65bba028fd70bc6de80d43d0dbee47", "zh": "很好。我們贏了。 "},
  {"id": 36, "src_sha256": "d69dd89e34ba480040294d48a34835a8a4072698b1f4a7ab633940652fa090f6", "zh": "我不太了解 Dark Savant。但我知道從來沒人說過他半句好話。我不喜歡這樣做，不過我想他非死不可。 "},
  {"id": 37, "src_sha256": "267d2c0418d79869a3bad5e73d00944ffa9253a24c69d4051305a7e2f2b6cea6", "zh": "沒那麼難啦，你知道的。 "},
  {"id": 38, "src_sha256": "832650885a07b9274928f9611a334f41fbe8361698c80e29bf90dd4a32455f4a", "zh": "我看到有人。 "},
  {"id": 39, "src_sha256": "9125cd4ac265769884e0c0a75f7f3c0a43a0115070ba2445abf50026a3b93685", "zh": "我沒東西可以發射。 "},
  {"id": 40, "src_sha256": "c2a638f36528f0ac67e904031899e05b411a7bb28a10def57225910308144dd9", "zh": "等一下。我想我們少了一個人？ "},
  {"id": 41, "src_sha256": "7e127ea492625879f9ff2e5766fce0fc7c60d7617ce824ee3c08639129cf8c1f", "zh": "等我告訴爸爸我去過 Cosmic Circle！可惜 Dark Savant 比我們先到，把一切都毀了。 "},
  {"id": 42, "src_sha256": "3728cd1d0002a27692aabe3f2b0248cea24b7733ce692f18bf4e9dbd2b3c652d", "zh": "太好了。如果我們要創造新世界，就不該像這個可怕的地方。它應該是片美麗的綠地，像我老家的農場那樣，只是沒那麼臭。 "},
  {"id": 43, "src_sha256": "4e442b4eef6aff7eae3b63ec18f131ed2a35b935447c69d1a780d34e47a63ea5", "zh": "你以為我是傻瓜嗎？這種事你得找個男人。 "},
  {"id": 46, "src_sha256": "e1286af7a5edaf04cd3eeb9f7236ef82518e8e414c48215a4baa3fad89158754", "zh": "哎呀，好奇怪！我握著它的時候感覺得到它在動。就像一顆快要孵化的蛋。 "},
  {"id": 47, "src_sha256": "4e008fac615db81e501f0d92809278c570d4f2b9e1620876c4dffbf40feb1c89", "zh": "我對這個不太懂，不過幽靈給我們的東西，我什麼都不信！ "},
  {"id": 48, "src_sha256": "2bd45fc3dce3462244b81546bbcb1b0e4f5aa7a291506e853034a6d4fc5bede3", "zh": "現在我們拿到了。也許我們該趁 Mook 起疑之前離開？ "},
  {"id": 49, "src_sha256": "2e662eae35384122a8bea66d04cfc45fb5283bebcbfe95c4eb1ebf4f2488a252", "zh": "Mook 鬧得那麼大，我們還是拿到手了。 "},
  {"id": 50, "src_sha256": "61827cbae678f3c049af9a90f3767f59d432787ed8446e44590adffd1a99acf0", "zh": "我不意外。就像我爸爸說的，豬就愛一起在泥巴裡打滾。 "},
  {"id": 51, "src_sha256": "f3d947627ce06a68f209467d0c1bb8510390f62a1e824b35d1d46666e302dca5", "zh": "等一下。那位好心的 Mook 先生請我跟同鄉相處一陣子。這麼親切的邀請我很難拒絕。不過別擔心，我很快就回來。 "},
  {"id": 52, "src_sha256": "818859f52bd805892bcfdd92f0e278d71635a6b68b2789a5e8ebb093472447a9", "zh": "午安。我帶來 Mook 營地的消息。他們找到一件很有意思的東西，藏在他們的營區裡。我想那是我們在找的東西之一！ "},
  {"id": 53, "src_sha256": "63ba685ebba09469e648baaabfc2fc268d622e339f8457ff58f29f712db04aae", "zh": "不，恐怕不行。 "},
  {"id": 54, "src_sha256": "c3c7d23f653d4383bb9ffed98913bacbc3bfc6ab7a70dedb651b7c77509e1bbb", "zh": "你爸媽沒教過你不可以說謊嗎？ "},
  {"id": 55, "src_sha256": "10e28108c0e3a6545cd6e50d41793d6ba6bc7e6dc3f0ac3855e3500310688c8a", "zh": "哎呀，真好！ "},
  {"id": 56, "src_sha256": "78620408c512fb143917d70441e1791de1075bf9d6d6b2b1848c4aff83f80f57", "zh": "打敗敵人就像擠牛奶。全看節奏。 "},
  {"id": 57, "src_sha256": "9fccc8d039f604800c9c193e8736d704305a5874d8cd272c0a3d7cd628406249", "zh": "嗨，Vi！ "},
  {"id": 58, "src_sha256": "3f3872f69f6cbc6c4cf2c65eb5e49e07773da3df0994953215635e2fdb6add62", "zh": "謝天謝地，我們逃出來了。 "},
  {"id": 59, "src_sha256": "30ed9571ac851a5695614da3983185adf7f974db4737b13d0ac2302a8f4270a0", "zh": "Dark Savant 和 Rapax 是盟友？聽到這個我很遺憾。 "},
  {"id": 60, "src_sha256": "71626dc83f90addf30f66d3cb5c5105555da5279408833ea51814abd6e4f6494", "zh": "他好像為了什麼事很興奮。不知道是什麼讓他那麼不開心？ "},
  {"id": 61, "src_sha256": "7da946e4463fd3c38f6d6dad6e7c04b1353699cf34859eb27abb2a586fd84e33", "zh": "好奇怪的生物。他說的那個「Forge」我沒聽懂，不過聽起來很重要。 "},
  {"id": 62, "src_sha256": "15a2e9a734de7e87516fe86e7815f05845b7e41eacbe3527cc6d828c6a5f5e22", "zh": "我們把飛船打下來了，可是萬一 Savant 不在船上呢？我想也許我們還會再遇到 Savant。 "},
  {"id": 63, "src_sha256": "4e47af04857c3076c2679a34184763d00a41c584ff3e55bdb363230d8c7ecb1a", "zh": "爸爸常說，要是你不願意打到底，就別浪費時間，握握手就好。可惜他們花了那麼久才學會。 "},
  {"id": 64, "src_sha256": "31ff0d5760305cf72100a48bcd5803530258290caf3aa63e40a15e2a93122202", "zh": "我想 Umpani 和 T'Rang 終究是去不了 Cosmic Circle 了。 "},
  {"id": 65, "src_sha256": "696fec2e9cddf9753b8c5d3c8e583aa06876a53bf1712a7d486adf079df416fc", "zh": "我們做得很好。大家繼續保持。 "},
  {"id": 66, "src_sha256": "1154ddadc087e80208eb5a0c3741b704c044587566ccd8c2b2cb7bdbfd68510a", "zh": "他為什麼要丟下這個？除非這東西不是看起來那樣？ "},
  {"id": 67, "src_sha256": "3e7b382e9b74dc12106f6f07d6f27061de10765fe5dbb61bf36b5977adb8471d", "zh": "看那個生物。 "},
  {"id": 68, "src_sha256": "36e0d7b0d6fb6d58708d5fc642b5a24e4fc30396463c02af558a6c6f49342c8e", "zh": "我看到某種生物。 "},
  {"id": 84, "src_sha256": "d46a178aa800e49c830528baf11e3af248f444b7cb0da0fc8299165bd44caa17", "zh": "我覺得好一點點了。 "},
  {"id": 85, "src_sha256": "88081e87a5a74e935b991e9f1c95bc7b540f87749fd985848144e80223896d93", "zh": "哎呀，鬆了一口氣。 "},
  {"id": 121, "src_sha256": "ac4668fd0e0c9a9dc975052213cc0533e04d321f91400495d281e327590a5408", "zh": "我不知道該怎麼想。他看起來就像會在我爸爸的戶外茅房裡結網的東西。 "},
  {"id": 125, "src_sha256": "5c57f034a6b5888919752dee3e9949d1dd5cea372339fb7ee9fbaa8c97329f08", "zh": "好有趣的小生物！ "},
  {"id": 128, "src_sha256": "ecd269180cf891d7c6f0981c8a6ae34cd20e97accf0673af58e57506f05b7294", "zh": "他看起來是個很聰明的人。 "},
  {"id": 129, "src_sha256": "7f20c20c2f4bf9509a2cab5da6395ec1e84b01a7f3e7ffcddaf66cafb9f628b1", "zh": "嗯，一路下來滿顛簸的。不過我們到了！那麼，接下來要做什麼？ "},
  {"id": 130, "src_sha256": "daedecc775d6c5851e152e381d6d5d4f2b70d4f3258044403193ed5dff9ffb15", "zh": "不知道這是做什麼用的？ "},
  {"id": 132, "src_sha256": "4fe4a01357a009acb17239abd9b171702b735abe542dd819bf640958469fce0b", "zh": "很好。現在我們有 Helm 了，可以把它送去給 Marten。 "},
  {"id": 136, "src_sha256": "8aa3ff63c3ed5a80f0f1f980c155cbfd676d40322b4b670c3e21ee34a257bede", "zh": "好了。Arnika 不再受 Savant 的炸彈威脅了。狐狸的牙都被拔光了，就吃不到雞了！ "},
  {"id": 137, "src_sha256": "9acec06e04383f8c1596a70898707cecf2dff17cada95a6564baa068b44ef602", "zh": "看，有間房子！誰會住在這種沼澤中央的遠處啊？ "},
  {"id": 141, "src_sha256": "d719f4efba0cee7a1020b979bb8a80c6447b1e24f1a555e4d054cc7b78b6f08e", "zh": "好吧，大家準備好要游泳了嗎？ "},
  {"id": 143, "src_sha256": "0a39ace7c81b54856fa915adc372f37bcc34dd6dad06ff9aed8214f00ec0eb2d", "zh": "真奇怪！看起來他們從另一邊把這面牆封死了！那他們是怎麼逃出去的？除非……他們沒有逃出去。 "}
]

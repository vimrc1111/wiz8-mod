[
  {"id": 0, "src_sha256": "156c5a216b0d2060af6614b42e8cad67eb98b3efaa3b4859622b7a3332bf02a4", "zh": "你在看我？！ "},
  {"id": 1, "src_sha256": "54ca8f5db7e8fc777ba77ee697fbc06afc6e9ba645e03cd862082388e340c66a", "zh": "喔耶。升級啦！ "},
  {"id": 2, "src_sha256": "9d79a2577ea4a1a3459f28d225227df6d0c6a0027974351652a87b1212624f49", "zh": "我現在就需要幫忙！ "},
  {"id": 3, "src_sha256": "b1dab4d3e42d4c1073766c4aff41a3a58918584559b93c0b991fdd13f488a085", "zh": "我快死了，你們這些笨蛋！ "},
  {"id": 4, "src_sha256": "4ec425c6b15dd6349a692323b26f3ad517d5f156f7829c475b9a2f9e4be87841", "zh": "你想把我操到散架嗎？！ "},
  {"id": 5, "src_sha256": "e9dc170740ed86ee88abd11e74ed5db5ecb2036140c30231aa2a768cffb44479", "zh": "我到底是哪裡有毛病啊？！ "},
  {"id": 6, "src_sha256": "b3b1e1c29f94d5e2d24f0098081e8f6fd0d77ced655f1328fb2faf9a0890f21f", "zh": "我病了！ "},
  {"id": 7, "src_sha256": "5bb1e132290d92fe88213bdeef8575c2ab76c23ba2123c6cdf797211eb9088b8", "zh": "我看不見啦！ "},
  {"id": 8, "src_sha256": "ef0af28afea38a879873acd1feac8cf4011fb8a5f2e02e6ac6f198172d88d69e", "zh": "我看起來像馱馬嗎？！ "},
  {"id": 9, "src_sha256": "f98ad1f675bf2eb45d0f2061dc24cd5859e87c082f9b8841dfaa46e45ff21203", "zh": "我動不了！ "},
  {"id": 10, "src_sha256": "f015e386c739f5f3b4a392c716444e333261a543677b787b0df4eb116d25dd8c", "zh": "沒錯！ "},
  {"id": 11, "src_sha256": "17fefe7d4f49d0294001e5506e30c297b2d4ed206a66175b6b028fa84067e466", "zh": "該死，真糟！不過這讓我覺得自己活得超過癮！ "},
  {"id": 12, "src_sha256": "33697b82f7e542a3991f8e24264136237fcc1a3ae5044f2729750992303a1c2a", "zh": "我的天！我還以為這下完蛋了。 "},
  {"id": 13, "src_sha256": "e6189c4f2e11b25e4f22c143bdf70fafed994f6afecd4e9afd2356a265204d3f", "zh": "唯一的解決辦法就是把某人的腿扯下來。我想。 "},
  {"id": 14, "src_sha256": "07fb13eedfda64426dcb9bb29b82e1836f411189e8d06bbd3739900ed7a86e2f", "zh": "好安靜。我最恨安靜了！ "},
  {"id": 15, "src_sha256": "75f4dd2928b23c0c0a0a23e36237956f1db7b8da93375a418dd58222d9c8960e", "zh": "你何不乾脆飛出去算了？！ "},
  {"id": 16, "src_sha256": "f413e9977639a4fda55313ad1dfac8ff0bdc003c407d1c1c7c5bf9f78c694e54", "zh": "對，我搞砸了。你想怎樣？ "},
  {"id": 17, "src_sha256": "b0ab750bcfb8fc27dd06cddb8d2e8bfc7e25d6238b3fa18363b3d38eaedaf111", "zh": "白痴！你到底有什麼毛病？！ "},
  {"id": 18, "src_sha256": "610ca9e27e5fa5580a49fa1ad9ab9f4a5eafd7cc530a511aeffe9b81d30967b2", "zh": "那個死掉的傢伙……他叫什麼名字來著？ "},
  {"id": 19, "src_sha256": "f5a17e921d2815d2c1cb105d71c679bb3cdf635b215c81b02dd62584b0644364", "zh": "我就知道她很弱！這下證實了！ "},
  {"id": 20, "src_sha256": "bf6ee33fe8d1c6a2f4fa23233fa83aaae1cdb7d15498d04657f20cd183b60595", "zh": "該死！死了！這叫我們臉往哪擺，啊？！ "},
  {"id": 21, "src_sha256": "51f4e99d3f5a512ab7c6e64c7e9f75b1fe33843a3a4a5996d83b25fb8d8b720e", "zh": "喔耶，現在我火大了。這會很難看。 "},
  {"id": 22, "src_sha256": "5bcedf4b450728775d89f33db8d37a57971c35b213f88ba246de03354309dcc6", "zh": "一群沒種、愛哭的廢物！全都死光了！ "},
  {"id": 23, "src_sha256": "b6b15f26922bd2729f78de28decf5f71a13eaf7cadf14ee4a4f281061d4a53ad", "zh": "快抓住那個東西！ "},
  {"id": 24, "src_sha256": "0878b4db51f02651029b42f02d4dc8d84fdb74b4c3712e9295d07cc29398775e", "zh": "免費的東西！ "},
  {"id": 25, "src_sha256": "e83a1ca16be88fea94146607f526ccd7f74a765af7659c7c3df75c343c6aa23c", "zh": "天哪！我最恨陷阱了！ "},
  {"id": 26, "src_sha256": "af06b8d0baa6e073c28f1c38a7821168153df33b26c60ee8b7d4f27d513e3d7f", "zh": "哼。看來我發現了誰的小祕密。 "},
  {"id": 27, "src_sha256": "efe8250835c8468ea3dd98e30e00a626a08c24ee1e84f95c8c7aed5b7e18fc02", "zh": "危險。我愛死了！ "},
  {"id": 28, "src_sha256": "d222c9a5ca556cdcb1c0f3ffe026afd20e2c5f4fca65bb1cc398a52b743d1eab", "zh": "我受傷了！ "},
  {"id": 29, "src_sha256": "cceae02fe0e4cfc8f294c0f59d5ac90f8c55904e86ca900245ed6fe26d9d9bb5", "zh": "有人可以打？讓我來宰了他們！ "},
  {"id": 30, "src_sha256": "da809445966f64b699dba9260215e4f808f47efd7b17e71c7e3babdbc5a7954b", "zh": "要打架？好戲開始啦！哈哈哈！ "},
  {"id": 31, "src_sha256": "0497060c26d2907bd4460dcf810a14edf5b9fae48c204cccf31d0c88f9bf7ba7", "zh": "這場會很艱苦。放馬過來！ "},
  {"id": 32, "src_sha256": "6c1399c221d94585db335b0de09fb99e29821d6cc8939f4911060cf83af9e275", "zh": "給我找個受害者來。 "},
  {"id": 33, "src_sha256": "b056e67f313fa322a1eb4947ca668799bff9d0d697c2c3c78cbd90019af9658a", "zh": "這些東西到底是從哪冒出來的？！ "},
  {"id": 34, "src_sha256": "dc8ffa6cee204740850da28c7ea0ecca80252cb5a739b7b154f342b359056d4b", "zh": "差點被打中！差點而已。 "},
  {"id": 35, "src_sha256": "4ef78afa51ffd156aaaed2fd95a6449cdd8432ee6c963d19b1ba718e40566f58", "zh": "這麼快就結束了？該死！ "},
  {"id": 36, "src_sha256": "06367cf5930bf8e9ef11733c72b900e78595a76d11836a0c303c1d1ca9583e63", "zh": "耶！耶！耶！喔天哪，這可是千載難逢的擊殺！嘿！Dark Savant！倒下了！ "},
  {"id": 37, "src_sha256": "fc58766e70a8cf490aaa947a4d64a37412627beeafac4fb40bb67bb7c07f1485", "zh": "這正是我喜歡的！ "},
  {"id": 38, "src_sha256": "fd70cf17251cbc7b41d83adad999da024b46364ee7df3b492fb4e6833f19f77c", "zh": "注意啦！有訪客。 "},
  {"id": 39, "src_sha256": "db9f5047b60de057058ec265b2ccb0755a5342e777cb1ad8f40af3b18736e978", "zh": "馬上給我更多子彈！ "},
  {"id": 40, "src_sha256": "82ab257f409ebfeec94bc224ee9137f216409aab833a3b3129c7d09972c087fb", "zh": "有人不見了！等他們回來，我要殺了他們！ "},
  {"id": 41, "src_sha256": "d8bc034127b626aafeb4eac19a2371bb6cc069ca06944697d79fb51f39710702", "zh": "退後！你們知道 Dark Savant 就在裡面嗎？聽到沒，Savant？ "},
  {"id": 42, "src_sha256": "221db7a8e898fd435f31cfd91f8f4bbd57da1b774d74d013901ec8264143c3b4", "zh": "新宇宙，是吧？讓我來試試。這次我們就跟上次一樣，從一場大大大的爆炸開始…… "},
  {"id": 43, "src_sha256": "bd55c1062c8380b183bb58be5cb35cc0304280a724bd518620102150b3248201", "zh": "你瘋了嗎？我覺得這種情況需要一樣我給不起的東西。 "},
  {"id": 46, "src_sha256": "c581724caa25fdcaaf71f1b826f3b8e120d9aeae7a913359a46cf429c351ab0a", "zh": "搞什麼鬼？花那麼多錢，我還以為會大得多！ "},
  {"id": 47, "src_sha256": "7717effc0679606e00e8d6d5614afd1fda4c54686377e9f31ebb9a83d2400025", "zh": "Marten 為了保密真是做過頭了。那個奸詐的老狐狸！我愛死了。 "},
  {"id": 48, "src_sha256": "c47bc37a0f30a9c6760931081c8ea03dba9bf510573bb105be3a02a485ae5470", "zh": "拿到了！現在趁警鈴蜂鳴器還沒響，趕快閃人！我可不想弄成什麼血洗場面。對啦，嘿嘿，我真討厭那樣。 "},
  {"id": 49, "src_sha256": "622661930e232aa1720f2026b95dbe06d81eeec18d03bc9b520c5ef3983b8ada", "zh": "讓我看看這東西。Chaos？你管這叫 Chaos？我是說，這不過就是一塊廢鐵！好啦它炸掉過一顆星球。現在它也沒嗡嗡響啊。 "},
  {"id": 50, "src_sha256": "db904346996c2266b934bc1375d6aca3f83eccea4475d3bb8b6bc2686942d099", "zh": "這下……真是……爛透了。 "},
  {"id": 51, "src_sha256": "d328b43e3c31022d3ac849bf20052ed491fe9e02eeb58257e00be4e0f0da8b83", "zh": "別問問題。我會回來的。 "},
  {"id": 52, "src_sha256": "3fa118ba86863055853357a45258c1443ab35eec701a9e0c4ead0e5e702191b0", "zh": "好了，我回來了。現在給我聽好！我有事要告訴你們。那個 {{Mook}} 的地方裡，有個很漂亮的東西。我是說真的很漂亮。他們管它叫……啊，Callisto！ "},
  {"id": 53, "src_sha256": "624582af5d298abd29c9710eec69312644623e8f5f71581cd89e96bd2c7654cd", "zh": "你腦袋壞了嗎？！ "},
  {"id": 54, "src_sha256": "f725520cd86934a03bb0c3c0bdd4f8acf3bb369bf60638c82cf581ff4a659bf9", "zh": "這個混蛋應該知道不能對我說謊！ "},
  {"id": 55, "src_sha256": "72f3076ee8984aa43f1e95de2fdc2b05188075e8c4680d5b526248489cc7e033", "zh": "這太爽了！ "},
  {"id": 56, "src_sha256": "ea7723a81d7bad8f65665f00b03176198b138f992a2c7f825e52b8725eb79ccb", "zh": "這才叫做事！ "},
  {"id": 57, "src_sha256": "21ccbf361be18d80f4c5eac147ed94548f3d2584e95639ecfde2b3bb28689e99", "zh": "Vi 在前面。 "},
  {"id": 58, "src_sha256": "9f20bb020ada328d27ee53b2015ab419a3d967a01a58fc4f5afd66c00a608808", "zh": "該死。我們幹嘛停手不打了？ "},
  {"id": 59, "src_sha256": "fd44e7d3676cbf65e795905c3d074d8b95c1dfc13f5b923a07144eb9d2b2c43c", "zh": "Rapax！Dark Savant 跟 Rapax 聯手了？他在想什麼？他到底要幹嘛？！相信我，這會見血的！ "},
  {"id": 60, "src_sha256": "7079d51fd7277739276c0dd7ed88ac0546095fa8fc16994dd685ce919183cc17", "zh": "你要去哪，啊？你自稱什麼黑暗之神，結果看到我就跑？！追上去！我不管 Vi 怎麼說，我閉著眼睛都能殺了他！ "},
  {"id": 61, "src_sha256": "0a4fbdba0d6778fd559f56d25b93bdc8432740e97e36320af00ec34a203e219c", "zh": "筆？我飛了大半個宇宙跑來這裡，就為了聽一條龍跟我講一支破筆？！？ "},
  {"id": 62, "src_sha256": "5d80f68544e25204edacbd62b5460b1fd28dc5cdd6ad51c627ef72bb7df185e8", "zh": "降落通知，這裡是 Savant 航班 401。我們將以碎片狀態抵達。嘿嘿嘿。 "},
  {"id": 63, "src_sha256": "1e304163cad84a318cc19fc8e7de3275966d5e4ad46ae4b58c592ab28778f3a2", "zh": "我們幹嘛搞這種事？我是說，現在他們都成朋友了，我們要幹嘛？我就愛打仗，該死！ "},
  {"id": 64, "src_sha256": "ded0509649989099fd4b9eced088393c8166684107e419a12dc7bc3ed295cbda", "zh": "該死，真臭！你以為他們至少會把屍體埋一埋。我是說，沒有什麼比死掉的 T'Rang 更糟的了。什麼都沒有。欸，他們到底怎麼死的？ "},
  {"id": 65, "src_sha256": "169afaecbb7b3f6214d52f77da87b5a2e7afa89a2a0224a0c32fdeaf1d1e4a0c", "zh": "那個任務搞定了！ "},
  {"id": 66, "src_sha256": "97f991dd9e8c502124ddc9ebf1693497c331b91e29809b9aaae10c8e821dfe15", "zh": "Dark Savant 到底為什麼把這東西丟了？他瘋了嗎？看起來是個好端端的……啊，管它是什麼。 "},
  {"id": 67, "src_sha256": "6686db2f863328afb03d04e62847cbe8cbce07afdb4b16f91c0dc8d1977190a0", "zh": "眼睛看這邊，馬上！ "},
  {"id": 68, "src_sha256": "577b25e6673d8e6bdd2687d46388ffc2a7ddef708e68de5ca7aadc83fc24960e", "zh": "怪物衝過來了！ "},
  {"id": 84, "src_sha256": "0dd25960de192b1cfa0ff8d30948dc68af1923ddd0d1c011937bb8e5946e0fc7", "zh": "這……才……像話！ "},
  {"id": 85, "src_sha256": "6df8623b51dc4de436284cb0bce1038d99c229e43b70f4d46b722a6e3bd24130", "zh": "真是鬆了一口氣！ "},
  {"id": 121, "src_sha256": "fb028c24bdfc87607078dc10b673da2941324fc7d61114f5d0bff7c5c3bf00f2", "zh": "這才是有話直說的人！ "},
  {"id": 123, "src_sha256": "9898070b15d47315fc55ef4398b920cb1b7ae47e682841478ba04cbd9ab93370", "zh": "他真是個口才流利的人，以死人來說啦。 "},
  {"id": 125, "src_sha256": "43bf62f0efe8bdaa854dcdcf25f5de45c652021acd5c9719905bab1836e52b7f", "zh": "我真不敢相信我們浪費時間在跟一隻花栗鼠講話！ "},
  {"id": 126, "src_sha256": "4fddaa4c9f823fe40b141077f3f84c0c81fc2b0174fdc7c5416c8cd076d9652f", "zh": "讓我去單挑他！一對一！ "},
  {"id": 129, "src_sha256": "2acd285644fa44314259542563779f45a6bea1e08164b817c21c808e7e9adc85", "zh": "船難。這不是踹我腦袋一腳嗎？我是說我們該動身了，可是只有一個問題。我們根本不知道自己在哪裡！ "},
  {"id": 130, "src_sha256": "93676943abf291332ff2878e0f3609641b5c19480f817257f2bb3d63f57b4acc", "zh": "這到底是什麼鬼玩意兒？！ "},
  {"id": 132, "src_sha256": "57ab834496723bbb48a05b10cc63a54db5b232d113291611b073a4914ed62c1b", "zh": "費那麼大工夫就為了這頂爛頭盔？我早就夠平靜了！走吧，把這東西拿去給 MARTEN。 "},
  {"id": 133, "src_sha256": "732c32e2172449f0a1d7823553ddb57ed57257defa5b53da8dff19771e8ad90f", "zh": "哼。這地方跟你們那顆又大又肥的腦袋一樣空！當地人都跑哪去了？ "},
  {"id": 135, "src_sha256": "75fc6f9b66aece0679f0db4a9ce726a30782a99d0cb3a0fb2063fc9303ce80e3", "zh": "太好了，又一個{{Android}}。這個看起來壞了。讓我拿它們當靶子練習。 "},
  {"id": 138, "src_sha256": "8df2422cf5156b8e9df70d89f568c4a6efe43fd7d846ac628bbd75a8885a9434", "zh": "小心點。踩到那個岩漿你的屁股會燒成灰！ "},
  {"id": 141, "src_sha256": "2c95491e1349ba23332704c5875ad03daee5977a8b946bcb3d5820a5b116221c", "zh": "喔太好了，要游泳。我最恨游泳了。我可不是跑了一百萬哩路來把自己……弄……得……濕答答的！ "}
]

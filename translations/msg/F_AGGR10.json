[
  {"id": 0, "src_sha256": "483e5953499513e096862c2ab3664067e44c066001002741b30bd1db0b9e941f", "zh": "那就出發吧。我們時間不多。 "},
  {"id": 1, "src_sha256": "bdf7d026eb01a510c29df94ffdd10b729970a3294c1e8e47bfcc34ea1c656b16", "zh": "我變強了。 "},
  {"id": 2, "src_sha256": "1411d578f6fc71d034e74f63c573f50cc6685df875ba1c1d6a5d256f16bbf4bc", "zh": "我有些傷需要處理。 "},
  {"id": 3, "src_sha256": "05d5686adf7b55545f5af74c267cc9d560feb859601b0ea841c59d1a206d88c0", "zh": "我需要醫療，現在。 "},
  {"id": 4, "src_sha256": "eae8b9a28a4981a963ceb13416bce5bc8f8b81b1e756a4ec41bbe2446b9ec743", "zh": "我想我們可以休息一下了。 "},
  {"id": 5, "src_sha256": "4c85730b093850b1892e6d7d0c69dcdbb5268ee98267b3e8c57b699884cdfcb8", "zh": "唔。我覺得很糟。 "},
  {"id": 6, "src_sha256": "74bf6e5dbac1cf9070d667538127b584a59bb3b03f730a5683da8220c5ba96ad", "zh": "我不太對勁。 "},
  {"id": 7, "src_sha256": "e32933eb1358b7b05d0bd5750c9efb8a3d0aaaec48c6660de674c96785ccb4ab", "zh": "有東西弄瞎了我！ "},
  {"id": 8, "src_sha256": "b881e972a87549d81088110393943a3e77f9a9519c6045ca7d0c77e1eb935538", "zh": "我扛不了那麼多。會拖慢我。 "},
  {"id": 9, "src_sha256": "fbf605a8306a4f2f5db08b20f37c695e68bc0f53165e56fed1d15a127890ef28", "zh": "我一根手指都動不了。 "},
  {"id": 10, "src_sha256": "4be68c9f2de3a5735ac97652556b0d651fd072f964ec29fa9118158fc2b65a74", "zh": "沒錯。 "},
  {"id": 11, "src_sha256": "c7fed26303abb3c5cd33d00e540ceb4c717ea911894709b0fe118e6e3af03a49", "zh": "好，結束了。把它拋在腦後，繼續走，行嗎？ "},
  {"id": 12, "src_sha256": "14e0606e9572a3bbe2c4caf69c8dfc7b9bef993b7b0da24575fd7d652aac82b9", "zh": "死掉最糟的一點，就是會拖慢你的腳步。 "},
  {"id": 13, "src_sha256": "02b3e31bdd82ba7fc2c68af5deb9ff01dad2034cd5f4a707ed500ee1924db50d", "zh": "這下不妙。 "},
  {"id": 14, "src_sha256": "46a743ad599a5e6c949ee8ead0085901a0ec78fd5795a21c900d7cdf5fdfd2f2", "zh": "來吧。我們得動起來。 "},
  {"id": 15, "src_sha256": "abb9ac4938ca17b9537f87c5c2e84bed3f288b0ff7d6094327d7e28c966a5938", "zh": "現在不是站著發呆的時候。走吧。 "},
  {"id": 16, "src_sha256": "06f2f39cd8d6b1ced965d79fccaac027a6778614a592eea73a53560f5d678548", "zh": "我的錯。 "},
  {"id": 17, "src_sha256": "321f0af8c67fba439c09f21578722b2093890197c452db0131c022502e647d5b", "zh": "小心點。 "},
  {"id": 18, "src_sha256": "b97f3bf931eaef49c21de0093f2b767e69a73901c5149014b82acb8cc0ec677d", "zh": "該死，真浪費。 "},
  {"id": 19, "src_sha256": "bb02a34a2fa4680416746055eec93bfa3a57ec3794676a65e7b278c0045e8221", "zh": "該死，別在我面前死掉！ "},
  {"id": 20, "src_sha256": "f273f52ae3243945357ecae3d3c63cbc8b0d33acf09790b2eff0dc5ee7219b09", "zh": "大家小心。我不想再看到任何屍體。 "},
  {"id": 21, "src_sha256": "ae1ef4ae355fca88e4d8348ad356c5e18fd16347d576386e97c0d64bfc7f1562", "zh": "來吧，大家。我們辦得到！ "},
  {"id": 22, "src_sha256": "b0c4bc9f4408a7b4392fe0306b40f8dce778b088cf0d27e2e9574d69c49ebb01", "zh": "腦筋動快點，丫頭，現在全靠你了。 "},
  {"id": 23, "src_sha256": "7a3a4146aac143d0ad71cdc73d9d1baa93c5f6c76330de2aa88af8b4a65e0cdc", "zh": "看到東西。 "},
  {"id": 24, "src_sha256": "465da8bcb4ff4eab9bf56a4f2614805ce11e2caa81a381422d6ddb9bbb4548bc", "zh": "看，那邊。 "},
  {"id": 25, "src_sha256": "33c9e68bfba6e1e38ba470147d1bfde0c0e264aa350b2812650940a996932ce0", "zh": "這東西看起來隨時會爆炸。 "},
  {"id": 26, "src_sha256": "78fe2fe089364043d90997a7b282a88aee1cfd583398598e05ef875ddc2a1e29", "zh": "嗯，這裡藏了東西。 "},
  {"id": 27, "src_sha256": "ebe396b49c1b010f328e472dbcdf0b00b6e6229458b73834992428da9906f8dd", "zh": "這可能有危險。大家小心。 "},
  {"id": 28, "src_sha256": "61388e9ff7f3085591882c7f04ad2c6f77bcd49fda9d55d61ecd820f62f820c5", "zh": "受了點傷。 "},
  {"id": 29, "src_sha256": "6e9a9db5ef517cae3a615c64a8187287ff36eaee9a285305c8c1b71d3ef59670", "zh": "這點小衝突沒問題。 "},
  {"id": 30, "src_sha256": "92b4fc695536e39a134296bc8b27829d5aa180ed0a42d63a84c2431f2e4f1ef0", "zh": "開戰了！上！ "},
  {"id": 31, "src_sha256": "75143b269659e98f44fdfbb5efdb7c78f0588217b40310f6dec6cd4350e05214", "zh": "這下不妙。準備迎接一場屠殺。 "},
  {"id": 32, "src_sha256": "f47441349e9c75f776c9c8becbd51d4b7b664d7b02e789b6eedb4cd213c38993", "zh": "需要目標。 "},
  {"id": 33, "src_sha256": "aaaf81c0c0d4c28aa90fd916fdf23eb168e7f09a0bae677fe5a11fcc3f4af989", "zh": "我這邊有狀況！ "},
  {"id": 34, "src_sha256": "9cb044b51db6da37e08acbb5d0f571034dc1481c3c5051daf7d9bb2f9360d4ff", "zh": "呼！好險！ "},
  {"id": 35, "src_sha256": "aac436e45b2cb6613a98d46ed436d7d4a819e9e26a2d66e533be7b22a89511ac", "zh": "我們辦到了！ "},
  {"id": 36, "src_sha256": "220c5207f3a49594f52794e12e042ff0f80606d3a7da586a73dd496ad48dc094", "zh": "你知道嗎，他差一點就成功了——差一點就能照他那扭曲的形象重塑宇宙。可惜他運氣不好，撞上了我們。 "},
  {"id": 37, "src_sha256": "6d92898e9c914badac9ec1e16e658f521646603a98298502aabe57a058131de9", "zh": "就這樣吧。現在繼續走。 "},
  {"id": 38, "src_sha256": "11e57e8d3c2106f8b28bccfa1cd1320bcc14053e063322be4d41c103d89e2087", "zh": "那邊那個是誰？ "},
  {"id": 39, "src_sha256": "85aae192794a8e3c83efc38efb78d6547e7dd69faed87c1c3c905d1931cb04f1", "zh": "我沒彈藥了。 "},
  {"id": 40, "src_sha256": "7337f2e8191e4b628588c20a2b655cecac85f46fe5b8f1565908974d5f6658ed", "zh": "該死，有人不見了！ "},
  {"id": 41, "src_sha256": "a5a9a61548cf08909e49141692c4f5b5b66e5e5d515e596c4b7c224683e00dd6", "zh": "好，我們進來了。不過別放鬆。我敢說 Dark Savant 已經替我們準備好一場「熱烈」的歡迎。 "},
  {"id": 42, "src_sha256": "02b493d7246456e400a96be7f4d62b0e380b7e7d3f6b77b72be0f51e1274b03a", "zh": "來吧，別拖拖拉拉的。開工了。這個新宇宙不會自己創造出來。 "},
  {"id": 43, "src_sha256": "99c7603d6dcece624c144777b660acd3eea0114100881f391c6100822ea5138b", "zh": "別傻了。那種事得找個男人。 "},
  {"id": 46, "src_sha256": "a3c46c702db90ebf4c1e9bf34124529e1b27ffc8ce1070c0b54ebbd738c62b59", "zh": "所以這就握有生命的威力，是吧？嗯，希望它值得我們為它吃的苦頭。 "},
  {"id": 47, "src_sha256": "aaff5d9f6787cfca51685fc8cf41bf5ccb72ce06c7a36dad24472d202fddf65d", "zh": "好，趕快把這東西送到 Ascension Peak，免得它也把我們其中一個逼瘋。 "},
  {"id": 48, "src_sha256": "8092efd39c3ce4ae4ea0f18cfde475c8b7137607995ddbe473fd97d5587d5db4", "zh": "拿到了。現在趕快離開，免得 {{Mook}} 發現剛剛發生了什麼。 "},
  {"id": 49, "src_sha256": "76bb5e5e27f93168f3f381f60097f29653d81c9590ad230852a0d77b415759bd", "zh": "拿到了。現在把這一小塊 Chaos 送到它該去的地方。 "},
  {"id": 50, "src_sha256": "9ba221c82cfd5d44bd107a3c4acc55ad97a97ed6dc1e6af6c740d57ff77454f6", "zh": "這可不是好消息。 "},
  {"id": 51, "src_sha256": "0eb1a1f49fc27db1ede1e899fd9468aeec481afd66a2d5eaed34bfb6107ff6c9", "zh": "等一下。{{Mook}} 請我留下來一陣子，我答應了。我沒辦法拒絕自己人。別擔心，我很快就回來。 "},
  {"id": 52, "src_sha256": "5b6969b29c298071f034fd80b7de9a43386b3fb6275177e321741916c482b398", "zh": "我回來了。有消息。{{Mook}} 在裡面藏了東西，某樣特別的物品。我敢打賭，那是我們要找的三樣之一。 "},
  {"id": 53, "src_sha256": "e49a8b7b4b954986a9d9b53c66454430b924403224d35eea8e4c2bc2498e2da6", "zh": "不可能。 "},
  {"id": 54, "src_sha256": "6793a39ce055545a1f62bb556c44eb764f0c6c0e37360ca5c226113f601cece1", "zh": "真是個騙子。 "},
  {"id": 55, "src_sha256": "2660e933e876569b52e0fd810a04f13522e252938afcbb45d5ed9811a97e9947", "zh": "這個值得留著。 "},
  {"id": 56, "src_sha256": "b450a1052b1b58a9b48e2b2a818cf89a80c15e04de7386b4eef295c655923b7a", "zh": "不賴，真不賴。 "},
  {"id": 57, "src_sha256": "aa5b51314fb960015f4843d9676cdb27b36f06dff5e9826175e9595e893542c7", "zh": "Vi！ "},
  {"id": 58, "src_sha256": "013d6e0429a902977013342cf67075cf50f4a44279de70d6f148db33aa4a8b0f", "zh": "好，戰鬥結束了——暫時。 "},
  {"id": 59, "src_sha256": "a0ef83ebb20b8572254ca75d2f2d2862993be526697113e425f93483556ee371", "zh": "這不妙。有 Savant 撐腰，Rapax 能讓這個世界吃盡苦頭。 "},
  {"id": 60, "src_sha256": "be600a1ae466a48fb51e6d6e1b13f833afbb3f546498e453f90a3b2e13ee85c5", "zh": "剛才真險。他本可以一眨眼把我們全滅了。幸好他分心了。 "},
  {"id": 61, "src_sha256": "350368b14e501fecf14886078e332e297eb8bbca6f7858a24ba8fe66ada8dfdf", "zh": "他真怪。不知道他怎麼會知道那麼多關於 Cosmic Circle 和 Cosmic Forge 的事？ "},
  {"id": 62, "src_sha256": "ba294d228e927bbdba3ada129690586d6d1efa4e9b35ce4ec80f01b95f2d3286", "zh": "好槍法！這重重打擊了 Savant 的兵力。要是我們真走運，他就隨那艘船一起沉了。 "},
  {"id": 63, "src_sha256": "ed018b009444ee360491482f26dab6d40a4c6a39a0662e6a0aa3f065056cff29", "zh": "就是這種時刻，讓一切都值得了。現在繼續走吧。我們還得對付 Savant。 "},
  {"id": 64, "src_sha256": "7f825b7779e810b26dde7e295c8e7acc26bc3f710381e0f31a93d44c348df414", "zh": "這不妙。快走，免得弄成這樣的東西回頭來找我們。 "},
  {"id": 65, "src_sha256": "58a3d801a70d7f60c6bbc52b2cb34d369392f339709b6f03e903e384452952ae", "zh": "幹得好，各位。現在繼續走。 "},
  {"id": 66, "src_sha256": "2c653155d276909c975ad4b5ec59eab4d0449c0cdf642ba1f7438424aa5e0a7b", "zh": "這東西一定是假的。他不會把真貨丟掉。真正的一定在別人手上。 "},
  {"id": 67, "src_sha256": "f95266c063cbca9194906f24b2f75355393117a156fca09dea3fc4b86c2597e3", "zh": "看到有東西在動。 "},
  {"id": 68, "src_sha256": "6812989d124e9ba5d0b72c1ab1c4638cac2157aafab6b37f65d873277d68f38c", "zh": "看到一隻生物。 "},
  {"id": 84, "src_sha256": "d5a4c8742f4f181ded9f21b67c58474c9942e9739cf42caeb2aa75524f88656a", "zh": "開始恢復了…… "},
  {"id": 85, "src_sha256": "07b6c16141c7986f277cc60aecdb627b90c1c978720b6e9e7c365b57d5712ce7", "zh": "鬆了口氣。 "},
  {"id": 120, "src_sha256": "923c136730f5741e4e8e76a1f79fed41e1a18c6940cb29e26e4e80bc6923fb82", "zh": "他看起來很清楚自己在做什麼。來吧，走。 "},
  {"id": 123, "src_sha256": "1d3ac8c2f362631bcadecce6c185436a5b6b7f703ef92428180c1c41bcff2a76", "zh": "對一個死人來說，他話也太多了。好吧，我們走。 "},
  {"id": 124, "src_sha256": "0db9e1c5cbbb70fd2d96f94c31b2d0907a4a1696721978a0ce677bd8bdb6ee57", "zh": "你們聽到那個鐵傢伙說的了。我們有任務要做。 "},
  {"id": 127, "src_sha256": "33223d7d794b0d657c9098a9f8d0c42b6805ccfd5864cfb069553cfcb334bf38", "zh": "我一點都不信任那傢伙。來吧，走。 "},
  {"id": 129, "src_sha256": "00b76dd52644c921447269d430d27a303b0c070333e7cc1be2f1c600168bd1ed", "zh": "好，站著不動沒法幫我們脫困。走吧。也許能找到文明的跡象。 "},
  {"id": 130, "src_sha256": "bf05953fa84b9067bae562f5d2986b57b61aab381654b8670eb9d062faa72cf1", "zh": "奇怪。不知道這東西是做什麼的？ "},
  {"id": 132, "src_sha256": "813663a0a5a69b3e5b97477e568677f673245df0be793b0affe2636807f3c474", "zh": "這一定就是 Helm of Serenity。現在我們可以去追蹤 Marten 和 Destinae Dominus 了。 "},
  {"id": 135, "src_sha256": "59ea1241686630650560e650ea54fec69becb363a7b14e7c2c8d4aaa60882d52", "zh": "咦，是 Savant 的{{Android}}。這個看起來壞掉了。 "},
  {"id": 138, "src_sha256": "2678a025d37ca7ff644bcfd7dc93fe778fcb4c8052448c0583cc4dfe4348793d", "zh": "小心。誰踩進那熔岩就別想再出來。 "},
  {"id": 140, "src_sha256": "81210b9788310f6d4b9c3ea4506493cc6777a3a94f6ebe2255d86cc2a1c2bb13", "zh": "嗯。看起來他們用傳送門運來更多 T'Rang——一大堆 T'Rang。 "},
  {"id": 145, "src_sha256": "5a3515ea224f2a8c99a4426f51eb75592defdb2be1cebe9be38107ea3e2b1137", "zh": "這麼說我們現在是 Templar 了，嗯？我作夢也沒想到。 "}
]

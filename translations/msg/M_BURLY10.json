[
  {"id": 0, "src_sha256": "929feb6578965bb121693835b6f3b17618bcf52d43f03355ac2b8d070d38547e", "zh": "你要我打？我打。 "},
  {"id": 1, "src_sha256": "52ea6bbbd0c9ec7b855328ebd898f853a298c1dc79f5054f5cf827a7abadd09a", "zh": "好。我現在更會砸了！ "},
  {"id": 2, "src_sha256": "f2af3a9b8701f599ba82e9e7bf94d10517041ef359a61fb3e41bd512ad54b3f5", "zh": "看！我流血。 "},
  {"id": 3, "src_sha256": "c70f9a613954211e5c8eeea62981cf0f4528a79736fcb9075797b6aa379bf8c4", "zh": "我傷很重。救命！ "},
  {"id": 4, "src_sha256": "4bf84314659f20d431726dc78a2a1ea8370af80339b23fcd0a7c80aba8fec117", "zh": "我睡。現在。 "},
  {"id": 5, "src_sha256": "d3b71938bc8dfa296d6ce69abe98e9c8bcedf822de2d614bd8ada900b4909eaf", "zh": "我不舒服。 "},
  {"id": 6, "src_sha256": "91b48b8fd827ed1b5879d5b0eaf470492d5a0f8f2f6bf53165959dae0d5ec950", "zh": "我肚子裡怪怪的。 "},
  {"id": 7, "src_sha256": "d2957deaf25d0b19cc5c0e15c96a70485290b8930f4ab2ed0029fe323e823b0b", "zh": "我眼睛黏住了！ "},
  {"id": 8, "src_sha256": "8b7acb2e4f5a6da64baf8e609e8533730853b1777fb011a4186eee29cf921df7", "zh": "這太多了，連我都扛不動。 "},
  {"id": 9, "src_sha256": "0c7f427c65ee11e08de17cc03283dfc7522a2222656c365e60debd1c327590d8", "zh": "我卡住了！ "},
  {"id": 10, "src_sha256": "c9a6551a0c2039bf8d3f3f047d2bf6f792f71c821769cb73c5b6e2aa8c7d25fe", "zh": "嗯哼。 "},
  {"id": 11, "src_sha256": "f1a15336abf2ead0158158cf0865c4d2ecad9000fe0dcc480cc543dd71ba94f1", "zh": "你不要再讓這種事發生在我身上。 "},
  {"id": 12, "src_sha256": "0e61f53a841c16b8f902f10d3dbb4b82d8f7801b13c07c76ba0fa6a5ecf3369a", "zh": "你為什麼帶我回來？那裡好舒服…… "},
  {"id": 13, "src_sha256": "164a7b1ebac430f615192d6d40b444e844add86dc7a08000760757e8b7d362dd", "zh": "這很糟。非常糟。怎麼辦？ "},
  {"id": 14, "src_sha256": "5a84ce5cc29339a6e6b801d6bf7e3bb3618f91c771a09dbc74959b2a7108226c", "zh": "呸。這些石頭難吃。 "},
  {"id": 15, "src_sha256": "3977238c4c201422b4a16e38dfcf1d7bbd66b844b741719cb0412dca39414c70", "zh": "無聊。我們走。 "},
  {"id": 16, "src_sha256": "a6dbb66c9ded0d4c9ad674ff82d954d631e3751d00035c9745a43562979c2a6b", "zh": "我抱歉。 "},
  {"id": 17, "src_sha256": "c34c77ba26c269cfbf924279852ce1cbca1ec32291c38cc60b0688d3ce8b9188", "zh": "哈！這好癢。 "},
  {"id": 18, "src_sha256": "9fddb69475c298f58bfd9c9d127f6041a67871410aae32ff52f3ef37a71c36ff", "zh": "他死了。 "},
  {"id": 19, "src_sha256": "c00da91b866eac0eaba01b0687b729146d50d73c15dd4fd187b1f1662c809450", "zh": "好難過。我想她。 "},
  {"id": 20, "src_sha256": "f8ad236756e45ff94226dec08545ba12dd8e86b9ddecaca9534f2cac5d9d96f5", "zh": "他們不強，不像我。 "},
  {"id": 21, "src_sha256": "e704958fae574f5b0ae40319d7dbd5538c0ef55a2c7949037ef0193ed14b810a", "zh": "很糟！我砸！ "},
  {"id": 22, "src_sha256": "c7ac8ce4774be367aa52eb7a3b7c24b5a6bd021585f0a7e000717fe05d9b0722", "zh": "我砸！我把他們全砸爛！ "},
  {"id": 23, "src_sha256": "60885f8036da562aacd3cc2bab4c5461ff0e96acc43913e87f5cf8807f6755f3", "zh": "看到那東西嗎？ "},
  {"id": 24, "src_sha256": "bd91f2dfccd4cd33b9aeacc54e85fd36a87d5206f515c718c504233e28bee70d", "zh": "看！ "},
  {"id": 25, "src_sha256": "84000d219e662312603033b772ae5c4263a0ef303f9590082a9907901d4f2f10", "zh": "這很難搞懂。 "},
  {"id": 26, "src_sha256": "6270a5779c25595be870755ef19b1a44e836e9acfc0898e5612666285072d7a6", "zh": "這裡有祕密。 "},
  {"id": 27, "src_sha256": "64115b7f20863f1b6ee21870ac63364689f0cf6fd08fb9882e32c33fb924f25e", "zh": "這裡有壞東西。我感覺得到。 "},
  {"id": 28, "src_sha256": "7d3df5fbf47f75c62d4e9905787e2358d1936741f99b1d99b46547200209d720", "zh": "我痛。 "},
  {"id": 29, "src_sha256": "428f59f4548f53f7866974fb9c8efaef39a1ade605f9cb0c950a10f3c3e694b3", "zh": "我們把他們全砸爛！ "},
  {"id": 30, "src_sha256": "ec0ff22c76392d6883e7efe3422469a6eea7a1a3460d33f20d5e6d86e1f6fa51", "zh": "現在是打架的時候！ "},
  {"id": 31, "src_sha256": "f51ac71c98d26ab488c38521dbe9dda78d07db0484d85d39d05b9d74c3da15be", "zh": "這仗很難打，很糟。 "},
  {"id": 32, "src_sha256": "f06a12ca82b841bfa6a999a2f5cee7f428c27a59b4963ac72d4da2ff1108ec89", "zh": "下一個砸誰？ "},
  {"id": 33, "src_sha256": "a825d8d378f1498570999426f5224e0c6ceaa4d8c7fbf674c8e3576d4a5da280", "zh": "人太多，砸不完。 "},
  {"id": 34, "src_sha256": "e80c5114582909930192c90c15cf0be5501e82a0360fdeb09f02b2ccf6eeadb3", "zh": "哈！ "},
  {"id": 35, "src_sha256": "5ce59dfff5238ced9552d453849f6cf583b2fbd510106f103de3c1b16247e3e4", "zh": "我們贏了。好！ "},
  {"id": 36, "src_sha256": "0a7ef238f936c175bbc370dbbf5ca0f69f262ce7e1a99e9d3538b2fbc7a11553", "zh": "他壞。我們殺他。現在我們走。 "},
  {"id": 37, "src_sha256": "11467c54b6495f67857a9b83a6ccef6fca6d17c35c3a5f53563cce2f65e306c2", "zh": "哈！我砸爛它了！ "},
  {"id": 38, "src_sha256": "698ee440c9f0923b0fa5e5a0b453391b79a3cd67f062078dd75004039bdcf31f", "zh": "那是誰？ "},
  {"id": 39, "src_sha256": "017a2d1f7184feafa659f3c00a3ee4b050fe0e43ae06d63daacbb6f7dad9a070", "zh": "不能射。需要彈藥。 "},
  {"id": 40, "src_sha256": "ce0a51c8e02b0f459130136d15b4ac9f10a8196a16e2094dcb1defa0d361dd48", "zh": "有人不見了！他們去哪？ "},
  {"id": 41, "src_sha256": "544e55c6b560a9d617cf4df24e49c293939698be5289a083ac5874c8370a32fc", "zh": "好地方。泡泡頭在這裡嗎？ "},
  {"id": 42, "src_sha256": "fc4d871020a0645b4979a6bbf688020b41f10ebb4dbee6cef1e27741d53571b7", "zh": "啦啦啦啦。這好無聊。什麼時候才又能砸東西？ "},
  {"id": 43, "src_sha256": "a144b4fd0d5bee4cc1bc82394e4e12e92a82aa5f0d1d2d9cd6d0141bf5823d06", "zh": "她人好……雖然是惡魔。 "},
  {"id": 44, "src_sha256": "3589863d7fe0a6a8e064d8876de98eee812738f1af93c72e2902580f37e36eb5", "zh": "停！我、我感覺到東西。是惡魔女人。她用魔咒詛咒我。我要是離開，我就死。我們去找惡魔女人。我們殺她。 "},
  {"id": 45, "src_sha256": "1bb9cafb65a2eb9220fde5910cc29033154242913ed1248f546acb9dd09e67ea", "zh": "惡魔女人現在很近了。我感覺得到。 "},
  {"id": 46, "src_sha256": "17313ce4b98f942507e8d09afc3c9983fc0b31fb4e0ce255f9825d3c73d41cc6", "zh": "這是 Astro 什麼的。有生命之力。 "},
  {"id": 47, "src_sha256": "f3b865929147eecc6c4384f5476a3b942581d944fa98fe4d77f792da231e1fb5", "zh": "這東西讓我變聰明？哈，好好笑！ "},
  {"id": 48, "src_sha256": "f5d6ab79f1470670a6dc682d654817e6251c1a2be80a6d05e44ca8dc5e29ed29", "zh": "我拿走。現在我們走，趁他們還沒發現。 "},
  {"id": 49, "src_sha256": "f00a6c648c736f76e6394f235407b0991a7f90baa74dd5f84afeeeb586dadab0", "zh": "這東西怪怪的。它在抖，還會跳。 "},
  {"id": 50, "src_sha256": "34d3593233b94ba82866aa410d1944382d36a9e7e61614a1002cbaf52cbd8cc4", "zh": "這不好。 "},
  {"id": 51, "src_sha256": "437a49a029a4437b1d75973997a7800f2a7a1b735298cddebc5bcf71739298e5", "zh": "好心的 Mook 請我去找他。我說好。我晚點回來，別擔心。 "},
  {"id": 52, "src_sha256": "6e3720cb878902f03230b06bb7837ffc557bd22879bad73f91c8d46f41509e6f", "zh": "我回來了。我去找 Mook 的時候，他們給我看圓球東西。他們叫它 Callisto 什麼的。我想它是我們在找的東西之一。 "},
  {"id": 53, "src_sha256": "b0866d25916bce8de8b837029cedd1c12f3b58f1b051f1b3c7e9556a17b0e7a2", "zh": "不！ "},
  {"id": 54, "src_sha256": "441c4101f78d42e1ee86ba2e70d22ce65ecaf4c7dbfcd18f0d7f14182345a6c2", "zh": "那是謊話！ "},
  {"id": 55, "src_sha256": "62a31a2aadbf78eca1272787b522d0af1c2f3ee7d4adcd6d190acac985f85ca4", "zh": "啊啊啊，好！ "},
  {"id": 56, "src_sha256": "dcbc879e816fda6fbe48c81b001fbcf3b2613ea3a2292b01cf27bb9e050425c1", "zh": "我把他們砸得很爽。 "},
  {"id": 57, "src_sha256": "aa5b51314fb960015f4843d9676cdb27b36f06dff5e9826175e9595e893542c7", "zh": "Vi！ "},
  {"id": 58, "src_sha256": "89567ab30bc88bcc4f78c271c6831272167d60841631fd3deb2b3ef5845695af", "zh": "我們快跑！ "},
  {"id": 59, "src_sha256": "0607ea552c58146119ee72942438d7fae9ace38ad67c954dd5390d5e258e88ed", "zh": "泡泡頭跟討厭的 Rapax 在一起？這很糟。 "},
  {"id": 60, "src_sha256": "e587efe5363bf26eb7a69726f21c9c09bfaecd50e1312a208b6109848abfc053", "zh": "泡泡頭好像很生氣。他應該冷靜。 "},
  {"id": 61, "src_sha256": "206867fafc742c187850eb5f1c154b8c173ab3a90c34df84efb7b7abdf34bd65", "zh": "Bela 很強！話也很多。我喜歡。 "},
  {"id": 62, "src_sha256": "91cbfcae85a2ea25ef1f2bacd75ea036b851bb3e907f72fc1b49a19101814a64", "zh": "飛船在天上畫出漂亮的線。你覺得我們打它的時候，他在船上嗎？ "},
  {"id": 63, "src_sha256": "de7005c1ab338ebe1b8e5547073e9cf8deb9d1b7c363ab8b82cf8a3da05503aa", "zh": "所以蟲東西不再跟角人打了。我們可以走了嗎？ "},
  {"id": 64, "src_sha256": "0cddd5947412334b3d9406b83f273034ca4f26a5a220d65666a7124a0844b247", "zh": "他們死了。我們走。可能殺他們的東西還在這裡。 "},
  {"id": 65, "src_sha256": "2779c9d08b0275692d832d497cf9d687fb4df109f026dec2c769b3fb063bfb08", "zh": "我們做得好！ "},
  {"id": 66, "src_sha256": "1fdbff5b8fd6eda7444e759c71175875b4942db25af4e0fcc8c46f20e783d2d6", "zh": "他為什麼丟這個？一定不是他要的。可能是假的。 "},
  {"id": 67, "src_sha256": "32fdf232f9dd2f999c53c8beb044598d81a2263e1f8f311a9a8e98b68e97a29e", "zh": "看到怪物。 "},
  {"id": 68, "src_sha256": "41cb50a394f1ecde3c4ce6306952a069bb77b9b7002e81588466e7e630afd6e5", "zh": "有東西在動。 "},
  {"id": 84, "src_sha256": "98d458e490aa3c21d1a088c424b1a1ebbd1cddbdcddec8ca2ae4ebf14de85691", "zh": "好一點點。 "},
  {"id": 85, "src_sha256": "027329aeab368ba677f660fe181918bfcf6bbdf390d513347e35b6332936bb54", "zh": "好多了。 "},
  {"id": 121, "src_sha256": "001451820b22add3685b084fa53c43661b3eefe7d62fb678243693d602b7aa07", "zh": "蟲人講完了，所以我們現在走。 "},
  {"id": 124, "src_sha256": "43422d2850557b150807c3be0307f5707e0610f60983121e3e4aeb0398b8ce80", "zh": "他們怎麼做出發亮的鐵人？ "},
  {"id": 128, "src_sha256": "cefc89c5296ef3191431d9dff669cf1a40b613c27d230f6424316af106ae3a86", "zh": "毛毛人說什麼？我沒注意聽。 "},
  {"id": 129, "src_sha256": "449c392d1d4559b7f4c8b5f2a4ee7a73281d433e5e928a0a7cc6fbf4ce597ea1", "zh": "我們墜毀了。我們還活著。這最重要。 "},
  {"id": 130, "src_sha256": "c934d1bb5814fc3510859b129735e50ad43f25d3f7622d58bea7ba1e939ae765", "zh": "這是幹嘛的？ "},
  {"id": 131, "src_sha256": "baa02f6d6ca83f392021ef81c3e9f595b3cf9e05d8e765579bc9c0579adfb949", "zh": "惡魔女人死了。詛咒沒了。我現在好多了。腦袋裡沒有聲音了。 "},
  {"id": 132, "src_sha256": "de96669c7a435c5a1fa3d1fe96b1206228b244bc5c9c5ea5b8e4832f055a2a73", "zh": "我們拿到 Helm 了。要拿給誰來著？ "},
  {"id": 133, "src_sha256": "b88dd4bf6c7f7f6e5b86e1868a03d94f575942eeb06e5c1f062c39d74bed1ef6", "zh": "這裡沒人。他們都去哪了？ "},
  {"id": 135, "src_sha256": "dcb8c4be239cec353a5cc2d3d2694540d9d7b5e0aa36f650b9cb1e7eb15caf1b", "zh": "看——{{Android}}。但這個壞了，不會動。 "},
  {"id": 137, "src_sha256": "5d8a1cbac03b405ad36d6a7654a9f2d9448af14a70d252d43feca59d2c2c9535", "zh": "看，有房子。可能有人住在這種地方。 "},
  {"id": 138, "src_sha256": "c1352ec28cc45cd2e7cb5f98a5b1f8b0d9e7a81a9a5ab46bd941700c49089ddd", "zh": "岩漿很燙，會把我們全燒死。 "}
]

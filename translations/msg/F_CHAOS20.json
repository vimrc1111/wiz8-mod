[
  {"id": 0, "src_sha256": "13e803b6b0b3a3e37209d9c8a4b74ca1a116035dbd831cc0ddf60003a98e3c44", "zh": "我可以使用許多破壞的工具，對吧？ "},
  {"id": 1, "src_sha256": "7c188adfedd7a2941d368c47b2b319c06f7d45bfd9e380404e69745b7d2022c5", "zh": "我想我進步了。很好。 "},
  {"id": 2, "src_sha256": "5dbbd236de47edbbd0c9c4a71ccde19a5e750ddeb20904413594e0dfddd76dbe", "zh": "到處都是血，我無法行動！ "},
  {"id": 3, "src_sha256": "afeb0c4a2e1185175d83d12e5042b5fb20f059ed22ecf2726b835929e46bca54", "zh": "我……少了身體的部分。 "},
  {"id": 4, "src_sha256": "8547d0d8caabd9821471e504192f01bc91a16e0cb44b5fb71fc62fb8d4f679fa", "zh": "我休息，否則我會……不高興。懂嗎？ "},
  {"id": 5, "src_sha256": "1077c5255c66d6c73a4e0ef4126c4c11966b48bf098343cc337aa480a74e269d", "zh": "我覺得不舒服。 "},
  {"id": 6, "src_sha256": "dde3dd81cd000b9af7d74f8d46eaa0bc7681549d8687687266667f447780da0d", "zh": "我有毛病了。 "},
  {"id": 7, "src_sha256": "7b606e3654fb4ce5fb8ea469569929fff738404e5487f6a12d7449a1d29855ac", "zh": "以前我在黑暗中殺人。 "},
  {"id": 8, "src_sha256": "e1025c46f03f068586c9911a93c2ddf6e04ac589e05c98b8a182fc84cb699b51", "zh": "我是殺手，不是搬運工。 "},
  {"id": 9, "src_sha256": "1170663a0e95bf6ae617c2d008a4722e5591dc14b26427adad3f4f42bd79fc62", "zh": "真可憐。我不能動。 "},
  {"id": 10, "src_sha256": "a8b9ebabe7283bbe817a9522d7cb4a528c0ecdbf54b6f156e8b1ef185451d7ba", "zh": "對。 "},
  {"id": 11, "src_sha256": "face9474b3a1898a5c2efa02e4facffef9aee551c27339783058b54b1879b993", "zh": "不可以生氣……你怎麼可以讓那種事發生在我身上？！ "},
  {"id": 12, "src_sha256": "1b8aff7b47f243ff6d8c8227bca970e5ee9a10d27df267f12ec9865167c022a1", "zh": "死亡，我想，當作旁觀的運動比較好玩。 "},
  {"id": 13, "src_sha256": "c64a38cb189b29549ee16879a898f18cd12aae13e21b738bbaf14fdca2f21107", "zh": "因為這件事，會有麻煩的。 "},
  {"id": 14, "src_sha256": "e9e37d325a796001d674f61ad31b5f7932385ea3dac0ba370874f2020c2b4500", "zh": "這不是我說的刺激。 "},
  {"id": 15, "src_sha256": "5ab790bea5c33d65389caa67b86f9a10bd0541361efc805a0d4d5757955b7e1b", "zh": "比起新鮮空氣，我比較喜歡新鮮的血。 "},
  {"id": 16, "src_sha256": "f281fa63f19d029c7449498eb4a124c732bf73ec7253d1c2b6a29d9b5a9526d0", "zh": "很抱歉。我滑倒了。 "},
  {"id": 17, "src_sha256": "1a2a0a42962a0b751642800ad653f26d6aa9ce64dd135201a0e6298f2389311b", "zh": "再來一次，我就要你的頭！ "},
  {"id": 18, "src_sha256": "8956c8ed2261280fb6df576f8d962eff90233f4abffe56352d8f0c3cdbec50c1", "zh": "很可憐，不過他太弱了。 "},
  {"id": 19, "src_sha256": "e464af459a5d1b1167a83480269423587cddfa6f48ac6dad62f99671ac718cd6", "zh": "她的血，我會報仇！ "},
  {"id": 20, "src_sha256": "ae54f2d0569bf4d0135564e8d3e33dea91ae840de8e64a009bbae25a83e7b22a", "zh": "我們的客人死了。真可惜。那麼，我們要怎麼處理屍體呢？ "},
  {"id": 21, "src_sha256": "91b1697d5e0e33f49afa6c82a41f49e9ec48b44cea87a6277b7162b6c8d08a43", "zh": "我開始把這件事當成私人恩怨了。 "},
  {"id": 22, "src_sha256": "908323b7b843e3805338778115093847214d642c128b102c1fd834d434c97a2e", "zh": "原來結束是這種感覺。多麼振奮。 "},
  {"id": 23, "src_sha256": "a56152ed359cbeb669fdfe8eb43bcbee2469236312376b2e9086a9902aa8c89f", "zh": "看！有東西。 "},
  {"id": 24, "src_sha256": "14fdd19939d00dc865e099ea165033e0a61f3b94215a928b6f89c1d7e291e48b", "zh": "值錢的東西！ "},
  {"id": 25, "src_sha256": "24ffa92d7859536e51afa57b2317f2f110ff17df58f5046aae0ac59c377882bd", "zh": "啊，陷阱！看起來也很致命。 "},
  {"id": 26, "src_sha256": "635bc849a300cb4786240cb6ef744ccb32227a15816928831597ec5f0f7f430a", "zh": "有東西藏在這裡！ "},
  {"id": 27, "src_sha256": "c972c55f783ace1ac6fcf381b2cd268eb5550f7fb8b122a9aa780f1560f6886a", "zh": "這不是個好地方。 "},
  {"id": 28, "src_sha256": "52471a3d3adbe54ab5e3d4de7a68630d3a07c06bcfca906641f7ce199ba199d8", "zh": "我的傷開始讓我變慢了。 "},
  {"id": 29, "src_sha256": "2449304740e23be5fc47094eec086b2351d56f9e4635e0f16457e216ea4688da", "zh": "敵人？很好，他們會死得很快。 "},
  {"id": 30, "src_sha256": "61ead8114aebf33de14013b53a886498507917eff7ef0059517f3db86f2ead82", "zh": "敵人會死，慢慢地死。 "},
  {"id": 31, "src_sha256": "cd767b568b4fd882163d546a98ddc516e44d42220ac8aacfaed057ff38d44e87", "zh": "我們的敵人很強。讓我來處理。 "},
  {"id": 32, "src_sha256": "831ff97762e1973b0bb6d73062f2fb4d10bda3cc2268a04df0d1687aee130252", "zh": "誰想下一個死？ "},
  {"id": 33, "src_sha256": "dfef67214ef576307ba996ad805b2a08a972997c4b7b844831e3cb99cce8b4ee", "zh": "這些東西從四面八方來！ "},
  {"id": 34, "src_sha256": "3bb8ec969d9b0ae1b85babd2a6ca747c934f47a8bc72b5f94c882b2a3810369b", "zh": "差一點就中了！ "},
  {"id": 35, "src_sha256": "2e3e3154132a5b37d7156caba03f1f80b6a16dc6d4b6b935092e85f9163bd2e5", "zh": "他們的血是我們的！ "},
  {"id": 36, "src_sha256": "b42397c0bfd99e42612375a7f7d8c761e7369d1a69e51a336c5ebda0f4cf058b", "zh": "Dark Savant 就這樣完了。啊，我現在要去哪裡找值得一戰的對手？ "},
  {"id": 37, "src_sha256": "4e58c0f4217f68f29f0d8bfab3a72e6f4018621cbac00d368fcc27b09c14a200", "zh": "那一個稍微抵抗了一下。 "},
  {"id": 38, "src_sha256": "6c8a34271f5d6a344a48a94e4b74eea78cb34d8d8f5b00dee217970b2ed73ced", "zh": "有人來了。 "},
  {"id": 39, "src_sha256": "6412a23df493067db738ea88d644969886c3b5a03b29cb256f27b1007774661b", "zh": "我需要彈藥。 "},
  {"id": 40, "src_sha256": "18dd15aad823e8751db2958133948bdb5deaf1b8d0ad092ac9220f834379f7c4", "zh": "誰不見了？有人不見了！ "},
  {"id": 41, "src_sha256": "a4730cca371f372f08dea23f7f6148ef11ad381d4c260d16af62fd0714428625", "zh": "Dark Savant 在裡面等著我們。多麼美味的貓捉老鼠遊戲。 "},
  {"id": 42, "src_sha256": "692b541b41b9dd54cb58cf63e6e5127b3f144c0e686e9d8724852042284dff16", "zh": "給我一把刀，我要刺破手指。我想這個新宇宙的故事，應該用血來寫…… "},
  {"id": 43, "src_sha256": "ae74a06e6a1cd2898719f0276674e889385ae682ef544e2c494df36e7f353389", "zh": "這太荒謬了。這需要一個男人！ "},
  {"id": 46, "src_sha256": "1c1e9e871622a528fbebd32fdeb6dc6561eb4724a832c298e34500266e787315", "zh": "代價很高。可惜 Rattkin 從 Savant 那裡偷走了這個。我本來寧願從他冰冷的死人手指裡把它撬出來。 "},
  {"id": 47, "src_sha256": "2c13302aa572bfd2ca31b3eca44c9d26a4aeb81dfead93500b22e96923b07772", "zh": "這裡的這些人都是為了守護它而死的？真令人敬佩。我們只能希望自己也死得這麼漂亮。 "},
  {"id": 48, "src_sha256": "5d862e615672b5e8e043e668941e483f2091530563a86cc3bee2dd828d87b32b", "zh": "啊，Chaos 的威能！在 {{Mook}} 開始起疑之前，我們離開吧。 "},
  {"id": 49, "src_sha256": "add83aea5201f033d55ca8f33891de76ebc708226642ae188cbf6bad2f8e0fd6", "zh": "Callisto Device！她這麼輕易就落到我手裡！可是我知道這個裝置能做什麼，我們必須小心。 "},
  {"id": 50, "src_sha256": "439ed7cdcc28083f594c86deca30ab83de950274687c6e2ecf605735306df395", "zh": "看來我們的敵人聯手了。 "},
  {"id": 51, "src_sha256": "26c44088891a60b32a99f00bfc95c76e02ed0fc605eb694723bf8cb3835219fc", "zh": "有件事我必須去做。{{Mook}} 是我的兄弟，我要留在這裡陪他們。我過幾天會加入你們。不用擔心。 "},
  {"id": 52, "src_sha256": "7160afaa6396cf04245efd7b3ecbd797e5b52532409435cdd58b0f8fd37510ad", "zh": "我猜對了，我的時間沒有白費。我在那裡發現了一樣東西，他們有個裝置。我相信就是我們在找的那個！ "},
  {"id": 53, "src_sha256": "7f5ef65f39505272a2bc889cfc9b9917b5d9040c4f260728e90f3c1b1435cba7", "zh": "那不可能。 "},
  {"id": 54, "src_sha256": "46a0e8e2f3f7dc8b0186a1063ee28e04e9a1cb92a6929c584948c644653e6816", "zh": "說謊的豬。 "},
  {"id": 55, "src_sha256": "fc4ad1c6dc7396e4faf6a907cec1f03de7dd5888701a4ce7a98477134ad052a9", "zh": "這個，我們一定要留著！ "},
  {"id": 56, "src_sha256": "f3f8e3f70c3ac3250d165366216490d3206c7d93778d2da25a883137f70342bd", "zh": "沒有什麼比血的滋味更令人滿足。 "},
  {"id": 57, "src_sha256": "e5fce8379535ca026d41cc3db203ea85c7a5f5f486df61d674c10eb5f0401aa0", "zh": "Vi 在那裡。 "},
  {"id": 58, "src_sha256": "65c05f869887c8f73c729ceb0961962d7e1266816845f6c463ad978166f618fb", "zh": "真可惜，這麼快就結束了。 "},
  {"id": 59, "src_sha256": "8465a3e3a2c0aa1a85f2326754ccca28734a5e4d9fd67067487ddc5059349851", "zh": "Rapax 不過是粗野的蠻子。Savant 不會跟他們結盟。至少，我希望不會。 "},
  {"id": 60, "src_sha256": "5972609bff38ab561910ad2546336c8af5f5f654056c9f3e2d56de8d09dd0d58", "zh": "所以那就是 Dark Savant。嗯，嗯。這是個最有歷史意義的時刻。他剛剛遇見了他的殺手……就是我。 "},
  {"id": 61, "src_sha256": "1ee2d19eb8e79e75c4d661e5a9bc8647af7c9c65cc07bd84351dc1cea0eee531", "zh": "惡魔說的這支筆，我們絕不能讓它落入他人手中。它能成就許多偉大的工作，但也能帶來許多毀滅。 "},
  {"id": 62, "src_sha256": "f5a31d609605e626988eb22b84281de8a4abc39b9649eda1124521f4ce8fb519", "zh": "完美！Savant，他的船，現在化作百萬碎片飛散！可是，在確定他確實在船上……而且死了之前，我不會休息。 "},
  {"id": 63, "src_sha256": "57347370de900c0aced8f0acabb82f55d2061b4ba03bdc418140f19353868a0f", "zh": "T'Rang 和 Umpani，終於，他們之間達成和平。不過這大概意味著大規模毀滅性的兵器將告終。真可惜。 "},
  {"id": 64, "src_sha256": "efbfcef78ac3ddee076880029a8df4a7173413e6fb7b4003aed03a68538b60b2", "zh": "這是什麼？這些屍體？誰殺了他們？我準備好要保衛這座 Peak！你們聽到沒！而且我知道殺手是誰！ "},
  {"id": 65, "src_sha256": "0d5e5c0acc52e6ff33e6b65e5e417bed2b607c84bb42395469c92b341bd70671", "zh": "完成了。我們去接新任務。 "},
  {"id": 66, "src_sha256": "9f9b37f96f1e63f60cea995455eea9420791610514f788311b3da96aa2291368", "zh": "Dark Savant 丟了這個！看起來像 Astral Dominae，但不是。嘿。是沒價值的廢物！我猜他被騙了……如果他沒有這個裝置了，我們必須查出誰有！ "},
  {"id": 67, "src_sha256": "f3026c08e14fa90e05eea15b415917ec0955ee00d7852ad02a27985d24300c00", "zh": "我發現新的受害者…… "},
  {"id": 68, "src_sha256": "d99780d2d25fe66f5a1e06212b964cea016ca2570c9c78bcb798cae7ab26bdac", "zh": "這裡有野獸！ "},
  {"id": 84, "src_sha256": "444b226a9ca2d996ea61ef83a994c88a7b65aa297600e477a51f99048405ae90", "zh": "現在不太糟了。 "},
  {"id": 85, "src_sha256": "dcfff5a8390e392b511acde5cf02938e51423f4e9f37e8a597cef9291c7f2adc", "zh": "我現在好多了。 "},
  {"id": 120, "src_sha256": "5c46957149a32db5356565c73b8c2df04a648400467f1930203d262253447399", "zh": "一位非常體面的紳士。我只希望他說的是實話。 "},
  {"id": 122, "src_sha256": "03c64c8c40e14c110d04809b8b1d13b5be8226c0d9370b008b3c250fa1f47e07", "zh": "一個和善的傢伙，我想，不過太誠實了，對自己沒好處。 "},
  {"id": 123, "src_sha256": "5ec4c3886afe477d9d1dd1d1ec842b1bae51e9c7eb190d9ce0577e440a92c61c", "zh": "死亡似乎沒有讓他不能說話。 "},
  {"id": 127, "src_sha256": "f674b311f0112a9d0e6caffc5d41889ef11d931527825c11f8260e048c6e0da3", "zh": "啊，一個聰明的小傢伙。不要把背對著這一個。 "},
  {"id": 129, "src_sha256": "151ab895c31d288986919ee1b4512491b5055bed6f111a77b538c58d7d0aa07a", "zh": "看來命運給了我們低級的一擊。也許以後我們有機會還禮。不過現在，我們應該勘查這一帶，弄清楚我們在哪裡。 "},
  {"id": 130, "src_sha256": "2d36dcecdbcfd98108a801105f043dd21bc7abe701d36f9478bf079d31c66cea", "zh": "這個是做什麼用的，我在想？ "},
  {"id": 132, "src_sha256": "2385163e65a28221be8eb1c94b30ebfc9f763777309ed04d538ae544d611e10f", "zh": "所以現在 Helm 是我們的了。無疑我們應該把它帶給那個瘋子 Marten。 "},
  {"id": 133, "src_sha256": "b5f45158088dccd640525e79b4a53748adce022d369bacb113c70d411f679365", "zh": "哈囉？有人在嗎？嗯，看來這地方像墳墓一樣安靜。 "},
  {"id": 136, "src_sha256": "8e5b6ff0f41f9e4d57072971b77af709687a7298f16ccb206c7a948491479b37", "zh": "這一定是 Savant 開店的地方。非常令人印象深刻。 "},
  {"id": 138, "src_sha256": "5c0a07c429af4fa703cc4025e113911947dbf2f8286add78b7e0526b518a5e9d", "zh": "小心不要踩到岩漿。大概會把你的腿整個燒掉。 "}
]

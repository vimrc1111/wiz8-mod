[
  {"id": 0, "src_sha256": "519f46f946f37f2c535dfa40f0aaf68a0e6604fa530dd6150dec982574e227a1", "zh": "這是訊息 0 "},
  {"id": 1, "src_sha256": "9b2cb61801fc8e0c2748bb13f63db5f3500f24a43c4ef73695400855eb8bef2f", "zh": "母艦通訊站 "},
  {"id": 2, "src_sha256": "e36852555bcf5182265d80186d44f7d4a77b7f6656857a069f64c1bf9a8890c9", "zh": "畫中一名男子在城門外手持發光的物體。這個場景讓你想起了什麼，卻怎麼也想不起來。 "},
  {"id": 3, "src_sha256": "8a73999323278e6a86eab794f002dc856e1c13beceb8435b7405df7489483543", "zh": "塗鴉寫著：「我們的秘密安然無恙。MARTEN 永生。」 "},
  {"id": 4, "src_sha256": "0f08dec00895a7c2e5303be0bb0c57d1356409d96e6f5851aba0158fccce9a7d", "zh": "瓦斯標誌開關。待修！ "},
  {"id": 5, "src_sha256": "4ffae181dddbdae6c8578663d40f598d00cb6febee68870ad9581618c282bf13", "zh": "發電站 "},
  {"id": 6, "src_sha256": "33661b532440550a1fcd6f4d0ef699cd7bf865dd345dfe03c9a42496165438f9", "zh": "北區 "},
  {"id": 7, "src_sha256": "8983ba57e6c7cf23561fd06ba1d505ab4a1c808e6fa4f1aa1273e698a5b2fd6d", "zh": "書架上排滿了皮面筆記本。你取下一本翻閱，每一頁都是你完全無法理解的思想與概念。你不禁懷疑這是天才的作品，還是瘋子的？ "},
  {"id": 8, "src_sha256": "030e1da3621ead7aa914c2f25c5cacd4bcfe2db5fadf7a323ede60db0784ea40", "zh": "你從書架上取下一本書開始閱讀。書頁上密密麻麻寫滿了蜘蛛爬般的字跡。你看不太懂，但書的內容似乎是關於宇宙的三種作用力：知識、生命與變化。 "},
  {"id": 9, "src_sha256": "8bb79ef3ebc85dd4111280816fe31835790dbe1632114ad20eb1b33f342d5de9", "zh": "你從書架上隨手拿了一本書來讀。你看不太懂，但注意到一件事：每一頁都提到「知識」這個詞，而且寫得又粗又大。 "},
  {"id": 10, "src_sha256": "761c69a556fa3ec25e1556e5d6d4b23d3ae4d3925bdf1fdfe82a816678ec3e5d", "zh": "這些書似乎都與宗教有關。你發現許多提到「Lords」以及某個叫「Circle」的東西。 "},
  {"id": 11, "src_sha256": "4f72b0b455508d1686de170147ed4abb0e1ce802cc17b6a9d82fd8341cd466dd", "zh": "這個書架上的書你一本也看不懂，裡面全是你從沒見過的奇怪符號和圖表。 "},
  {"id": 12, "src_sha256": "9f42a945eea81a0bbdc43799cd0d34afb29c5b8bf14c393ccccb0a27270d1ffa", "zh": "這些書裡全是沒完沒了的數字表格。可能是帳簿，可能是星圖，也可能是{{Magic}}公式——你毫無頭緒。你的數學向來不怎麼樣。 "},
  {"id": 13, "src_sha256": "e714c1672b341231da2f4fd9839be7c27cc76fa32f27a78bee87b2d8e7c26dff", "zh": "電腦螢幕上滿是化學符號，超出你淺薄的理解。 "},
  {"id": 14, "src_sha256": "94e7b2b361445d3ffe9458e79405a23d63b091c5f60792c9a9371272222b7412", "zh": "MINDBLAST 計畫最終報告：Mindblast 原型棒已經完成，它能將精神能量集中成熱能衝擊。一旦量產，將徹底改變勢力平衡。Umpani 將在我們面前覆滅…… "},
  {"id": 15, "src_sha256": "b696e3fb61649e41ef9206df73a086b1222c5b5163afab154d1b22e68f8bd244", "zh": "標誌上寫著：「誘餌釋放」。 "},
  {"id": 16, "src_sha256": "e029736c8e63ceb1a9a85ccd7d3367af9b4bac8cf9c076dfe8354f57d388025f", "zh": "這扇門紋風不動。門的另一側牢牢閂住了。 "},
  {"id": 17, "src_sha256": "4e06e2d4cb79b489d521c75447a1d1b4b0284b4bca4939f3821678b6e6d3f03a", "zh": "這是訊息 17 "},

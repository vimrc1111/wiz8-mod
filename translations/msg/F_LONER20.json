[
  {"id": 0, "src_sha256": "5ccaf3ba1a2d78220b5a6620b69e40aac22a15fa5cd6ddd9a14fc23dfeddd9b4", "zh": "好吧。不過我跟你說，我心裡有數，別想耍花招！ "},
  {"id": 1, "src_sha256": "5b778c76407c652b7af2a14161b1b41318620fcfce9db24cb4f0f9542b7caaae", "zh": "變強了？哎喲，真不錯呢。 "},
  {"id": 2, "src_sha256": "1d5961cccad843b30478a2ad31640782f31d59177b848e9f215a6cd0d7c92d26", "zh": "哎唷！好痛。 "},
  {"id": 3, "src_sha256": "84c3025fc175b6bec6db0993c77035c148c019e25e6f48a8164ffb1a720561ff", "zh": "痛得要命。 "},
  {"id": 4, "src_sha256": "34ddc5769eb9161c9edcbf1fe47540495c8753bd8a5a17b67b7a827b85660d18", "zh": "好啦，讓我歇一下。 "},
  {"id": 5, "src_sha256": "a7aea3015d9a39ad98bc463f4ba9eb0773a6ae983baa7a1e178fb74271c19194", "zh": "我覺得難受死了。 "},
  {"id": 6, "src_sha256": "5366d907282d5c91b633c61b975ecb707a32ff837e69248c0d36ab7f82e5375f", "zh": "喔，我覺得怪怪的。 "},
  {"id": 7, "src_sha256": "9cfe2b8ec49520ab14652ab8327c82e05890d72b792feb1c187c5b03f87b0be7", "zh": "欸，我看不見了。 "},
  {"id": 8, "src_sha256": "6b0d23f55c94328882d19f53a6c7b01b146079d4716832510ace7bb3bdaa37fe", "zh": "那麼多我拿不動啦！ "},
  {"id": 9, "src_sha256": "708fdba833eb8106881ddc7367ce98e8352a7eae374baa76c51a43c143300ddb", "zh": "我完全動不了！ "},
  {"id": 10, "src_sha256": "62a58711f727cf5c81ad00f6ed68d806bf64d03602bd63cddd89c982278f7e1d", "zh": "沒錯。 "},
  {"id": 11, "src_sha256": "8ae81c761e26ea7d5f6d4a85f52a5729dd7aed0112ae1909566be12c900fd35b", "zh": "糟透了！我就知道不該跟你們這夥人搭夥。 "},
  {"id": 12, "src_sha256": "08544148235b861e1a2366b74e2ead26d0110237fc62aadc2842ba7feb5a5b3e", "zh": "你們救了我？嗯，看來你們還不賴嘛。 "},
  {"id": 13, "src_sha256": "119456d1057ba375f034d4c27fa07fb22ebe9e8ac6ffeb83c1dc46d41b3bc80a", "zh": "太可怕了！就沒辦法補救嗎？ "},
  {"id": 14, "src_sha256": "2f320453068deffab23dd618d698073c22eb5c428aa6ee8f462dc9dea62376f7", "zh": "你們確定知道自己在幹嘛嗎？ "},
  {"id": 15, "src_sha256": "da088383cf3a54968a089b23a07b92e06585b044152966021300956f10dc226d", "zh": "我看你們這夥人也沒那麼糟嘛。 "},
  {"id": 16, "src_sha256": "c93afbc621c570c8d71cd5e1ba841baa6d8fb964b40e803736665132e40ac6ec", "zh": "抱歉！ "},
  {"id": 17, "src_sha256": "8d2ec76c66f3a25d3bc48d19da26e91938ff029240d951ad7bc5d880764df6e0", "zh": "欸，小心點。 "},
  {"id": 18, "src_sha256": "a6573c8ea734941334b4268fe0a33dce83274b49cdbe4716e349ac147f0c30d7", "zh": "真可惜。我才剛習慣他呢。 "},
  {"id": 19, "src_sha256": "ac5d663cedbf0204a2774490f6484da2aaaca4c1459f9f1bb8457a71ce521fbd", "zh": "真可憐。 "},
  {"id": 20, "src_sha256": "d3d25302f9493584699101582c56ad4dd60054ba24fa0617cf88534e9cc46642", "zh": "我說啊，總比是我好。 "},
  {"id": 21, "src_sha256": "9c8a013a3aa07114c5fd29320870a216e72f12e50d21c4a7fdadf6be69d22eed", "zh": "你們其他人可別這時候死給我看！ "},
  {"id": 22, "src_sha256": "ead83fa81a21876a22fb43b7e18c7d5655140c5785c9da730652b3f1a1b8972d", "zh": "我早該料到會這樣。看來只能靠我了。 "},
  {"id": 23, "src_sha256": "bd91a964a7fa87585850842fd46b0daae82794b88cd3c5811b38a2b75f6cfa2e", "zh": "你們看這裡！ "},
  {"id": 24, "src_sha256": "8f4d558e1d3a0b3d15ff44a192f5cea6e9c271e85df02deb137191a4004a1374", "zh": "這是什麼？ "},
  {"id": 25, "src_sha256": "ef6e645f942ef67834b821ee1b568c095ed829dbba183c1180e78a1b97e25a72", "zh": "別催我。這些東西很危險的。 "},
  {"id": 26, "src_sha256": "c60f1ef618dd4dafa9c8d90ac40705a50b941a58c9c319256e2470b37ee8bc1b", "zh": "等等。這裡藏了什麼？ "},
  {"id": 27, "src_sha256": "efb214c5291432f315539bc12eaac8f5d78019a59b102b2e0efe340ddbf18bca", "zh": "我不喜歡這樣。有點不對勁。 "},
  {"id": 28, "src_sha256": "44102980708c882e0706321ee531d83a5aa6501b5ebd52f65110d2d36dc3b4e6", "zh": "喔，我全身都痛。 "},
  {"id": 29, "src_sha256": "8328dbdbc31ba6d2a99d85bc8e3240a6f82a354ea985167073c85755471cb502", "zh": "這場架簡直輕而易舉！ "},
  {"id": 30, "src_sha256": "83e4478c4173f3d38a59eb0b0e87dd5c42f8f79e0a5ee84070a530a549ebb80f", "zh": "來吧，上去收拾他們！ "},
  {"id": 31, "src_sha256": "1b4ac6baaec882650e29e713f846adee93e6eeac63a0e6aaf7c8839c4274f7c0", "zh": "喔，我不喜歡這場仗的樣子。 "},
  {"id": 32, "src_sha256": "96662714fad6c2ac948b5dbb64908767ec393bd179012f12ace61db5f8bf3216", "zh": "那我下一個該瞄準誰？ "},
  {"id": 33, "src_sha256": "42d357036015584e6cabf304b650c613d2faf75c517ae1d3023f10786a7ccdae", "zh": "欸！他們聯手圍我一個！ "},
  {"id": 34, "src_sha256": "b795a14f83dd01fbc779a5f833f3c44357da488f923d8314db7f761abf7c004c", "zh": "哎呀！好險。 "},
  {"id": 35, "src_sha256": "348d2f93571959950c78ba699c5497da7f3afc447b6257bbf641b481efa7654c", "zh": "就是這樣！ "},
  {"id": 36, "src_sha256": "388354e752de451740709766c29bf8ca9d40fed4975c405d15a869bd3ee7f515", "zh": "活該，他就是活該。我這輩子見過上百萬個貪心的混蛋，但那個 Savant 是最糟的。沒了他，世界會好得多。 "},
  {"id": 37, "src_sha256": "1e507af62cf851533a13dbd90d7cf5844b51d71c3a1ad9d7753179e39498d136", "zh": "我一向說，塊頭越大，摔得越重。 "},
  {"id": 38, "src_sha256": "4a26e6f2b93552dbf3fa529e62560860c0faeb16f6df0457d33fac9d441aadfe", "zh": "會是誰呢？ "},
  {"id": 39, "src_sha256": "edac0ac9199e6f488622fe972e0b21362148e54d9f6ec7e7352d63166defe426", "zh": "我得有東西可以射！ "},
  {"id": 40, "src_sha256": "c2135d674c7b198d96a82b035e6e1f3c5feb301db08440f649b96a3f54e28f8c", "zh": "欸，有人不見了！ "},
  {"id": 41, "src_sha256": "70d9f35da58aa966df3283ca641e7d72af7fce975fac20a0dcb4d3e92079ad4e", "zh": "喔，這不是挺氣派的嗎？不過別太自在。Dark Savant 就在裡面等著我們。 "},
  {"id": 42, "src_sha256": "4db0b636524117b01a523f93ce94a0d400280ba7ba327cd88106d9b2e6005866", "zh": "哎呀，我作夢也沒想到！誰想得到我會跟你們這夥人一起站在 Cosmic Circle？別見怪，不過仔細想想還真有點好笑。 "},
  {"id": 43, "src_sha256": "59b62572ae18f64ced59847187bfe93b1b39af56dd3c0733e8787a5d7a5aa0b6", "zh": "你瘋了吧！找個男的去做。 "},
  {"id": 46, "src_sha256": "e4c2fe3f5be0c92e8cfc8b399ae554e447de63111a9a91802a141c000320262e", "zh": "我們拿到了！我從沒想過會這麼容易。那些 Rattkin 一定很機靈，才能從 Dark Savant 手上摸走這個。 "},
  {"id": 47, "src_sha256": "ca5e91dada5860797f3ad9f0ed4a08a099171976c46191663ad94fe41b799e80", "zh": "Destinae Dominus……我只希望它別給我們帶來像給 Marten 那麼多麻煩。 "},
  {"id": 48, "src_sha256": "88b43f192c09a9c51be5794009a09b49eb56faea8e52e6c697f879ea022765f1", "zh": "欸，好聰明的招！現在趁 Mook 發現我們幹的好事之前，帶著這玩意兒閃人吧。 "},
  {"id": 49, "src_sha256": "751947169d7ab61d7128b75246c6c6f4d79b1720c65d44b5bd00e0c9616c6fd1", "zh": "所以這就是大家搶破頭的 Chaos Moliri？嗯，我看現在是我們的了。 "},
  {"id": 50, "src_sha256": "fc6205171e629b2107370f928731325cb6905df9a2708c7cd469b402dbc08402", "zh": "這星球是不是越來越亂了，是不是？ "},
  {"id": 51, "src_sha256": "b679d59393aa8e59fcd0e5f48c7bc937f362e312461ee8ada814522941de9ec5", "zh": "等一下。我有話要說。Mook 邀我在這兒待一陣子，我也答應了。別擔心，我一眨眼就回來。再見啦！ "},
  {"id": 52, "src_sha256": "705308ca6104478212a2e12e577a1cecf9dcef835ae0606e925768ba1057634c", "zh": "好啦，我回來了。還有點消息要告訴你們。Mook 在裡面守著某樣東西，很重要的東西。我看八成是 Chaos Moliri。 "},
  {"id": 53, "src_sha256": "af5996cb3c42872d3d8066afa05889d1e2a95ceb865dd6a59de68640386076af", "zh": "我辦不到。 "},
  {"id": 54, "src_sha256": "658765d18f6dd25981831b7c850eb085a556f766c74aa8de19b462388820605b", "zh": "你不可能真的相信那種鬼話吧。 "},
  {"id": 55, "src_sha256": "7364484674f008272542846430feeeb672b7d4f15873533b4924004d6e01f6e8", "zh": "喔，這個真不錯！ "},
  {"id": 56, "src_sha256": "aa03a8771ac5404b1239045ba56bb0f93555e8529e5de9737e5ada9a2c842ca1", "zh": "幹得漂亮，我自己說的。 "},
  {"id": 57, "src_sha256": "2d625c327036d7e1dedd0d5ab9bee52058ba7483e8732196213a1a570110d9d3", "zh": "哈囉，Vi！ "},
  {"id": 58, "src_sha256": "3fdbce3d8bc59407819e5f979c884b92ec84a4900e47c7bf37af5ccc4f74f554", "zh": "好險啊！ "},
  {"id": 59, "src_sha256": "0c419363d7294d29a15c970f8f82d53ce71aa55318077b01c226a9ad37aaabdb", "zh": "我不喜歡這個消息。Savant 和 Rapax 都瘋得像隻野鳥。他們什麼事都做得出來。 "},
  {"id": 60, "src_sha256": "b901e98019d18eb9824b80e327e3b271e6ec576b7bd608cd08d0697aa3d58b33", "zh": "他是怎麼了？我看他蠻瘋的。不過，瘋的人往往最危險。 "},
  {"id": 61, "src_sha256": "29677fba4f90d3b5ddec710cc5a71ac70c105b567320625791d26305b95e5e37", "zh": "欸，我從沒想過會跟一條龍聊天！他是個怪傢伙。不過，他似乎對那些 Cosmic Lords 和他們那個圍欄知道很多。 "},
  {"id": 62, "src_sha256": "7c209fcd4f54afea54a2a3f70c4d500a3781817e16bbfa8a0c1e1f6d32464f2a", "zh": "至少那艘船不會再惹麻煩了。我只希望我們把它打下來的時候，Dark Savant 就在上面！ "},
  {"id": 63, "src_sha256": "550c1092d613bc98200633d2ffa0dda0f0b5660df1928bc0c6cd34bba43a76e5", "zh": "和平？嗯，我想是不錯。不過我懷疑那夥人撐得久。 "},
  {"id": 64, "src_sha256": "b254e6bed0170c95f4e165785f764dabbcf3ab161c1cd39b7a10d815c3630735", "zh": "真嚇人！看來我們不是第一批上來的。小心點——不管是什麼殺了他們，還在附近！ "},
  {"id": 65, "src_sha256": "73b4be5f9e751d4f7ec4de55fa0c2c1a98360ff46d8890811ea3b6869fb1b1d1", "zh": "幹得好！ "},
  {"id": 66, "src_sha256": "9dcc3a847caa6a141683c7167327095bf5b2690b18239b40b2f5a626d1efd932", "zh": "這是什麼？看起來像那個 Astral Dominae。但 Savant 為什麼會把它丟下？除非……欸，這一定是假的。喔，敢騙過 Dark Savant，臉皮可真厚！ "},
  {"id": 67, "src_sha256": "d104d67eff44267fa33be94406ff598cf28aa617c003523281a0afc77e8f5fb2", "zh": "看！那邊有東西在動！ "},
  {"id": 68, "src_sha256": "e08664d9956eb2b616b8fd61e24ab1c4f9e86a565145463a51d529bd0ac070bc", "zh": "欸，有東西悄悄靠近我們。 "},
  {"id": 84, "src_sha256": "dc84b54b817f1f1b8e20554b71dfadf6bb6e464d2223216f90d6bf6d82d79f25", "zh": "好一點了。 "},
  {"id": 85, "src_sha256": "50f12dcdd1e52cd91cae7ee4b4f472f0a9ed277decd9b4021b1f8de29eb3bdc0", "zh": "欸，好多了。 "},
  {"id": 121, "src_sha256": "05e4874ece1bac1a13c67e9eb551a65e985a09433bdf9cace1e31356458b29ca", "zh": "我看他知道自己在說什麼。不過他長得毛毛的。 "},
  {"id": 123, "src_sha256": "384a1cdd09cd9e9cdf166024983899a90d678d3047e3053de0fa24a8af3a44cf", "zh": "欸，我們真的要聽鬼的建議嗎？ "},
  {"id": 127, "src_sha256": "8f9de58e9104c844633ee3424abbe7fbcdcc16ad9b310b799560a60ee7116e3e", "zh": "別背對那個人。我一丁點都不信他。 "},
  {"id": 129, "src_sha256": "c42f2d67d7b1bb74fb3e4d1985f536087140d0e4e118e129267945bc9c4db092", "zh": "哎呀，我們這下慘了！不過還好，至少人都還齊全。 "},
  {"id": 130, "src_sha256": "781f5c8de480153a74a639b1e6bf5eec92288e0a37c009e01735ca459f4a0068", "zh": "欸，這東西是幹嘛用的？ "},
  {"id": 132, "src_sha256": "84c8a0cdd3c4ad4b4ccdc2f0c450c6335e801ff4ff7e0857524756293507bca4", "zh": "好，我們有這個 Helm 了。然後要拿它怎麼辦？ "},
  {"id": 133, "src_sha256": "b4c82d1538cefe28da483e62cb7a156f47c6cd47eff81d86d55f31c9825b0d8d", "zh": "這地方沒人啦！大家都跑哪去了？ "},
  {"id": 134, "src_sha256": "68d5227d8b3e34c211fa6118196c18724903f2c284edcb6d5395e6eb0829cfdd", "zh": "等等，那一定是 Dark Savant 的塔！天哪，真是個醜地方。 "},
  {"id": 138, "src_sha256": "fc0bc1aae39613309bcae8d51d06df7150e4a53d0f5f2d9a645ecae80e95027d", "zh": "小心岩漿！會把你燒個精光。 "},
  {"id": 140, "src_sha256": "37c0c5dc2918b22944aa06955d13919c7f8d47853022983c0ce2a69a8cd12021", "zh": "你們看！那東西左一個右一個吐出小 T'Rang。欸，你們說他們為什麼要帶這麼多到地面上來？ "}
]

[
  {"id": 0, "src_sha256": "c8d5fe6b9f9a01a864b3834d1c0a2a7ae7973e3f68fef2b8fe4cb14a7522f8bb", "zh": "就我們私下說說？這份工作非我莫屬。怎麼樣？ "},
  {"id": 1, "src_sha256": "9b318d39cc2c370b490d05c783510f95b36f00aeeed7775804b8011837823ed0", "zh": "我比較想拿現金當表揚，不過升個等也行啦。 "},
  {"id": 2, "src_sha256": "2115c195dee367cfe477c5e8de581efd4ae7da3e561b72d0b27aadc69151bbbb", "zh": "我快散架了！喂，快點啊！ "},
  {"id": 3, "src_sha256": "62196957b1cfe99e4cdd8ce86d77c95371cffc7420ed567736c9e74f11c93b8c", "zh": "哎呀看哪！……鬼門關…… "},
  {"id": 4, "src_sha256": "6781600991712e8e0fd9e960c78699a25d6980a2a3be4fc7016341d386e65d14", "zh": "我看大家都該睡一覺了。放心，值錢的東西我來看著。 "},
  {"id": 5, "src_sha256": "3de05ccde4a838b383e26af64e72065f33057ad9645c64ac285654de96c80453", "zh": "最好趕快治好我！ "},
  {"id": 6, "src_sha256": "7d735e6b0800a4f1c31ce421991c4b556d70dca7101ccc799515ed22a1bcf037", "zh": "這會要了我的命！ "},
  {"id": 7, "src_sha256": "873fc467a01f190e410913027f7ad9543b9a06d4be9a1b3636c5ab8a34789dd4", "zh": "等我看得見了，我一定把它打趴！ "},
  {"id": 8, "src_sha256": "6da2c22ab736f7f98c2e50c2d50a007e429ed8b838b022574aff453f0c0d78d1", "zh": "你一定是想把那個給別人吧。 "},
  {"id": 9, "src_sha256": "dd1272da0ecbb05ed4e23a8f3bdace975d06c5752caa7d193e3c4ae0ec7ad0c5", "zh": "喂喂喂！我動不了啦！ "},
  {"id": 10, "src_sha256": "88e9aa78d270ebc52fb53cfb98e6ce6a08570dc1b944459879907a335682d855", "zh": "你信嗎？我剛好*就要*這麼說！ "},
  {"id": 11, "src_sha256": "1066672ac6000845773a7e3364085dc491a82631e9e3dc47a816b99fab3419bd", "zh": "你知道嗎，那是我這輩子最慘痛的一刻。不過我這人不記仇，我喜歡原諒別人。也許你可以幫這過程快一點，呃，你懂的，付筆和解金？ "},
  {"id": 12, "src_sha256": "a7aa5e7d126d3fa669399323bf89b2c9cf35fda21260cd350d9fe352ad74536d", "zh": "這樣好多了。對了，給我 100 金幣，我就告訴你另一邊有什麼。 "},
  {"id": 13, "src_sha256": "d2aad9ee9ef11d6e0b787d374f95169eae9a894d1ac83ea5164517de1f17a359", "zh": "這回我不確定還能不能靠嘴皮子混過去。呃，讓我想一下……不然乾脆你們來解決吧！ "},
  {"id": 14, "src_sha256": "15598a505ac7bb6c41b79e19b4fe98cad13c97f451758362ed17976bb0577d19", "zh": "你欠我的錢帶了沒？你記得吧？那晚在酒館？ "},
  {"id": 15, "src_sha256": "b19e218e5d42d57a44a4b798f5015c8a2f9c9775c6d5b791ff69889230fc5091", "zh": "你知道的，這裡一定有辦法賺錢。 "},
  {"id": 16, "src_sha256": "330664688803cc5e9c641e4d5d163afcb988929b97142f622190ee569739bb4c", "zh": "嘿，人無完人嘛。 "},
  {"id": 17, "src_sha256": "530bd08faef9ae022258c4f38604124de135263acdeafc2262b8f823ad355d30", "zh": "好一場表演！你該賣票的。 "},
  {"id": 18, "src_sha256": "e1ea53905d9c715a0847acadc04de08629ba30d5b28d08206ed8750079c05748", "zh": "真可惜。我、呃，幫他拿東西。 "},
  {"id": 19, "src_sha256": "f21a098aa6a398a226d7f8bc7f8b5a92a997381a298571154edd0580a7a822c4", "zh": "我們讓她死了！ "},
  {"id": 20, "src_sha256": "f8f6e6b51ba5e89a53315a7856af893aece7bfadbd0cb97c23464a630bfd4ec0", "zh": "好。我們就說從來沒見過他們。只要你們點頭配合我，一切都沒事。 "},
  {"id": 21, "src_sha256": "dc07a4e0ec4ff2ea10296b363dcdb523f20d92e17ff8a241155c2e8454222894", "zh": "只是個小挫折而已。 "},
  {"id": 22, "src_sha256": "a436e8e5ddc62fd74e377ec1d534f5db55aee5e41ea935df36436ddb58d2a7b0", "zh": "你知道嗎，我剛想起來我有地方要去……而且是離這裡很、很遠的地方！ "},
  {"id": 23, "src_sha256": "5a45847049841607a1d6f004047bb454152a3dfc739af6b27b9e8b63c115c1aa", "zh": "嘿，看！那一定是我掉的。 "},
  {"id": 24, "src_sha256": "46fa15ce28cb6c03f0b3dcda0ae4e69834f7c0ef57368d95a70b646f5be62f3f", "zh": "又有東西！我來拿。 "},
  {"id": 25, "src_sha256": "b16857891eb063d7326abf6a1e5dbe471dedd1592c05ea0010fb8a0d4b1a3621", "zh": "陷阱我一眼就認得出來。 "},
  {"id": 26, "src_sha256": "fade2beb2859095469fb67ffe67c7bd4757a2e9cbf34c01a5936897db8e47434", "zh": "嘿，有秘密！ "},
  {"id": 27, "src_sha256": "7cf7942066073111b200b7558713bbb0c3ea37ad43a6c045f98b3e7369858984", "zh": "等一下。我覺得我們正被引進什麼圈套。 "},
  {"id": 28, "src_sha256": "fad6ac4db6b29d0b7d7be6047505f2e13f799d4f4c36af8124c7b5c178d1bf18", "zh": "啊，我被打得好慘。 "},
  {"id": 29, "src_sha256": "f8f83f4bbe504094ebc6ff503f1290a03bb7c984a0929b3db9c182bc93e75b71", "zh": "這些傢伙不堪一擊。 "},
  {"id": 30, "src_sha256": "bad82cbf7a5e32ae85db91d10726ef79d692fd01419f2563b35a53ac0e9b8f02", "zh": "把他們打得滿地找牙！ "},
  {"id": 31, "src_sha256": "921c653add33b33b1aadab44feef1604795e4715f091384482a49ba19f094b79", "zh": "啊，你們去打吧。我來守後面…… "},
  {"id": 32, "src_sha256": "1a1b45327968ec33c28e482c065dc590e95ae9247de7864c0165585fe69deee1", "zh": "哪一個活膩了？ "},
  {"id": 33, "src_sha256": "690cf7861563c1e65d8e9c4dd25756c1e5ea085f13b9c66269eb48a5ab351202", "zh": "太誇張了！他們是從哪冒出來的？ "},
  {"id": 34, "src_sha256": "85b00a9c59d5bb6f24be96e824979338651104464d5a442deaf6b007856a7bea", "zh": "差一點，老兄，可惜還差得遠。 "},
  {"id": 35, "src_sha256": "f8ba1558b7c0edc2eb47478021c0e37b390ffb6a089f603ce89af68b0a8bdeac", "zh": "我們的勝利從來不成問題。 "},
  {"id": 36, "src_sha256": "496d0fe169b624eda3f8d23dc250ba337483b9b77c96d7baebc919d7a4722d21", "zh": "騙子騙不了騙子，Savant。小偷也偷不了小偷。不過，*殺手*是可以殺的。尤其是我出手的時候。晚安。 "},
  {"id": 37, "src_sha256": "5ec5be445836aa31bbced934c03f10de498e013f67ba09675b7d06d3b7eb7b91", "zh": "你知道，有人幹下這種大事，朋友通常會湊錢給點獎賞。真的，他們都這樣。 "},
  {"id": 38, "src_sha256": "dd12b21198599ad81ee66e8dbfe8155dc5f3427b2e9203951142785f3dd23587", "zh": "趁他們不注意，我們來搜搜他們的口袋。 "},
  {"id": 39, "src_sha256": "7fe346a92bd26ebc84dddd932bb5baf00e64208c8447c88cafcc1ad77038acd2", "zh": "檢查彈藥！全部交過來！ "},
  {"id": 40, "src_sha256": "1b72cd81f722140923b6d20ed99bad99a6a971befc801be0f33c0dab50c20cc9", "zh": "嘿，他們跑哪去了？有人不見了！檢查你們的東西！確定沒少別的！ "},
  {"id": 41, "src_sha256": "85c7009f51c86328a44379d652e1b7266ae1b3b64f92b9b43a3877d41cd14025", "zh": "等我們進去看過之後，有幾件事我想寫進那本書裡，好嗎？我是說，在你、呃、我們解決 Dark Savant 之後。 "},
  {"id": 42, "src_sha256": "8c7af19f473b263b74708ecb960232cbddd6c7d6d37f8faf8593aa2bd0e660fa", "zh": "喔耶！你好啊，命運！我是你的主人！ "},
  {"id": 43, "src_sha256": "d687203d0810f462a93bdd1752aed754c308d63e3c08c25a905fe30c37e5c60f", "zh": "閉嘴。我不想聽你說半個字，懂嗎？那是為了自由所做的*犧牲*。 "},
  {"id": 44, "src_sha256": "cfb5a572e5aa1b7c193788cb304ee268e7484776af859e1813e08599c7dca8c7", "zh": "呃，各位？我有點麻煩。好像是 Al-Sedexus，你們記得那個 Rapax 女人吧，就是想跟我私下談的那個？嗯，她好像要再見我們一次。有點小事，就是一份要我命的合約，似乎我一離開這裡就失效。懂我意思吧？ "},
  {"id": 45, "src_sha256": "8774681f0bd1bc91263953aa86959a282d249a8805e0e4f61035e840441d31f0", "zh": "好，我們快到她那了！既然是我把我們*捲進*這麻煩的，那*你們*救我出去才公平。我是說，拜託，我的工作已經做完了。 "},
  {"id": 46, "src_sha256": "38e7a77b4e5ba0693fbb74e40521575ddda771c63b4eec5a056e3191778ff585", "zh": "你知道，我一見到 Rattkin 就覺得有好感。就是一種特別的親切感而已。總之，我自願保管這個，當然，只是在把它送到該去的地方之前。 "},
  {"id": 47, "src_sha256": "57e1b590fb998e818ccc5ade9cbdd668ed287ee505e969f01d2392da40ff35a0", "zh": "不管你們怎麼想，我不在乎。如果這寶貝有*全部*的知識，我就要它！後果？哈！我看 Marten 只是不會用而已！ "},
  {"id": 48, "src_sha256": "435a10bcc85732238377e6d784a1f778dfd54d794fb62d21ad5b217dae0d2d57", "zh": "到手了！我說嘛，偷偷來就是划算。好了，趁那些高高毛毛的傢伙還沒發現，我們把這小傢伙搬出去吧。 "},
  {"id": 49, "src_sha256": "521195f0974c359f4baf7758e4dffa0eee748ea173ea853d626bf6d5a11e966b", "zh": "Callisto Device！總算拿到這東西了！我還在想是不是在 Dark Savant 手上咧。 "},
  {"id": 50, "src_sha256": "f2ac22d487029a5189e5780334a733760ab56400c4a07ece4020c2ba62da5747", "zh": "太好了。又一個好消息。 "},
  {"id": 51, "src_sha256": "4a99008f9108369cc261ce1f8110b96b079edf160717756f0c5e63a77f19c6ce", "zh": "呃，各位？有人請我去跟這些 Mook 商量事情，因為我自己就是 Mook……只去一天左右。之後我會回來，我推測這筆交易可能對大家都有好處，說不定還有賺頭。好嗎？ "},
  {"id": 52, "src_sha256": "b4e62b9e2db9af271d62321f6ebe1b04cbe6ff1c82dd576d2639dd5b9df9e757", "zh": "嗯，午安。很高興再見到大家。所以，我覺得當顧問有錢賺，至少對 Mook 是這樣。而且我確定牆裡面那東西有錢賺……他們有我們在找的東西！ "},
  {"id": 53, "src_sha256": "30a6eaa5fa694af05b6beedd4853c6d7f07426f96ea8567422e2eb1201d32525", "zh": "今天不行。明天也不行。 "},
  {"id": 54, "src_sha256": "a7fa789d67d59cadf8e75546e31b6003948252de3c61796135e16c746c97131c", "zh": "我聽得出誰在說謊。 "},
  {"id": 55, "src_sha256": "286f490d393aa2c3c3d1951d8f9b874191c207fd754d31cced55af8838d33e36", "zh": "喔耶！這真是太驚……啊，沒什麼特別的。嗯，大概不值錢。我就、呃，替大家收著好了。 "},
  {"id": 56, "src_sha256": "569ce24efd29abf4f33461807c60362108a03c20f13be0ec603a8e1608146434", "zh": "我從不吹牛，但我真他媽的厲害！ "},
  {"id": 57, "src_sha256": "af1f70dfc13246d4215918167e53b661a5db02e7f6a3c9048d5702cf3a3dc73b", "zh": "啊，是 Vi。我就是愛這女人。 "},
  {"id": 58, "src_sha256": "5313f072bc00d9cba819c89e4e4b58b0156a1895ad78d9b6bcd57bf05c9fc61d", "zh": "我們及時逃出來了。 "},
  {"id": 59, "src_sha256": "03bc5f71e6c4bfe409aeb9937c479c7c65cf8b5106753fd287096ef6109b422a", "zh": "聽著，我們這樣辦。我們穿上 Rapax 的服裝，躲進山洞裡。這樣應該很安全，對吧？ "},
  {"id": 60, "src_sha256": "75f5d953ff0bcfe770d62347fc3a53185e84b563bc190969b81e3cdf2f4427aa", "zh": "我說我們快點往反方向退。如果那是 Dark Savant，我可不想靠近他。 "},
  {"id": 61, "src_sha256": "b823d52e06e8bd21aff11516038d7a33c7a252688e362bcc07e60d61cc18e93b", "zh": "這個人我們得拉攏。如果他知道怎麼找到那座 Cosmic Forge，我就是他最好的朋友。 "},
  {"id": 62, "src_sha256": "a03658db5730ba3506c5753ba120c535a734576f18741b81471bea7e30485a0e", "zh": "完美的一發！而且萬一 Dark Savant 不在船上，我連不在場證明都想好了！重點是這樣：我們就說我們的船也被炸了。他怎麼會知道？ "},
  {"id": 63, "src_sha256": "ccff468306dcbabf160354a19e5e57d2ccf802758fe9f6157079a0c038e7dc9b", "zh": "現在戰爭結束了，你們不覺得他們該，你知道，分我們一些大火力嗎？我是說，他們現在又不是真的需要。 "},
  {"id": 64, "src_sha256": "5f887890bb7c30d73633cddcb0ca84758391afc03ea51b366897bd310c95b04b", "zh": "不是好兆頭！我說我們別裝作吃驚，這樣萬一兇手還在附近，他可能會覺得我們沒在圖謀什麼。 "},
  {"id": 65, "src_sha256": "00ec95d4dc97d2767cd35905ecdd5f1992b650dcbffb5b9392c889a5fa03b59b", "zh": "工作完成了。什麼？沒有錢？ "},
  {"id": 66, "src_sha256": "6bcd44eaa24592946e390d73f312a081d200a68a6a33b70952e2c35c7b90c3ca", "zh": "看看這垃圾！難怪 Dark Savant 不要。我是說，連我都看得出這是仿製品……而且還是做得很爛的那種！ "},
  {"id": 67, "src_sha256": "4f0ba62105a0ce027ed29560c7d01fe01d5a8d37a7f8090532b363588ead3c54", "zh": "來了一隻活的！ "},
  {"id": 68, "src_sha256": "ef3308103400966dbf18ef16b254ff9d95f86dbf99ccba3f116ba1b29e6ca029", "zh": "有東西來了！ "},
  {"id": 84, "src_sha256": "bd62a4c3dcecb564588f87a65da322f11d263fa27b7ede3f579693657580ce6e", "zh": "這才像話。 "},
  {"id": 85, "src_sha256": "061576a12fd4b5f881a619ab5ce11c12d640122faab8c5c4c1ad81eb0088599f", "zh": "啊，鬆了口氣！ "},
  {"id": 120, "src_sha256": "357d2f5867ef53028bd630a7b60bb94467f1dda377322260cd38c1d355686583", "zh": "他本來也是個不錯的傢伙，要是他別像背後插了根棍子……呃，那樣僵硬的話。 "},
  {"id": 127, "src_sha256": "fcb2d6cc6d1e96b4c52d2630bbb3df4677c73e1d185a744d5371eaa58b724588", "zh": "這傢伙滑頭、狡猾，不能信任。我最清楚了！ "},
  {"id": 128, "src_sha256": "881fb57c92a7046df2403168f1285a975a0a2455355936c0ded3b1411eeb25a6", "zh": "他看起來是個老實、容易信人的傢伙。我最喜歡這種人了！ "},
  {"id": 129, "src_sha256": "a4032ec0bfaed90743b9fd01ae007a7c19e4b2058524b1cf115be2e9ca88f60d", "zh": "所以我們被困在這裡了。那只是一種看法。我比較喜歡想成是整個新星球等著我們來採收！ "},
  {"id": 130, "src_sha256": "944afb781ec8472b92309a6cbf4dc2bf997b975c42da81c188276bf1353ce224", "zh": "看這玩意兒。不知道它是幹嘛的？ "},
  {"id": 131, "src_sha256": "8d5ef3eafd26034e520ec5b5fc495bf49db2bbea7d20ab4612c12608b0b1af44", "zh": "真是鬆了口氣！我終於甩掉那個母夜叉了。她擺了我一道。沒人這樣對我還能活著的。 "},
  {"id": 132, "src_sha256": "f71835bb81e2f1b87f16344744904e71ffc038717b902158da60184fc7ab6078", "zh": "所以我們拿到 Helm 了。下一件差事是什麼？ "},
  {"id": 134, "src_sha256": "7e60abdca78dbd8cefd89363e8f51c327db9c50f9d888fa80db52e4d93585863", "zh": "那座大塔一定是 Dark Savant 的藏身處。 "},
  {"id": 139, "src_sha256": "d481404110eb4e0ca731c723c808ffcfa90371f283a2207c6f5e88cb1fbc6bd3", "zh": "嘿，看那些雕像！每一座都朝著不同方向。好像在指著什麼東西。 "},
  {"id": 144, "src_sha256": "0ba67c40a97a73ba0064f70d96b7c0f349af3b36297ba77a41a34c573bf3cf1c", "zh": "這裡應該是 Rattkin 的巢穴。哼，既然他們能搬進 Trynnie 的地盤，我們也能搬進他們的！ "}
]

  {"id": 0, "src_sha256": "519f46f946f37f2c535dfa40f0aaf68a0e6604fa530dd6150dec982574e227a1", "zh": "這是訊息 0 "},
  {"id": 1, "src_sha256": "fdb5cfba4918dbceb9cdcfb0cd1328d1c64191e14d99a77a3317aeaa6b4fc613", "zh": "衛兵營房 "},
  {"id": 2, "src_sha256": "0b201c99876dab8e6e024998ee7163c91895317df17b84871b517011c7004cb1", "zh": "一排排瓶子擺滿了架子。瓶子全是空的，只剩下一些深色黏稠物質的痕跡。 "},
  {"id": 3, "src_sha256": "9be14c7f6b0ac325890ad0831e5cc7e8b878317318bbd9029ac2d3cd0083704c", "zh": "「Al-Sedexus 歡迎所有加入 Templars 的人，不論高貴或平凡，同族或外人。然而，通不過她考驗的人，她會徹底毀滅。Al-Sedexus 將她的 Templars 留在身邊，聽從她的差遣，滿足她的心願，並守護 Rapax 王國……」 "},
  {"id": 4, "src_sha256": "2f36c0e62a3bde296543b2c23d71cbf37bdb84122b31e5ec1b7300ddb07afdcf", "zh": "僕役宿舍 "},
  {"id": 5, "src_sha256": "5820891ec14349a93d70d39fb318c4fbbb5ac5ba32a0fb81b313402efad7b859", "zh": "國王寶庫 "},
  {"id": 6, "src_sha256": "2fa313d4fd0c4048cbaaea074528a0b385f71ae66c3c0923644d130799fbe3eb", "zh": "南牆有點不對勁，似乎閃爍著奇異的微光。 "},
  {"id": 7, "src_sha256": "a0573425cad2570581f9b1b64092427ea82b02bf477158b4971f5e9a26b6c27d", "zh": "你注意到東牆上有一個小小的鑰匙孔。 "},
  {"id": 8, "src_sha256": "5a1c4870af4a4048c51839777191e2eef218756d9a52968514159ec4052b63bd", "zh": "王子的遊戲室 "},
  {"id": 9, "src_sha256": "6a54462f8cb28589852ccf0de30adf44a155a8ff6030bfb545e9e4c93b8e6bad", "zh": "皇家動物園 "},
  {"id": 10, "src_sha256": "24b6015206e61bb7a93343ecc9d0538c9b4fc9d6f3bf657a404b045feda69a55", "zh": "僅限授權人員 "},
  {"id": 11, "src_sha256": "95a30a2f33d6455808d5a1d854ea36ec299bb0efcceee8b8c39878cd71656151", "zh": "你注意到東牆有些奇怪。 "},
  {"id": 12, "src_sha256": "c32c6f136cc1779c26766bcb5624e946acee585975f090d727591a98de18f71f", "zh": "它似乎卡住了。 "},
  {"id": 13, "src_sha256": "6c2da482ddd0395f8b699d9286ad894cd4642ec03ae0ef1bf0299c9c78efaead", "zh": "監獄。探視時間已結束。 "},
  {"id": 14, "src_sha256": "62bdbb714f61c70ea5510fb8c2245693e96302e986b709fd891fb3f8575b5fdd", "zh": "THE CASK "},
  {"id": 15, "src_sha256": "f0a4b2baecd373eb2da65e78a153bf80693fc3ef31a913521312d7691519396d", "zh": "城堡警長辦公室 "},
  {"id": 16, "src_sha256": "9213818a10ed984da556fe23fcc1f8b28c189dd123a3ff23bbf20389c95843cb", "zh": "這是訊息 16 "},
  {"id": 17, "src_sha256": "95d52d8e91668279fc5ab834ecf93e359818a98fd6d0b85832a55b06e5db37aa", "zh": "書裡寫滿了名字，一行接著一行，一頁接著一頁。你突然大吃一驚，在最後一頁看到了你們自己的名字，墨跡還是新的。 "},
  {"id": 18, "src_sha256": "454a49a17c5b118759fc2ce7bd37309edacc0a78a8d9fd1d839db72b9d32012a", "zh": "新進者徽章 "},
  {"id": 19, "src_sha256": "86421fe49c76a6a5e3ed5fa88c50be0e4636544e9587c1b4259acc4f16df25d6", "zh": "AL-SEDEXUS 祭壇。入內吧，新進者！ "},
  {"id": 20, "src_sha256": "073ac20f7a72210459d1734279ad5a0e99bf0e9921c2f7bdf7232930923c9b76", "zh": "你停下腳步，感覺到了……某種東西。也許是一種氣味，一股麝香的香水味。轉瞬之間，那種感覺消失了。你緊張地環顧四周，尋找氣味的來源。 "},
  {"id": 21, "src_sha256": "b277e1439a17a9778795bab2b83e5f08b5cde0a919e805c810937c8a149630bd", "zh": "這是訊息 21 "},
  {"id": 22, "src_sha256": "c2c02addcc4002180a4190235ae30684fe0cea36333bfc985fc37a7d4fe0c1eb", "zh": "這些地圖與圖表描繪了 Rapax 征服整個 Dominus 的計畫。一時之間，你覺得這個想法很可笑。Rapax 再兇猛，怎麼可能打敗科技先進的 Higardi？接著你看到計畫中提到「Savant」，笑意頓時化為寒意。有 Savant 站在他們那邊，Rapax 的勝利實在太容易想像了。 "},
  {"id": 23, "src_sha256": "19ef67e86befcee0b05100d72507aa96c528fd93c1f3e765fb1ce64da2a380c0", "zh": "這是訊息 23 "},
  {"id": 24, "src_sha256": "f2f263d481ab2c6b10f73fbbf1ed0699897fb6fa1a031727d6d2680aa9baa158", "zh": "這是訊息 24 "},

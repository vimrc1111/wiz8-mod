[
  {"id": 0, "src_sha256": "8da497a504c997f938e9d807deaf41a351e45ee5dc57532e8eb233350b34e4cd", "zh": "很好。我的敵人將領教我的怒火！ "},
  {"id": 1, "src_sha256": "1f69a0539fd68d0e0c4ae7aae68129f30769f0854d0d2a8873b119530fc5f0ec", "zh": "哈，這樣更能與敵人一戰！ "},
  {"id": 2, "src_sha256": "5a41986219cc26df2bce5d0d108f73d8cf389dae77ec63e7c2444b3ac589c69b", "zh": "我的鮮血染紅了戰場。 "},
  {"id": 3, "src_sha256": "ae6c82efa313580a4fc58d12771d338cbd3a5b83852c5ba371046bdceeb05e6f", "zh": "死亡……正在……等著我…… "},
  {"id": 4, "src_sha256": "903462ffa46a9bdaca1004eb3043cd2a89b7de44694a3fdde4fd32b5dee2b1c0", "zh": "是時候休息了。 "},
  {"id": 5, "src_sha256": "287769bf86641ec7c6c599fbd8f5c9088f9c39beabf2348e49b1e40a620f54b2", "zh": "這是什麼災厄？ "},
  {"id": 6, "src_sha256": "c924c0d51a736a1966487fcf1057ff193e9a1fb30a12284f898466b664b770cb", "zh": "我染上了瘟疫。 "},
  {"id": 7, "src_sha256": "e6313ea7796f189d9eb24ad48b5c488cdff515c738c2f37e5c721b60493d3edd", "zh": "一片漆黑！ "},
  {"id": 8, "src_sha256": "7370b30316d7be1b1187d1245594a38a79a82c9e13c62a95ad410b69f7e5043d", "zh": "若再多揹負一點，我就無法戰鬥。 "},
  {"id": 9, "src_sha256": "65310bbe6e869a984a2fe831184ccc4bcfa69e9fcc56d46530213b5acff576b7", "zh": "我動彈不得！ "},
  {"id": 10, "src_sha256": "5cbe14d22eca5a0c295d122577869d9699739317198a16b9f34c8be6e292728e", "zh": "正是如此。 "},
  {"id": 11, "src_sha256": "c190436ffe8bd9649bd5b3f3670b6df2a733c942fad2a956b5cb432d8388f451", "zh": "我歷經千重地獄，仍然歸來！ "},
  {"id": 12, "src_sha256": "250614232f441c89af7d1f1b35202e71e51cc313c3be76b4ee6014541ef0ecaa", "zh": "生命，榮耀的生命！我再度擁抱你。 "},
  {"id": 13, "src_sha256": "5cc3d863d006c83e0bff2cfeb52ad861db69390912f543e4965fbfea222da720", "zh": "這是個陰鬱的日子。 "},
  {"id": 14, "src_sha256": "3fcf3fc0b8aeea179a62b3c204e32796718bdae71e4f3c76581ed46d1b1c6904", "zh": "我們還能再見到故鄉嗎？ "},
  {"id": 15, "src_sha256": "928113af8a587263b60fb71be3df70926d9bd2d382117528f3bd53a8b721143e", "zh": "想必你還要繼續那些毫無意義的囉嗦。 "},
  {"id": 16, "src_sha256": "783b091f5b250c89f77edb67b5acf53e58ffe60df91a70b166886427571f6dc4", "zh": "萬分抱歉！我犯了錯。 "},
  {"id": 17, "src_sha256": "60b276a41a17f055720bd1aec7c0f590c18c1408a03b3fea7f2670cde4d024f3", "zh": "技藝不足，就用勇氣來補。 "},
  {"id": 18, "src_sha256": "86d130247b5e84fddf1b9da8a9fe9c3334ca70c2d22c2f845142558e35e7482b", "zh": "怎會如此？他身上幾乎沒有一道傷！ "},
  {"id": 19, "src_sha256": "bc5e726f8802623b391b19f899c1554f00ffa32c87a48274dfa4a58e678b1df5", "zh": "永別了，姊妹。我會為你的死復仇！ "},
  {"id": 20, "src_sha256": "374229cf03ac367a42743ccd531789fc11ba29f20cc63288d6e34b80ff5c6017", "zh": "又走了一個？這世上的人都像玻璃一樣脆弱嗎？ "},
  {"id": 21, "src_sha256": "9da4737c483e2045e2698cd8f946dd3c36f2ad303505044d526670ec36cd4b91", "zh": "我們這幾個還站著的人，將為同伴復仇！ "},
  {"id": 22, "src_sha256": "6829dea0188fcd98101e6f2bfa434d28e40d72a1c1de7e57f3c52cfb67f8196d", "zh": "我絕不畏縮於戰鬥！ "},
  {"id": 23, "src_sha256": "bb805495fd3ccc9aa91c8d98817ec86888aca2dc1dce64b1c8bbf1152d0c9cfc", "zh": "那是什麼？ "},
  {"id": 24, "src_sha256": "0a6f79ac677829feac3210b92ece4022b1fbbf279cd82a55639572ee1674e0db", "zh": "我看到了什麼。 "},
  {"id": 25, "src_sha256": "dca61c5dca30a8c8cfe2bff87c4aeaf51595cdaa083ce0b89b528d83690cac2b", "zh": "我不喜歡它的樣子。 "},
  {"id": 26, "src_sha256": "76b5ee8a1852140e3180996f203ee4966f05b8fb2cf2381172052467057349ba", "zh": "這是什麼？ "},
  {"id": 27, "src_sha256": "1df7bbaf8803d9055edf419cebbdeef693f316da8251af1d237e1bf18e6bc09c", "zh": "我感覺到邪惡的汙穢。 "},
  {"id": 28, "src_sha256": "9ead267e3ea45b9aabba176ae9292dd947706a168a78cac93fd53ec9901bc612", "zh": "我受傷了。 "},
  {"id": 29, "src_sha256": "1c6963da6e207ed5b197515f30d27214bb9cd6c353e86db369ec8161f408bb4b", "zh": "啊，又有獵物送上我們的刀口！ "},
  {"id": 30, "src_sha256": "c7da122e13969b04d35d9233326277227eb3f13965dc918763c1d98181f3a979", "zh": "戰鬥開始！ "},
  {"id": 31, "src_sha256": "f5b05bbe22c87dc2a3c8abaeadacf225edd16aa28d62c232c9cd96358ec36c02", "zh": "好！這場戰鬥將是對勇氣的真正考驗！ "},
  {"id": 32, "src_sha256": "37feff1fd8a9606ba9aec3b0db9c04d2a3a85be21c172214206355e761640088", "zh": "下一個要嚐到我怒火的是誰？ "},
  {"id": 33, "src_sha256": "f328f7e940dfe74271b418808dc00047a0f7eba52764a3996d6cb7ed8159710a", "zh": "啊哈哈哈，又是餵蟲的好料！ "},
  {"id": 34, "src_sha256": "8cf264a0a058eee11ed33f8916ed2e676c9636bc96ae20ec4f65530106402fb5", "zh": "你不會這麼輕易奪走我的性命。 "},
  {"id": 35, "src_sha256": "969c4aff511acc4f41501ef5b42a5a651cfd4e44e5fc107bbd87713394658882", "zh": "勝利屬於我們！ "},
  {"id": 36, "src_sha256": "2ae5f85c0f4512760587af1f0265d758fbd5a681a33d17649f0271cc5888eed6", "zh": "終結了。這個曾經強大的暴君，如今不過是塵土。來吧，朋友們，我們把他留在這裡。沒有他，世界更美好。 "},
  {"id": 37, "src_sha256": "13be6434de1b7472146279412f4928f9c6dedde8f38e964aae68286b1d0a60cc", "zh": "勝利！{{Bard}}將永世傳唱此事。 "},
  {"id": 38, "src_sha256": "c6cc2cad2ff578e04a99894d18a43d841a4f14a425d0705c45e3826f01f4e2f7", "zh": "來者何人？ "},
  {"id": 39, "src_sha256": "15a404044ab923a7bbeb624c40442099c854bc243428002df39d614018449b0a", "zh": "沒有新的補給，我無法發射！ "},
  {"id": 40, "src_sha256": "ee7e2bfe642e0979dc1f30667708130757599ae2ee7e8cb115b800dbaaf17154", "zh": "我們之中少了一個人。 "},
  {"id": 41, "src_sha256": "ae769adb27e07242c7b22c211c31096c0f12eaa58d2f22d3abbbcc474e5fa6bf", "zh": "終於到了 Cosmic Circle！然而我們不可久留。Savant 正在等著。 "},
  {"id": 42, "src_sha256": "2610056ce80b6685dba57f0ca2c01dac72d39e7dae0638af27197c4f957b2299", "zh": "於是圓環閉合，新的命運破曉。然而我的心被撕扯著，一邊是對新開端的希望，一邊是對逝去世界的哀傷。 "},
  {"id": 43, "src_sha256": "907fcef53bbf14dcb8b2de3cb163df9ab4ea0581fc6cd26d1dc0c1502fdf15e1", "zh": "你瘋了嗎？去找個粗野的男人吧。 "},
  {"id": 46, "src_sha256": "562a96a38d8c1ccbbe170e02c8fbd908024ae3a459987c199d4e2b33d1607727", "zh": "至少這件聖物不再落在那些害蟲手中了。 "},
  {"id": 47, "src_sha256": "66ed62013a3ae77a1a089a3373e7324d8e1efad09380174ee8d0db78f3cc32aa", "zh": "我對知識的信任，遠不如一把亮刃與一顆堅毅的心。我們把這東西放到它不能再作惡的地方吧。 "},
  {"id": 48, "src_sha256": "fce6ca0cc0f6d9be011548dd16306f24fe4a86a9098c888254906f9545d0f070", "zh": "好，我們拿到了。趁他們發現我們的詭計之前，快走吧。 "},
  {"id": 49, "src_sha256": "a99298adca0dcf764cf8bfa32c58458f5b4bc4df7b09135643e221b64dee0fa7", "zh": "終於，它是我們的了。我們的任務離終點更近了。 "},
  {"id": 50, "src_sha256": "f8811be9efff0b5996777d34bdaa816269cc88f7ad9b921d61c561f756f42c4f", "zh": "這是噩耗！ "},
  {"id": 51, "src_sha256": "0ec4087592277b21ee56ba3fd6502628c441f9a06e95c50be7e753fb7731eb98", "zh": "朋友們，我必須離開你們了。血脈之情不可否認，我得暫時去與同胞 Mook 會合。別擔心，我會在晨光中回來。 "},
  {"id": 52, "src_sha256": "737999f89d8205d04607259077e0bc7e83ce7551a562f606a931fe78a454603c", "zh": "朋友們，我帶著消息回來了！我的同胞找到了某種裝置。那可能是我們要找的三件之一。然而他們並未起疑。 "},
  {"id": 53, "src_sha256": "832223db11f9186dedd6fdd02c06489a2b8cce837af61d95d55954fbc950ea18", "zh": "我不能。 "},
  {"id": 54, "src_sha256": "e5cc911ce68dc646ccae8beeace7ff1c50cc49afe8e98afdc7023d1452e7c118", "zh": "哼。我在這些話裡聽見謊言的空洞回響。 "},
  {"id": 55, "src_sha256": "75a7a82f200d4d55c57449d766571d5a7133457bf5a15fd928af309d7a75eb15", "zh": "啊！無與倫比的寶物！ "},
  {"id": 56, "src_sha256": "9fa560acbaae5b477c840926d084e1f37d141f9be7a56a3183a2980502f1b7be", "zh": "勝利！勝利屬於我！ "},
  {"id": 57, "src_sha256": "5c6bebfec7fc27f4f7f57c10971af6789e4e44e86f89e5e2f8455a1433fa0336", "zh": "朋友們，我看到 Vitalia 了。 "},
  {"id": 58, "src_sha256": "9a5e4f99e7877c7238b39d228a32ab6c69c7e4802e8bdea8b8c90530897291fd", "zh": "我們改日再繼續這場戰鬥…… "},
  {"id": 59, "src_sha256": "25fee1bfe13c609e3e3c8bf5af2893fd80a30916366ab670032d311442e248f4", "zh": "Savant 與 Rapax 結盟了？那我們都得提防。那個黑暗惡魔與那些野蠻人的聯手，必將結出血腥的果實。 "},
  {"id": 60, "src_sha256": "e73ba9e419d68199612efbf03fb2b807f03072adc55faa720ddca1887ed95615", "zh": "我多渴望一堆溫暖的爐火！與那個黑暗惡魔的會面，讓我寒到了靈魂深處。 "},
  {"id": 61, "src_sha256": "115ec97eb79bdf891bcd61754191613a087bfb985645f469a54a765a725db5e8", "zh": "他的話語似乎很有智慧，儘管他的模樣陰沉。 "},
  {"id": 62, "src_sha256": "c741406aa92e44dcda07ada325aa36049bd7de40489a033c2f1b24636b1bd89d", "zh": "重重一擊！Savant 的飛船沒了，他的大軍也潰散。然而那惡魔本人或許仍活著。不見到他的屍體，我絕不安息。 "},
  {"id": 63, "src_sha256": "d1fa035817879b4a08fb8b5843a88e89c3913c0121ae9707b0b7344229264c67", "zh": "把你們的劍收回鞘中，讓和平降臨吧。朋友們，我們做得很好。 "},
  {"id": 64, "src_sha256": "f52a5756ae7000f447ab526d4915273dbe924a89f76b5f4bb280cee3ce1fa3e3", "zh": "死亡終將征服一切。來吧，朋友們，我們走。不論是什麼造成這一切，可能仍潛伏在附近。 "},
  {"id": 65, "src_sha256": "1d9c196cb80451bb04a33917915b9e6dc38ff82535d20d0cd7b5c792c39a3469", "zh": "做得好，朋友們！讓我們歡慶吧。 "},
  {"id": 66, "src_sha256": "f5526b2acc37edf0c15f6b5a08b27adac96b673d30daa4b0f3fd1ab864f4f5d7", "zh": "小心點，朋友們。凡是來自那個黑暗惡魔的東西，我一概不信。 "},
  {"id": 67, "src_sha256": "8f9880123c6dfa90f96961ebb4d504d967d4cad7138736a534035104541806d8", "zh": "看哪！一個生物。 "},
  {"id": 68, "src_sha256": "7504d30343e27e5bf0ac80b3d673990d1d6de1b4c3cbf360f4d295cae2139b85", "zh": "那是什麼野獸？ "},
  {"id": 84, "src_sha256": "10023e77f91bd0a21f779ffee7c13ab59f9faf038bd33ce35e9ab183f784a776", "zh": "少了一樁需要擔心的瘟疫。 "},
  {"id": 85, "src_sha256": "4a02fd1ad05dd33cb26aed8fcec32328e1c1d776eaf0ddffb7c931abfca7b22e", "zh": "那場瘟疫退去了。 "},
  {"id": 120, "src_sha256": "610420158267532d8b0d1bc9363dcd1a66c4c42dda26342f4e3fdf16fb5743b2", "zh": "他是優秀的領袖，也是我們所有人的激勵。 "},
  {"id": 122, "src_sha256": "3ad502552236f6592432cb56bc150cef34a6c86553431a0645a6619a959fa250", "zh": "感謝你分享你的智慧，治療者。 "},
  {"id": 124, "src_sha256": "47603e8edbbe9a6c5f164f3433c5c0677a67b981e0ef62b669252119d244bcc8", "zh": "這個奇異的金屬之物，真的是 Cosmic Lords 的使者嗎？ "},
  {"id": 126, "src_sha256": "02798cb08aa7a7278f74ca35d8641c5160abf13bb633a56feb7abf899f266549", "zh": "Rapax 是汙穢的生物，他們的國王也沒有兩樣。 "},
  {"id": 129, "src_sha256": "f12471b098250c2db45609906a738805dcb8f0a4e5ec700c4117bd8ce0debd78", "zh": "新的冒險開始了！來吧，夥伴們，讓我們探索這個奇異的新世界。 "},
  {"id": 130, "src_sha256": "4d7cd418200ce0bd46b2e5c3de7ec9bfd1c6eca05ecb9416f14f2c418f74a0db", "zh": "那麼，這個奇怪的裝置是什麼？ "},
  {"id": 132, "src_sha256": "93411775e7de05351d9105974dcceff81bfe8155a936ee6fe72e2e4a23115fb0", "zh": "如此，我們已經取得 Helm。接下來我們的道路指向 Marten，Destinae Dominus 的守護者。 "},
  {"id": 134, "src_sha256": "61dc1debe55c529c989851ee87abb2eee8b18d5e03c4536cb1a83e13aad65909", "zh": "這座塔必定是 Dark Savant 的手筆。我能感覺到他的邪惡氣息。 "},
  {"id": 139, "src_sha256": "85f95ddce07bbab51f3829a3b3cdb931112e06e15ae5460851c9ad977e3ac33c", "zh": "你們看到那些雕像了嗎？我確信它們必是某種徵兆或預示。不知它們象徵什麼？ "},
  {"id": 142, "src_sha256": "f68b7117c475c51dd903289872b9b54813e7cb1941116e2b0224586b7b2e87f6", "zh": "於是我們進入了 Umpani 的內殿！這確實是座雄偉的堡壘。 "},
  {"id": 145, "src_sha256": "2fd733591c66604366a33f8ecac93468ec7ee81d2fdfcf5d994b0998d6a52ec0", "zh": "與這些汙穢的野獸同行，我不能說我感到喜悅。來吧，我們盡快離開這裡。 "}
]

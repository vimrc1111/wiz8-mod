[
  {"id": 0, "src_sha256": "22ed231e8f2b6df13edde3ac70071e7eb8f3808c27f63823d88ac1c6a3809747", "zh": "別擔心，朋友。這件事交給我吧。 "},
  {"id": 1, "src_sha256": "9bad16d0a5d675ca0f1504a80f9a8341b3764983638c2682bcb48246834cece1", "zh": "經驗本身就是最好的獎賞。 "},
  {"id": 2, "src_sha256": "6e4e15e707a21883f56f02775cb49c6a39c138bfa3bf88392a04c99e12f469ea", "zh": "沒看起來那麼嚴重。 "},
  {"id": 3, "src_sha256": "953e470c7ad09c2021d70d9156c126d3c82ae0aa207ff998ac88b5dab00c47ce", "zh": "哎呀，真的……只是……擦傷而已…… "},
  {"id": 4, "src_sha256": "b0a65f6ae164a3e258812a52497ca7ec228fcc6ec373285b1d32ea0954455d7f", "zh": "我覺得有點累了。 "},
  {"id": 5, "src_sha256": "27be511cf8fb259c457f48ab6f4e6fa8e8b8a7637d254f7a29f63bce66ed8170", "zh": "覺得有點怪怪的…… "},
  {"id": 6, "src_sha256": "46c8a7afc0e8dbabf82ed2667e68b1128ef2db69dbf9870c76eca8d5e902bcd2", "zh": "不……太舒服。 "},
  {"id": 7, "src_sha256": "8281a98acbbb592d8de59d23b7f8c4dc617a9e111119c0c543f1d2680b6035ac", "zh": "為什麼我看不見！？ "},
  {"id": 8, "src_sha256": "a710c3d10eedf69bb1c86fdc1133a780516fa8ebe94aa1b6c4bd7809e946aee3", "zh": "哎唷！好重，不過我會試試看。 "},
  {"id": 9, "src_sha256": "b146b128594600c2269309b676855ecb94218d10fc746fa147601c5242a59dfa", "zh": "我……動不了了！ "},
  {"id": 10, "src_sha256": "a98def4ac1649e97bce21696c264384942a61c4c664f38ed19f586eca4e249c7", "zh": "我聽到了，朋友。 "},
  {"id": 11, "src_sha256": "c837bd317edfce19b8c2605a0923e410e5bf1275ed242d84de57437b9270764e", "zh": "本來可能更糟的。嗯，也沒糟多少就是了。 "},
  {"id": 12, "src_sha256": "6501a80f408ef6d0b36a97cd96366b7083128960fbee36a393c519395ceb754b", "zh": "謝謝你們，朋友們！能回到隊伍真好。 "},
  {"id": 13, "src_sha256": "e9d8ecdc0de517a817262fa3297c0b93d70827cb16ea1ba26e08230a60d99798", "zh": "情況看起來確實不妙，我想。 "},
  {"id": 14, "src_sha256": "c3d4a0a03b6413a089ec985d29e806ac6960b16eecf193c535f28d08237c8970", "zh": "我們表現得相當不錯，你不覺得嗎？ "},
  {"id": 15, "src_sha256": "fe1d95c0b530e567e0ff4cc4efc98d8607d1bdb43862458bd6aaafcb73077f4b", "zh": "不急。欲速則不達。 "},
  {"id": 16, "src_sha256": "8c4a1b1c362ead17043766fa912d00161ace4d0b2c10c208a67711769299057a", "zh": "抱歉，朋友們。 "},
  {"id": 17, "src_sha256": "b4c6d6c4d79a597258aa1d04275fb855eca998673b418a464f3c958c13ce4191", "zh": "錯誤能磨練品格。只要下次多留神就好，嗯？ "},
  {"id": 18, "src_sha256": "0add7d2f4a6dd8380004f3d94196360e9a72d8e9bbda0362fd09ab2f698a70ad", "zh": "我們會想念他的。 "},
  {"id": 19, "src_sha256": "f2e30faadca105602c9a41265cd10568beb5f495dbdf926ac42b44f38fde3efa", "zh": "她走了。真可惜。 "},
  {"id": 20, "src_sha256": "d6df23b0027b592f5495c8eef7ea69b34b0af0e0acc4af5654352d5e5bde42e4", "zh": "我們應該好好照顧我們的客人才對。讓人家死掉，實在不太禮貌。 "},
  {"id": 21, "src_sha256": "ea3c61bb0cd365667b6afac4d2d6494631f230fa63bf4af3eaa1adcbbacdba6a", "zh": "我們還是能辦到的！ "},
  {"id": 22, "src_sha256": "5f5bd4c04ad1fd72aeb06353cf3c701d177161df9f86b0ff24f3fcb405d1820c", "zh": "唉呀。我不確定自己一個人行不行。 "},
  {"id": 23, "src_sha256": "305783db60de08a631a2d75b135d041382f13ac1ab283d5931a866791fccced7", "zh": "看那個！ "},
  {"id": 24, "src_sha256": "0146979276d85bb6dbc9cb0a8a5364ab1ca736bd9c9d3e8dfba0a8897bb32362", "zh": "快拿起來！ "},
  {"id": 25, "src_sha256": "ac6285412b506b2a6032f4dd8f262475c06b4c4c3cc1489d3fab6d4270430a9b", "zh": "等一下。陷阱可是很棘手的東西。 "},
  {"id": 26, "src_sha256": "8dbd0c8a96f82937fad984685c967a4cf0d1e72b5cf419e750a8e3529f232e67", "zh": "這裡有點奇怪。我們來看看。 "},
  {"id": 27, "src_sha256": "330efdf2114e6460a4508c765f818425917f1b49754751db5f81fb43eb5588f5", "zh": "嗯。大家在這裡靠緊一點。 "},
  {"id": 28, "src_sha256": "4fa5bf13ace139e78700018063ca0666b677b6fbedd9d8a81d272a006e25fde8", "zh": "我被打得有點慘。 "},
  {"id": 29, "src_sha256": "f65acaf5427c00b5088e2451c1fc42f5e66886e03aee01012d34cf6c6f29737b", "zh": "沒問題，我們輕輕鬆鬆就能打贏他們！ "},
  {"id": 30, "src_sha256": "dbe27f7eb74bba21dc899519dae356f2a7e2c1c434bd35dc97c751298fdd799f", "zh": "大家準備好戰鬥了嗎？ "},
  {"id": 31, "src_sha256": "91058675c34f12d1649be1cda6712aef4c89d9fe49c5706f13928c5eb58d6341", "zh": "好了，朋友們，這需要團隊合作。 "},
  {"id": 32, "src_sha256": "33579c59fe4c4245400c4c82d1e3696db7108ec07a118d4a7f1d468c35e58c8e", "zh": "指個目標給我吧。 "},
  {"id": 33, "src_sha256": "2d2dd50a62fa69a8284b1ff4d8a662642ddf6085e2c2cda1b11d3c97a0e06974", "zh": "我想我是自不量力了。 "},
  {"id": 34, "src_sha256": "d7fc02555422967c51836c637b973288a5201b02012b8c957ad89c03854dae44", "zh": "好險！還有誰受傷嗎？ "},
  {"id": 35, "src_sha256": "9c9218e092cc7307606c9e42f1e55063f94592e06d980119e2d4d3c401142683", "zh": "幹得好！ "},
  {"id": 36, "src_sha256": "a21d8f312c519677eb48df7e5cf91e555eeb701f7d5c0d88fe188d0e33d5136b", "zh": "我知道——說不出好話，就什麼都別說。不過，Savant 非阻止不可，而我們正是最適合的隊伍！ "},
  {"id": 37, "src_sha256": "a9940ec1c78f0f9499c2bf972d3de05415760be4faca3b7cb31c10ad1ae4a486", "zh": "幹得好，朋友們！ "},
  {"id": 38, "src_sha256": "4a26e6f2b93552dbf3fa529e62560860c0faeb16f6df0457d33fac9d441aadfe", "zh": "這下會是誰呢？ "},
  {"id": 39, "src_sha256": "f17b46dff3958382838975485195d92b1e31b4a443055a7025b598d83bbae906", "zh": "能給我點東西射嗎？ "},
  {"id": 40, "src_sha256": "f21712d41568e659e0d9a116000b4c8f411b86e649b392f23c6848547840bfbe", "zh": "朋友們，我們有一位隊友不見了！ "},
  {"id": 41, "src_sha256": "7a19e7cc27d81a3760600de6a77f113e76bd514741b020f82c8d827c6981d5fc", "zh": "所以，就是這裡了——Cosmic Circle。打起精神，朋友們。這將是我們最後的考驗。 "},
  {"id": 42, "src_sha256": "b15d3dfba8fcc5f8a25ece0c0cbff052662a9dc39ef422b07d79c02dfaedf2f3", "zh": "幹得好，朋友們！我知道宇宙現在掌握在可靠的手中了。 "},
  {"id": 43, "src_sha256": "a3d89d35b0e534a81d073d9e2388391132010d4da4a9c0f3e3da8465d5ca34a0", "zh": "那是……嗯，紳士是不會張揚這種事的。不過，不知為何我突然覺得餓了。 "},
  {"id": 44, "src_sha256": "ad454f8a47edb5ef3aadda6cb691acf08c9f3f116b95bd611428f7a901081c51", "zh": "等一下。我——唉，我讓團隊失望了。後面那位，呃，女士，Al-Sedexus？她對我有某種掌控。她不讓我離開這裡。我要是離開，就會死。 "},
  {"id": 45, "src_sha256": "fd55a12986c5426de637a451b76af1561f4cdecae5df3c743caf4b1d759675c3", "zh": "各位朋友，稍等。Al-Sedexus 就在附近！我感覺得到她的氣息。 "},
  {"id": 46, "src_sha256": "eaf1fa5e6a44f950deeb1af3d999c9fb8050a1d1457f01f81c0b995409fec60d", "zh": "先是 Savant 拿走了它。後來 Rattkin 又從他手中偷走。現在 Atral Dominae 在我們手上了！誰想得到呢？ "},
  {"id": 47, "src_sha256": "4b2d4d356f2ab92fd8caeda67b3538a0bf561173427b4a47a840a5a2e3d96066", "zh": "所以這裡面裝著所有知識的總和？哎呀，哎呀。Marten 把它交給我們，我們該感到光榮才是。 "},
  {"id": 48, "src_sha256": "0aa2a0649fe98d39b9c5fe188fc33517b08c5e642dc50ef97a566bfe47695dce", "zh": "我拿到了！我們最好趁沒人發現之前離開。沒必要跟 {{Mook}} 起衝突。 "},
  {"id": 49, "src_sha256": "f3590a16cd9cc4f8ed8251054fcf3bdb97a549e7af018dd203a534106957a223", "zh": "知道它在我們手上，我就能睡得安穩些。這麼強大的東西隨便放著，我會緊張。 "},
  {"id": 50, "src_sha256": "2d1db77d60ae810ba180791f867feebf905a8b2ab007dc3ec7c76f9ea65511ef", "zh": "朋友們，這會讓我們的工作更困難一些。 "},
  {"id": 51, "src_sha256": "e8bc111d8565fb960c901e4e09ca2f24cd91f4fb00edf6155dbdc70725fdbc41", "zh": "失陪一下，朋友們。我的族人請我跟他們相處一會兒。我不能拒絕自己人。我很快就回來。 "},
  {"id": 52, "src_sha256": "6c8cadf27afe1062b29fe77570fde2c28bd7a49df6954730ca80f41fcec4e658", "zh": "回來真好。我有消息。{{Mook}} 在裡面有某種裝置，很特別的東西。他們叫它 Callisto 什麼的。我想我們應該去調查一下。 "},
  {"id": 53, "src_sha256": "75ed2816a73d6f0c0591f26dbe1bc20eace4ac7995d55243327c41eb0f3706ea", "zh": "我也希望可以——但我辦不到。 "},
  {"id": 54, "src_sha256": "88a216416a9dc21cd5539497fdf683ec783a8cb9654565144852d80bee37da94", "zh": "我不喜歡說別人是騙子，但是…… "},
  {"id": 55, "src_sha256": "b0cca61ababb0b7227291a293e73867fec25af3bc24930fe366fe6f02a7ef1c2", "zh": "真令人佩服！ "},
  {"id": 56, "src_sha256": "ce523e4263df9dd0e700b9ee973a4020d20d38cb14c8cb3d091f9e6212016b4d", "zh": "就是這樣！ "},
  {"id": 57, "src_sha256": "2d625c327036d7e1dedd0d5ab9bee52058ba7483e8732196213a1a570110d9d3", "zh": "你好啊，Vi！ "},
  {"id": 58, "src_sha256": "24cfbef376151e544d74f93855e431949d45027771e6611594e0a68f22c19e3b", "zh": "我們成功了！ "},
  {"id": 59, "src_sha256": "d550bb80e2de42c6807fa04acff766182f46774d510e5672ca19b52273ea7a29", "zh": "Dark Savant 跟 Rapax？哎呀呀。那個惡徒怎麼不去跟 {{Trynnie}} 聯手呢？ "},
  {"id": 60, "src_sha256": "625503bf5b3a79426bc49bb3dd67dbb6c1973c3b68eadd5f1af9e449a5986f56", "zh": "大家都沒事吧？剛才真是奇怪。我原本預期會是更……暴力的遭遇。還有，他為什麼把那件東西丟下？ "},
  {"id": 61, "src_sha256": "5d1fe8038302d1705c7899ba1aafda1ce90f5ea46b5f5ba6a843da32fb19511a", "zh": "他提到的 Forge 讓我著迷。聽起來使用 Forge 的人……嗯，什麼都辦得到！ "},
  {"id": 62, "src_sha256": "5f08e6fbf45c195ca02b8c5e0a1f8923f087da913d54d5d3e3efda34e3930ba4", "zh": "幹得好！Savant 失去了他的主要據點。要是運氣好，說不定他真的在那艘船上。 "},
  {"id": 63, "src_sha256": "9e8736149f804ddaa8acd111dfa10d4b94f8856b1a5296692d76d66d0259cdc7", "zh": "看到這一幕讓我很欣慰——如此宿怨深重的對手之間竟有了和平。而且是我們促成的！ "},
  {"id": 64, "src_sha256": "5b7e966482f9b7efebabd977a675d66ebdab3e1e1427173f2f1072fb6360dcaf", "zh": "他們發生了什麼事？是誰幹的？ "},
  {"id": 65, "src_sha256": "293bf7c4480710a078c1949bd1a6a17591b6dac4ec56e56c9f59f1248e060742", "zh": "幹得漂亮，朋友們！ "},
  {"id": 66, "src_sha256": "79f95923435d7749c59b2eaa75e04eff69ab8fc6f8137c0094283450cf08bfe9", "zh": "小心點拿著。這看起來像 Astral Dominae，但 Dark Savant 不會就這樣讓我們拿走吧，對不對？ "},
  {"id": 67, "src_sha256": "77735eda0e11fcf7b14674ba568490b61cb1ad21439c0ce9386fe412523f1eba", "zh": "我看到一隻生物，朋友們。 "},
  {"id": 68, "src_sha256": "22be9f528e6cd2b1b2c5cd34d413bd368174c8a8ea2074fb2dfc1512f133d4af", "zh": "看，有東西在動。 "},
  {"id": 84, "src_sha256": "34c4143482028b26fb12c8bd637d498afa58f757852810c33e48bbe2082b47a1", "zh": "好多了。 "},
  {"id": 85, "src_sha256": "d8096a10779787b35c52e418397df5ab42b83f1b4f0d375354fd5b6c9cd35aa2", "zh": "啊，舒服多了。 "},
  {"id": 121, "src_sha256": "619504858e9e7fd3a6a491cd4e8c1952d92e59c9433c5d52f52734fabb8134b8", "zh": "起初我不知道該怎麼看他，不過他似乎是個正派的人。 "},
  {"id": 122, "src_sha256": "7b3552c9c0fea5d1e28ebf9e877721bce1c39f6e8161f59b81611c8c4cc066d5", "zh": "我相信他正盡力幫助鎮民度過這段艱難時期。 "},
  {"id": 125, "src_sha256": "7e756af06602bcc68c59d523cbd942b489e7c1b7fa5da7853ef5e0b9c3640fa4", "zh": "{{Trynnie}} 是迷人的生物。我想多了解他們。 "},
  {"id": 128, "src_sha256": "2e179af6ff973584f50deb4052e071b136012168a583933e1d423c3b31e9b1cb", "zh": "{{Mook}} 一定對這個地方非常感興趣，才會大老遠跑來參觀。 "},
  {"id": 129, "src_sha256": "f365cd614c17bb58cb06e481cd57b313d3d5e553c6252700e43d059a3531f74a", "zh": "別灰心。我們雖然有點麻煩，但只要大家同心協力，一定沒問題。我能否建議先從收集一些補給開始？ "},
  {"id": 130, "src_sha256": "78c1466d4608721ea77fa76f23679f9c197d3ca1e5e28010793cc8b5feedfcc3", "zh": "嗯，你們覺得這東西是做什麼用的？ "},
  {"id": 131, "src_sha256": "05a8b516aae5ba564d8ebd6f0401960bf85cfb94c93bac0a59f2dd217fd7dc47", "zh": "謝謝你們，朋友們。Al-Sedexus 死了，她對我的控制也結束了。 "},
  {"id": 132, "src_sha256": "59717c12eb12ebaf98a1382c0fd2b6e9971dce4f4f620056fee3b9d300c2c1bd", "zh": "幹得好！Helm of Serenity 到手，我們離 Destinae Dominus 又近了一步。 "},
  {"id": 134, "src_sha256": "c17cd714ab47e33f4ffda817d3f1e6e1b867f5031b09dd7af6b729623458daa7", "zh": "你們看看那個。那一定是 Dark Savant 的高塔。 "},
  {"id": 136, "src_sha256": "23980686f8a689c4e43faf8e7e389e2c8dcde1774f927bca32248df74a042844", "zh": "幹得好，朋友們！我們剛剛拯救了 Arnika 的每一個人，免於 Savant 的炸彈。這一仗你們可以引以為傲。 "},
  {"id": 139, "src_sha256": "754a7cb085e3720403f05872eac6047e1b2c8b55beb852204ebd3e6e5115ff9c", "zh": "你們看看那個？那邊的雕像……簡直像是在指著什麼。不知道是什麼意思。 "},
  {"id": 142, "src_sha256": "9c09dbc2535d6788d9bb9f204f75f6fd69f77931779b45c4334832506d4fbf53", "zh": "所以這就是 Umpani 的要塞？整齊俐落，非常軍事化，正如你預料的那樣。 "}
]

[
 {
  "id": 0,
  "src_sha256": "0f7637badeac7ffb5c826828c4b3293e2610a99183b80dabf3c1df840d170045",
  "zh": "嘶嘶！ T'Rang 與 Umpani 之間的和平，全都壓在你們的肩上！"
 },
 {
  "id": 1,
  "src_sha256": "4eea01ea7113bf789007d53c9aa401c2e598491692aaf1035c26a8f5e1ad54e3",
  "zh": "嘶！我的氣力與見識都增長了！"
 },
 {
  "id": 2,
  "src_sha256": "736862519edbac9e8c51615c778d437cb2545ca190c1cbd57e7119f196932588",
  "zh": "嘶嘶！你們必須治療我！"
 },
 {
  "id": 3,
  "src_sha256": "862fe44e23b03ba9b9d2c7717c4ffa4ff9f572c8034451c37b0fd448c5971713",
  "zh": "嘶嘶！！我快死了！"
 },
 {
  "id": 4,
  "src_sha256": "c06f5ea564476dc337beda924b32b620a52ad7a0b46f842548bd40add3dc70ea",
  "zh": "讓我們休息。我們的表現全仰賴於此。"
 },
 {
  "id": 5,
  "src_sha256": "63eb5763bf751dca87296f60298f8dbeef296a3e27abc57d8021da7360a7983d",
  "zh": "嘶嘶！我怕這會要了我的命……"
 },
 {
  "id": 6,
  "src_sha256": "a10e960ad0eb5b94da8ea6c9e75812adafff8ed030c95756e7f0c20a65e77c2a",
  "zh": "治好我這病！嘶！"
 },
 {
  "id": 7,
  "src_sha256": "c55fa79ef82689d83d76fc9bfd85efc7c9e850161f15c701225a02df81308f36",
  "zh": "我看不見！"
 },
 {
  "id": 8,
  "src_sha256": "58e112371ca0cf76e5ccfd6dd04e2b02eb928988b7f23ce56ab332f637d8ae13",
  "zh": "身上揹這麼多裝備，我沒辦法戰鬥！"
 },
 {
  "id": 9,
  "src_sha256": "e53a4da507e09e2b6690f47db2a36fab62903ea71173098d5c40b07101ee09d9",
  "zh": "嘶！動彈不得！！"
 },
 {
  "id": 10,
  "src_sha256": "f6f8d493bb2ec8258f72f270b47c60e2a920c2e07ba6412d2457cf1a24f7e802",
  "zh": "是的……我也是……"
 },
 {
  "id": 11,
  "src_sha256": "469aa3ae28a3cb0164ed6b1cd1f15b6aaf335c4961a5483c84f13d905a0984e7",
  "zh": "嘶嘶！蠢貨！你們不知道這趟任務有多重要嗎！那種事根本不可原諒！我該把你們每一個都打殘……嘶！讓我遭受這種恥辱，都是你們活該！"
 },
 {
  "id": 12,
  "src_sha256": "57d1bf07ef7c76892ff7719ac937602389f224d69c95b6adb4012dcc308297cf",
  "zh": "嘶嘶嘶！你們讓我死了，蠢貨！沒有我，就沒有和平！"
 },
 {
  "id": 13,
  "src_sha256": "8a0195b48598955081d31b1a466c048df34ea092a2ed81e39e7773cc13f9ca8e",
  "zh": "如果這不影響我們的任務，我不明白我們何必在此逗留。嘶嘶！"
 },
 {
  "id": 14,
  "src_sha256": "f7c6ced1a63de9540dd27bafde973b989bdedeb5edcde0db4ecbc6bb7a0d7e7f",
  "zh": "嘶嘶！你們在看什麼？！沒見過 T'Rang 嗎？嘶嘶！"
 },
 {
  "id": 15,
  "src_sha256": "a153fe84a99c4d357357fecaad7aadf0e4f6f614c2da9130d4be075caae7d185",
  "zh": "這毫無意義。我們有這麼重要的目標，為何還站在這裡？"
 },
 {
  "id": 16,
  "src_sha256": "972c2dd5ef9298813037a496c465fe4728dee12330de8be33066fe24a487fae3",
  "zh": "嘶！我受過的訓練可不只如此！"
 },
 {
  "id": 17,
  "src_sha256": "e52619fffda10f10cbe14c8e47141da244580e105cd9de805c750015c88201a9",
  "zh": "嘶嘶！你們沒受過戰鬥訓練嗎？！"
 },
 {
  "id": 18,
  "src_sha256": "ab0e9d951b363996dc7216a97c11705ae18c44769dc53298612dabfe6ca85780",
  "zh": "他對我們的任務並不要緊。我們別耽擱，繼續走。"
 },
 {
  "id": 19,
  "src_sha256": "149be6d5f21cfcb94b0257715d06d764ceceb96ea0c8ae162260a21029994e04",
  "zh": "她對和平而言並非必要。"
 },
 {
  "id": 20,
  "src_sha256": "5cea346f9f40a45e19eb463f27ed55b238634e86c8d767648bc621485fe48b5f",
  "zh": "嘶嘶嘶嘶！ Rodan ！蠢貨！你們怎麼能讓他死了！？沒有他，和平根本不可能！我給你們一次機會讓他復活，若是辦不到，你們的死期就到了！"
 },
 {
  "id": 21,
  "src_sha256": "4bce7ed0d6eec2a46d469dde212aa4d29be93d45045ba1a832d185454cb3a82c",
  "zh": "嘶嘶！這些生物，死得這麼容易！"
 },
 {
  "id": 22,
  "src_sha256": "aec7e0f9d4cee06deaa09ed71fd062bdf7ccb904afc71391707abe32e8911f75",
  "zh": "嘶嘶嘶！哼，這不是太珍貴了嗎？你們只需要護送我們平安抵達和平。結果你們不但害死了整個隊伍，連我的夥伴也賠進去！我們獨自上路還好些！"
 },
 {
  "id": 23,
  "src_sha256": "552a86f91e945df0fab603467e8321f5e8fcf718b88832a7cdce736fb162811c",
  "zh": "那裡有東西。"
 },
 {
  "id": 24,
  "src_sha256": "4ed272de9206aa34a883ae8929059048eddd6c89eb4a7c3a12f50ee319968117",
  "zh": "我看見東西了。"
 },
 {
  "id": 25,
  "src_sha256": "553e3653a0870de4b5271080f6baf363762fec4e95608005c459b002bc4cca83",
  "zh": "嘶嘶！有陷阱！"
 },
 {
  "id": 26,
  "src_sha256": "69f75d459ea2c527c9c19efa1a98ccf6b2fcf92af21f582b03fdc06646fdaa80",
  "zh": "嘶嘶！有東西藏著！"
 },
 {
  "id": 27,
  "src_sha256": "d77e45a9a0420d248b615fdc7c2590f786ced7e08258273692773979123e3fc3",
  "zh": "嘶！我對這個地方感到可疑！"
 },
 {
  "id": 28,
  "src_sha256": "718f1035c2730d14e01a5357a751166f2f076a484db35d16e3fc2b19a539fd72",
  "zh": "我必須治療我的傷口！"
 },
 {
  "id": 29,
  "src_sha256": "9f68bb2851e7c8da9a3457debe741c374c1f2d7406d91a466e8b03ba6965b0d3",
  "zh": "嘶！殺了他們！"
 },
 {
  "id": 30,
  "src_sha256": "d1dc4fdeacab0a0c7574e435bbe5c3d2ad6a22f29cba202bd5848511a1759d2d",
  "zh": "嘶嘶！他們威脅我們！"
 },
 {
  "id": 31,
  "src_sha256": "3aa3e3efc04b63ba043add237eb0317b4bedc9308f9189175f58b5ab512b0ed0",
  "zh": "他們擋不住我們的路！嘶！"
 },
 {
  "id": 32,
  "src_sha256": "a04a1cd0c8a0b580a6066c1c246abe7fedc1c8803643cfd5d4e4d268d0396991",
  "zh": "我該殺誰？"
 },
 {
  "id": 33,
  "src_sha256": "5355bff5421af25bd739eb9f98aa27e01a77cf53f48e689c63560718da62866c",
  "zh": "嘶！退後！退後！嘶！他們越來越多了！"
 },
 {
  "id": 34,
  "src_sha256": "33587b11a49ef47768a95c8a019d58b5b1fc1b6038a710e15bf79ed08e18f757",
  "zh": "嘶！太近了！"
 },
 {
  "id": 35,
  "src_sha256": "704526c4979bf17d00364ab19aaf55f160d5a41c001d49fea508482a6944f4aa",
  "zh": "讓我們繼續執行任務！"
 },
 {
  "id": 37,
  "src_sha256": "d7f55a023e1970cba162dbfd2b57fffb4d7f66ac49550151b48929c98315164c",
  "zh": "嘶！竟敢擋我們的路！它不是偉大 T'Rang 的對手！"
 },
 {
  "id": 38,
  "src_sha256": "02717dd9e33a5415b82490d4f11d633e9c4758b11ca8c74ef09f27a5a455720c",
  "zh": "Rodan 會替我們開口……"
 },
 {
  "id": 39,
  "src_sha256": "0dc46269b99d3ea363a74eb768d9608acedf05f2fdcb44ebb3658644774575c1",
  "zh": "嘶！彈藥！嘶！"
 },
 {
  "id": 40,
  "src_sha256": "612e65b75b6206ed7d74820be962735a09b18cde2cf8863ed748165d3e0e3a76",
  "zh": "嘶！完成這趟任務需要每個人！我們必須找到他們！"
 },
 {
  "id": 43,
  "src_sha256": "b2b916a7d5e21469a394b117b7ea5d2673d7b4de1738f35c6787c6199ec61018",
  "zh": "嘶！我不會降低自己去遷就你們的水準……嘶！"
 },
 {
  "id": 46,
  "src_sha256": "887ec538d387bbea0782e645aa45d0e20917a6044de11e200d484ee7787475cb",
  "zh": "嘶！ Astral Dominae ！嘶！別讓它落入 Dark Savant 手中！他要靠它才能飛昇！嘶！"
 },
 {
  "id": 47,
  "src_sha256": "d86386af6b7ce251252870b0f717b786b9d31343a4d781f4f53e78acdce73c6f",
  "zh": "嘶！這是什麼？ Watchers 肯定會很感興趣。"
 },
 {
  "id": 49,
  "src_sha256": "e0a68d3fc88d50bffa5cc856a81b53b31462657e36263bfedbc278f2e2ad0661",
  "zh": "嘶！ Callisto Device ！嘶！別讓它落入 Dark Savant 手中！我聽 Rapax 向他提過這件東西！"
 },
 {
  "id": 53,
  "src_sha256": "290e91026c502eb223c990793dc1881a6c32bfa2cb54028778dfab9d09d6f2e9",
  "zh": "嘶！我辦不到！"
 },
 {
  "id": 54,
  "src_sha256": "b4a9465d9c13f45803feb57f29a9f06bdbeb5473b7e4d3a3c4b7346557c107da",
  "zh": "嘶！騙子！！"
 },
 {
  "id": 55,
  "src_sha256": "7be555a84f097c4822531a7950d0d88b2a5d40823e04a9349103043cd1630d93",
  "zh": "這個有價值。"
 },
 {
  "id": 56,
  "src_sha256": "679f23dc1ba7204432198584bb3941403a6c22f91ccf73ca48c53f6060fcf9ec",
  "zh": "嘶！偉大的 T'Rang ！"
 },
 {
  "id": 57,
  "src_sha256": "f00aeb59d0d2a9d1fb3ac2f242418c2dd68dc98842cc8736176b70e650e53b94",
  "zh": "Vi……嘶。"
 },
 {
  "id": 58,
  "src_sha256": "657548b4f88998b6d71e0cbbdf35beba46870ff52aa29faee2fc67f230e666c5",
  "zh": "是的！我們躲過他們了……"
 },
 {
  "id": 60,
  "src_sha256": "886f6109a1fcc01bd6390687f86f28c46ec4f0833c18ef58fe90bdfd11df2e76",
  "zh": "嘶！別再讓我出現在他面前！ Dark Savant 已與 Rapax 結盟，要毀滅這顆星球與我們未來的命運。他就是我們終極和平的最大威脅。"
 },
 {
  "id": 61,
  "src_sha256": "b9dc7aad95dc04c2711ea05a0e591a93376f47382a93ea79d9590c57edcbfbdc",
  "zh": "我們現在沒時間跟他談！等和平達成後再去找他。他不會誤導你們。 Rodan 提過他！"
 },
 {
  "id": 62,
  "src_sha256": "7154ae4621670fead174777097535d48ff9f602529a4b479c5291a6454f095db",
  "zh": "嘶！ T'Rang 帝國的怒火將降臨在可怕的 Dark Savant 身上！今日，我要討回我們的血債！"
 },
 {
  "id": 66,
  "src_sha256": "959413a003b3a7b4e4e6121c16531b34d533773cc9e5a2ae8a0f21379398bafd",
  "zh": "嘶！你們為何給我這種破爛！這毫無價值！騙不了我。 Astral Dominae ？胡說八道！"
 },
 {
  "id": 67,
  "src_sha256": "34f76c01c81764f70502ee57fa4367178c3d9978edca3757054ad35c8ee2a3fb",
  "zh": "嘶！發現野獸！"
 },
 {
  "id": 68,
  "src_sha256": "38df99d96009a7adae50bfca97e778f54c040d58a5327b940ff2e181b70fdbee",
  "zh": "嘶！他們來攻擊我們了！"
 },
 {
  "id": 69,
  "src_sha256": "56b269e7a73bf211753e39e758f8a3d1cc4ae762f39cd23b6fc25de54473ad4e",
  "zh": "嘶嘶！嘶！我們是和平的三件工具！你們這一組、 Rodan 和我自己！若我離開你們，和平就毫無希望。我懇求你們重新考慮。"
 },
 {
  "id": 70,
  "src_sha256": "3e67ea0d1756f3f355126016234171a6aea4843f702e9263a6f54f66d67e5b78",
  "zh": "嘶嘶！ Rodan ！這個 Dark Savant 已鎖定 Arnika 要加以毀滅。 Rapax 已與他結盟。等 Higardi 死光，Dark Savant 便能飛昇，而 Rapax 將得到整個世界！嘶嘶！我們必須在一切化為烏有前確保和平！"
 },
 {
  "id": 71,
  "src_sha256": "e372af38f6af5f88ebceeac252232a3305a6b84fc5bfa9d2410b7a8cf2b5458a",
  "zh": "嘶嘶！蠢貨！我們有任務要完成，而 Trynton 不是我們的目標！"
 },
 {
  "id": 72,
  "src_sha256": "3a252f84c6b3a8a575a56e3455968ffb33cdf0d317e78144f228a935b885a064",
  "zh": "嘶嘶！讓我們立刻趕往 Z'Ant ！必須趁太遲之前告訴他和平的事。嘶！"
 },
 {
  "id": 73,
  "src_sha256": "c6329e834e3c072c33e2f1f2806482cf0c6f3d52f4226b8933bfb25f8af9209a",
  "zh": "嘶嘶！！我們在這裡有什麼事要辦？嘶！和平近在眼前！繼續我們的任務！！"
 },
 {
  "id": 74,
  "src_sha256": "d7d5413e875085e197ad9594dd4f6d62598a50af67f21ed567ccec3f03c082ea",
  "zh": "嘶嘶！！ Rodan ！帶路！！嘶！"
 },
 {
  "id": 75,
  "src_sha256": "bbf9afacce7af62d75614307b7f2523bc5bfbec1ea4739542229ea4f05c761f5",
  "zh": "蠢貨！這是 Rapax 的家！他們也是這場陰謀的一份子！別進去，我堅持你們聽我的！"
 },
 {
  "id": 76,
  "src_sha256": "c4e7f1ba5b94b302af0b0384fcd7360cdf3bb39a858fc57bdadd5e2a19fcfa34",
  "zh": "嘶嘶！你們為何一再耽擱我們的任務！它比你們任何瑣碎的計畫都重要……"
 },
 {
  "id": 77,
  "src_sha256": "bd9b83213bde3d693b6ba5c97d37cd2155ec37317e1ad38a5cffbc6d75223a47",
  "zh": "嘶！你們快到 Bayjin 了！我求你們帶我們回到我們的指揮官身邊！這份和平的可能性不會永遠存在！"
 },
 {
  "id": 78,
  "src_sha256": "f3ccab4c002682a75b0a5d07de26651928eb17554f0358c52d38ab50df1e0636",
  "zh": "嘶！看路啊蠢貨！這是通往 Ascension Peak 的路！拜託，聽我們說！立刻帶我們去見指揮官……否則偉大 T'Rang 帝國的威勢將降臨在你們頭上！"
 },
 {
  "id": 80,
  "src_sha256": "971308e2b90b976edfb355b2f82654d9540cf22a075d5a3126954ab71cc566b0",
  "zh": "我們的前哨就在這附近。嘶！"
 },
 {
  "id": 81,
  "src_sha256": "2ddf37cc46e2a3dfe69c846f9445f9322adb47be089e61e211bddffdd606c298",
  "zh": "嘶嘶！你們要回 Rapax 營地了！我們會被再次抓住！嘶！立刻離開這個地方！！！"
 },
 {
  "id": 82,
  "src_sha256": "2d4e0939edb0985aacf9ad97156d79b30b1433e265a7e8e9a0c6e89c6aea7c61",
  "zh": "嘶嘶！我再也無法容忍！嘶！你們冒犯了 T'Rang 帝國！我離開你們！"
 },
 {
  "id": 83,
  "src_sha256": "c8e30bd8a405300ad9ac43b50344bebb11255b8ad6f45354ab5cd721feb1c1f3",
  "zh": "嘶！這一帶太危險，我不能獨自行動！！"
 },
 {
  "id": 84,
  "src_sha256": "7b186142cfb1e84639b88e6e6e5a7f529b6ca5defa059489d8d3205696be771f",
  "zh": "嘶！還是有哪裡不對勁！我想這可能是致命的！"
 },
 {
  "id": 85,
  "src_sha256": "e873e230ef21e3221679a9428a3666b2cc9b6f1855fd1789554f0a90350be683",
  "zh": "嘶……病已經過去了。"
 },
 {
  "id": 86,
  "src_sha256": "ca206bc106f4132691afab69b9e51dd229d483e387d79fa67c54903697716fa1",
  "zh": "嘶！你們竟敢帶我來這裡？這也是你們計畫的一部分嗎？！我要求立刻離開！"
 },
 {
  "id": 87,
  "src_sha256": "b34a7b3b85f39e6615675fa833bcc749bcafda04335cfe57c356fed89538b011",
  "zh": "讓我們立刻離開這裡！"
 },
 {
  "id": 88,
  "src_sha256": "4f9557a8ecb14506fd67b69bb67701f176fe3122c43ac6cf9e8d75d4cb99ed0e",
  "zh": "我幾乎希望自己還待在那個籠子裡……"
 },
 {
  "id": 90,
  "src_sha256": "9bc6d7591a6d48c28eb1ad0ea3d34ad3e90c41f2474e141563cf6010aefc1414",
  "zh": "嘶！你們這些蠢貨！沒有 Rodan ，這趟任務絕不會成功！你們最後一次侮辱了 T'Rang 帝國！就讓我們持續的戰爭壓在你們良心上，直到你們可悲的餘生結束！"
 },
 {
  "id": 91,
  "src_sha256": "80a8f3dfe1c1a70658579bf917fcf042b9711c31afca45251a0b3b7c5e77d3f0",
  "zh": "嘶！你這愚蠢的將軍！你以為我為什麼獨自、手無寸鐵進你的營地？若 T'Rang 打算入侵，我可以向你保證，絕不會是這副模樣！我們說的是實話……要麼團結起來對抗 Dark Savant ，要麼必定被消滅！嘶！"
 },
 {
  "id": 92,
  "src_sha256": "8e16508af3df797f65b585708244f45fb6d73f52e43fd28fcf78cc215e9cec7f",
  "zh": "給我們你的承諾！拜託……"
 },
 {
  "id": 93,
  "src_sha256": "75aa95598a19a48eaecc7c0ed0fbf46899667f17656122cfb142daa1499f2c61",
  "zh": "是的……我們有。這是我領袖的協議。"
 },
 {
  "id": 95,
  "src_sha256": "7937d22df7936c412f5ec6581784811333887b6a216b4cf3a2e2bbf67ba94cda",
  "zh": "去 Ascension Peak ……他已一無所有……他所有的計畫都毀了，他的船四分五裂。將軍，如果他還活著，就會在那裡……"
 },
 {
  "id": 96,
  "src_sha256": "f4d7962a1d451a232edbd060777434ae4582a0e377d3479fc517bf46d92b694f",
  "zh": "Z'Ant ……你必須……"
 },
 {
  "id": 97,
  "src_sha256": "f5186ad777a51d7e636e7504c03a03c6c0250963b0f64e051aa02213ddacacf0",
  "zh": "而那正是我們帶來的東西。多日前，你派我去 Umpani 營地找出其中的叛徒，我辦到了。嘶！但回程途中，我被 Rapax 抓走……而且無法逃脫……"
 },
 {
  "id": 98,
  "src_sha256": "1a237e344dc4a07d567caaaee456354a1ff8f1eb95ae2c185d88c4e9ae2af13f",
  "zh": "嘶！ Z'Ant ，你必須聽，否則你也會死！你說要殺 Dark Savant ，卻對我要說的毫無興趣，而我說的正是那個人！"
 },
 {
  "id": 99,
  "src_sha256": "1b3d24f5378f99ac2ea7d9cad0448c8529b0d473c6852ce7429a1b684716c7a3",
  "zh": "一分鐘……然後你自會願意聽。 Rapax 把我關起來時，把我放在一個 Umpani 隔壁的牢房。我打算殺了他。那天夜裡我醒著等那個 Umpani 睡著，卻聽見一個 Rapax 在說話，還看見它們之中有個披斗篷的身影……"
 },
 {
  "id": 100,
  "src_sha256": "de722bf57adf6a5976f813d723fa1c1010d49a1bbc4c75f0d6038a3eb2a092e9",
  "zh": "那就是 Dark Savant 。我仔細聽，聽見了最駭人的事： Dark Savant 與 Rapax 已結盟要毀滅我們兩族……而你和我一樣清楚， Z'Ant ，他們確實辦得到……除非我們聯手……"
 },
 {
  "id": 101,
  "src_sha256": "7889813b8dc9b2446e0c33d17668599825303dd35284708ccebe64aeebf58d3a",
  "zh": "但你會的， Z'Ant ……我們聯手就能毀掉 Dark Savant ！聽我說！嘶！ Umpani 擁有一門砲，能把他的船從天上轟下來，只要他們知道船在哪裡……而 Z'Ant ，我們「有」那個答案！我們聯手就辦得到！"
 },
 {
  "id": 102,
  "src_sha256": "99ebdb078f68b0c3e5f902f041a231cd7a07e9fd2d2a1a61b09dd4fb10f8f5ae",
  "zh": "Rodan 相信他的領袖願意……只要我們能讓你同意……"
 },
 {
  "id": 103,
  "src_sha256": "cfbf294b9a67accad0e7914d26b5d01c1127c538721c5d48edeb5eebc714886c",
  "zh": "或許你會的。 Umpani 將軍已經同意了……"
 },
 {
  "id": 104,
  "src_sha256": "f199fd71a2318107b8aefabaaa1bca4d13d9a49761e2f55cc7dd88b476c64110",
  "zh": "這將是我們最偉大的一天！ Dark Savant 將永遠記得我們聯軍的實力！"
 },
 {
  "id": 105,
  "src_sha256": "36aa5da2caafe7a7914a93ec653649bca644bbcd5c74c57832fa6f03fcead5cc",
  "zh": "嘶！蠢貨！你們怎麼能忘了 RODAN ！！沒有他我不走。"
 },
 {
  "id": 106,
  "src_sha256": "443fe7a5c48e4ae8e35a644174ed32114fcb9b68d6bab398405f8c6a835bf3bc",
  "zh": "嘶嘶嘶！你們這些愚蠢的生物！ Umpani 與偉大 T'Rang 帝國之間的戰爭現在永遠不會結束了！和平明明就在你們手中！ Rodan 和我走了這麼遠，竟被你們欺騙！"
 },
 {
  "id": 107,
  "src_sha256": "099de50a84c2a763a42be20a8c211767bad0709bde7a7bb12bf857591d6192fa",
  "zh": "嘶！把你們的手從我的東西上拿開！"
 },
 {
  "id": 108,
  "src_sha256": "b2224fbb7aa4f9e6a7c05187abea0816ab8f1005848033b24219787a4fc0040d",
  "zh": "嘶！我要與 Rodan 一起離開。我寧可與他一同丟了性命，也不願與你們一起丟了榮譽！"
 },
 {
  "id": 109,
  "src_sha256": "466a49b6d9636a6a73238413c7bbe96c28d925d3437ea35e8343dec15270b945",
  "zh": "蠢貨！你們不配這趟任務！"
 },
 {
  "id": 110,
  "src_sha256": "891c1329bd2d843c10d75f2570325ade4d819efe7bef98ae1af098bdcd8ad3fa",
  "zh": "你們做了什麼？！你們毀了那艘船！現在我們永遠無法達成和平了！"
 },
 {
  "id": 112,
  "src_sha256": "4625ee5dc907f1dc703f7a94593b1cb13fe3cd0559e76d4263fccb3438300281",
  "zh": "嘶！我說過我不會進入這個區域！"
 },
 {
  "id": 113,
  "src_sha256": "7b8e877ee5383c6431bc4e642bff4cbf8edf996393b3976e7ad71abd20077725",
  "zh": "嘶！讓我們招募 Rodan 然後立刻離開這裡！"
 },
 {
  "id": 114,
  "src_sha256": "cfb52827432fadcb2375c72eb591bd4e6e69c2c843e32ec4b7caa8deadaabb6c",
  "zh": "是的， Rodan ，你的領袖正如你所說的那樣……"
 },
 {
  "id": 115,
  "src_sha256": "d1bddd819b9f7d327c85c1169cc2348e88e88526e9f73dfbf961db99a02dcac9",
  "zh": "Z'Ant 值得信任……"
 },
 {
  "id": 120,
  "src_sha256": "a8f3fb488d10b071da3d7a55182d183d8632b715a737e7dc22d82cad635fe7dd",
  "zh": "我倒覺得他死了更好看！"
 },
 {
  "id": 123,
  "src_sha256": "c0225cda3e9d599a42eacd5db77fd9d8c8d6ebf12faabd09c838d8e366aa8d7a",
  "zh": "這能有什麼用？"
 },
 {
  "id": 124,
  "src_sha256": "315225fe56ef0ffdd35ced28455895946f275de3582ed57f03c91dd9a8befdca",
  "zh": "她活該！她竟敢挑戰 T'Rang 帝國！"
 },
 {
  "id": 125,
  "src_sha256": "4c244f09c7ea30c46df5777425658a627d6900f3ee9f62a616467b1df8ad8d96",
  "zh": "是的！等我們取得 Destinae Dominus 後，這件物品會對我們有幫助！"
 }
]

[
 {
  "id": 2,
  "src_sha256": "7de3378d7af3dfdd0e2b8a8bca0ab46c94642067899fb4624da22941056069b5",
  "zh": "想活命的話……就滾！你們不准待在這裡。"
 },
 {
  "id": 3,
  "src_sha256": "9c0f0b6606dbc05fc33ed522b00f1f04798dc882ada327605f3d45a52a0a169e",
  "zh": "再往前一步，我就殺了你們。這裡不歡迎你們。"
 },
 {
  "id": 4,
  "src_sha256": "f8a504084629d9940c764739e67c5b86f81629a1f13cf0b4fa69d9d3369b7f75",
  "zh": "現在就回頭，否則我只好親手把你們趕回去！"
 },
 {
  "id": 5,
  "src_sha256": "6adbf63e7ba1a778e22e265b654f8c9954228b96958548d30fe838c957bb8b80",
  "zh": "你們以為潛進這裡很聰明嗎？再想想吧！"
 },
 {
  "id": 6,
  "src_sha256": "43b1e264dc45c9fff05e6d87403408d2b5b2d02196c27be65843553d2eb947ad",
  "zh": "所有未經許可闖入的人，都注定要死！"
 },
 {
  "id": 7,
  "src_sha256": "8b1c1a780e44f64c698da04405fc32c3b4bd6a744cb3e1ea623f393182d458a4",
  "zh": "你們或許活著來到了這裡，但你們不會活著離開！"
 },
 {
  "id": 8,
  "src_sha256": "acfef2172f76e9c644f6fe91d4e94f1004fe0323d57b33ddf3f9ffbeb29b97df",
  "zh": "是你們先惹的。由你們來收尾！"
 }
]

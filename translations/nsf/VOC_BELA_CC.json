[
 {
  "id": 0,
  "src_sha256": "2dca56ce37e31c01a64e841a13c09ee211c503835493f0f53c4c69df4b56b0d1",
  "zh": "Cosmic Forge ！這是我們唯一的希望。憑它的威力，已發生的事或許能被抹去。快！"
 },
 {
  "id": 1,
  "src_sha256": "60df5324338f68784c594dbb4e57aef0e10f6fa8ab5062ec40e189d3d604bdca",
  "zh": "凡是用這座 Forge 寫下的，都會成真。只要改寫那本書，我們就能消滅 Dark Savant ！"
 },
 {
  "id": 2,
  "src_sha256": "c18343d8aba5bcb3d5219437c41e39c13866a786a21c04c7110f7ef31c71b6f9",
  "zh": "放逐公告\n\n因濫用權力並屢次違抗我們的意願，我們，Cosmic Lords ，特此放逐並驅逐……"
 },
 {
  "id": 3,
  "src_sha256": "19f37c155fbf74d705febe35679f013174afc42f527d6d5ab3a41dcec8644fb0",
  "zh": "你們還來不及消化這一切，Bela 便向前一步，眼中浮現恍然大悟的神情……"
 },
 {
  "id": 4,
  "src_sha256": "d858333a1cc247cc74b805555b2ac1e0236f9f9f1a80e8c92c2c4197eabf7f4a",
  "zh": "所以是真的。他是……他曾經是……Phoonzang 。"
 },
 {
  "id": 6,
  "src_sha256": "a3f0ebedc107f32a32ed71bef36ab3bcd33c76d6526bcf5b388cc145becc47e3",
  "zh": "他指的是 Vi ……她的家族一直被稱為「鑰匙守護者」。她從沒真正當一回事，但後來……"
 },
 {
  "id": 8,
  "src_sha256": "faf9e5f5f8a5b104c05fd4f4e57e11566bb784941fadc9665e6d7b1ad04d7932",
  "zh": "想想她和數百萬人曾崇敬 Phoonzang 以及他所代表的一切。卻不知道他後來變成了什麼……"
 },
 {
  "id": 9,
  "src_sha256": "a7a323bee8482235545400b7a18120f8d1584a2048709f1d56c1414973fb8f86",
  "zh": "那「就是」 Phoonzang ！"
 },
 {
  "id": 10,
  "src_sha256": "e94d3b7225f9e5e31daed81ab792d48649a37a94198cf042779afece6242fd90",
  "zh": "過去已被抹消。少了那一頁， Phoonzang 從未被放逐！ Dark Savant 從未誕生！"
 }
]

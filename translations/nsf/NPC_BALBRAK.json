[
 {
  "id": 2,
  "src_sha256": "a832e3344780e46b3212d2554c0c38bc23e8e3e6fa05c42fb1e7d2bd85281450",
  "zh": "還以為你們早就死在外頭了。"
 },
 {
  "id": 3,
  "src_sha256": "7df410585761a24203b671c4999080376d2640aa5713320df81b6047de172cd3",
  "zh": "滾遠點，一群廢物。"
 },
 {
  "id": 6,
  "src_sha256": "5a0ca9ccddc988eb1ade2f808eaed8de4382387dc324761646f2e3389a7cec5b",
  "zh": "你們以為你們是誰啊！"
 },
 {
  "id": 7,
  "src_sha256": "2504624b96f7aee7a7e9b9be435d82f9516ae2c1e7807c091ffe92bb615bb18b",
  "zh": "我看起來像是特價品嗎？哼！"
 },
 {
  "id": 8,
  "src_sha256": "d0bf3efc5c8aa51f99f6bc8ec9a91b63266d9943784305221f32f914f053c3c2",
  "zh": "等塵埃落定再說！"
 },
 {
  "id": 9,
  "src_sha256": "c40aae0dcb37cb027120f4b97e2de0a884a06b2d2d6e510f1401605c03ffb736",
  "zh": "那是我的工作，廢物！這裡的招募全歸我管！"
 },
 {
  "id": 12,
  "src_sha256": "7de47477020e10c42b50f46f78f970abc10cf519de169363e00838517da773e1",
  "zh": "哎呀，哎呀。"
 },
 {
  "id": 13,
  "src_sha256": "ddb19c6950a009c31789b41aa8583371e1792f15a9934c686d5ee4775eabd864",
  "zh": "不用了，謝謝。"
 },
 {
  "id": 14,
  "src_sha256": "91a766aa19b1834f774f08d619e227dd6bb12748106b8741c505448f012f61e6",
  "zh": "這值多少啊？"
 },
 {
  "id": 15,
  "src_sha256": "e9427b0d0096395b0f2d4da3d41739fec124934ef7d16ecb741fd98628df9700",
  "zh": "看來得等下次發餉了。我再也付不起了。"
 },
 {
  "id": 16,
  "src_sha256": "c838fd4dd1e0a93e2ad473b4a7b613a92b4a0cb7b9ea3fc733341791112129a6",
  "zh": "這樣不夠，廢物！"
 },
 {
  "id": 17,
  "src_sha256": "ba1c8454960a3a387f3eb65f100dc22f1d6b20ab4f6893afdd83e157f85242c1",
  "zh": "我以前也有一個一模一樣的……"
 },
 {
  "id": 18,
  "src_sha256": "b215d3f650fc439618c0ba19587bd1c9e73b64ce127b9d6dcdf776c91646741e",
  "zh": "你們需要好好管教一下，廢物！軍人才不是這種德行。"
 },
 {
  "id": 19,
  "src_sha256": "309977117df22637b5bfb9afde13ff0f05fe4eb4b9c77fad88ef67e1c555b49a",
  "zh": "我不敢相信！我真該把你的手扯下來！"
 },
 {
  "id": 20,
  "src_sha256": "ed9e8f2f29a86d9f50407c5aee46c8c59bcc685574addee84b48cf001368ae43",
  "zh": "廢物！我要把你們碾進土裡，直到只剩一灘肥油油的污漬！"
 },
 {
  "id": 21,
  "src_sha256": "0ab4f3241b24180132bf381f4a8e599b0774279be6f07c5533bc0248131d3ec4",
  "zh": "謝謝。我會確保這筆捐款送進 IUF 的金庫。"
 },
 {
  "id": 22,
  "src_sha256": "3e1f8a3d9f09b91f5ab8a7e9f3bd27a955a871975e852eee94c8c0d628f10f00",
  "zh": "聽著，我還有事要忙……"
 },
 {
  "id": 23,
  "src_sha256": "2d47ddad5d50174feb399beeb23de2f26c2c8b12a14e723183e236148bddb973",
  "zh": "這件事去查查 EWAXX 吧，大兵。"
 },
 {
  "id": 24,
  "src_sha256": "4561aa8abf941133aaa382074fa6a5e40a7fa631437555728b7c7f7e7b000d96",
  "zh": "先把你們的安全（ security ）等級弄高一點，也許我們再談。"
 },
 {
  "id": 25,
  "src_sha256": "9188f9d119d69afdc9d333a98fb720d8f40fa48068980c6f12b9f77e8e47fa4e",
  "zh": "喂，爛腦袋！我說過……"
 },
 {
  "id": 26,
  "src_sha256": "3f438dcebc622ef22ec3d1b9a8fe1c5700889b3b77f577895e3c079708721b01",
  "zh": "你們想先知道什麼？"
 },
 {
  "id": 27,
  "src_sha256": "b6bf2d098db57db4b72540d12c23dd841b08fc05ede44c7df3af4086d1ec6fe0",
  "zh": "另一件事也挺有意思的……"
 },
 {
  "id": 28,
  "src_sha256": "fe952179d4f7b8b3116bd84f88980a8e9b0c1413b173097cc159a37cf66a3c69",
  "zh": "誰會想得到……"
 },
 {
  "id": 29,
  "src_sha256": "e04e0b64bbca1b1aeb51c6647f3529fedbdd0c05699ecf6486dd87c124d17642",
  "zh": "我這邊還有一堆表格要填……"
 },
 {
  "id": 30,
  "src_sha256": "9d39fd0d32f398cffa74a67da903858f99517238554fefd7b4e5f392b0cb6dd2",
  "zh": "你們的任務還在等著，我可不想耽誤你們。"
 },
 {
  "id": 31,
  "src_sha256": "b8ef0b75975d7268765494616833619e9c04f7fcf297001dbb926ac646d7a9ae",
  "zh": "本人正是。總算把地面任務搞定了。這是顆大星球！我想我們的部隊得花上一陣子才探得完。"
 },
 {
  "id": 32,
  "src_sha256": "6fc36c54887115709838c1116916b900e55a17a92014c1d3c8591a0e95d9344a",
  "zh": "就在這裡的東邊。我們在那一帶做過紮實的斥候（ Recon ），除了一些，呃，令人不安的存在之外，當地人似乎挺和善的。"
 },
 {
  "id": 34,
  "src_sha256": "204d25392d04a6e97f6a45879003ac30b9b2d1e83ff70033cb4277dfca62dab0",
  "zh": "這事去問 Sparkle 吧。她就是那裡來的。"
 },
 {
  "id": 35,
  "src_sha256": "8d08cb9913ad05709394968ce2de718946a29d7eb8ecec5f042380660d12a2e1",
  "zh": "我們派了一位最好的追蹤者（ tracker ）去那裡執行任務……"
 },
 {
  "id": 36,
  "src_sha256": "8d08cb9913ad05709394968ce2de718946a29d7eb8ecec5f042380660d12a2e1",
  "zh": "我們派了一位最好的追蹤者（ tracker ）去那裡執行任務……"
 },
 {
  "id": 37,
  "src_sha256": "9d16d9a7a22075f672a63685f29f0dc60c3c61d5bbab9df0881ae7726c30131b",
  "zh": "對，她是座不錯的堡壘。比我們在 Guardia 的那座強太多了……"
 },
 {
  "id": 38,
  "src_sha256": "1fa6dfe34c5450e1c04857fb0e6a65dc30f52ad1ad7add3e9714bd57d359be65",
  "zh": "我們的斥候（ Recon ）遍布那一帶！"
 },
 {
  "id": 40,
  "src_sha256": "170f6e9790ab997383606aca1c5db6f678ce1dfd223b5a2b76ca730651b3319e",
  "zh": "Ascension Peak ？嗯，我知道。那簡直就在隔壁。不過沒什麼好擔心的。至少斥候（ Recon ）那邊沒給過我任何理由往壞處想。"
 },
 {
  "id": 41,
  "src_sha256": "be8485332f8954e3f6d3dda9736379f3bf50033745b869829112449e425a25c2",
  "zh": "我們所知不多。遲早會派斥候（ Recon ）過去。"
 },
 {
  "id": 43,
  "src_sha256": "75883650faf9cba6cd45b731c0f019f2b53a007af4c788df8ec0e02123e7a4a3",
  "zh": "你們說 Arnika 那群傢伙？安全（ security ）風險第 5 級，低。沒什麼好擔心的。"
 },
 {
  "id": 44,
  "src_sha256": "0077b137370108f135fecb9052d31615abd8976dd1d0f2ff1d5a694d7556ed37",
  "zh": "可憐的小傢伙們。跟 Rapax 打了一輩子的仗（ war ），還是撐著不倒。那才叫勇氣。"
 },
 {
  "id": 45,
  "src_sha256": "421d3fd2be5b26f0829df22e61c6a79e4b8e2c2657b05ef77ead74df7524710b",
  "zh": "安全（ security ）風險第 1 級。斥候（ Recon ）告訴我們，牠們只對殺戮有興趣，就這樣而已。"
 },
 {
  "id": 46,
  "src_sha256": "0ba8b1c2b6e79958121ef3f62483c8188da50d85b7fd1b9d6e1df2243d0df3c2",
  "zh": "Umpani 帝國聯邦，沒錯！"
 },
 {
  "id": 47,
  "src_sha256": "3a18cb993b3418886dc98da12fde2e1d8cac24349b3fc9e08358e5e0ae53e7ac",
  "zh": "黏答答的臭蟲！通通給我剷光！"
 },
 {
  "id": 48,
  "src_sha256": "2e0a99a6cf08b55a0491e22116129a37af82882ec045fbcb55ce7c831bc5b979",
  "zh": "Helazoid ？哼！你們從哪聽來的？那是 Guardia 那邊的事。舊任務了，弟兄們。"
 },
 {
  "id": 50,
  "src_sha256": "8eff9e8ed55e90daece3cc3ace57a837d4220346c993abe886d970876e862802",
  "zh": "Rattkin ？拜託，弟兄們！給我專心在眼前這顆星球好嗎？那是 Guardia 的舊任務！這裡沒有 Rattkin ！"
 },
 {
  "id": 51,
  "src_sha256": "64654ce7d7f53c858d484194973354035e583b701602324dd0911b63715d4008",
  "zh": "Mook ？我想他們不會對我們造成什麼麻煩。"
 },
 {
  "id": 52,
  "src_sha256": "40a731a1dd704ebb261f6c5125864c22435de865ff9a7c5ae6d572c721b0a222",
  "zh": "我只認得 Uhrinna 一個。"
 },
 {
  "id": 53,
  "src_sha256": "18501ab2a5c3efdc87d3a5f8604e363d589ce86cb032408587143c03ab2eae0f",
  "zh": "舊任務了，小鬼們。你們得向前看！別跟我說你們得了什麼創傷後壓力症，因為這裡唯一的心理輔導就在 Roadhouse 裡！"
 },
 {
  "id": 54,
  "src_sha256": "6e77ff23678e06deff75d8aec0463246cae9d8b2f52e4661dbb0f906c530e9f0",
  "zh": "Dark Savant ……關於他有什麼是我不知道的？！他就是我們降落在這顆星球的原因。他把 Astral Dominae 從我們眼皮底下搶走了！"
 },
 {
  "id": 55,
  "src_sha256": "b2aa6b5e48088b1ab12f6d4fa32c7cb48ca03e217762f1f923ed5f1bb3636497",
  "zh": "你們要提防那個女孩……"
 },
 {
  "id": 56,
  "src_sha256": "f9197356e59f34a42d6f3f6ea93b29f152fdacb7338792f747356f312c16a51a",
  "zh": "幹嘛問我？她就在那裡啊。"
 },
 {
  "id": 57,
  "src_sha256": "d060f0c4f4a364122f3553490c22fa19821b6dc96e0f0e965c7e296e62720197",
  "zh": "有人說那只是 Uhrinna 的另一個名字。"
 },
 {
  "id": 58,
  "src_sha256": "9afd730e1633ef9ab2d83c48eb35fff396ab28be8f5179451e1498bf790a5796",
  "zh": "除了斥候（ Recon ）傳回來的消息，我所知不多。大概是某種瘋狂的 Higardi 吧。"
 },
 {
  "id": 59,
  "src_sha256": "0088936418d110f9142bcc036471343b0bd02f95a38685169fe631c0366f6314",
  "zh": "Bela ，當然，我認識他。你們只需要知道這樣就夠了。"
 },
 {
  "id": 60,
  "src_sha256": "0c51dbecc763e358cc8a3f649013808cd31459308b571b2cf06d33506fe657aa",
  "zh": "你們見到將軍的時候，可以自己去問他。"
 },
 {
  "id": 65,
  "src_sha256": "a91e594ceec341a2bf64223ab95fa358a389865623e3bac174fec28fbad688e1",
  "zh": "Podheads 的莢（ Pod ）。"
 },
 {
  "id": 66,
  "src_sha256": "35cc6871ee770bdefe881a5043a61ae288701f2acabb646d19b9f95a93fd6a15",
  "zh": "沒想到還會再聽到那個名字……"
 },
 {
  "id": 71,
  "src_sha256": "d0fe5a6e89b8e1fa42d9f531238e24e74fed543a56943112b452863198318231",
  "zh": "我只聽過一兩句，大兵。你們最好豎起耳朵。去問問 Higardi 。"
 },
 {
  "id": 72,
  "src_sha256": "edc29765a98f5bd09fae39fd76db5e8146c3f3a21269481f2b24f8c785dbc394",
  "zh": "我對你們的故事沒興趣，笨蛋，我也不會跟你們說我的！"
 },
 {
  "id": 73,
  "src_sha256": "87ca023f03c4133c2b4a56438251f954cb789cf0ad6f4771eb0428d119695fbb",
  "zh": "是 Sgt. Balbrak ，小卒！"
 },
 {
  "id": 75,
  "src_sha256": "60805a6296fc070166e5f6205468369a09e4f285cb4c074a3b8b6a7c3d578b67",
  "zh": "閉嘴，廢物！"
 },
 {
  "id": 76,
  "src_sha256": "36a4d4bf729d29c750581f38ef5be9df5e73df4ad7f8555b4059ec0d5d527c24",
  "zh": "我今天不接受點播。"
 },
 {
  "id": 77,
  "src_sha256": "0bdb03310cc21fe9683f5f1ddf7d7151913009939a4ce82599d518843d5696a2",
  "zh": "嗯，你好啊。"
 },
 {
  "id": 78,
  "src_sha256": "bc3c62acba8f1f7213da27ab11a3ca2ccf01276aa4cccbbb9ef57e25e1c9bee6",
  "zh": "好吧，小鬼們。"
 },
 {
  "id": 79,
  "src_sha256": "a58b411d636b3d70a7d3a0dbf412f1b87510464d42f308067abb128ce004d93d",
  "zh": "幫忙（ help ）？我是個招募官。我們可不是以幫忙出名的。"
 },
 {
  "id": 80,
  "src_sha256": "7154069fb968fae472000e5c5be56c2a396077f43ef1ad9ed07a5c7e01f5a405",
  "zh": "你們顯然把我當成軍需部（ Commissary ）了。"
 },
 {
  "id": 81,
  "src_sha256": "eec62534703982582aae7d99de9659776a617d50f6abc8152e309cf2afb95de4",
  "zh": "很難說，弟兄們，很難說。我的表現永遠取決於上一次任務。"
 },
 {
  "id": 82,
  "src_sha256": "e914dd11aff02b26397d3ad3e5c1eea07cd08ee6b2282d0bd9250902be247ebc",
  "zh": "喔，我這裡可沒有那種東西。"
 },
 {
  "id": 83,
  "src_sha256": "349c0e399f536cf36c25f4378d48cab591ea9ac63807cef8533d522a11f98302",
  "zh": "那是我的事！"
 },
 {
  "id": 84,
  "src_sha256": "48751498150a71748b6137140236f11fc35e8bcfe27b6ea660a158a54905a90b",
  "zh": "一堆破銅爛鐵……"
 },
 {
  "id": 85,
  "src_sha256": "fa585e9eca324e2c5e23c19c0f258e992c913dea5460e224b81fd4d7393c68ea",
  "zh": "多漂亮的船！我真想把它收進我們的艦隊！"
 },
 {
  "id": 86,
  "src_sha256": "e8f2fb92e43da92a5aff1431f5c34c5fd601a5c36d2e5810cbd917da50a2e323",
  "zh": "全宇宙再也找不到更棒的船了。"
 },
 {
  "id": 87,
  "src_sha256": "3764f458a28ffca2cb94876d6c8d4f5683cb82a8de93fc429b9c178859bff9e8",
  "zh": "我想我該指派個人去查查那些針對那名士兵的指控，可是我就是沒有半點證據。"
 },
 {
  "id": 88,
  "src_sha256": "f4d027a4d5024afe4af93f880ff7d265b233af64b982ea48f859b961e48af2c1",
  "zh": "Rodan 那傢伙死哪去了？他兩天前就該回來了！我有種感覺，他跟那些 Rapax 脫不了關係……"
 },
 {
  "id": 90,
  "src_sha256": "baca9a79410cdb54af35fbc0483842985f6960a316ee9d927984ca01302149df",
  "zh": "你們說的是 Arnika 。"
 },
 {
  "id": 91,
  "src_sha256": "bdd3cc7395cb820b70e4884cf5a8138b719e5d05323f1c61cde1763127959322",
  "zh": "那是 Trynton ，大兵。"
 },
 {
  "id": 92,
  "src_sha256": "1d8775e78a1420ae47027d826d931489e5d10deca24fc47276a83d06913a1dfd",
  "zh": "我聽說 Trynton 過去有一片沼澤。"
 },
 {
  "id": 93,
  "src_sha256": "3edc63d9ebf3fd6229c0db117e8221c667231d8747549f3494286557807a7a19",
  "zh": "Marten's Bluff 。從這裡走得到。你們得先往西南走到 Arnika ，再往南穿過 Trynton 。接著穿過沼澤，應該就能到 Marten's Bluff 了。"
 },
 {
  "id": 94,
  "src_sha256": "aaa35106ea2b4800e554598a4e69d318cbf17f52af65ec6e5e208e5a26bacdba",
  "zh": "我猜那是 Rapax Away Camp 。斥候（ Recon ）之前回報過。不過我不知道在哪。"
 },
 {
  "id": 95,
  "src_sha256": "e9cfec37dc3276557f69fd1c83f2b167b24f5e9ef5c535e939bd4fd32856d8a9",
  "zh": "就在這裡，大兵！"
 },
 {
  "id": 96,
  "src_sha256": "d5329aa9d1b56386387849ee806fbbb919ef60b3a1404ff1beeba2c7a321cb45",
  "zh": "我確實聽說過這裡西邊靠海有些洞穴。"
 },
 {
  "id": 97,
  "src_sha256": "e16f1feadc0888771c6ab508e2d05676c0ffab3d7ea79d1a1882d7fd12da246c",
  "zh": "那是 Rapax Rift ……不過我可不會去那裡。"
 },
 {
  "id": 98,
  "src_sha256": "8c19cb13d489b87597c319c059de03ef931241fe60a6bd30b9999fd24b17604c",
  "zh": "我猜那是 Rapax Castle 。"
 },
 {
  "id": 99,
  "src_sha256": "cc623cc7c8b119dfd8b875f6ddbbc013d50d0cf165ab8dc2428ce70b928e1e92",
  "zh": "喔，對。 Ascension Peak 。"
 },
 {
  "id": 100,
  "src_sha256": "8a6bc5d2ad12826a28290c2ece470e667e5df41f64ac53d0dd0b895166f369d9",
  "zh": "我不確定能不能信，不過聽說那是 Cosmic Circle 。"
 },
 {
  "id": 101,
  "src_sha256": "4dc2c2dc5801ebc44792c53dfc48c7a20bf8b060ad3ae998e77a370393d28f32",
  "zh": "喂，有人在家嗎？"
 },
 {
  "id": 102,
  "src_sha256": "8793f8077251ddb26231bb07148bbff682bb90887eeff9be78b3e15462793187",
  "zh": "不知道，弟兄們。"
 },
 {
  "id": 103,
  "src_sha256": "bdc463f2835fdf2ca33c8e9d3e388dcda4058ac806bb7e24319447738d9217ca",
  "zh": "這件事去問 Bayjin 吧，弟兄們。"
 },
 {
  "id": 104,
  "src_sha256": "97b7731752255e0f4d7b2a475f661c6c2f1b63fe9c12313f8cff5e4d20f6c075",
  "zh": "真是驚險，弟兄們。很高興你們撐過來了。別擔心 Savant ，小鬼們！他很快就會得到報應！我們一得知他要去 Dominus ，就派了斥候隊來這裡設立基地營。"
 },
 {
  "id": 105,
  "src_sha256": "5964d9cb05dec08a90e654c13622325a20c5041b230ae11db38a5c168aa38ee7",
  "zh": "我們知道他在打什麼主意，而且「這一次」我們打算贏他！嚴格說來，這些都不關你們的事。你們的服役期滿了，而且是光榮退伍的 Guardia 老兵。你們可以自由離開去探索。"
 },
 {
  "id": 106,
  "src_sha256": "fb07e885b1547e0c9755c6b173c327bbadd64eb5000a3ddda42865dfd22b53a7",
  "zh": "當然，你們也可以留在這裡跟老戰友們一起重新入伍（ re-enlist ），加入全星系最強的戰鬥部隊。怎麼選都隨你們。想再簽一期的話，到基地營（ Base Camp ）來找我就行。喔，還有，你們絕對想不到我們有什麼新裝備（ equipment ）！"
 },
 {
  "id": 107,
  "src_sha256": "95b3131756fdb7fafe340ec4012c92a780bb1193f38486c9cc60c7be2bd8f2bb",
  "zh": "眼下沒有任何事給你們，弟兄們。有變化我會通知你們。"
 },
 {
  "id": 109,
  "src_sha256": "1183e8fda485c3c46928ec49244d641919789cddedf95460455998cf64c39c81",
  "zh": "我可沒辦法盯著每一個人，你們知道的。"
 },
 {
  "id": 110,
  "src_sha256": "f1f7bb38e45438795d8d5cc906122a7278069094ea9b7a4c9836d6f924b23b2b",
  "zh": "正是我想見的一群蠢蛋！你們公然違反 IUF 的命令！我這輩子從沒見過這種事。你們完蛋了，小鬼們！聽見沒有？！？ "
 },
 {
  "id": 111,
  "src_sha256": "1bdf79ee86805c4f1429e359c8c502f3a2fd35f29cae5d33383980d5c26e6ac8",
  "zh": "你們在 IUF 的前途已經結束得徹徹底底，我寧可親手把你們這兩條可憐的屁股扛去給 T'Rang ！乾脆你們自己去加入他們算了？！這樣 IUF 就穩贏了。現在給我滾出辦公室，不然我把你們肥脖子做成筆筒！"
 },
 {
  "id": 112,
  "src_sha256": "41aab38cce4fcc52807f6962a4deafc87013d68a63f68bb0e16b2d536c7b1180",
  "zh": "想入伍（ enlist ）嗎？我還有個名額要補……"
 },
 {
  "id": 113,
  "src_sha256": "cb195a69f92d1229e4e8b77752c6168e41118e9c6bfd51d5bf6faca8b4559f28",
  "zh": "你們帶了什麼給我，小鬼們？"
 },
 {
  "id": 115,
  "src_sha256": "f537bebdb31037bef180bccc7ac69fcf8cdfdfb8dfbd4efaa8329a5b1644325d",
  "zh": "我欣賞你們的熱忱，不過簽一次就夠了！"
 },
 {
  "id": 116,
  "src_sha256": "c6df9a95b48cfa05419ee243d0a3086552c2861569f6c8234472e4c32446e5c3",
  "zh": "喔，你們到底對 Sparkle 做了什麼？不太耐操，是吧？我想過這可能會是個問題。唉，算了。我剛說到哪了？"
 },
 {
  "id": 117,
  "src_sha256": "ae4b77c102ebb42b8f6c5daf93cad8bba6316c1b04d958f8d3a4b801dc31a0ec",
  "zh": "嗯，那可是我們這趟任務的關鍵！讓我跟你們說個大概。幾年前我們差點就拿到那個裝置。可是 Dark Savant 搶先一步。所以我們一路追他到這裡。這次我們不會再冒任何風險。等我們把它拿回來？它就永遠是我們的了！"
 },
 {
  "id": 118,
  "src_sha256": "b64f082ce45ffeff8faa38134a1a67038ef6b282af8e8b1b33a28a6701f99cda",
  "zh": "我們對它又有了更多的了解。當然，你們已經知道 Astral Dominae 了。嗯，看來這個 Destinae Dominus 跟它有某種關聯，而且她背後也有一段有趣的故事。"
 },
 {
  "id": 119,
  "src_sha256": "c0ca0681e7c31e81be98644f55e6ed193406b4becc9f4f015fb8b912b5971b6f",
  "zh": "Higardi 守護它好多年，後來他們自己人把這該死的東西偷走了。這種事在 IUF 這種團結的部隊裡絕不可能發生，我告訴你們！直到今天，斥候（ Recon ）還是確認 Higardi 仍不知道它在哪！"
 },
 {
  "id": 120,
  "src_sha256": "5ec9c8e697ad866c8674b126ed78aa90d38a5900f863bc09965a2cbc8cd70de1",
  "zh": "嗯，我得告訴你們，小鬼們，它似乎是我們在這裡處理的那個大謎團的一部分。有風聲說它跟 Astral Dominae 和 Destinae Dominus 有關，不過我們還沒有確認。"
 },
 {
  "id": 121,
  "src_sha256": "2d72310207586d71d66c46b7e8641ccd09668d5ec585450ff5e0f61838e8d345",
  "zh": "既然現在東西已經在我們手上，大家就保持安靜，大兵。還有，小心點！"
 },
 {
  "id": 122,
  "src_sha256": "05e1a6ded29d6e9eb9962e0d53855983e795f1022db299b215c50b34c8508089",
  "zh": "好吧。要是你們之後改變主意，再回來找我。現在，恕我失陪，我有一大堆文書工作要處理。"
 },
 {
  "id": 123,
  "src_sha256": "5f8339b771f5680de7ce811e8ceafe706ee5066978c04639f0707bdbef73d56c",
  "zh": "很好！首先，當然，我得讓你們過一遍我們的高強度障礙訓練場，確認你們有那個本事。大兵 Sparkle 已經通過訓練場了，正準備接受我們的高強度 STF 訓練。"
 },
 {
  "id": 124,
  "src_sha256": "5e645d567b77cc89f79b831c71c82124802036e0ac4ca12c920a49c5aa0fa867",
  "zh": "STF 就是特種戰術部隊（ Special Tactical Forces ），專為我們在 Dominus 的任務所設計的訓練。所以，趕快去障礙訓練場找 Rubble ，完成後回來這裡報到。對了，你們會需要這張通行證（ pass ）……"
 },
 {
  "id": 125,
  "src_sha256": "69439e93ee859221dca62b6f4e2c331777c624a07abf3b78b38aa2e71a27760b",
  "zh": "我不知道他在哪。我派他去探查一處可能的 Rapax 營地……然後，什麼都沒有，從那之後音訊全無。要說我不擔心他是騙人的，不過他硬得像骨頭一樣……我相信他沒事。"
 },
 {
  "id": 126,
  "src_sha256": "e63ffe6f02121bc9b1f64a8382b32d38e53a301801002ccf3233fd7d918bdcc5",
  "zh": "我們會為所有 IUF 人員針對派出的任務進行訓練（ train ）。"
 },
 {
  "id": 127,
  "src_sha256": "2193665cb8087a904ac6b0cae434a256c4897a6ee12885bf857e1ec875bdf407",
  "zh": "Sparkle ？哎，她看起來也許不像個軍人，不過她很懂門道，而那正是我們最需要的。"
 },
 {
  "id": 128,
  "src_sha256": "5f804a21359b820cf85aaf5302150503f3fa201dea2c46b752a98c962f96d281",
  "zh": "嘿！你們還沒完成！別像娘娘腔一樣，快去跑障礙訓練場！"
 },
 {
  "id": 129,
  "src_sha256": "d51e265f01b25b6c33d0344555984eaa069b5a9cab9e50d4e63dfe0f69bb14cf",
  "zh": "跑完了，是吧？我想你們一定對自己印象深刻。哼，省省吧，廢物們！現在要來真的了，不是那種扮家家酒的訓練垃圾。 "
 },
 {
  "id": 130,
  "src_sha256": "0daba218822a23684eb9e37445591acf0e0b7ed582b5ca494532f03157ad937d",
  "zh": "我們需要你們去確認 T'Rang 出沒於 Marten's Bluff 的斥候（ Recon ）情報，就在這裡遙遠的南方。我需要一些證據。所以，給我帶點東西回來，任何百分之百 T'Rang 的東西。懂了嗎？出發！"
 },
 {
  "id": 131,
  "src_sha256": "91759e6874f61bb8db1b3940509edb21c6c9183d7e6376bcc63e3ca9b486cd19",
  "zh": "噁！你們自己留著吧！嗚……"
 },
 {
  "id": 132,
  "src_sha256": "fb2f46a2c7728333676f552d4e0044d2d13eb4dfd216846e9d0801e7d51b1fe1",
  "zh": "不過我以你們為榮！看來你們找到那些黏糊糊的傢伙了！我會馬上把這情報送交斥候（ Recon ）部門。在這期間，你們出去殺蟲的時候，這裡有了一些重要消息。我想你們已經聽過 Astral Dominae 的簡報了吧？"
 },
 {
  "id": 133,
  "src_sha256": "a6a48cb4400c75330a1568816c1b87b9ff8372cdb196181e95188f1538fc2ebf",
  "zh": "嗯，斥候（ Recon ）回報有兩件類似的物品。所以，把眼睛放亮點。我們希望你們能替我們拿下其中一件，不過在那之前，我們得先把你們訓練到最佳狀態。拿著這張通行證（ pass ）到哨站（ Sentry Booth ），然後到營區裡向 Sgt. Rubble 報到。"
 },
 {
  "id": 134,
  "src_sha256": "0903691557c2a186997b4342dd3931f024f5921c54239de65c6d46fc08ee86c2",
  "zh": "喔，還有，你們在軍需部（ Commissary ）也有一筆額度，可以去補給一下。好好訓練（ train ），小鬼們。最艱難的路還在前頭。"
 },
 {
  "id": 135,
  "src_sha256": "073e369e511d2676f49f38e111d9e4982fe623dcf33be9fac2189dc28c689271",
  "zh": "你們來了！我相信 Sgt. Rubble 已經教會你們怎麼分辨屁股和火箭筒了。如果有人擋在我們下一個任務的路上，這會派上用場。這是個大任務，小鬼們。對了，你們還記得我說過那兩件新裝置嗎？ "
 },
 {
  "id": 136,
  "src_sha256": "b01054de28d528a38ea8ff0aaed113f2ea433abc916ead933262028359eda371",
  "zh": "嗯，我們相信 Mook 可能持有其中一件。不過……我們暫時不打算動武。首先，我們要試試外交途徑。 Yamir 要你們把這封信直接送到 Arnika 的 Mook 營地。"
 },
 {
  "id": 137,
  "src_sha256": "dacc7dbce8c005e0e2fd52c3bc714ed1be1fd2bd31abc94a68ce81eb2cd526f9",
  "zh": "還有記住，這次「不准」動武。懂了嗎？很好。出發吧。我這裡還有一堆文書要處理……"
 },
 {
  "id": 138,
  "src_sha256": "b21c9ba893d86ce43418718e0e3e86a110489f8ff4df4f9812eb1a67b3824237",
  "zh": "嗯……讓我看看。對，對。喔，這會讓將軍很高興。"
 },
 {
  "id": 139,
  "src_sha256": "5ea06e5cb1693855b5780161b47bca60308428723f3ffe315ac53c76b0b07746",
  "zh": "哎呀，哎呀，各位。我得說，你們幹得漂亮。給我一秒鐘行嗎？"
 },
 {
  "id": 140,
  "src_sha256": "30458dffb95f3c741db613602532462c592d176535e8303cea3088379be0399b",
  "zh": "對，我是基地指揮部的 Sgt. Balbrak 。我的斥候（ Recon ）小隊剛回來。同盟已經談成了。"
 },
 {
  "id": 141,
  "src_sha256": "cf88f9a0c9181f09ff874c32084074ea6418bb35226c6191c61592b0321ad841",
  "zh": "收到。好了，弟兄們。你們升遷有望了！將軍要見你們。我也授權你們使用 EWAXX 。你們的帳號是 STORM ，密碼是 BIGBADMAMA ，連在一起一個字。 "
 },
 {
  "id": 142,
  "src_sha256": "a291ca0a6e8aa5e30b0cd0f4466d67d435de24dfa2aa3f2f51bd7ab254cba820",
  "zh": "現在，別在 EWAXX 上耗太久，因為將軍在等你們，而那個人「最」討厭被人等！待會見，弟兄們。恭喜！"
 },
 {
  "id": 143,
  "src_sha256": "8f54e17bc03bb9efba3ff7b40a1332ce49ee24a147f7997978069fb57efd925f",
  "zh": "喔……我的……天。你們……你們是怎麼拿到這個的？！？哇！除非總部另有指示，否則你們先自己收著。"
 },
 {
  "id": 144,
  "src_sha256": "2194a7360f741591ce2bc9e9c18f35ed8bbf10d342eb09982af0a5cec59a973d",
  "zh": "他們的軍牌？他們……他們死了？喔，該死。"
 },
 {
  "id": 145,
  "src_sha256": "0bac74e67912cfe4810851da662716cf75634d1eee43e94df2eb9fb74a610df5",
  "zh": "不過各位？我看你們少了一個人。 Glumph 。他也參加了這次任務。我建議你們先回去找他，再向將軍報告這個消息。還有，各位？把他活著帶回來……"
 },
 {
  "id": 146,
  "src_sha256": "c83e3f716f305c0a52876c557bc89409bd680cae866ae257d9767205cbc6194a",
  "zh": "Sgt. Glumph ！長官，我們都已經放棄希望了，我得跟你說。你們全部直接進去。 General Yamir 正在等你們。"
 },
 {
  "id": 147,
  "src_sha256": "ce3ad087290a3529f5dbe6189c55449e4b0160663124d6aaf2726ba9204ca079",
  "zh": "一個 T'Rang ！你們瘋了嗎，各位！我們可沒有指示你們抓任何人質！現在給我把屁股挪到……到，呃…… Rodan 那裡去？我敢說你們拖這玩意兒進我辦公室一定有個很好的解釋。雖然我實在想像不出那會是什麼……"
 },
 {
  "id": 148,
  "src_sha256": "900225d6e8dea2ef81e55a0c02b5b2c11b2558be58b352cb11b886277717bb1e",
  "zh": "我不知道……我就是不知道。讓我想一分鐘。"
 },
 {
  "id": 149,
  "src_sha256": "78138115e9251f17421bf7f3be9d7f84ce05a81378408611b83f70077297309b",
  "zh": "嘶……"
 },
 {
  "id": 150,
  "src_sha256": "2ebc23a637fcb46d8120b3bbe3b9e0ae03ec15bdcd1c443b13482002f6e4dae7",
  "zh": "嘶……嘶……"
 },
 {
  "id": 151,
  "src_sha256": "6e432b79b0b366d1a68bb6ab18d4456ac2abc0a1eb8369b7d9950fc6b7a8a96c",
  "zh": "好吧， Rodan ，你可以把它帶去給將軍。我不知道你捲進了什麼事，不過我真希望你清楚自己在做什麼。我得讓這些士兵跟你一起去。以防萬一。我想你明白。"
 },
 {
  "id": 152,
  "src_sha256": "7a3bae51167e27a590ffb4ceb98f16869f35bf86fb06ae5f50aacd7adb3ee841",
  "zh": "把那玩意兒弄出我的辦公室，弟兄們！"
 },
 {
  "id": 153,
  "src_sha256": "8bd17ed075fd2a35c6fa7c077d89df19b7d245846105651bb06726eb1bd0c01d",
  "zh": "各位，你們現在得進去領受命令了。這已經超出我的權限。出發吧……別讓他們久等！"
 },
 {
  "id": 154,
  "src_sha256": "20c06e47029f0791206de08603a7433cca516143514ab07a1a0c40bbe6364f9b",
  "zh": "當然，IUF 擁有宇宙這一側最優秀的追蹤者（ tracker ）。那些小子能沿著一滴水追下瀑布。"
 },
 {
  "id": 155,
  "src_sha256": "43946043009e3b3f7e578bc1570b8fb9f82d76e43e02201efe650370ac676c19",
  "zh": "對，就是買東西的地方。就在街對面。"
 },
 {
  "id": 156,
  "src_sha256": "fbcc850f66e567e5bc42843974b8bfb0be49771489bca25c520b2b4112cbda99",
  "zh": "斥候（ Recon ）！就是出去看，然後回來報告。這就是我們的本行！"
 },
 {
  "id": 157,
  "src_sha256": "218ef9b7f56c7654f2b0219738668416d98b941298c853388766884f8494cd22",
  "zh": "障礙訓練場（ Obstacle Course ），當然。它夠硬，才能淘汰那些軟腳蝦，懂我意思吧，小鬼們！離這裡不遠。我相信你們找得到。"
 },
 {
  "id": 158,
  "src_sha256": "ac236fd7e55d34cb99b67d50199cb0cc0026175735732643734c78ce8b0fc498",
  "zh": "喔，偉大的 Uhrinna ，各位！這是 Glumph 的軍牌！我們一直在找他和他的人馬。喔，天啊……喔，天啊。這是悲傷的一天。將軍會想見你們的，小鬼們……"
 },
 {
  "id": 159,
  "src_sha256": "f2b8b8c80f0a2456994fafaa78b34c39b0a31c00ecbe35813103780e2755c95d",
  "zh": "各位，我沒料到你們會……搞什麼鬼！ Glumph ！看看你們！其他人呢？！？"
 },
 {
  "id": 160,
  "src_sha256": "57424b9a48e58ae2524ce159ff2328a2ec5c3db7e79a33b7c63c453d4bc2221d",
  "zh": "別急， Glumph ！好了，進去吧……他本來就在等你。各位，你們跟他一起進去，幹得好！"
 },
 {
  "id": 161,
  "src_sha256": "162b9c54f1987db7841b0d51d9a8ab141a8439302238648a188bfcf257920c0a",
  "zh": "你們進去需要這個……動作快點，小鬼們。將軍不喜歡等人。"
 },
 {
  "id": 162,
  "src_sha256": "0b553717f0e412c9541901d8a2ede726908db24c0ae8acb73c306e43205f4f47",
  "zh": "喔，偉大的 Uhrinna ，各位！你們找到 Glumph 了。喔，天啊……喔，天啊。這是悲傷的一天。我想你們最好帶他上去見將軍，小鬼們。"
 },
 {
  "id": 163,
  "src_sha256": "061a6d66ccdfe353332483784fffff6443576f8bafe3ab8137e353f597805c40",
  "zh": "那 Kunar 呢，小鬼？"
 },
 {
  "id": 165,
  "src_sha256": "d8e1fa76e7fc84e348325ac22d2a3fce40b67cb8a4494c378f701abc7f824f22",
  "zh": "哼，哼，哼。這張通行證（ pass ）不是真的，各位。嗯。果然不出我所料。我們組織裡有個不可靠的環節，而你們找到了證據！等我一下。該死的叛徒（ traitor ）……"
 },
 {
  "id": 166,
  "src_sha256": "3aeba27aa36db0151436d16c70b4fb64872188ddf907260d0a23fd1640470c83",
  "zh": "當然是。現在聽我說。我需要你們通知 IUF 安全（ Security ）部門，軍需部（ Commissary ）出了問題。紅色警戒。需要立即行動。"
 },
 {
  "id": 167,
  "src_sha256": "1ce9828684ac6686caf226f3073f4d9731ac5912cc34025112f001c8e0de7a5d",
  "zh": "好，這樣就說定了。回到正事。我們剛說到哪？"
 },
 {
  "id": 168,
  "src_sha256": "5bd0bd8c7c8fe168f9cc34725eeebafc9d7477057363df8bb58b8663b1a36afd",
  "zh": "別煩我了，小鬼們。"
 },
 {
  "id": 169,
  "src_sha256": "75188dc0e58a80453089838bad73e2b7fdcf65a4e01e3c58e2439f5142506ce7",
  "zh": "你們回來這裡幹什麼，廢物們？斥候（ Recon ）一直盯著你們，我「知道」你們沒做我要求的事。現在給我滾出去！"
 },
 {
  "id": 170,
  "src_sha256": "ea984291ce121c4f5429c5645b3dee2c0483b394911e59f64b78c9888f849bbf",
  "zh": "基地電腦系統。無可匹敵。最先進的科技。就在大門裡面。門上就掛著牌子。"
 },
 {
  "id": 171,
  "src_sha256": "a167dba2b833770c931a72dcef6baecd1638a8e285d530c4ce2b8cd0cfde778e",
  "zh": "給我牢牢記住，大兵！"
 },
 {
  "id": 172,
  "src_sha256": "70dc5baa361dbe0b719ea36fdfa7bb5d98fa53be9717633b57653de01a08584d",
  "zh": "他已經被永久調派到我們特別的「長眠地底（ pushing up daisies ）」小組了。"
 },
 {
  "id": 173,
  "src_sha256": "8e1958601dff4bd231ce3cd9b81185f20d169a1c8308165382a0407dc1a4c16f",
  "zh": "這座基地是全天底下最安全的基地之一！"
 },
 {
  "id": 174,
  "src_sha256": "bfc6a1412c65287b1463a621ee2a670f4003cd36beaf9aca617e3e5c0d0ab3aa",
  "zh": "我上班時不談宗教。"
 },
 {
  "id": 175,
  "src_sha256": "32ccd3632ab2dd701a8189df70ea5fe3554a12e3d66c4ad06093b052d3f8b058",
  "zh": "酒吧？就在營區裡，弟兄們。當然，那裡的客人有點粗魯……"
 },
 {
  "id": 176,
  "src_sha256": "5b95193561cadcfa2686e3299a7fd120dea4e13e068fbe1a45975076e0158206",
  "zh": "哨兵在營區北端。只是一台機器。沒什麼好怕的。"
 },
 {
  "id": 177,
  "src_sha256": "aeadfb2361a305d57bdadbe6c0291b52dddc12de0a9f3531657350eaf83ec4ca",
  "zh": "等你們準備好了，自己就會知道一切！"
 },
 {
  "id": 178,
  "src_sha256": "c57a9b2f9aa11f8c9972a4b2640b73d66b63203dc7878c718441815b4a726459",
  "zh": "喔，我們有一大堆裝備（ equipment ）。"
 },
 {
  "id": 179,
  "src_sha256": "34c87e98cb9666b5f02b774f492ed7c98f0e3af0af9336a8f16265f02fcb74ff",
  "zh": "等我知道了，你們就會知道，大兵。"
 },
 {
  "id": 180,
  "src_sha256": "a9293059de9fc350c9af4426085b67d10abc4f69cf9d319f40da3e94998493ba",
  "zh": "問得好，弟兄們！當兵的就是愛聊自己！我已經待了很久了。你們也許只知道我是 Guardia 老兵，不過我打過不少場仗。"
 },
 {
  "id": 181,
  "src_sha256": "5055b901b54d0f67932b67bb09c2efb18b38032f690ee738a0ce053294077172",
  "zh": "這對我們最優秀的軍官之一來說是很重的指控。你們有證據嗎，小鬼們？還是只是想找麻煩？"
 },
 {
  "id": 182,
  "src_sha256": "85b6fc036027b2a7760eab559507474fcc8758ef135ece7d7f90f38c71dac740",
  "zh": "不過既然你們不是我們的人，我就不能放你們進去。當然，你們隨時可以入伍（ enlist ）。你們得從基礎訓練開始，跟其他人一樣……"
 },
 {
  "id": 183,
  "src_sha256": "44794561daab4c7d69191606ee6e7e19898617d520dde1d7dfa55457acf187f2",
  "zh": "你們來了！很高興你們過來。將軍要我跟你們談另一個任務。對，小鬼們，我知道，你們已經在執行一個了。不過你們很勤奮。我們對你們有信心。"
 },
 {
  "id": 184,
  "src_sha256": "e1534aafdc3167bab97b8674353f26de8b116938d058151e838624797c74f190",
  "zh": "你們還記得我說過那兩件新裝置嗎？嗯，我們相信 Mook 可能持有其中一件。不過……我們暫時不打算動武。首先，我們要試試外交途徑。 Yamir 要你們把這封信直接送到 Arnika 的 Mook 營地。"
 },
 {
  "id": 185,
  "src_sha256": "782c283f3a3e97d5f962dfded2d06647c621880bf4ba613b556e815857a927b9",
  "zh": "還有記住，這次「不准」動武。懂了嗎？很好。我相信你們順路就能送過去……"
 },
 {
  "id": 186,
  "src_sha256": "83be7eda04063eabba03f9bed842f20911021b914c44f41775e0a4b2756a15ba",
  "zh": "你們需要通行證（ pass ）的時候，小鬼們，我會給你們的。"
 },
 {
  "id": 187,
  "src_sha256": "8701bb151e5005ad4c90f05beb0eb5906d33a2df7802138e3caf2fbcd9d74dfa",
  "zh": "遠，非常遠，弟兄們。"
 },
 {
  "id": 188,
  "src_sha256": "f6a6a0f9841d4fd01791d99e82e961938e0611c46db402622139f5de347b1b4a",
  "zh": "別質疑我，大兵！"
 },
 {
  "id": 189,
  "src_sha256": "65d373e77db8b9bab1e0e00586c43f96139e38b053994f0fe313e3c1e9203b44",
  "zh": "在這裡的北邊一段距離。"
 },
 {
  "id": 190,
  "src_sha256": "7bdd89c9004bbddc4b3bda1333de694f7f56b035d1b78fde94f25e9934a664b4",
  "zh": "你們得往南走，弟兄們。"
 },
 {
  "id": 191,
  "src_sha256": "66a2c4b6c1c6fbe482ec09444d32ae1b5ab7c0b840cfee529e5a70ea2198bf5c",
  "zh": "在這裡的東邊。"
 },
 {
  "id": 192,
  "src_sha256": "1bc5205f001f2077dbcc6b394f24c76f4b505a0655caf36add9346c025b90c24",
  "zh": "往這裡的西邊找，弟兄們。"
 },
 {
  "id": 193,
  "src_sha256": "983f1a2aea235e9d9a10f70ffa6be7a5e64f0c19df03ff6e4d19ec336f816d02",
  "zh": "你們的任務？"
 },
 {
  "id": 194,
  "src_sha256": "a9e444a831c0860a05d91fadc894f3a75bb64b9052083ce7665307fcba972f67",
  "zh": "完成障礙訓練場。"
 },
 {
  "id": 195,
  "src_sha256": "d15942d0e6e3caa2c2ab470fbcfec4753cf7d919f2e32b34e086ed2c931ca601",
  "zh": "去斥候（ Recon ） Marten's Bluff ，給我帶點東西回來，任何東西，只要是 T'Rang 的。"
 },
 {
  "id": 196,
  "src_sha256": "cfbafd64acafcc59377c6eac03cc9d296a86d38bf90598be6717353812b288ba",
  "zh": "我不是說過你們需要更多訓練嗎……這麼快就忘了？"
 },
 {
  "id": 197,
  "src_sha256": "8eaa5901dd1aaed44ae66a45e39f6040e5117c75e18f08aa3398879930e47a9e",
  "zh": "去 Arnika 看看能不能讓那些 Mook 開口。"
 },
 {
  "id": 198,
  "src_sha256": "63aab0e8fb18cbc142556d1b7d7327911057ebf09a7f9683f231213b9f952fa2",
  "zh": "你們現在是聽將軍的命令了，弟兄們。我不知道你們的任務是什麼。"
 }
]

[
 {
  "id": 0,
  "src_sha256": "2bb4ff0fcd75c3663b8510a87534ad65166863fbb024ac03f2a42bfe5102c6df",
  "zh": "站住！只有真正的 IUF 自己人才能進來。我們可不忍心讓一般平民去受這座障礙訓練場的活罪！我來翻翻新兵名冊……"
 },
 {
  "id": 2,
  "src_sha256": "3e17cecf1ad28d284a1aa652a235d379df768f58402d45852abbb60b1d098390",
  "zh": "我不信任你們這些外地人！"
 },
 {
  "id": 3,
  "src_sha256": "d0b4dc0a3f53dd4d40e318a4b1520caab9d84d88df56925e445a7218a0f3917c",
  "zh": "我看起來像是會被甜言蜜語哄的人嗎！？"
 },
 {
  "id": 6,
  "src_sha256": "e6c5462ba52e58d1e97cfe5a68803242f0fcf91b32b712aace973b095f3c2639",
  "zh": "這套留著去對訓練（ training ）場的小姐們說吧！"
 },
 {
  "id": 7,
  "src_sha256": "c82a17784941a45b896201b0202ad6d8e4a5455642516a1c496aa5e37c41cc5e",
  "zh": "我被侮辱了！勇氣是用錢買不來的！"
 },
 {
  "id": 8,
  "src_sha256": "96f7d885ebc1c131320e2c663fb6009edeb859953e3984b1159fc2922bb9f23e",
  "zh": "這裡到底在搞什麼鬼！先給我停手，別打了！"
 },
 {
  "id": 9,
  "src_sha256": "ca42bbe495840d1cc9f06799f9d91e436c7999c2b0c766eaf442d98c82818ee3",
  "zh": "你們在開玩笑吧！哈！這笑話不錯！"
 },
 {
  "id": 12,
  "src_sha256": "dfa346f974eb5ed957c91de933f68fdf861f979b193b73d7c7cc480fbc89d62b",
  "zh": "夠了。"
 },
 {
  "id": 13,
  "src_sha256": "60f98edb0c97cb1a37534da36990c2271fb9d10703a4dd3e5f7b719b201e5b2a",
  "zh": "我可不是你們的垃圾桶……"
 },
 {
  "id": 15,
  "src_sha256": "84ffcfb56e6e4b0fe163458611185ecb2574965c0adedf09fc7c084db00f9a2d",
  "zh": "各位士兵，這場買賣（ sell ）遊戲挺有趣的，不過我們還是回到正事上吧。"
 },
 {
  "id": 16,
  "src_sha256": "5a71c54e34ee573cc8d2d0405f9ac18e7ecc02fcd2b908efbcf09d6c4dfa83c5",
  "zh": "不夠錢，是吧，小姐們！？"
 },
 {
  "id": 17,
  "src_sha256": "5c58adf2984c59a67cfdfc767752ca72c3f691010d79503d32708d95483de567",
  "zh": "我把那東西放哪兒去了？嗯……"
 },
 {
  "id": 18,
  "src_sha256": "de11398ca45da5114e9c7b12d64cd07d529b09ac81aa71fd370f7ad3540d0102",
  "zh": "笨蛋，我一定會把你們從這座營區的這頭踹到那頭！"
 },
 {
  "id": 19,
  "src_sha256": "c5b582c9e8d7439c235c34db47e9238a405c7114556a39bf991f959fe4cb3fe3",
  "zh": "你想扒我的東西？！給我聽好了！我不管你以前學過什麼把戲，最好馬上給我忘掉！"
 },
 {
  "id": 20,
  "src_sha256": "41418a181b9d95df727c078661add386528600785420184817c1dde1950a499d",
  "zh": "我會把跳過你們的*屍體*也算進訓練課程！"
 },
 {
  "id": 21,
  "src_sha256": "867cd2cc23c59e047db6080e4e1db9cad7c39813e6a19d0f16654bcedb2f8517",
  "zh": "好歹能貼補點開銷……"
 },
 {
  "id": 22,
  "src_sha256": "c983d31fe9aa300a73112b3ef289e02b06142f3d470e1ae3a53a4cebb1affa40",
  "zh": "我是教官，該死！不是老師！"
 },
 {
  "id": 23,
  "src_sha256": "d5ab6e1c0b78158f8d9bbaaf027d4182976ab7f814eef7bf52ddd84ccc6a027a",
  "zh": "這裡不是交誼社團！動起來，士兵！"
 },
 {
  "id": 24,
  "src_sha256": "8a4bf769f748ab0ad8029e2ed83e7abd5affb405b2a70f772cb3c6f0eae3584b",
  "zh": "輪不到我來說！"
 },
 {
  "id": 25,
  "src_sha256": "326fd039d8dc5ac1be025ccda770809df62b79bf3dfe668e37a90e336674ee28",
  "zh": "快點，士兵！我說過了……"
 },
 {
  "id": 26,
  "src_sha256": "fad46c91abe56abb045d92aa042d5389f9e08ef6bf83bbe99ac8cec398b732b1",
  "zh": "慢點，大嘴巴！我只回答一兩個問題。"
 },
 {
  "id": 27,
  "src_sha256": "24682586161b9bfa5033d97c3c4f6b6ae370b452101fcefd3a609caa334368ac",
  "zh": "關於另一件事……"
 },
 {
  "id": 28,
  "src_sha256": "82c84a10d367a06fd9f647302cacb954bcb973c91d2c6ab8f54e3c65a38693a0",
  "zh": "你們還真是知識寶庫啊，你們。"
 },
 {
  "id": 29,
  "src_sha256": "6fb82d49ffe52229a04ee09ebf0e75be3936f15ea79ca6f871343002c08a6bc2",
  "zh": "也許我們該繼續訓練（ training ）了……"
 },
 {
  "id": 30,
  "src_sha256": "ee8b10ada810e70c39c58ae823056c8427b13ed1ec2747f3e38c5b6bae5dba1c",
  "zh": "快點，士兵們！當{{Fighter}}，別當話匣子！走了！"
 },
 {
  "id": 33,
  "src_sha256": "d0ae7f9538e548e240307ef4bf45ec2e3d12316cc816436574f4ae47b170ecd7",
  "zh": "我自己也不太清楚。"
 },
 {
  "id": 46,
  "src_sha256": "0487e55e8d2f7fa888b491da1f9a16e3d74c5210f41c786b5aeb514c99c54581",
  "zh": "千真萬確！"
 },
 {
  "id": 47,
  "src_sha256": "833aa1726af0f10897de1a9e102bf36250fa220cccb1e74299c50ae4825a510c",
  "zh": "別擔心他們！我會把你們訓練得夠好，一百碼外就能轟掉他們的腦袋！"
 },
 {
  "id": 60,
  "src_sha256": "15bb6cea5e100b866bb8a0a275cec2ed771407ebb8950300c3e2a3a00b9e2ed0",
  "zh": "你們要是以為將軍會來看你們訓練（ training ），嘿嘿，那你們可想錯了！"
 },
 {
  "id": 72,
  "src_sha256": "2a51ae68aaacf318b452f26670d364941a031b7f0b30a91a743c92674868bacf",
  "zh": "謠言？謠言說你們再不動起來，就要挨一記踢頭！"
 },
 {
  "id": 73,
  "src_sha256": "da11ea00c393181c16cf5ab8800c4f806d437eb6976f08cdef16cf14706f6148",
  "zh": "我是 Sgt. Rubble！IUF 裡的「UF」就是我放進去的！可惡，我得想個更好的座右銘。"
 },
 {
  "id": 74,
  "src_sha256": "9eacb6b4f77b1bef22ffa908cfd4d3d34b16a37ceebe250450451408e026c183",
  "zh": "命運（ destiny ）？狗屁命運……"
 },
 {
  "id": 75,
  "src_sha256": "368569a85060e5fcd49f35297c8fdb12d78317a62a47e1452807575f57ebf252",
  "zh": "那個詞是我發明的，你這 BLOWBAG！"
 },
 {
  "id": 76,
  "src_sha256": "51515f81f3f4bafba4d2f59666b6cb2c2d4ea26f2faa9ad8b4c76218f2ac41e4",
  "zh": "有點創意，士兵，別這麼老套。"
 },
 {
  "id": 77,
  "src_sha256": "39b63c46d4eef9f2f4fb4b05a489d5d50e1976d859b5f5769bae71eaf331881f",
  "zh": "士兵。"
 },
 {
  "id": 78,
  "src_sha256": "8600e4b0abb6080ee97513ffead6f10e1cce4e1d1fc26af5f114318f04c8f752",
  "zh": "祝你們好運！"
 },
 {
  "id": 79,
  "src_sha256": "848c9706a14cc147bb0242a6a4629c169564f271e52074f3421b400638de97aa",
  "zh": "我會幫（ help ）你們保住你們自己的小命。這是我的工作！"
 },
 {
  "id": 80,
  "src_sha256": "7265ff51567c96443cd8fbb8d1f1b0bfd5c34e52c175c26e99c42b3ad96da520",
  "zh": "什麼？你們跑來這裡買東西？！？這是一流的訓練（ training ）設施，不是跳蚤市場！"
 },
 {
  "id": 81,
  "src_sha256": "c6df3ef1ee40deb60dba6e92458a2d23e28af279bcf6f94e9b128b428f57a58d",
  "zh": "現在不是打聽我個人近況的時候！你們給我繼續訓練（ training ），否則我就得讓你們倒著走一遍！"
 },
 {
  "id": 82,
  "src_sha256": "7e53b0997ee04db936d7cc3b91b15c726239698cad1ddd29369707a0fd915fd3",
  "zh": "那些裝神弄鬼的玩意兒在這裡幫（ help ）不了你們。"
 },
 {
  "id": 83,
  "src_sha256": "9421102a168d413c72859da7d2fc57f5bcba12d112d428877742bdd3bede5d43",
  "zh": "我們要讓 T'Rang 跪下！不然他們靠什麼撐著就讓他們倒下，管它是什麼鬼東西！"
 },
 {
  "id": 87,
  "src_sha256": "61720a4386aa58c25ae1f421dafe7922a8bd0abb0d62e6bcae5542b148487ae7",
  "zh": "可惡……我忘了去倉庫領那批多出來的火箭彈。要是被 Kunar 拿到，他轉眼就會賣光……"
 },
 {
  "id": 88,
  "src_sha256": "e110dbcdc2cd1e1ffa58a621b445a03db3e1d165c39d7d4e98cfbd6c2bbcc344",
  "zh": "說起來，我早該讓那些小子穿上防彈衣出去的。那些怪物目擊報告讓我有點緊張。"
 },
 {
  "id": 89,
  "src_sha256": "e4e933d8cf97094a8e2c38e2363bce559ab2f386a4e91e1f83c4fb6b0b05d5e1",
  "zh": "我訓練（ training ） Trynnie 來做這事，說不定還比較有指望……"
 },
 {
  "id": 101,
  "src_sha256": "b1c21c03b91e1810ed105174e452891f8bbb3f2186a1b9997fcf740410a87182",
  "zh": "把眼睛睜大一點！"
 },
 {
  "id": 102,
  "src_sha256": "4f8a02e9b00b5a263730f79c87287e4c8dda3db2c161aa2efb0fa1d94ccdcdab",
  "zh": "誰在乎啊，小子們！"
 },
 {
  "id": 103,
  "src_sha256": "3471434899264ed05e1cf274dab0911a3f328d6db6f293de79de06944c9a83a2",
  "zh": "我們猜是在 Bayjin 吧。"
 },
 {
  "id": 104,
  "src_sha256": "dc0ec871b9c2d4cb1cc796681e9a4d04f7277d7229fe98a6069bc9b4b05fae89",
  "zh": "看起來沒那麼菜了，士兵們。"
 },
 {
  "id": 105,
  "src_sha256": "1bb2bddf978cc9173e5a39c68c2d3072319518588e3d4bdb96bb8f3925b1842d",
  "zh": "又回來啦？新兵通行證帶了嗎？"
 },
 {
  "id": 106,
  "src_sha256": "182b1d6d35b77f9f80befdfa177def0c11bf18a8b4f185f86409553d9d53db7e",
  "zh": "沒空閒聊，小姐們！"
 },
 {
  "id": 107,
  "src_sha256": "61e0f8e5945881b76116cd6967449f789c527b280ca57ba8784b3d5f9a49df38",
  "zh": "不太聰明，是吧？聽著，你們要過這裡之前，得先到 Balbrak 那裡報到入伍。你們這樣讓我都替你們難過了。"
 },
 {
  "id": 108,
  "src_sha256": "2513caab99f99c5e3e3399a16452a83dab065d6ffd8210299d48dae44189e774",
  "zh": "Rodan！對，我聽說你們帶了一個……一個……T'Rang 過來。老實說，我還以為他們在開玩笑。無意冒犯，但如果你們能把*那傢伙*帶去見將軍，離開我的訓練（ training ）中心，我會很感激。"
 },
 {
  "id": 110,
  "src_sha256": "2ebe7c1ce49cc924a5483c2296b816ff19b51189663d18aaca99caf20e15841b",
  "zh": "那就去找 Balbrak 登記吧。我這裡可不是遊樂園，懂嗎？這個訓練場只給新兵，而且只給新兵。"
 },
 {
  "id": 111,
  "src_sha256": "9c7692d3aa1a85e20885df03e374aac1d1f89de31c60197c28451a0b8ef33cb7",
  "zh": "那就讓我看看……"
 },
 {
  "id": 112,
  "src_sha256": "a455e82b2a903b65dfdae5a76f3618d1f37af40e2351101c05e281cae20d78c1",
  "zh": "看來你們確實在我的名單上……好吧。我們來看看你們有沒有那個本事。障礙訓練場的規則很簡單……從這頭進去，從那頭出來。不准抱怨，也不准回頭。"
 },
 {
  "id": 113,
  "src_sha256": "579fd88415652b0ce3472b83aba83b0de7c43dd9e4887c4dcba18dbbb91f755d",
  "zh": "你們要是能通過，就不用來問了！"
 },
 {
  "id": 114,
  "src_sha256": "ad866635db349ec02f82381eb78cc9f36677f67e38c4357b2731292492cd6e5b",
  "zh": "幹得好，各位。看來你們還是行的！去向 Balbrak 報到領取下一步指示。我相信我們晚點還會碰面，對了，恭喜——你們已獲准進入保全等級（ security level ）2。"
 },
 {
  "id": 115,
  "src_sha256": "e8e349507d91d9326c0ad2dfc3228588557f3b7428441bf04f176c30bae197bb",
  "zh": "哎，拜託！拜託啦！這蠢東西……給我進去！完美！喔不……喔該死……>>>>KaaaAABOOM!!<<<< AggGGHHHHhh!!! Ooooh noooo...."
 },
 {
  "id": 116,
  "src_sha256": "8affac6ab6ebeff2caffadac0ba2c41ac56a9b19a9be6966d5c497d946983a4c",
  "zh": "哇！這場面夠看吧？好槍，好槍！等那些蟲子見識到這些傢伙——直接轟它們一個大洞！*嘿！*我猜你們是來接受進階訓練（ training ）的吧？嗯，再進階就沒有了！"
 },
 {
  "id": 117,
  "src_sha256": "ffe5684d57fca6c025fd51ce352dfcc4e3a461d78853f8e3bed48618031d2e7b",
  "zh": "這些寶貝在適當距離能解決大多數東西，不過近距離要小心，不然會烤熟你們自己。好，開始吧……"
 },
 {
  "id": 118,
  "src_sha256": "988d5434cbf5f9e253a94f3674a07b4e6c98886baa663fe33e19357f8ed96564",
  "zh": "準備好了嗎？來試試看你打得如何。至於那些以前受過火器訓練（ training ）的人，別以為這是同一回事。老舊的鉛彈和這些高科技{{Weaponry}}差得遠了。"
 },
 {
  "id": 119,
  "src_sha256": "5a0245770d4468cd63f25ddcdb7d9376772c96f179818d53052a433c27d7d58a",
  "zh": "快點，小姐們！把那該死的玩意兒瞄準！"
 },
 {
  "id": 120,
  "src_sha256": "313fac7d9f019a018ef2b216a7618fcd11bf0d328b8edcebddcf1af355aab5a9",
  "zh": "開槍的時候想著「T'Rang」！嘿！"
 },
 {
  "id": 121,
  "src_sha256": "acf5ebe153fd070f2b56c19132503c18ebcf9532d5db6323f7d8c5d010b3eaa4",
  "zh": "你*看得見*靶子吧？那就別浪費這些。"
 },
 {
  "id": 122,
  "src_sha256": "6e1ac7d963d64f4966ff9875e9011fc93f048a39c8f31220de801131565edee8",
  "zh": "現在小心使用。這裡有靶場讓你們練習。玩夠了就出門往右走。隱密行動（ Covert Ops ）訓練場。我在那裡跟你們會合。"
 },
 {
  "id": 123,
  "src_sha256": "1c590e075a19b53343c2e6fc70272cc0d481256e27c3eacd89ae091610b9bfb9",
  "zh": "放輕——鬆，小姐們！你們不怕黑吧？隱密（ Covert ）行動的設計是要提升你們的{{Speed}}和{{Stealth}}能力，前提是你們本來就有一點的話。好，過了這道小門，有五面旗子。*同時*也有五隻怪物！"
 },
 {
  "id": 124,
  "src_sha256": "a1a2da88596b34af6f30db19336ff4d1272dd51e389c5b241fb02724d1cfb8fd",
  "zh": "你們活著回來——這是重點——帶著全部五面旗子，我就給你們評等。不然，我們就給你們一場快速的葬禮。要出來的時候，找藍色的光。那就是門。出發吧，殺手們！"
 },
 {
  "id": 125,
  "src_sha256": "07de32e52794cb8ee00792067c25208d42f5e6f198f34e8eafea57a610ec7c6c",
  "zh": "你們*總該*會數數吧，小姐們！給我回去！！！"
 },
 {
  "id": 126,
  "src_sha256": "e940084c6022b7dd0c5e4e980a77023ac8f9e868ba2ec37cf1abb4fe9e9911f1",
  "zh": "幹得好，士兵們！我知道很辛苦，但這些訓練（ training ）長遠來說會有回報。你們被拔擢到保全等級（ security level ）4。回去向 Balbrak 報告。他有另一項任務（ mission ）要交給你們。"
 },
 {
  "id": 127,
  "src_sha256": "32993268056c7343657a6920fe56efcdebf62e900c2b3fa82f562970cbfbad93",
  "zh": "我還記得你們連槍都拿不穩的時候！現在你們要成為 IUF 水下戰術部隊的創始成員了。我希望你們清楚這有多危險。上面寫著你們馬上出發執行任務（ mission ）。命令來自最高層。穿好裝備，我們就出發。"
 },
 {
  "id": 128,
  "src_sha256": "88bd9730db1dbec4a9e6344b5bcb0b8531301e7b6de62bc1cd32eceb869bee44",
  "zh": "UTU 是所有 IUF 小隊中最先進的。你們被選中，應該引以為傲，士兵們。"
 },
 {
  "id": 129,
  "src_sha256": "09b4717f8abb8102519a2c3765cbe9a05dbabe26c93dab5bace6f561584d9567",
  "zh": "潛水衣（ suits ），士兵們。就在那邊的櫃子裡。"
 },
 {
  "id": 130,
  "src_sha256": "c44d20e246187322dbcd6c6bcf46d28a0b739eed2caff2e025493ce0e48c7cd9",
  "zh": "你們在這裡可讓我們相當光彩，救出了 Glumph 和其他人。當然啦，他連淹過腳背的水坑都游不過去，所以他差點死在下面也不意外。不過另外那些人……真是令人難過。"
 },
 {
  "id": 131,
  "src_sha256": "531ac6d444c9a44eb53cfe0b8bc46d8e246384dc983ffae52b3669022076ff0b",
  "zh": "你們的腦袋現在應該已經在水下一百英尺了！快去！"
 },
 {
  "id": 132,
  "src_sha256": "bbdcff0db07954e929965d3a6c583a7b1cdf88d8ca0f7e49f9c27c8d9adb629c",
  "zh": "去穿好裝備。潛水衣（ suits ）在那邊。"
 },
 {
  "id": 133,
  "src_sha256": "b4cb202b54fc5e43a33a3d8ad7ae14f05149770e1381d03df41427bb08bc20b4",
  "zh": "好。重點如下。首先，有幾件事你們得知道。你們這些施法的，聽好了！那些裝神弄鬼的東西在下面可能不靈，所以別指望火球能變出什麼奇蹟。其次，潛水衣（ suits ）要一直穿著。脫掉，你們就會淹死。"
 },
 {
  "id": 134,
  "src_sha256": "3c997cb4dc6ddb605dbed02fde7bbd0528b30e08065039b174417f12d08845ca",
  "zh": "目前我們還沒做多少探勘，所以下面要小心。不過我們確實知道，至少有一條隧道（ tunnel ）能直通 Bayjin 那邊。祝你們任務（ mission ）順利，各位。"
 },
 {
  "id": 135,
  "src_sha256": "97b1b2a4ae04426dcbd8889ba8b348d79bc575c67c858bb6438e2ad563c685a4",
  "zh": "我看你們打算待會兒去游個泳啊。"
 },
 {
  "id": 136,
  "src_sha256": "ef5f9ea7540faf94ccb2e6d4df2aef3ec808930fabfd1220a77f80bede45de2f",
  "zh": "我的專長！這裡是整個 IUF 最先進的訓練（ training ）設施！"
 },
 {
  "id": 137,
  "src_sha256": "5c816c576667b63a150da253f63013b0afffec666e2a2c240cef21accdfe66f8",
  "zh": "做了你們就懂了。"
 },
 {
  "id": 138,
  "src_sha256": "c73dbb769e091d92f168da46c7d896c36a7b04bc7b9ea4fba781231cffa8c96b",
  "zh": "啥？我、呃，我真不知道該怎麼說。讓我想想。你們該去找誰談呢？啊，我想 Balbrak 是你們最好的選擇。"
 },
 {
  "id": 139,
  "src_sha256": "18fc727b4a43b0384fc88307bcf85c2b47a966d2d11d37625e0b41df573c8dd9",
  "zh": "我只知道他們通過了訓練（ training ）……這就夠了！"
 },
 {
  "id": 140,
  "src_sha256": "410410684a09a888b911ac205e539d3c98c5c0b05e6eee7c9a6415a450a7e852",
  "zh": "我們知道下面有隧道。嗯，我本人是不知道，不過以前的 UTU 已經證實過了。"
 },
 {
  "id": 141,
  "src_sha256": "99151c676c91ed1c78f5fb8041185c7a5963956e12eef90e4b59e63e7cc3162b",
  "zh": "頂級貨色，士兵們！你們會愛死它們的！它們也能讓你們活命。"
 },
 {
  "id": 142,
  "src_sha256": "292d048aa42bd81ede3e35d8667e26c0968eb0eacc0b3f02ec8fc0dbf9f803ea",
  "zh": "士兵們，我只負責訓練（ training ）。關於你們的任務（ mission ），去問派給你們任務的人！"
 },
 {
  "id": 143,
  "src_sha256": "ba2fecb8c9787d2c2f0c91ee4a95bae546b525c7ad2397f19f2b6a0872374a54",
  "zh": "噢天啊……士兵們，你們最好把這些拿去給將軍。馬上。"
 },
 {
  "id": 144,
  "src_sha256": "e129b8b81a22857d4a44c07dbda1331cc7c52240cf3a36b877c4258339816b5d",
  "zh": "Glumph！你看起來像被火箭拖著跑過一樣！無意冒犯，但我看過你狀況好得多的樣子。將軍急著見你，你和你的人最好馬上過去！"
 },
 {
  "id": 145,
  "src_sha256": "6ecb42e2e9b6d927928fa6f81049c2d746b6974318978baa2930cee403e590d1",
  "zh": "你們聽到了！去將軍那裡！"
 },
 {
  "id": 146,
  "src_sha256": "02c7ee2be7cf612db099f8688fea78be7af1d3a8b1b0f0735d826825a60a75ea",
  "zh": "你們聽到了！去我說的地方！"
 },
 {
  "id": 147,
  "src_sha256": "120558d908693186e2bbca4c59b40d2c02df6cf60954d343f19b2d94aebc9c88",
  "zh": "我說過一次了！夠了！"
 },
 {
  "id": 148,
  "src_sha256": "7a5449582098a1f23c72475e826df0e5b451d200f273712c9937efbdd0ddb9a3",
  "zh": "我想是在這裡的北邊，但別當真。"
 },
 {
  "id": 149,
  "src_sha256": "feda87be835ff2751ba19358b8d387e5eb3963aaea828b04212be0a3fc6039bf",
  "zh": "可能在南邊，但我不確定。"
 },
 {
  "id": 150,
  "src_sha256": "5507444f9ae768df5cf08626c7e1780da818977289994fdcf5988aafee307b39",
  "zh": "我會往東走，但不知道方向對不對。"
 },
 {
  "id": 151,
  "src_sha256": "08e72adbfe88d2ff4f96d59ea498c676693fb14309e9f32bee7708ecbd6ca53d",
  "zh": "大概是西邊，但你們最好問問別人。"
 }
]

[
 {
  "id": 2,
  "src_sha256": "d4ac122e31b28e1d59c44fc64f1eb0b0b233092b341e02e295a13ef5642f58a4",
  "zh": "我叫你們滾你們沒聽見啊！"
 },
 {
  "id": 3,
  "src_sha256": "5c694ed04eca08e962fd8c4c1722c45f85fcef055a0c2488033392fbf532bac8",
  "zh": "你們別想拿甜話來哄我！"
 },
 {
  "id": 4,
  "src_sha256": "6d72b9507cb089267ee17c9843c518035bb7df889fbb038fde4bd78409b367db",
  "zh": "我剛是說「滾」嗎！？我是說，呃，我是說給——給你們啦！我是想給你們道聲謝，謝謝你們跑這一趟。"
 },
 {
  "id": 5,
  "src_sha256": "c8743f85d6379bcf6582642bbf07faa7fded993210938f5b86bf8e93c150fb40",
  "zh": "我就是有點緊張嘛，你們也知道， Marten 的老地方到處都是那些 T'Rang 。"
 },
 {
  "id": 6,
  "src_sha256": "51023644c49a4ba17a276175184d470cf31738dea26a78ee503e056506096e4d",
  "zh": "聽好了！我會把你們的腦袋擰下來餵鱷魚！"
 },
 {
  "id": 7,
  "src_sha256": "15d1e3ad115aa79aa0652196f914cc2fca87e5efca3fdf7aa89dbc5a51efdabc",
  "zh": "我知道我可不只值這麼點！"
 },
 {
  "id": 8,
  "src_sha256": "cb82da2b7bb049307958f2fe7accdc1d2f5ee723a07cf48f4e114f4430cb988f",
  "zh": "你們把他們惹毛了啦！"
 },
 {
  "id": 9,
  "src_sha256": "9dea8abd4fb6505953d05b7039085cfdedc81df577059eb3987fc4cc056a249a",
  "zh": "你們都瘋啦？我才不加入 Marten ，也絕對不會加入你們！"
 },
 {
  "id": 12,
  "src_sha256": "2f3a58c58ebcbc76d03523672be0215bf8c70c96a5867233186192603ac2151d",
  "zh": "真是太好了……"
 },
 {
  "id": 13,
  "src_sha256": "a947c12e62b5cb3c419cbdd266a5c9db1662c453ba7b5451e7d9d067d83da206",
  "zh": "我比你們想的還要挑剔啦……"
 },
 {
  "id": 14,
  "src_sha256": "7b6c756dab286ae019f0807ec69cd2e5c01c5039375f7a17f41b8dc3427eff7d",
  "zh": "欸，那東西對你們來說值多少？"
 },
 {
  "id": 15,
  "src_sha256": "aee1b2078fe8dc9906a9965a65d9e57ff8800b118f448184dd9dbeb7e6a51ffe",
  "zh": "唉，我買進的可比賣出的多得多……而且我不再買了。"
 },
 {
  "id": 16,
  "src_sha256": "76b006cd79c7baf75bfc1edc9dc7f8511a79b7b1e247847f641636048f29cb48",
  "zh": "你們想坑我？你們錢根本不夠！"
 },
 {
  "id": 17,
  "src_sha256": "7829ee94251e5731867d1516f2f9549e0db2299fdcbf033caa8f6915f0a55946",
  "zh": "你們這些沒良心的偷雞摸狗膽小鬼！這是我的！我就知道是你們偷的！"
 },
 {
  "id": 18,
  "src_sha256": "86db72c254c6d55da7ce39000eb4ecc06bcca6259073b5c3be512a4b37ca1601",
  "zh": "我還以為我們是朋友！"
 },
 {
  "id": 19,
  "src_sha256": "2fd06cca86296cac4f0dbf865ac71a37b7d3ed3c6c9a94913354631f6e5698b1",
  "zh": "你們這些偷東西的蜘蛛迷！！"
 },
 {
  "id": 20,
  "src_sha256": "c905c661eeaef493af0f8ddb8912d5be7efd66131aaff017a91f2a86e91931cc",
  "zh": "你們怎麼可以這樣！？"
 },
 {
  "id": 21,
  "src_sha256": "c4be710dfb795f514bde7d9dc0da0b4d8144294d703f22120d4eca6895c2477c",
  "zh": "我總是用得上……"
 },
 {
  "id": 22,
  "src_sha256": "66e12a8855671c4549db552c20f263f6b656435ea4f8d87a47a2242f1da9dacf",
  "zh": "我不太出門的，你們也知道……"
 },
 {
  "id": 23,
  "src_sha256": "7a7ff63a431842a9907f2694f65482176bf68eb44937d68d2a27deba55933e4a",
  "zh": "我不在乎那個……"
 },
 {
  "id": 24,
  "src_sha256": "cdbdb69b54664ab874190647d41b2b9faccf968924b416e88d225c25c7c0fe1b",
  "zh": "管好你們自己的事！"
 },
 {
  "id": 25,
  "src_sha256": "97fa2c2417ea1672b9568384dacc0b5d56a357e6774d3a7ef8a5131db1ee1ad2",
  "zh": "把你們耳朵裡的蠟挖乾淨！"
 },
 {
  "id": 26,
  "src_sha256": "d0dcdfef4d6877fd93f5c6f5ff19ed9eb50acb7edb3d8ac77d34226a4c49ead3",
  "zh": "你們一次最多問兩個問題。"
 },
 {
  "id": 27,
  "src_sha256": "e67eebca0a6ba6603b5311837f1ca82741363f300c359c57a72ccd9035ead56c",
  "zh": "然後呢，你們知道……"
 },
 {
  "id": 28,
  "src_sha256": "6f6059f777975dd986e68ab2d4a9139de130b5c567fa1acf495dc1de8375ca13",
  "zh": "唉呀，這可有意思了。"
 },
 {
  "id": 29,
  "src_sha256": "cc831d85ff5ae94e8342114896e07000fbf4973bf121b1f75c31f3c4daca972e",
  "zh": "聽著，我沒空理這個。"
 },
 {
  "id": 30,
  "src_sha256": "7679a712cff70c5c2747cfbfc1a093a6ee59731448966e5ae86f9cd8d68a4375",
  "zh": "聽好，我還有別的事要忙。"
 },
 {
  "id": 31,
  "src_sha256": "e13bacae7a387c546559833849784dd54e6e2dbeb1b0372a42c4fd422874b3c3",
  "zh": "看看你們腳底下！"
 },
 {
  "id": 32,
  "src_sha256": "5f3285a7f691e13170a7a7521ff070d5b8ebe408507707591f60eca5b7a30f4c",
  "zh": "我已經有，呃，至少一百年左右沒去過那兒了。"
 },
 {
  "id": 33,
  "src_sha256": "69b05a8e4903457ed5f459a7ed6002ee24ca0808e4a8456901059a6a21712165",
  "zh": "喔，那是 Rynjin 住的島，要我說，就是一群野蠻人。他們拜某種海怪。當然啦，你們要去 Sea Caves 的話，就得從那兒過。"
 },
 {
  "id": 34,
  "src_sha256": "b791c730511da6ca1a1ec0162a4f63fbff071a8e676d3389d442b36f2915eb6c",
  "zh": "那是那些小樹精住的地方。要我說，一群小偷。"
 },
 {
  "id": 38,
  "src_sha256": "a33bcaf67adaa65db70e2841bb040740f62ae9c8ea4e77e3492005cf2d42b02a",
  "zh": "這才像話嘛！那座老堡壘的事我無所不知。以前是 HLL 的，不過他們很久以前就放棄了。軍費縮減，你們懂的。後來 Marten 和他的手下接管了。"
 },
 {
  "id": 39,
  "src_sha256": "ac6fec1139d50b40d813e22d35b6007d2f8c35a2882a74b51cbff64d6e86935f",
  "zh": "自從他離開，呃，算算也有一百年了，那兒一直空得跟 Hogar 的腦袋一樣——直到那些 T'Rang 玩意兒搬進來！當然啦，那些蜘蛛現在大概後悔了。唉，Marten 在那地方布了一大堆陷阱！嘿！要是他們是來找 Marten 本人的，嗯，他可不在那兒！"
 },
 {
  "id": 40,
  "src_sha256": "654f0bb20e3ddff9f65403af49810cf736a1ab67b2f56bfcbe826865705351ca",
  "zh": "如果你們是要找 Sea Caves ，我不想潑你們冷水，不過你們得先穿過 Bayjin 才到得了。前提是那些 Rynjin 沒先把你們的頭扯下來。這裡北邊有一道階梯（ stairway ），直通海裡。你們要找的就是那個。"
 },
 {
  "id": 42,
  "src_sha256": "867314f6a45fdb4112746f0465c172d90f5552dd9f33fd836a8e991416dc628e",
  "zh": "你們在為那個老 Circle 煩惱啊？你們都別擔心了。"
 },
 {
  "id": 43,
  "src_sha256": "3314deb522985dcb3425de04d70218c46f8fb047564c8a7b177c67f9dd0dd01a",
  "zh": "就在這裡北邊。"
 },
 {
  "id": 44,
  "src_sha256": "bde25f3570ae5c874b7b6b2ff0308e5e72d3e145950032c2f06e5c753a9d0713",
  "zh": "他們就是太自以為了不起，簡單得很。"
 },
 {
  "id": 45,
  "src_sha256": "a9fa75c324c05dc92b27a5f73ae855d4d4a2464a5ffb5086b0424119f839a501",
  "zh": "好吃……"
 },
 {
  "id": 46,
  "src_sha256": "1b0f1cf3d7a5b9c05e04149241f891f37acc93f41ff941f477db7117c6c1fea7",
  "zh": "一群討厭鬼，比那些蜘蛛玩意兒還糟！謝天謝地，這附近不多。不過這幾天我看過一隻躲在沼澤（ swamp ）裡。我敢說他會很喜歡我的香水（ perfume ）！"
 },
 {
  "id": 47,
  "src_sha256": "cfb40b211306cad8a9622fa129dcc217735f5e05b13d37fdefdfa31a6be28a50",
  "zh": "我從沒見過。"
 },
 {
  "id": 48,
  "src_sha256": "31a8c8f9624bc378223939ecf6334ce713cdf6308a612d7edce52925de14fff3",
  "zh": "你們瞎了嗎！？這鬼地方到處都是。不知道他們打哪來的，反正已經佔了崖上那座老堡壘。"
 },
 {
  "id": 50,
  "src_sha256": "44dd7fb86fbd1138edbf0914e253e6db0bf3db366a4be9125af1f409a2a85989",
  "zh": "一群泡爛的野蠻人，就是這樣！"
 },
 {
  "id": 51,
  "src_sha256": "cfb40b211306cad8a9622fa129dcc217735f5e05b13d37fdefdfa31a6be28a50",
  "zh": "我從沒見過。"
 },
 {
  "id": 52,
  "src_sha256": "3053877c075198bc5ba6fd946d8079d2362db4790b10d906e0894110efae1168",
  "zh": "你們是說那些又高又多毛的傢伙。我見過一兩個，不過我想他們不好吃。"
 },
 {
  "id": 55,
  "src_sha256": "abeb828734a5b6f192b593fb92d803634741ec9cd4bf8a49521c87c25f512633",
  "zh": "沒聽過他有什麼好話。"
 },
 {
  "id": 58,
  "src_sha256": "f0016d26cb87b502f6cfb5b3bf9fff1ed3d85ac33565a31293ef18231a7d983d",
  "zh": "大家都知道那是誰，不過你們要想知道更多，我建議去問聖職人員……別問我！"
 },
 {
  "id": 59,
  "src_sha256": "064ed46830b227245edf3a03d2e9a65adcfad0eb9e6f7a96ee81da233413eaa5",
  "zh": "喔， Marten 我是認得，沒錯，不過你們錯過他大概，呃，一百年啦！他已經離開那座老崖了，我猜你們想知道他去哪了，對吧？好，我告訴你們。 Sea Caves ！ HLL 為了找那個 Destinae Dominus ，追著他滿天涯海角跑。"
 },
 {
  "id": 60,
  "src_sha256": "6d65d03b835111615f6b9e14bae5686f251bf32465ab8a5ce306398b4dfe29d0",
  "zh": "我告訴過他最好找個安全的地方躲起來，而再沒有比那些老洞穴更安全的了。你們想找他，他就在那兒。"
 },
 {
  "id": 61,
  "src_sha256": "615148b8599f6d2690944936026316275b07a4676926974904c756c9732ba316",
  "zh": "我跟他們不熟。"
 },
 {
  "id": 70,
  "src_sha256": "d4b04c6fbf3db876b377e633088b541a861a09eeefe55d1ec308cc0c24d506f2",
  "zh": "那不在這兒。你們得去問 Marten ！"
 },
 {
  "id": 73,
  "src_sha256": "0c4d383f3176cf2c43f07e650eda0e9b962d04d5b6bbab81f981b973a15ede07",
  "zh": "唉，那比較像是 Higardi 那一類的事。"
 },
 {
  "id": 74,
  "src_sha256": "ba91fcf226bf7e4ac88ada70a4d13d8fcacb05b861a6ecb93ef88ef1c01c1dd9",
  "zh": "我賣（ sell ）二手貨。對二手故事沒興趣。"
 },
 {
  "id": 75,
  "src_sha256": "7fafee3a7c56b2e562bed6e19d741e497b74e1639fd8abdb46d85f9604f5637e",
  "zh": "我是 Crock 。你們居然不知道我是誰！我在這個世界待了至少一百年……"
 },
 {
  "id": 77,
  "src_sha256": "dda32a72fa960dbebb0b21bfca5a278800b921f56bd3f3f3abafd15c99fd0b33",
  "zh": "你們是想讓你們自己印象深刻嗎？嗯，你們可沒讓我印象深刻。"
 },
 {
  "id": 78,
  "src_sha256": "57f88ee821e1344995bec2329ef06947cbbbbe393e7201aa94d9acabd4c596c8",
  "zh": "這可是我聽過最蠢的建議……"
 },
 {
  "id": 79,
  "src_sha256": "031914046f41213c351df5b034eb505998cc07042fbfdde96446bcd4f4322673",
  "zh": "友善的一群……"
 },
 {
  "id": 80,
  "src_sha256": "96078a4c31312ffbe7625580acbda124260bfb6a99707c3d66419e8d5dad9395",
  "zh": "好啦，等我有你們需要的東西再回來……我總是有的。"
 },
 {
  "id": 81,
  "src_sha256": "10cbbfc0b6ffe64dcdbc61599f1bd14cf4b0e21870a0b994a83dbc75ea8539a6",
  "zh": "我這裡就有幫（ help ）你們的東西……"
 },
 {
  "id": 82,
  "src_sha256": "6f40680d8cea78a62bcf53bb6b399df91b234e003065312a5ffc098c605c8d00",
  "zh": "我有一些二手貨，只是有幾個凹痕而已。"
 },
 {
  "id": 83,
  "src_sha256": "2a5f021f4fdc388b0902b6fc11aac2a0fc763a6171731edb8354a955070e924d",
  "zh": "活到我這把年紀，還能呼吸就該偷笑了！"
 },
 {
  "id": 84,
  "src_sha256": "f21961a8c8e033fa854738a292981200eadfe60168f8e3fef28c9a503fa63fc1",
  "zh": "我有一些香水（ perfume ）……"
 },
 {
  "id": 89,
  "src_sha256": "6e5bfdfdfca6131a0014984e5171bbc456d713ce60328a634736ad95d758655d",
  "zh": "對，我是想過親手幹掉那隻該死的 Rapax 。我敢說他聞到這香水（ perfume ）會發狂……不過我……我得先想辦法殺（ die ）他！"
 },
 {
  "id": 90,
  "src_sha256": "eaf983fba225f8341321b5db2e344755f480361f16fb3cc23d03448c1d556da0",
  "zh": "那些蠢蛋永遠不會發現就在那幅畫後面！他們只要走過去就行了。"
 },
 {
  "id": 91,
  "src_sha256": "2f7518c0bed09d9a22693284d6c97ef0aee06c2d2b7509d3c9c48da3bec97cc1",
  "zh": "你們在裡面給我閉嘴！"
 },
 {
  "id": 92,
  "src_sha256": "148bb94150c1104f5b7169d0c29120a42b06a9288cbf35e52c31afc5d4f3ef83",
  "zh": "你們難道從沒去過 Arnika 嗎？！"
 },
 {
  "id": 93,
  "src_sha256": "97442bb9f2fc8756ef13328a5667a7d72986c82f6b9a428e361b00638408945a",
  "zh": "我猜是在某棵樹上吧。"
 },
 {
  "id": 94,
  "src_sha256": "0a4abd89f0fc6c420e46d262de90ccf769bbaa3c06a883760ca28e1f9027d76a",
  "zh": "我想就在這附近。"
 },
 {
  "id": 95,
  "src_sha256": "e1410d69a8e677ff4455d64d2db157c95e754bff3d1301643961e6e331e0246b",
  "zh": "在這裡南邊， Marten 的崖上。"
 },
 {
  "id": 96,
  "src_sha256": "1ec4ce2b873843d86d0b45821ea2e6363e642b85ba0ab4888920f2e0a10be7d6",
  "zh": "我聽說 Rapax 在這裡東邊有個營地。"
 },
 {
  "id": 97,
  "src_sha256": "00bdede5008d2db1bd923477618c3abc43b47753882e5683842ea322fdba2b1e",
  "zh": "你們要找的是 Mt. Gigas 。"
 },
 {
  "id": 98,
  "src_sha256": "1055610e73f0d78e8c9b9a0273c33a7f047639425d3d95b4f1d278ddc3d37c91",
  "zh": "在這裡東邊的洞穴裡，當然啦，得先穿過 Bayjin 才到得了。"
 },
 {
  "id": 99,
  "src_sha256": "0dc6033534d9b7dbbd82c94b722e9ad37482cef25567619d360fcb8798877f3d",
  "zh": "那是 Rapax 的地盤。"
 },
 {
  "id": 100,
  "src_sha256": "0dc6033534d9b7dbbd82c94b722e9ad37482cef25567619d360fcb8798877f3d",
  "zh": "那是 Rapax 的地盤。"
 },
 {
  "id": 101,
  "src_sha256": "96667da2d975d6b9c7c7218c84818e0b41e518f6e63a5461b07281bdcd4db00f",
  "zh": "怎麼不去 Ascension Peak 試試？"
 },
 {
  "id": 102,
  "src_sha256": "668ecb63d3164e5938e954cd9daec11c23161cc3e89e00707f1b0c82d336667e",
  "zh": "大家都知道那是 Cosmic Circle 。"
 },
 {
  "id": 103,
  "src_sha256": "04a62f6b8e2080b4c3f6e4307ffe8283265dcbbbebfbb58eda9bac2fec5f06d2",
  "zh": "你們是不是腦袋受過傷啊？"
 },
 {
  "id": 104,
  "src_sha256": "205da8a5726c6c218fe81308bcee653923a90c9467277cd237877489f21f5554",
  "zh": "我哪知道啊！"
 },
 {
  "id": 105,
  "src_sha256": "bcd0173bff559a61802bd8cb3999ce5c36d7a7787b6f6083e0587c9f6b9ed809",
  "zh": "對，那在 Bayjin 。"
 },
 {
  "id": 106,
  "src_sha256": "177141d865f18eef01b6821d4a93cc13f03d527bb2c628593690f1bf9800a99d",
  "zh": "滾出去，你們這些黏糊糊的……啊呀，抱歉！我還以為你們是那些佔了 Marten 崖地的蜘蛛玩意兒。這陣子客人不多，全都是他們害的！所以你們隨便挑吧。全是上好的二手貨。我今天的特價品是，嗯，香水（ perfume ）。"
 },
 {
  "id": 107,
  "src_sha256": "c45c1047267b1f08d40b31231d5a1311fcc798c28485f8c2fc4a351a2bdd7855",
  "zh": "原來是你們，你們這些蜘蛛迷！我猜是來找弄丟的人吧。嗯，這地方很危險，尤其是對那些跟 T'Rang 混在一起的人。不過，我或許能幫（ help ）你們……要是你們……要是你們幫我個小忙。有興趣嗎？"
 },
 {
  "id": 108,
  "src_sha256": "614a84a79afdb5f7f4ed2ad5208e638c7059afc4ddb3160d30ae5774a5565b64",
  "zh": "從沼澤（ swamp ）爬出來的啊，是吧……"
 },
 {
  "id": 109,
  "src_sha256": "1a0088e74124435cfa117d0356f9102edb1338d37e124ded9b33dc3d9bcbee9e",
  "zh": "我注意到你們的小朋友還沒回來！你們願意幫（ help ）我了沒？"
 },
 {
  "id": 110,
  "src_sha256": "1a7fa68246a2c29a556ff5f467e84432a1f718f6fa5d2fd358a8d71aef3cddc9",
  "zh": "我就知道你們會！這附近最近麻煩事一堆，現在更糟的是， Brekek 回到沼澤（ swamp ）來了！他大得像間房子，殺過的人比你們強上一百倍！所以我告訴你們。去找到 Brekek 把他殺了……*要是*你們有那個膽的話。"
 },
 {
  "id": 111,
  "src_sha256": "1609160eda82d2581542b2089681939dad4829a1ba0ced4394887a0e2f759035",
  "zh": "帶著你們幹掉他的證據回來，然後我會，嗯，我會看看怎麼把你們的朋友弄回來。現在滾！沒殺了他別回來！"
 },
 {
  "id": 112,
  "src_sha256": "0749d096944bc096f4923d8567e32eda47ce1ea4fcd5afd89d0a394ecb8aeed2",
  "zh": "哼，我也沒興趣幫你們啦！你們會改變主意的……"
 },
 {
  "id": 113,
  "src_sha256": "9b0ca2dcafa998f30e8513bab73b004e78fd40ea16d26458a336cfb5731ed58e",
  "zh": "怎麼樣，你們宰了 Brekek 沒？"
 },
 {
  "id": 115,
  "src_sha256": "9868aabf892ee88230bcc63426938a1928606e9127885e1a68cee790c63da872",
  "zh": "我不聽你們空口說白話。我要看到某種證據……"
 },
 {
  "id": 116,
  "src_sha256": "9f2f70bf3a95395d14925bbee5723168bd5c9fcf0384f7ddf8270e9281a9fa25",
  "zh": "你們說謊！我就知道！你們靠不住。好，等他死了再回來，你們這些說謊的、三張臉的、沒用的、吸渣滓的、螃蟹肚子！滾！"
 },
 {
  "id": 117,
  "src_sha256": "f70677e053dc7ed35890ab2aed8d11b9c9dcdbddc9a346fb3251e8288481a8b4",
  "zh": "那你們來這兒幹嘛？滾！"
 },
 {
  "id": 118,
  "src_sha256": "4767e601448d9c43c58b9ebc5e53cbb3a04af33d9e8d88cdff23aba064e6e3d2",
  "zh": "我的天啊！你們真的做到了……還帶回了些好吃的呢！說好的事當然算數。讓我，嗯，去打聽打聽。給我一分鐘……"
 },
 {
  "id": 119,
  "src_sha256": "0682466e70a43c7b6b988ee88137cf3b6b5303bf60169e53f8857785fa2a479c",
  "zh": "哎呀，瞧瞧我發現了什麼！你們敢信嗎？！那些，呃，T'Rang 把他們鎖在我小屋後面這間房裡。他們，呃，想把這起綁架賴到我頭上，我敢打賭。不過你們知道我絕不會幹那種事。對吧？哎，別這樣嘛，這場面不是很歡喜嗎？怪物死了，大家又團聚了！"
 },
 {
  "id": 120,
  "src_sha256": "12e4035dcdfadbe46a6d3ccc1fe52aa01437c6dafc5587e615a62126a302087a",
  "zh": "對，香水（ perfume ）。 Rapax 香水，而且是貨真價實的正品。瓶子上說，保證讓 Rapax 發狂。不過我不懂誰會想這麼做。他們本來就夠狂了。其實我猜它以前是用來獵他們的，你們懂吧，像某種誘餌。"
 },
 {
  "id": 121,
  "src_sha256": "e52c86936a219240e6bbee52ba8d63a812307359ac289450c6554fb26bae9ecc",
  "zh": "我看過他用那可怕的蹼腳趾把十個人夾扁！真的！"
 },
 {
  "id": 122,
  "src_sha256": "07ee6bee5ac92de1a8ed39a79176af4af1122ec31f7db35162106e0719720f7f",
  "zh": "東邊有個老礦坑。現在那兒除了一堆黏糊糊的 T'Rang 之外沒什麼東西。"
 },
 {
  "id": 123,
  "src_sha256": "771c750d8523a4329f24cdb3a65ab99a9bf2d92fc8f15d6e945c0e542442244c",
  "zh": "除了怪物、潮濕和沼澤（ swamp ）熱病之外，這地方也沒那麼糟。"
 },
 {
  "id": 124,
  "src_sha256": "ab236287397677433231eda705b448f7e276c2685cee54c55a0603d986cfa3da",
  "zh": "對，就是我。我在這裡待得比誰都久，嗯，也許 Marten 除外，如果他還活著的話。"
 },
 {
  "id": 125,
  "src_sha256": "2daaf35b4d2edf2b144183bd982499f19792fcb0d437db8c320bf62e6ea5cf3f",
  "zh": "我要是還有話要說，早就說啦！"
 },
 {
  "id": 126,
  "src_sha256": "27fb5209ac878ba9783048c22df3c2d7d43ca6711cfc3d6ed5bbf9713fb63d5f",
  "zh": "你們太往南了。"
 },
 {
  "id": 127,
  "src_sha256": "89dae491a49ddcc4ead9d8bcfddfcf89037f4aa7953d3d85f98a6e71580e8e6d",
  "zh": "你們太往北了。"
 },
 {
  "id": 128,
  "src_sha256": "8633bb35493e6ba8f1db7a1bbdc0e2120b5e927065e12c62c1f542ec1f6e2964",
  "zh": "你們太往西了。"
 },
 {
  "id": 129,
  "src_sha256": "93a7898e8be1fff1537d64546264302a0d4b3af50fa1a43f79497da27764f469",
  "zh": "你們太往東了。"
 }
]

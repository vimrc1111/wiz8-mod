[
 {
  "id": 2,
  "src_sha256": "210ac6499994401332fcc7bef7aa41d2f8d7389528c4c451e1b2c7e9bfce83eb",
  "zh": "別忘了回來喔。老大 Da Boss 交代我們要盯著你們。"
 },
 {
  "id": 3,
  "src_sha256": "3eb5217a38365b6b51bbc91d38b33cab11a6de4ca585440765b864d9ffb008df",
  "zh": "對對對，我知道那筆交易。我本來可以幫你們把價錢壓低大概一千塊的。"
 },
 {
  "id": 5,
  "src_sha256": "177678c7f80669b4f7c18766d739cd094fa4600cd06b769d1b442286613ef60f",
  "zh": "嘿！我們剛好在聊你們！我們想說你們可能需要一點保護。畢竟，要是 Mook 發現你們、呃，帶著 Chaos Moliri 走人了，大概會氣炸吧……"
 },
 {
  "id": 6,
  "src_sha256": "37259d6423a2bc21e15a81a649f1b52877e379400526616c151df1b28468ee71",
  "zh": "果然是真的！你們拿到 Destinae Dominus 了。你們看，前幾天才有人出一大筆金子要我們去找它。當然啦，我們看得出其中的眉角……"
 },
 {
  "id": 7,
  "src_sha256": "f20e51dd15792aca8a2da201399637acabb2406377ee385bed5b3464e4575550",
  "zh": "可惜你們錢不夠！那我們只好把你們身上有的拿走囉！"
 },
 {
  "id": 8,
  "src_sha256": "8f4dfbec0c40aea14307aeae2ac330adcc4c79e13ab85b53a5e7f6e14cfb4f58",
  "zh": "聽說你們現在手上的那些玩意兒已經成套了！要是弄丟了可就糟了，對吧，比方說要是大家都知道你們有它們的話。你們大概會需要一點保護……"
 },
 {
  "id": 9,
  "src_sha256": "2e8a10c672d3ae0ac2837f566f85882596c995563102c405d66594d021a39e90",
  "zh": "你們運氣真好，我們剛好聽到你們新弄到手的東西。你們想想，三件都在手上，嘖，一堆人都想要你們這些肥腦袋。老兄，你們現在比以前任何時候都更需要我們……"
 },
 {
  "id": 10,
  "src_sha256": "6ac11019b08aaf947a5dbf2fad597bd37c32c9e86a6ef370e163e6c70e3895e3",
  "zh": "Barlone 剛傳話來，說該付你們那筆例行的、呃，服務費了。不付的話你們會後悔的。"
 },
 {
  "id": 11,
  "src_sha256": "6bfd179b5098c548456825bfa923a5aa8086f50c4f555612131bf395d9c0f9be",
  "zh": "順便跟你們說一聲。現在有人正在對你們的腦袋下懸賞……下次見面，我就得動手了。"
 },
 {
  "id": 12,
  "src_sha256": "b77bbe7a3962f562c48f7a16897326e558fe3d24d22db8ec735f131be50a8fcb",
  "zh": "聽說你們在找 Cosmic Circle。它就在 Arnika 過去一點點。你們在那邊繞圈圈走個十次十二次，繞到頭暈，那就是所謂的「宇宙」了。"
 },
 {
  "id": 13,
  "src_sha256": "176b1fefc9ae834657d384d9407e278c23b31d2b8c5c23a28933e58bf71740bf",
  "zh": "退後！我們只是在做自己的事……"
 },
 {
  "id": 14,
  "src_sha256": "960f17c407e0e463b0c2304f02927e0d5bf066a6820a816933706c7abfe32aca",
  "zh": "謝啦。你們不會失望的。"
 },
 {
  "id": 15,
  "src_sha256": "87992a77cab2d25b6a18e4b4198fa6085e036cfad30e4701e19b1069f7d79ced",
  "zh": "沒人敢對 Razuka 說不！"
 },
 {
  "id": 16,
  "src_sha256": "c48a177781b5f158ebdc7ee7fc8c298c8849c54c5ada1c17d99386f5d728cef3",
  "zh": "而且這已經很公道了……"
 }
]

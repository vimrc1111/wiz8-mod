[
 {
  "id": 2,
  "src_sha256": "9c7c9ac72a36e1e4af1c80844ab298a39c37eb47748bf98d80450513607ab729",
  "zh": "我們聽說了你們跟住在 Trynton 的老鼠打交道的計畫……你們不會成功的。他們貪得無厭，而你們根本比不上 Rapax 國王龐大的資源。"
 },
 {
  "id": 3,
  "src_sha256": "5d279ea269d95ac8c3300b7276086cee6c5fff510b551387b66a96e2a5371c9b",
  "zh": "我們聽說 Astral Dominae 在你們手上！真不巧，你們也快要失去它了！"
 },
 {
  "id": 4,
  "src_sha256": "21a177ada9e79b85735e782ba9d6a101ae54a5cc10c815aa6e9ae84b905a0dd4",
  "zh": "原來這就是 Umpani 結成的勇敢聯盟。讓我們看看他們到底有多強！"
 },
 {
  "id": 5,
  "src_sha256": "bd259f31070466f104350bff02bca83b02a646785bcef304b2671b641a400798",
  "zh": "把那個裝置交出來！你們沒有資格參與 Ascension！"
 },
 {
  "id": 6,
  "src_sha256": "305c7de0a73984a7388731a87651572d575a2911973f534f50e59b5985fbc21d",
  "zh": "我們聽說 Destinae Dominus 在你們手上。你們憑什麼擁有屬於 Dominus 原住民的東西！"
 },
 {
  "id": 7,
  "src_sha256": "fff1e1605359a6e102a4cd9c6a8e1a8d0ef038f552defe540dfe474f7cd487bf",
  "zh": "你們以為自己越來越強了。可是你們還缺一件裝置，不是嗎？而且你們缺的可不只這一樣！"
 },
 {
  "id": 8,
  "src_sha256": "d59f9b8733d2ae4d60bd4355c77707e5f60ae8964020d157a6939ec6ab58f677",
  "zh": "如果我們聽到的是真的，那殺了你們，我們就能奪下全部三件。 Dark Savant 會出高價買下這份大禮！！"
 },
 {
  "id": 9,
  "src_sha256": "f41aefe1a90d33bd361d4513adbd93d7ea63ca01cb09430b694594cdcf1b36f8",
  "zh": "Trynnie 正在暗中對付你們。你們當然不知道，他們那些陰險的小把戲你們根本看不透。最好趁他們捅你們一刀之前先宰了他們。"
 },
 {
  "id": 10,
  "src_sha256": "b458f4732429691d886e2568652bb3993741475e6015f8eb7f90606828f6752d",
  "zh": "Destinae Dominus 已經在我們手上了。少了它，你們絕對不可能成功。"
 },
 {
  "id": 11,
  "src_sha256": "27de8c88443e79c8672b539f4af4f5698c5085443ee1c06f3c2a376fcc41c53b",
  "zh": "我不會走那邊。 Higardi 正在集結對付你們。你們都沒起過疑心嗎？想活命就離這一帶遠一點！"
 },
 {
  "id": 12,
  "src_sha256": "9c12df1b01bdc9852f698e49a4568dea1de27e4ab03d04c6c45fe5c2674383e5",
  "zh": "國王下令要你們的命！"
 }
]

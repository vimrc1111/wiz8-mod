 },
 {
  "id": 1,
  "src_sha256": "c60f39d9429bff83e739540fa3003b57cc8b36937c6487b6005d1ece32707b91",
  "zh": "你們和你們那些 T'Rang 同胞活不了的。把這話轉告你們的首領！"
 },
 {
  "id": 2,
  "src_sha256": "7f893db2d5f5a18a4cb86c9849ac60cd5525f5483dd3f22b2a3df0e9bf712bb7",

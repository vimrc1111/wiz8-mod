[
 {
  "id": 2,
  "src_sha256": "c891fa2ec59ea7e212a5688b0dac8e2bf3be71c8f310dd3a9db70e97150cbada",
  "zh": "不好意思，您並未獲准進入這個區域。"
 },
 {
  "id": 3,
  "src_sha256": "94ff746504cea0bd1cd73a9c9dbb17aee89d664d7d890186c3f881957fdc376b",
  "zh": "十分抱歉，貴團隊無法進入這個區域。"
 },
 {
  "id": 4,
  "src_sha256": "ee8eef769a76d29def117be445c4f39f87fd3b8a45c5e487efa7453bd72241b9",
  "zh": "這個入口並未開放給您使用。"
 },
 {
  "id": 5,
  "src_sha256": "b5b87b842254877b414a0bdf7a86c6b2c33d58eb83fc55438cb19ac732d89608",
  "zh": "既然您未獲准進入，我只能推定您的闖入帶有威脅性。"
 },
 {
  "id": 6,
  "src_sha256": "bee15dcf0f17182db2a5acb225d8c81a99edf9009dcdd89351d6aa257fdfad0f",
  "zh": "您出現在此處，需要我採取實力介入。您必須被移除。"
 },
 {
  "id": 7,
  "src_sha256": "49114ffdea8b745267c20e9481b05b4f43aedc97dc838d22b46a930bb59d52f3",
  "zh": "您未獲准進入此處。闖入者必須被清除。"
 },
 {
  "id": 8,
  "src_sha256": "fbf59907c6070451709f86766276da686229db741894c9a8259fcfdb66da1981",
  "zh": "這種行為是不可接受的。我堅持要求您停止敵對行動。"
 },
 {
  "id": 9,
  "src_sha256": "ba29a7a6b2edd46df2fe2a50b57b7f8bd4593ec6bd441ecc2c7d73e832c70cf7",
  "zh": "是時候告訴你們這趟旅程的目的了。我的 Mook 同胞發現了一件極不尋常的古物。這把他們引到一個叫 Dominus 的世界，他們正在那裡調查當地一種稱為 Ascension （昇華）的儀式。"
 },
 {
  "id": 10,
  "src_sha256": "e0b67a7d4a0613443493ed54e6b595f8280db98a933c2b96a1d251655b5e827d",
  "zh": "他們請我協助研究。但這其中有些危險，所以我帶你們同行，作為……護衛。"
 },
 {
  "id": 11,
  "src_sha256": "a237ab49265816096aca8d07718faa41fdd240e9f3bd52af940986af9d4761f2",
  "zh": "現在，請把自己繫上安全帶。我們很快就要降落了。要是 Dark Savant 偵測到我們的船，下降過程可能會有點*艱難*……"
 }
]
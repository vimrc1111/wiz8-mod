[
 {
  "id": 0,
  "src_sha256": "5e71bc2f89eb5b04ba9677bf9e5107a174e9a36d8577d711f53195274bc2f9b9",
  "zh": "這一切對我來說都好刺激喔！"
 },
 {
  "id": 1,
  "src_sha256": "bb960b435b92c2674c84e448e694ad8dee57a4b05b63743282e20e6936c4701f",
  "zh": "哇！你們一定會以我為榮的！"
 },
 {
  "id": 2,
  "src_sha256": "cfe27ddec91707be3120afcec130bc81f4cf6541b5656406a0e7656fb726bffa",
  "zh": "這些全是我的血嗎？！？"
 },
 {
  "id": 3,
  "src_sha256": "615f62d727f287857b549008dd1acd43067ecea1edf7e1ae06a9b432a6f04304",
  "zh": "我要死啦！"
 },
 {
  "id": 4,
  "src_sha256": "7c10f0966bcc3dcd2085ca5da6341f809b5b14da08019ea5de7164871c99a299",
  "zh": "難道沒有別人覺得累嗎？"
 },
 {
  "id": 5,
  "src_sha256": "91afdd32321fe9ae1158e83c34ed2e3d610118eea41451ee933c6a0ddeeb2fdb",
  "zh": "噢不！我是怎麼了？"
 },
 {
  "id": 6,
  "src_sha256": "f5685797a1d4035479eea82f4e56d30514eb54899c88396b006a827e7ee1570b",
  "zh": "這不會害死我吧，對吧？"
 },
 {
  "id": 7,
  "src_sha256": "66294ea8d842f6e7b09b7d63d9206936f1f77feafbac864fef514eed6b11f316",
  "zh": "我的天啊！我看不見了！"
 },
 {
  "id": 8,
  "src_sha256": "37dc63af5e14a573522c0c604abb829efbee6c67c30ca6960787e1a4130748d4",
  "zh": "我天生就不是用來扛一大堆東西的，你們知道嘛。"
 },
 {
  "id": 9,
  "src_sha256": "c7d28123b67b8612533e374a7ea6df91f302f2b459a4877943176a22cf680793",
  "zh": "我的天啊！我動不了了！"
 },
 {
  "id": 10,
  "src_sha256": "319c62cb6918df70adbc117dae2ffe6d5b05cb0c3b6212171f7894b859a17fd0",
  "zh": "哇！我剛好要這麼說耶！"
 },
 {
  "id": 11,
  "src_sha256": "8f461b8d00194c6038cf1be535d5f66fab57b1d43cc8a9ef146b5c082c7e8581",
  "zh": " Umpani 招募的時候，可沒說過會發生「那種」事！"
 },
 {
  "id": 12,
  "src_sha256": "4859a0c32d47edffb2977cb02f91fd2b0147dcf1515b9562121df3c942f5eccd",
  "zh": "我還以為只有 Trynnie 會那招呢。哇，謝謝你們。"
 },
 {
  "id": 13,
  "src_sha256": "0c80c4cffdef9ebbf5d699c9207f39423a570923e9686009709adff7f22d24a9",
  "zh": "噢不！我覺得你們犯了個大、大錯誤耶！"
 },
 {
  "id": 14,
  "src_sha256": "7ae276faee1007544b457abc1f4869b4088581082fef7fe5f3cd491c17d2ee37",
  "zh": "我當初決定加入 Umpani 的時候，有幾個人覺得我瘋了。"
 },
 {
  "id": 15,
  "src_sha256": "67d6838db7db28c8373ad512aae9f664e182fcb18b6eafa31d9ba7ef55e826b4",
  "zh": "你們知道嗎， Umpani 說他們很高興我加入。"
 },
 {
  "id": 16,
  "src_sha256": "166a76be55a6f731b0a5771912b77130c9500d5d17733db07fad20f1b43562d3",
  "zh": "噢不！我好抱歉、好抱歉！拜託別生我的氣！"
 },
 {
  "id": 17,
  "src_sha256": "2f13f501afc7ee3a96e4c002d71e88dd72dd687b40000c4dc3f070dbd49c1dab",
  "zh": "你不是故意打我的，對吧？"
 },
 {
  "id": 18,
  "src_sha256": "457c89924c0fbe79790e10a007b7dd92da027d12de012e9d9b0d5867ccf97336",
  "zh": "沒有人真的會死啦…… Trynnie 的 Shaman 可以想辦法的！"
 },
 {
  "id": 19,
  "src_sha256": "fa247d971911807e1fadf9e22f5019a8fcac2392166c5b479396feb59e25a601",
  "zh": "她不會離開太久的。 Trynnie 能讓死人復活喔！"
 },
 {
  "id": 20,
  "src_sha256": "c3a2d1229dd9b6fa3c67ba3c5bf695453b99d565a6853361b3bb2b0c6ca910be",
  "zh": "噢不！下一個不會是我吧？你們不會對我這樣的……對吧，對吧？"
 },
 {
  "id": 21,
  "src_sha256": "09a6cc63fd7999d9e732db0582451ada2bfc624fb249a881601c30f956706e99",
  "zh": "繼續上啊各位！別擔心！我們一定會逮到他們的！"
 },
 {
  "id": 22,
  "src_sha256": "b1cec61ad1fd3ea0f3f1984f886071a079abcadc9c0c8bb022124b34ebc5f88a",
  "zh": "呃，好吧。嗯，那我想我就、回基地去好了。不知道這會在我的服役紀錄上留下什麼影響？"
 },
 {
  "id": 23,
  "src_sha256": "845a7b4da6626946d71e6cd1f57f5ebc580b6b45bd829cbbb33ae72f3a311183",
  "zh": "我們可以拿嗎？"
 },
 {
  "id": 24,
  "src_sha256": "a8b48c72f73432fcedf41c25b1e32215e507ce4a74f4c9e83e27e5c2e4a8ffd2",
  "zh": "把它撿起來吧！"
 },
 {
  "id": 25,
  "src_sha256": "e808f2252ac90cb61f33364cf609d920f92ba36d404b1ff50b3d156e904d18ba",
  "zh": "噢。陷阱很糟糕，對吧？"
 },
 {
  "id": 26,
  "src_sha256": "9d01c7664c9d1f59506c2b9ff3fc014135fdb14bf3467a35a1a51b69ea7b18fa",
  "zh": "這東西躲不過我的眼睛！"
 },
 {
  "id": 27,
  "src_sha256": "7f25b80f1205cb6656582e504a6e5a21b37a9951930e37d7e9176b7cdae9e151",
  "zh": "噢不，不不。我對這個地方有種壞、壞、壞的預感。"
 },
 {
  "id": 28,
  "src_sha256": "19a060e87636b8f0c195986b11bd18f47c2b975c7d776dcb35f9335169f921c3",
  "zh": "唉唷。我傷得蠻重的耶。"
 },
 {
  "id": 29,
  "src_sha256": "38977b5d625198e24287ad6116b9fcc9ca14ad3abfad2327e25302d5beae7ae1",
  "zh": "好耶！我們去逮他們吧！"
 },
 {
  "id": 30,
  "src_sha256": "34ae231265bfbebedb134466cc24eb8b635f9cf756db5b5ea4c3b8061ebb2503",
  "zh": "敵人！職責！威能！勝利！"
 },
 {
  "id": 31,
  "src_sha256": "39bfc9c999fa05c6d19c971d5fdeb1dd3373b6ee7be84d32d6ad156797b6ca3a",
  "zh": "我、呃，覺得我們應該跑……"
 },
 {
  "id": 32,
  "src_sha256": "a9e31f9dffc8d600f11569708db9f16f9898ddc9a8c876209a59721a2e7275f8",
  "zh": "我的目標在哪裡，嗯？"
 },
 {
  "id": 33,
  "src_sha256": "4d6786cea24210601d9b01a029224a2516a7ac157f29ae0feea17e0fd61d3af8",
  "zh": "我被圍得水洩不通啦各位！"
 },
 {
  "id": 34,
  "src_sha256": "da539f44b5e7b3e6abdb94d5bec63e8c210cc2b2d284826eaed2ddfa23ac780c",
  "zh": "擦過我了！"
 },
 {
  "id": 35,
  "src_sha256": "53ad99c51174946d762266c31c5a2fd708fec88d0ff42aff6b395516c809a72e",
  "zh": "哇，我們好厲害喔，對吧各位！"
 },
 {
  "id": 37,
  "src_sha256": "40c65fea6248561be63a830a2b66eda2cf45ec7f31cdb86e5933844261f86baf",
  "zh": "哇！我打賭這下我會升官！"
 },
 {
  "id": 38,
  "src_sha256": "27189d999c47248c8d63163d3f3036d0f451ea2de8242cf8ea7104fb827b2290",
  "zh": "來跟他們打聲招呼吧，各位！"
 },
 {
  "id": 39,
  "src_sha256": "b464e40b791591b7f9b9d1ea00fa813b59d86133a4ff13fdf37c8ddd82f86aef",
  "zh": "噢不！我的傢伙沒子彈了！"
 },
 {
  "id": 40,
  "src_sha256": "ed9d00c950cab3a0cbc9b2fe4472cb0922a44c0fc0eddeaadd400846433052d1",
  "zh": "哇……噢不！有人擅離職守的話， Umpani 會超、超生氣的，各位！"
 },
 {
  "id": 46,
  "src_sha256": "b7d7fb629ce2da2b0ad292e1d4668ed22b53a98d407f787501c983b59518ba40",
  "zh": "我不知道這是什麼……"
 },
 {
  "id": 47,
  "src_sha256": "9c4386a735562595f8058188b12e74e59f16ab79e236c829211a2a0f5e2bfb93",
  "zh": "哇喔！這是 Destinae Dominus ！噢！那你們一定就是第三批命運的信使囉！我的天啊！ Trynnie 替 Marten 守著這個祕密，呃，已經有好幾兆年啦，而且只有真正的信使才拿得到！我這下要超有名了！"
 },
 {
  "id": 48,
  "src_sha256": "19b26d5aa297279197d24f8f8b8fc2d76735f05307523a6729e703a3b4257a65",
  "zh": "好耶！我拿到了！欸，你們沒看到那些大塊頭在附近吧？"
 },
 {
  "id": 49,
  "src_sha256": "7dbe598f042111fcbf5371571a26bb8607513ba37f3b0807505a56f80877c6d6",
  "zh": "哇，這看起來超重要的！如果你們要的話，我可以幫你們保管。"
 },
 {
  "id": 53,
  "src_sha256": "6a786a0548e99c6002ea668836a81e09697f1c943c0bb2c3d9820c17c7b08192",
  "zh": "我看不出怎麼可能。"
 },
 {
  "id": 54,
  "src_sha256": "871be7d0f0e54a6bd4f95b8d6ae62d2f139a443b448ee2d1e8034e9cedb39c2c",
  "zh": "騙子，騙子，騙子！"
 },
 {
  "id": 55,
  "src_sha256": "1f8cfa7ba84824d6fcc337d9f5384addc5e83d435ad1da37a73ee23361822d93",
  "zh": "哇喔！這個好漂亮喔！"
 },
 {
  "id": 56,
  "src_sha256": "5bed98577de0a3e1f60e151c6a0ab89252f1f0ffa988f82c0fda98ffcb733438",
  "zh": "你們看到了嗎？你們有看到嗎？是我殺的喔！"
 },
 {
  "id": 57,
  "src_sha256": "8867f8561ff1fd4fcbdf03fc4e8b087ac903a463165ff398ea89b64b97fb53bc",
  "zh": "那不是 Vi 嗎？"
 },
 {
  "id": 58,
  "src_sha256": "6112b874c77310bc6b7400c078be5e7f35065a75f592b85ccf80652a1f8e11f6",
  "zh": "好耶！那些壞蛋在這裡抓不到我們！我們安全了！"
 },
 {
  "id": 59,
  "src_sha256": "745b5f624e1be768de0d8806f2799e3bd905952c471e63e618bfb135d07dfb21",
  "zh": "嗯，我可以告訴你們我知道的 Rapax 的事。他們很壞！自從 Ascension 開始以後，他們就一直攻擊我們、傷害我們……什麼都幹！跟他們同夥的人絕對不可能是好人！"
 },
 {
  "id": 60,
  "src_sha256": "43b6b49ace7805998db15aa4702ba289818cfb5023f2c143e062ee0c794aad9b",
  "zh": "嗯嗯嗯……我可以回家了嗎，拜託？我不知道那是誰，也不想知道。"
 },
 {
  "id": 61,
  "src_sha256": "eaf2a29c4af8577e629a8e4dea64b0b1344afe8615e9d560ade949ce4522504c",
  "zh": "相信 Trynnie 的直覺！他說的是真的！"
 },
 {
  "id": 62,
  "src_sha256": "c2e10f033243d8b8b4c2637b0b6a664f264a5f19dbbe4d8d0dff2af0d65fccff",
  "zh": "他死了！他死了！他死了！呃，他死了吧？我是說，他當時在船上，對吧？"
 },
 {
  "id": 65,
  "src_sha256": "363cf8fc2e7657133fa195256039eafe9527244db4a1dc371e301475b5f3cb24",
  "zh": "好耶！我們完成任務啦各位！"
 },
 {
  "id": 66,
  "src_sha256": "6c16d617d0b2e9bb7082e3eeb872c3c6503ed6c5ba4fb611671aceabebc72693",
  "zh": "我不知道這是什麼。不過應該不重要啦。"
 },
 {
  "id": 67,
  "src_sha256": "110972cc9fd1fc8268c2aa08516080f9a3c455bdab887c66244947e566febc48",
  "zh": "我看到一些生物耶，各位！"
 },
 {
  "id": 68,
  "src_sha256": "1c96a4d7a5121629bf030681aa3903556b2ad84778b8462b4b492c079f70a92b",
  "zh": "小心喔各位！怪物！"
 },
 {
  "id": 69,
  "src_sha256": "42aa686c948a70388f7409515ec6104873b37bb332bd916da50233c63c1010a2",
  "zh": "你們會跟 Balbrak 說你們真的很喜歡我吧，嗯？我是說，我想要一份好的報告。"
 },
 {
  "id": 70,
  "src_sha256": "0ec957db3706ac2c8fcc91a7c4262c9d837264af5d034ab912fff562924a7303",
  "zh": "你們知道這個地方嗎，嗯？你們知道嗎？這裡是 Arnika ， Higardi 住的地方。不過這裡出了點事，現在人沒剩多少了。呃，也許我們可以稍微去偷看一下他們的房子，好不好？那會有點好玩耶。"
 },
 {
  "id": 71,
  "src_sha256": "8ff5dbb8002816746a99c0a0e6564ca1e9969ad74ac45456d8362a0af935bf3f",
  "zh": "嘿！這是我家耶各位！我等不及要介紹你們給我所有的朋友認識了。一定會超棒的！"
 },
 {
  "id": 72,
  "src_sha256": "f2b3fdf0af1b41f4c728502bbb964c5c0f0fbefe09f75f4df1a206baa0286b73",
  "zh": "這是通往 Marten's Bluff 的路喔各位。呃，我的命令說我不能進去。不知道為什麼，不過命令就是命令！我會回基地去，讓 Balbrak 知道你們來了。"
 },
 {
  "id": 73,
  "src_sha256": "512e30b4414cc84fb2462b0fc87184148a5211e64a379d34927af1c1d24e9164",
  "zh": "哇，我、呃，剛想到我要去參加一個特別訓練，遲到了，所以、呃，我現在要回基地去囉。"
 },
 {
  "id": 74,
  "src_sha256": "7c5ace191cd6db86c935d5b52d31b427850f9417b3f40dad9569494ec2b6933c",
  "zh": "這裡就是 I.U.F. 超、超祕密的總部喔。總有一天，只要我很努力訓練，我就能見到 Yamir 將軍了！那會很棒吧，各位？"
 },
 {
  "id": 75,
  "src_sha256": "0cb0ee959014411fbffc4e79e6ac0aff73851a3b3c35fbd56cf98d9d81812e35",
  "zh": "呃，我們的命令沒說到 Rapax 的事，而我們正要去他們的 Rift 耶。我想我們最好回基地報告，不過呃，如果你們想去的話，我自己回去就好。"
 },
 {
  "id": 76,
  "src_sha256": "d5275029304c5a83206869b5862b7637389476ad8813a7d0930d33b89f4a7008",
  "zh": "呃，不不。這是通往 Rapax Castle 的路。我們的命令裡沒提到這個。你們要進去嗎？我是說，如果你們想的話，我可以回 Mt. Gigas 去。也許你們有什麼大祕密任務之類的。"
 },
 {
  "id": 77,
  "src_sha256": "3441b504ed1ffb80bdf4864974a938b72a4f4af3980dffb2782e5fffa50dbbf7",
  "zh": "呃，各位？這是通往 Bayjin 的路。你們想去是沒關係，不過 Trynnie 不下水的。我們呢，呃，很容易被當成魚飼料。"
 },
 {
  "id": 78,
  "src_sha256": "b724d1a82fd6e8a7a02d28f427d20912b40695fa4995c484424f915099563e2e",
  "zh": "這是通往 Ascension Peak 的路，對所有人來說都是很崇高的地方。呃，不過 Trynnie 也認為大地是崇高的，所以我們不會上去那裡，你們知道的。希望你們能理解。"
 },
 {
  "id": 80,
  "src_sha256": "b1c13a2863cefab4968c39bc7a06decde4be6b43bfbe8ab58ccd103a111421d2",
  "zh": "這片沼澤是個壞、壞地方。到處都是等著把你們吃掉的東西。"
 },
 {
  "id": 81,
  "src_sha256": "ee19fab95fe6a190030561a34c8a592eba2b1286c8d16f1b0420954900c94042",
  "zh": "噢不！各位！各位！我聞到 Rapax 的味道了。我、呃，噢不，我、我最好離開。你們可以去。去吧，不過我就是不行。 Rapax 是我們最可怕的敵人！"
 },
 {
  "id": 82,
  "src_sha256": "512e30b4414cc84fb2462b0fc87184148a5211e64a379d34927af1c1d24e9164",
  "zh": "哇，我、呃，剛想到我要去參加一個特別訓練，遲到了，所以、呃，我現在要回基地去囉。"
 },
 {
  "id": 83,
  "src_sha256": "fe6dc44f8de293459b44597943a87b99982eb3df4eddce83b527bb50a094442b",
  "zh": "我的天啊，你們是在開玩笑吧！？你們不能丟下我！我會被殺的！"
 },
 {
  "id": 84,
  "src_sha256": "b08cf6fd7be49844f59c8500c6b780f9656646f123e5c0ba27b7433565c0422e",
  "zh": "你們知道嗎，我有好一點了，不過還是覺得有點不舒服。"
 },
 {
  "id": 85,
  "src_sha256": "4b4d0848dd1de6f172755838f676fbab40d9a1e2416dcd8b53c3fb8250cebfa0",
  "zh": "嘿各位？我不覺得不舒服了耶！"
 },
 {
  "id": 86,
  "src_sha256": "ca5c44e19247d579e1021108b065cef72cf49ea4803190e8046b9765477449ac",
  "zh": "我們在哪裡啊？嘿……我們不該來這裡的！噢噢！我們慘了，慘大了。"
 },
 {
  "id": 87,
  "src_sha256": "6c51bcb20cd5a39a902e04506e01c5e6f7607d43e613853200b9c3259fbdfee4",
  "zh": "還要多久才能離開這裡啊？"
 },
 {
  "id": 88,
  "src_sha256": "c0b0b3ee122747289e7345d0b8804a516f591eb9739f79e63b46cbbdc39a7a2e",
  "zh": "我們快要離開這裡了嗎？？"
 },
 {
  "id": 91,
  "src_sha256": "2b12836d5b150335861e69898f06f643a73b377960130bfe86a90c5e7226286f",
  "zh": "呃，嗯……噢，不。那個，呃，首領？你們看，這些是我的朋友。他們不是來傷害我們的。我是說，我可以親自替他們擔保。他們、呃，不，他們不是替 Rapax 工作的。他們跟我一樣，是替 Umpani 工作的！"
 },
 {
  "id": 92,
  "src_sha256": "0fd7147fd14882d6c33714d10c47d990979c8cf8e51f5e94d60a6327e1dea361",
  "zh": "嘿！那是我的！你不能拿走！"
 },
 {
  "id": 93,
  "src_sha256": "627d61f9173d33a5acc60fadd9b190bc119cf14831521d2c5ac9191373a92bc5",
  "zh": "我說了我不想待在這裡！"
 },
 {
  "id": 94,
  "src_sha256": "8f06fd2e85301e372365b705a620b8101f0f97b468ecd435cc1b3fcd59a8ab27",
  "zh": "他人真好，對吧？你們知道嗎，我覺得他喜歡我們。反正他喜歡我啦。他是 Higardi 的聖人，有點像我們的 Shaman 。"
 },
 {
  "id": 95,
  "src_sha256": "c4088f950c43cf91e8b993daaa4a038d2d0b0648318390ff1f1320de9213a37b",
  "zh": "他是個很棒的首領！"
 },
 {
  "id": 96,
  "src_sha256": "cd4923ec6ad1e78dc42460ef4f30dd4536225758a16321d860d312343ccc1949",
  "zh": "我不喜歡他。一點都不喜歡。"
 },
 {
  "id": 97,
  "src_sha256": "0f9ad09f56c01dde3269a36dee6aff19b1063dbab58493867ddb5d76af5cfac2",
  "zh": "你可以把一整個我塞在他腳底下耶！不是說我想被塞在他腳底下啦，但你可以就是了。"
 },
 {
  "id": 98,
  "src_sha256": "6576ec7624bc8230c252794419222a57bff80ad6e4006405dda29b0b29bac4fe",
  "zh": "嘿各位？看看這個東西！我打賭它有什麼用。"
 },
 {
  "id": 100,
  "src_sha256": "e74078635c10080e9ffcb00f9e14a606a38cbd7f184e97e95878b3b494a3d083",
  "zh": " Helm of Serenity ！哇！這太棒了各位。我從來都沒機會拿過它耶。我可以拿一會兒嗎，好不好？可以嗎？"
 }
]

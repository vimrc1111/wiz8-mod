[
 {
  "id": 2,
  "src_sha256": "845f182e2c33daea4619e9d9f17a763a946da0f6152e478fd2446ed2a623a0c4",
  "zh": "長官，請繼續前進。"
 },
 {
  "id": 3,
  "src_sha256": "6729f041181ca10acd1ceff6828285155de636d8ede7d0426572bd30a0717a81",
  "zh": "長官！無事可報，長官！"
 },
 {
  "id": 4,
  "src_sha256": "02299db1df77038f04a7627d1c4abeff1a162520b7a7f3255ccf627d12ef53a7",
  "zh": "各位士兵午安。這一帶你們可以進入，請通行。"
 },
 {
  "id": 5,
  "src_sha256": "3201980fd91e39fea99474803850de5829571b1fa24a835bc3dd5780cf83ad31",
  "zh": "請前往你們的目的地，各位士兵。"
 },
 {
  "id": 6,
  "src_sha256": "f96232cb005f59a155e8f831cc01dc05a795a362d55e0f8b5b257da2f15a1626",
  "zh": "嗨，各位士兵。"
 },
 {
  "id": 7,
  "src_sha256": "f8b03f789a7c4e1ebec6b8b0b062a51f9c7c421fe305743d569a31fb9fe4c0a9",
  "zh": "你們有任務在身，士兵。最好照辦。"
 },
 {
  "id": 8,
  "src_sha256": "d603d8e6fdac01dd54b01cada4e6d923b1ad53141ce4b62eca929d3a714ee435",
  "zh": "你們把戰爭帶進這裡來了嗎！？"
 },
 {
  "id": 9,
  "src_sha256": "6c7e3e75d474f5d683caa7be8f41809a745c0ae3517d54dcfc02d725b2f04a50",
  "zh": "站好別動，讓我把你的腦袋打飛！"
 },
 {
  "id": 10,
  "src_sha256": "76a6307e4ca0ed9b4af75e882274f51ccc63e054281887a378de8b6d43f6c588",
  "zh": "這會教你們別招惹 IUF！"
 },
 {
  "id": 11,
  "src_sha256": "5887022fc4feb2d156ccedd737f6efff321247adddce83ca34b331a71ac822ce",
  "zh": "你最好先打電話叫你媽來，小不點！"
 },
 {
  "id": 12,
  "src_sha256": "461ec803d805ebc4c1c99bb3419e007f37b2917daea8a29c3c979e3b9572c28d",
  "zh": "是陷阱！是陷阱！中止降落！噢，不……"
 },
 {
  "id": 13,
  "src_sha256": "10d7d935e735428a376f2e39394d49ca626d1f15b34d57a4b79f50e61fc16f87",
  "zh": "幹掉那隻蟲子！！！"
 },
 {
  "id": 14,
  "src_sha256": "bd04159fc6d085a837e909591d0dcbed730a8c20fc5cddac9b1fd7e73c89cd91",
  "zh": "噢，天哪……怎麼會這樣？我……噢，老天。我這就通報將軍，長官。"
 },
 {
  "id": 16,
  "src_sha256": "90376d76ee028e8035eb8563a5f53c5e734428c52b9f1fe83f1e429bcd0b6097",
  "zh": "控制塔嗎？我是 Emmons 上尉。這裡沒有命令。我要回軌道了……"
 },
 {
  "id": 17,
  "src_sha256": "f16286ec5b16a0664d02edd8582394cab31b244bc2dae77af0bbf944d3cbc21b",
  "zh": "控制塔嗎？又是 Emmons 上尉。我還會待上一陣子。完畢。"
 },
 {
  "id": 18,
  "src_sha256": "79dc386280b7b8f78b994ebdd7349872ce96031a9ef8ba36a2ac29a8cb5387a4",
  "zh": "這裡是艦長。我們收到 Dominus 基地的確認，Savant 的飛船正在這顆行星的軌道上。全體船員啟動降落程序。防禦系統，紅色警戒！"
 }
]

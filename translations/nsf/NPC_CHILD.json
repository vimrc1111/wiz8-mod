[
 {
  "id": 0,
  "src_sha256": "8a7a1ccb4e933b467e875374fb21074dfa55adfc20e3d227bb8dbf9c13384d38",
  "zh": "是你！！就是你！"
 },
 {
  "id": 1,
  "src_sha256": "ae40bc012178389df4583b1cd4e4653541960bdc7f30d237aa4f540a8d172cbe",
  "zh": "你們別想從我們這裡過去！"
 },
 {
  "id": 2,
  "src_sha256": "af4ea16fd1511d73ecd671e7fd9a7ab5fdfa44bcfa02476ddc56a4b0f9c4b365",
  "zh": "你以為你可以一走了之，對吧！先是殺了我母親，然後把我整個拋棄！再看看你那張臉！！你連我是誰都不知道！對吧？對吧？！"
 },
 {
  "id": 3,
  "src_sha256": "6f40c0c06d88daf1e49c247b38194caeb31692c575c9791362a0c59fdf8f5bd7",
  "zh": "你不記得你和我母親 Al-Sedexus 那段風流韻事了嗎？這樣有想起來了嗎？我就是你！我就是她！我是你的女兒！"
 },
 {
  "id": 4,
  "src_sha256": "759a9e331d21ab75f9e1d09c39477f584651f635d187ff59e238e428b39a5198",
  "zh": "你們不記得和我母親 Al-Sedexus 那段風流韻事了嗎？是你們把「他」送進她的懷裡……這樣有想起來了嗎？我就是他！我就是她！我是他的女兒！"
 },
 {
  "id": 5,
  "src_sha256": "e85e538d0fd2a9da7e5df217004fce1d328c021fbb3d6801461b0c518fbf619c",
  "zh": "而你連想都沒想過，對吧？你留下了什麼……現在輪到我來「回報」你了！你永遠到不了 Cosmic Circle ！"
 },
 {
  "id": 6,
  "src_sha256": "1e14a95c24695bd1c0087cc2e6754e5b12910da96f79c941615dc83671cf7303",
  "zh": "這次你別想逃！"
 }
]

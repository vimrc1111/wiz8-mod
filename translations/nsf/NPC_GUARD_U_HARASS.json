[
 {
  "id": 2,
  "src_sha256": "19d8bf407873a3a2f180a4a85109ae59ddcb810855db26cd882ff07e31a57385",
  "zh": "我們知道你們跟 Rattkin 的小交易。我們也知道你們還在跟誰打交道！"
 },
 {
  "id": 3,
  "src_sha256": "7de23884167d7f6e71d085f5f87b25dfb50c9afd38cd935cf41424c067ab334c",
  "zh": "原來你們在這裡！把 Astral Dominae 交出來！"
 },
 {
  "id": 4,
  "src_sha256": "6b4a69b551e423bb31802e5bd522da795092901ad31df771edd7e01d7aacea3e",
  "zh": "所以他們派你們去跟 Mook 幹那些骯髒事？！可惜我們已經毀了你們所有的計畫！！"
 },
 {
  "id": 5,
  "src_sha256": "ae73eab2d41db9c74ba6922d40cca14a8abb9c91d89ac64492fd5be9123a19cb",
  "zh": "你們拿到了 Chaos Moliri ？現在可沒了！"
 },
 {
  "id": 6,
  "src_sha256": "5c337014448b709759157454f724addd1435e3ef527129c67e3848cc69cd7bae",
  "zh": "別否認！你們手上有 Destinae Dominus ——不過你們留不住它！"
 },
 {
  "id": 7,
  "src_sha256": "090bd97aa22b6a2165183af68929e31c6939ceea63760ab4df98fe1687871b23",
  "zh": "交給我們！我們知道你們至少有兩件裝置！"
 },
 {
  "id": 8,
  "src_sha256": "662e752a69736e14f1372e95cdc2357bede027964890f2778cb8f369feb91414",
  "zh": "Yamir 相信你們手上有全部的裝置……而我們可不想證明他錯了。上吧！"
 },
 {
  "id": 9,
  "src_sha256": "17a7937c16c206feef9f493e2224015c377b55d76f2ba948be0a84ba935c37ba",
  "zh": "所以你們就是這裡的威脅？去告訴你們的首領，我們已經去過 Cosmic Circle ，並以 Umpani Federation 之名佔領了它！"
 },
 {
  "id": 10,
  "src_sha256": "48aa1498df272185b8ca9ac7789cfe13f359ce97a6a250a4434b7c1748f24976",
  "zh": "Rapax 和 T'Rang 已經結盟——而且他們打算很快殺了你們！"
 },
 {
  "id": 11,
  "src_sha256": "306d58c77e5848e51ebfa68cfbb676db8fb7894d9e083f082363a961a3234eb4",
  "zh": "Trynnie 擁有 Destinae Dominus 。你們必須殺了他們才能拿到它！"
 },
 {
  "id": 12,
  "src_sha256": "830ce341227cc54b3c41071d148c091754e4ecdcea8f53fc1810d825e1030234",
  "zh": "Yamir 已下令處死你們！"
 }
]
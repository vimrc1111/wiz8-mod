[
 {
  "id": 0,
  "src_sha256": "00597140df20a9e30648e6b677f4ce3f021369287cb1c724c17fd9cbae5fd589",
  "zh": "你們是新來的吧？我從不忘記一張臉。"
 },
 {
  "id": 1,
  "src_sha256": "0af97790b9c4e35baba38b46c9683b5f13ffabc64bddfdfd16a71f70ccda9391",
  "zh": "這麼快就回來了……"
 },
 {
  "id": 2,
  "src_sha256": "3c1572fb29a0d1e372cfce0d47ebfaa2a846c7bb775236a6743f1603600a8ebe",
  "zh": "又是你們……"
 },
 {
  "id": 3,
  "src_sha256": "a3728694ae4d5b5ebb719ce133ecf6d4c7582c554779b6e9786c1ea5d6a83a5a",
  "zh": "現在才來，晚了點，老兄。"
 },
 {
  "id": 4,
  "src_sha256": "2e8d64c91bc46fee8e0b2cfd480591a359af6b881475f205f1a1ad2d9b2f3a59",
  "zh": "哦，真公平啊！你們一票人，我只有一個。我跟他們說過我需要更好的保全。"
 },
 {
  "id": 5,
  "src_sha256": "7e1cfaef90f1448e3c0ba84fe42e9e2bdfd5c291416a5660042ba12e961835cf",
  "zh": "你們現在又想幹什麼？！"
 },
 {
  "id": 6,
  "src_sha256": "e35e949be16493091d95e900843189d6e8f0a8c020785c0df5c246f2c785df17",
  "zh": "你們根本沒有你們想的那麼嚇人……"
 },
 {
  "id": 7,
  "src_sha256": "a2223b2fceb8caed2ef5a838d4b364d56d2f713ea1d7682ff32247148560d187",
  "zh": "這連行情價的邊都沾不上……"
 },
 {
  "id": 8,
  "src_sha256": "1530965ad53d2fd093b1768fbaa5cd03f0d91c84869ba24808718b4ab2aa8ad9",
  "zh": "把這堆垃圾拿出去！不准打架！"
 },
 {
  "id": 9,
  "src_sha256": "8e6c88420f1caf8b0839ea731094afd862b564a909e898dd0ed1e18a6aa354ab",
  "zh": "是喔，好讓大家來洗劫商店（ store ）。真是妙計。"
 },
 {
  "id": 12,
  "src_sha256": "c72a2384b0f8c9c54d1d00a7fbe9ad8b600c6636e38b73ae3d899e72de06685b",
  "zh": "一如往常，與你們做生意是種享受。"
 },
 {
  "id": 13,
  "src_sha256": "657f4417ccd31f807995b83fb62e08bd42d4e160da8d8fb9bf7caff3a78d5155",
  "zh": "我不要那個。"
 },
 {
  "id": 14,
  "src_sha256": "d0e27b107e00c569a9f924d8231441a35c2be1191f893434ca4886c0e676ce7c",
  "zh": "沒錯， T'Rang 同意付錢請我做事……"
 },
 {
  "id": 15,
  "src_sha256": "a30669ada2dae964b0ef89ba56104158ba3eaaf09eef58eaad1ee79a6fd34f1f",
  "zh": "今天到此為止……配額收滿了。不再收購了。"
 },
 {
  "id": 16,
  "src_sha256": "0da9823e328f1da304161b1def2a288ec91ce6f632f11aefdf1a425da3163306",
  "zh": "這不夠。"
 },
 {
  "id": 17,
  "src_sha256": "6cba6f894155a2a919658661b539c430946abdf419ae39a730855573730ed1a7",
  "zh": "你們以為我不知道那東西是哪來的？真是侮辱！那是你們從我這裡偷走的！"
 },
 {
  "id": 18,
  "src_sha256": "90f99cd67ff4df00dc8df5000515d577e186ed7d28a9d4177ecd6a3c9c8d96e9",
  "zh": "我不跟你們搞這種蠢事。滾出我的店（ store ）！"
 },
 {
  "id": 19,
  "src_sha256": "3eb05169afe25f3e1bcfb774064d7f0f33654a897d1ccf7c25a4dfc5f4f1d0fb",
  "zh": "夠了！我就知道你們信不過！給我滾！"
 },
 {
  "id": 20,
  "src_sha256": "1926b917cec1455be3fbb06d98d136a2e6e6c68c82194302d6f796c5747373f7",
  "zh": "站著別動，我好瞄準！"
 },
 {
  "id": 21,
  "src_sha256": "8cb3a288a43441537cbd929b0da7901bbfa41d45b9359aabe2daafd9d6900f04",
  "zh": "我不需要你們的錢。"
 },
 {
  "id": 22,
  "src_sha256": "f2568860b9e3415a7d19f6cda5db3b0e95703aa348ccff52b968b8286f0ae68a",
  "zh": "去 Roadhouse 問問吧。"
 },
 {
  "id": 23,
  "src_sha256": "f257f77affc91905976a2ba19245d43bf1fda49985ecf2c728634436df355324",
  "zh": "我又不是旅遊嚮導（ travel guide ）。"
 },
 {
  "id": 24,
  "src_sha256": "5b1bd228cca06fd09f64d3ac80386322ac60f7b92324a3e263caf53e8e5ea932",
  "zh": "那是機密。"
 },
 {
  "id": 25,
  "src_sha256": "e5e61a20fe830c8fe75d77e73ac3255ca9917cfd1a404aedebad7e8dadaa4667",
  "zh": "把耳朵裡的耳屎挖乾淨！我說……"
 },
 {
  "id": 26,
  "src_sha256": "979b8fc53d2d6856c0d66d650c150bc58a089df71690fa0aa64062ee814ce922",
  "zh": "你們想先知道什麼……"
 },
 {
  "id": 27,
  "src_sha256": "e590dd195b352ef692b5b9295aac822198b2db4c8ba11e87194ad2fda653d078",
  "zh": "然後……"
 },
 {
  "id": 28,
  "src_sha256": "0f544886524ad01ae3d17f549feabc03a004d86eb3d55caa4809041cfaa2325b",
  "zh": "哦。嗯哼。"
 },
 {
  "id": 29,
  "src_sha256": "54cbfda0784902c3301eb9fd0d57d98b81c1c14d5e47415b988932197a24d31b",
  "zh": "聽著，我還有存貨要點……"
 },
 {
  "id": 30,
  "src_sha256": "04d503198127947a91c32b40d344185683ed5d39ed8fe5485a3b3b6739ccd0fb",
  "zh": "我敢說你們還有別的事要辦……"
 },
 {
  "id": 31,
  "src_sha256": "25f0d5e59cf4b5954d28b14f3e836140dd1ec8b8d70a3f51c82e258a394e6df8",
  "zh": "低頭看。就是那樣。"
 },
 {
  "id": 37,
  "src_sha256": "04a65bf26fc0c37d1c71c7555fd9586164841919eca5228a08536765302da117",
  "zh": "出門左轉。"
 },
 {
  "id": 46,
  "src_sha256": "0e06893d8b427e93c91a78f757e599b296c8f4f921e843afcee0c2b32aa75bb4",
  "zh": "別提了，別讓我開口。我們就是一群被動的和平愛好者。在 Yamir 上任之前， IUF 可完全不是這樣。 Yamo ，那才是我們的人！"
 },
 {
  "id": 47,
  "src_sha256": "1a9fb2da9b111c8ef1876b0653ee3c2cd5aad1ed9a5fbcee69b64ae7a4e2bbfd",
  "zh": "記住我的話，要是 IUF 再不振作， T'Rang 會爬到我們頭上……"
 },
 {
  "id": 53,
  "src_sha256": "c504e329af95e0b2539bc65b60f0503784990d785cea6d892a5edb989d10dd94",
  "zh": "那是個老任務（ mission ）。要嘛你們知道，要嘛你們不知道。我不會告訴你們……"
 },
 {
  "id": 60,
  "src_sha256": "e7cef1332d4c3f3d40781e4bee53a968487669f1130491299717f485646622c0",
  "zh": "他在裡面某處，跟他那些哥兒們在一起。"
 },
 {
  "id": 67,
  "src_sha256": "454dcfc5fa5fddcbec6e33ae46f2e4f2a49690bbb44c4ca3241389e966de7174",
  "zh": "我已經賣光了。"
 },
 {
  "id": 68,
  "src_sha256": "fdd7b9537392610e1d4886ea389933ccb349ae926005bf5f7985f5b801732a55",
  "zh": "最後一個昨天賣掉了。"
 },
 {
  "id": 69,
  "src_sha256": "9d852ed5b5ed892f1441520016edc8f95bbf02efa6d146aa61012e1672664950",
  "zh": "我訂了貨。幾天內會到。"
 },
 {
  "id": 72,
  "src_sha256": "7a11e8b4382f62b13a5deb37a1c91ddb9fac5be9723842c1bb3aa75c4550ac38",
  "zh": "你們想聽故事？去 Roadhouse 。"
 },
 {
  "id": 73,
  "src_sha256": "ec024c4c9dd30ff9de0efdd410c544430ab314aa4f302813082c07e29f656305",
  "zh": "Kunar 中士（ Sgt. Kunar ）。"
 },
 {
  "id": 75,
  "src_sha256": "9de1b4249a4ae736bd88f607f7438b4c6b3b279e65ea715e828155580f4e74fa",
  "zh": "你們可真是群狠角色，沒錯。"
 },
 {
  "id": 76,
  "src_sha256": "bc234fad7326ec33feae7312434daa89817e26493e45a2072381e951b42aa2d3",
  "zh": "也許晚點吧……"
 },
 {
  "id": 77,
  "src_sha256": "c15316edbc603202555319e1d09e74b62c8897e2bdbce2c5ab7b9f7be8361451",
  "zh": "嗯，嗨。"
 },
 {
  "id": 78,
  "src_sha256": "f3f334da79d82bc361a6bf2f81f7f866419878d0a1b7b1ca10081d648768d2cb",
  "zh": "別讓門打到你們……"
 },
 {
  "id": 79,
  "src_sha256": "6ae81e4736e82605c6d5630657890bc5ab934459d3460b3aeb3b605ec30dc96c",
  "zh": "抱歉，我的幫手（ help ）賣完了。一兩個禮拜內都沒有新貨。"
 },
 {
  "id": 80,
  "src_sha256": "af12c426e4815f817290bb8f6116864eeafee29f54e7c7e87b98808b23b70fd4",
  "zh": "你們來對地方了。"
 },
 {
  "id": 81,
  "src_sha256": "25904985fb5143b309605f2c7f741c180b9e63afd52dab86580785885fb575a9",
  "zh": "我在這兒。"
 },
 {
  "id": 82,
  "src_sha256": "3e7379790bde2c094dea8d9b57d614d2af93e7c657fb7d73fbe0ac4b7eec7f3f",
  "zh": "我不碰那種東西。"
 },
 {
  "id": 83,
  "src_sha256": "cb711630b7d2bd88190750f5fc09971c2cbca7b23b2ea6b1e5b6667d5a4c8e02",
  "zh": "你們在說老派的戰爭（ war ），還是 IUF 現在搞的這種維和（ peacekeeping ）狗屁？戰爭——真正的戰爭——就是炸彈、突襲，不惜一切代價阻止敵人。*我*學到的就是這個，那時候 IUF 還是一部真正的戰爭機器，不像我們現在這種軟趴趴的組織。"
 },
 {
  "id": 87,
  "src_sha256": "0a9e012e6510d668723c8030e8f5067cf75ae0ecc99dbb182a81c54f46fe0782",
  "zh": "Destiny Arrives Tonight"
 },
 {
  "id": 88,
  "src_sha256": "0a761e15f6cb6ef970e2db29e76460a3433c7aad8061fb7475d98a94f8091e77",
  "zh": "他們到底在哪？ Z'Ant 說他們現在該到了。我不該相信他們的。"
 },
 {
  "id": 101,
  "src_sha256": "9ac7f1e0304d31cb191f27296c8d4127b18fa37562dcdb442b6b12fddb5d3777",
  "zh": "就在這裡啊，天才。"
 },
 {
  "id": 102,
  "src_sha256": "6d9bd53a673367678f5373282a691081d5f484afab9dbd6669042be29a6d1360",
  "zh": "我不知道，也不在乎。"
 },
 {
  "id": 104,
  "src_sha256": "1fbe95f4a328e394deb1ea728163f3456e7ff432b197f81c0d870a9e58569783",
  "zh": "如果你們要找補給，我幫（ help ）不上忙。 Commissary 只供現役部隊使用。不過我倒是有一面 IUF 軍旗的複製品——將軍想出來的蠢主意。我猜他覺得這樣能培養忠誠。"
 },
 {
  "id": 105,
  "src_sha256": "d7a0b0b2c05603fca469960390f98cee7b75704e4ce92362ea2468620939c762",
  "zh": "哦，對了，順帶一提， Balbrak 替你們訂了一張商店儲值券（ store credit ）。"
 },
 {
  "id": 106,
  "src_sha256": "ab57659096fd8221012f758eb80a8bb9ffaa584b490a531e48aaaf710770db18",
  "zh": "等一下！你們是 Guardia 的老兵，對吧？嗯，恕我直言，你們當年對 Yamo 可沒幫上多少忙，不是嗎？自從他死後，整個 Federation 都變了。現在我知道該謝誰了。"
 },
 {
  "id": 108,
  "src_sha256": "b2ec527450641572f7d538da406c4c3f1487cffcfa41d75763eca41e07752f57",
  "zh": "誰這麼告訴你們的？"
 },
 {
  "id": 109,
  "src_sha256": "f847a65423fce3730c681b2f29a1da2d3a1114ca54f3f7bcb656ccb46fe71f39",
  "zh": "而今天……開始了……這場戰鬥……現在小聲點！這地方隔牆有耳，懂嗎？誰派你們來的？"
 },
 {
  "id": 110,
  "src_sha256": "2945fb6b943e85ff2719959f5da3749ab6f7e2e5731a4747fecc2adc8bdfc479",
  "zh": "是嗎？你們是想跟我玩什麼把戲嗎？嗯？要是你們敢對這間房間外的任何人透露這次談話的隻字片語，我保證天黑之前你們每一個人都得死（ die ）。"
 },
 {
  "id": 111,
  "src_sha256": "5e2383e0a61d31426daa22b3af583bf08571f942d1860fdea3e049852a84aaef",
  "zh": "對，而且我確定他們有提到我們的協議，那筆小小的報酬，對吧？"
 },
 {
  "id": 112,
  "src_sha256": "1168336fb2a0dd18bcc36308fbff6e38555ba352c5c404d03fc84f5c1fb1e800",
  "zh": "我明白了……"
 },
 {
  "id": 113,
  "src_sha256": "2a8697beb0f2f47dbec89e9e1066f45644ced27cf206e11637730acdc488b1e1",
  "zh": "你們有錢嗎？"
 },
 {
  "id": 114,
  "src_sha256": "06d2e3014ef3692c6a0bf666afa60a086782040b112059baa70641956f63890e",
  "zh": "好。這是通行證。有了它你們就能進總部。爬到最頂層，到了那艘船，就把門閂繩索切斷（ sever ）。別忘了。你們還需要這個：「 Transfer to Base 」……那是控制密碼。需要更多背景（ background ）就跟我說。"
 },
 {
  "id": 116,
  "src_sha256": "7098419a9bb1b3548a752d34de93a465ad57ae40c8e397701c4c4867b023feca",
  "zh": "情況是這樣。大概五年前，就在 Yamo 將軍被殺之後， Umpani 任命了繼任者……將軍 Yamir 。嗯，這很自然。他是頂尖人才，我不會挑剔他的能力，不過這兩年來，他把 IUF 搞成了笑話！"
 },
 {
  "id": 117,
  "src_sha256": "88759fda7176b94705d1e9c9a36ffe3c9b44b25289c62227281497b925e6f190",
  "zh": "我們失去了鋒芒、衝勁、 Power 。 IUF 把自己出賣給了自己，我絕不容忍……也不容忍 Yamir 。我會盡一切所能確保 IUF 的原始目標（ original goals ）得以實現，即使得跟 T'Rang 合作也在所不惜。這是我願意付的代價。"
 },
 {
  "id": 118,
  "src_sha256": "602954a4b62301686a7b6c26f30282b1084e59f0ed26d2d762ee6e35fb682cf0",
  "zh": "我不知道你們這些士兵在說什麼。"
 },
 {
  "id": 119,
  "src_sha256": "24b779022ba4021f32b313d32b219b4325c7df5c6290f9c1a427f08dde1f06a8",
  "zh": "你們在說什麼，士兵？你們的行為非常古怪，有其他 IUF 弟兄在場，我想你們應該要表現得最好才對。"
 },
 {
  "id": 120,
  "src_sha256": "22ca4e320a2d7b3502497a559c977be930645b35e986a9e5c7822664d4b463a3",
  "zh": "跑道上有條繩索，一條卡榫繩。你們得把它解開或切斷（ sever ），不管怎麼弄都行——總之確保它不再連著。這很重要。"
 },
 {
  "id": 121,
  "src_sha256": "99d42a6e0135a0a430e234964e129289214acfcb550f978bbb1de698fac875c5",
  "zh": "你們只是恨自己沒先想到罷了。"
 },
 {
  "id": 122,
  "src_sha256": "e36e61c915d2bd1e14fdf98b806f842cc7d433cfed5d3225c0b384da3303f065",
  "zh": "不關我的事。"
 },
 {
  "id": 123,
  "src_sha256": "894a21fd02faccbcb43dba63e8ee1a06c6b0daa1cff593d2144322e44c02f001",
  "zh": "對，一面旗子。我不知道他期望人們拿它做什麼。"
 },
 {
  "id": 124,
  "src_sha256": "5bf856010cc7f9267a840277607beb0d18dcebf5dcbb211f5f28c426600767a6",
  "zh": "戰爭（ war ），真正的戰爭，這才是我們該做的！占領一個地方，若你不能突襲、轟炸、掠奪，那有什麼意義！所有偉大的帝國都是這樣建立的！可是在這裡，不！我們採取靜觀其變的做法。靜觀其變個屁……"
 },
 {
  "id": 125,
  "src_sha256": "3c89d7866be43ecbfe45fe674629bd5b92f4fa7ca92de1acfb4a576a853c848a",
  "zh": "你們該拿的都已經拿了。"
 },
 {
  "id": 126,
  "src_sha256": "09cba79350e67e2ff00fcc004e7e26a3e494058b3b3fc74d4e5458f343854d33",
  "zh": "從前， Umpani 非常好戰：我們想要什麼就去搶去奪。我們成了宇宙中最強大的勢力。現在呢？我們成了愛好和平的人，而這正在拖垮我們。"
 },
 {
  "id": 127,
  "src_sha256": "ecd3344b5e7e582d014a1b6aa505e17542e1b67d228048ca196177c1d3e02a6b",
  "zh": "你們想要任務（ mission ）？買點東西！"
 },
 {
  "id": 128,
  "src_sha256": "19e7b0213a2ac9e9f7ec4cfba074f472d9a1ef6bcc2a9ba42fdf95f847cfb729",
  "zh": "我不想再討論下去，士兵。"
 },
 {
  "id": 129,
  "src_sha256": "fc9848dffe5fcd8948eca9c61c1ad985b076bf7063ae7c73195f2e6cee2dd200",
  "zh": "我不指路。"
 },
 {
  "id": 130,
  "src_sha256": "6d5e90298b1ad2104408b175d607a28f794cd17f4c9633fdc10eeddeb3a68e2e",
  "zh": "Yamo 將軍……IUF 有史以來最棒的將軍！他現在在 Guardia 了，願他安息。"
 },
 {
  "id": 131,
  "src_sha256": "bb22da83653e4ab3118f4e325ae5584c826cfbe084d43a0e9416bb8becfceadb",

[
 {
  "id": 2,
  "src_sha256": "c44a2d9ec3c73386512a473b558824cbac54f1a0fed036ecb1635a4e7c46b04a",
  "zh": "恕我直言，士兵們，你我可不是同一邊的。給我搞清楚。"
 },
 {
  "id": 3,
  "src_sha256": "8e113e6470bd67f5e98500317e713fd2d2d95903bdb5b60487156cc35d7366b5",
  "zh": "把那副笑臉收起來，塞到你自己看不到太陽的地方去，小兵！"
 },
 {
  "id": 6,
  "src_sha256": "a464b8c7e511c44b729eb918221fe1de59cbce93b0eb629306a69bf858291321",
  "zh": "你嚇人的程度跟隻蟲差不多，小不點！"
 },
 {
  "id": 7,
  "src_sha256": "04b9338265cb724526ea2fba89fb95574e1936f78ef1857e8a8511082c577c2d",
  "zh": "你們想賄賂我？！"
 },
 {
  "id": 8,
  "src_sha256": "ae991feb1e4bd76c2370816096cf61d01165d4b07dea21b9483abbe563b27222",
  "zh": "先給我停止內鬥，士兵！這是命令！"
 },
 {
  "id": 9,
  "src_sha256": "f4190f4e39a27c057ffefca130a12a04fb03d39a454fe872280112bbb817b9c5",
  "zh": "謝謝你們的好意，不過我在這裡還有些事要處理。"
 },
 {
  "id": 10,
  "src_sha256": "1f877b02de60911d9bb35d86488116b17a440282cd7367b0929f60fdd1637907",
  "zh": "你們人太多了，這任務（ mission ）不可能成功。你們之中得有一個滾蛋！我要在這隊裡佔一個位置！現在就要！"
 },
 {
  "id": 11,
  "src_sha256": "1549825daa565d5d599b43944f17cf7b36e5b9f26c8ff4f086bcec5cb187bedb",
  "zh": "你們有直接命令在身：立刻把我平安送回 IUF 營地。（等我回去， Yamir 會收到一份大驚喜……）"
 },
 {
  "id": 12,
  "src_sha256": "e1027d8074f4d1b231cac131e1073d1e2f6c6cf018e401fb7c860377badffa3b",
  "zh": "好啊，真是好極了……"
 },
 {
  "id": 13,
  "src_sha256": "341748384b8281f37a358bb1ca992a12d05b05cd1755ac22fbee18cecd1564ed",
  "zh": "我不要那個！"
 },
 {
  "id": 16,
  "src_sha256": "b070f9c99fcf0d09c464c456d5815ea12aba2b8e500dceeacc43f4cc4c138825",
  "zh": "這根本不夠，小氣鬼！"
 },
 {
  "id": 17,
  "src_sha256": "ae9d2f61de07ef3fd0c5017fea25380e3ae84792e7d1fd1fb8311d5cabf2ff65",
  "zh": "搞什麼鬼？！？那是我的配給品！"
 },
 {
  "id": 18,
  "src_sha256": "d306c9901e9cc33360ae827b30c8af9d81c01fbf242525636d4bd9013086dd1b",
  "zh": "你們開始惹毛我了！"
 },
 {
  "id": 19,
  "src_sha256": "d76bb6d237ddc63241a6eeb3ef0fc614a2225d50721e6466b32ae09efb7b9d3e",
  "zh": "來啊！我什麼都沒剩了，白痴！"
 },
 {
  "id": 20,
  "src_sha256": "7bebe658b708e4254510162b359b7241c0cd35e07023c03438b52c208a9e1431",
  "zh": "我要把你的小腦袋擰下來！"
 },
 {
  "id": 21,
  "src_sha256": "879c18246b1025a90783e0be062ab2da485663de927814324795ae6480f9a360",
  "zh": "我拿這玩意兒能幹嘛……"
 },
 {
  "id": 22,
  "src_sha256": "59c4ee2e94bf373028066b57c8faeadfdec619ebb9acb7aa41fb75b798410eff",
  "zh": "這件事現在無關緊要，士兵們。"
 },
 {
  "id": 23,
  "src_sha256": "aaa3cd2203689f5234274a71a2fa1c8fae026272a8c225b48920961c08b39309",
  "zh": "快點啦！我得回 Mt. Gigas 去！"
 },
 {
  "id": 24,
  "src_sha256": "b6616133ffbd29fd43441cc053ad1d8cdb0b87bca9a8b2cf876cd96b4ef157b0",
  "zh": "關你們屁事！"
 },
 {
  "id": 26,
  "src_sha256": "d081ade1e8159885e998e3097d70def4f1687664d86eefb8763eb3daac523c18",
  "zh": "這些我一個字都不想談！"
 },
 {
  "id": 28,
  "src_sha256": "62ac3bc49a728c868f55b200929a0656fa75a2a2af9d9e9f47ca2b354229279f",
  "zh": "閉嘴，小兵。"
 },
 {
  "id": 29,
  "src_sha256": "dd70c0593bae23a876ab5b1d5a7e2ef3b1b7ca2868204ab194f39f1dba15e1ef",
  "zh": "現在就走，路上再說！"
 },
 {
  "id": 30,
  "src_sha256": "c8ad03f34be7949e8e10da8681b7fd23f599eb77044849ba53759b5be95a108a",
  "zh": "我們沒時間在這裡浪費！"
 },
 {
  "id": 33,
  "src_sha256": "5269847badd2ba3ae06901b265b71c07869fc8f3ad40f55575a6db9dcd09329a",
  "zh": "只要帶我離這裡遠遠的就好！"
 },
 {
  "id": 60,
  "src_sha256": "958fb03a7f6863ecd9da84deab9cf65cba719d640ea2ff298ddd08a7b23d7139",
  "zh": "別惹我開口！"
 },
 {
  "id": 72,
  "src_sha256": "bd5cffcff9c6db9fd8ac64c21fafecdd9be47c2cc75b267bcf13246a199660e5",
  "zh": "現在不是講故事時間！"
 },
 {
  "id": 73,
  "src_sha256": "97cafdc3ab74d54f0b34e2167623c3b6504a864df53d2715cc125a14eb1ae313",
  "zh": "Glumph 中士！我可要提醒你，我「確實」有軍法審判的權力。"
 },
 {
  "id": 75,
  "src_sha256": "e17b26b1e9b18670d9c30fb8b3bf8ba4d5a633f3d4996ce4a316a0641b105692",
  "zh": "要不是我累成這樣，我早把你的頭擰下來了……"
 },
 {
  "id": 76,
  "src_sha256": "94b293d670ee1396293e91f2e776e4b57f3ad32c6308205883a9fd5ed467c58f",
  "zh": "喔，才不會。我才沒有那種好運。"
 },
 {
  "id": 77,
  "src_sha256": "ac741255342813dcd6dece8d5f30c2244d1b5b0d4277dcef2eab558908428b12",
  "zh": "客套就免了……"
 },
 {
  "id": 78,
  "src_sha256": "2ff91387ddb2f69922877dbd80b7d08527b5c618b097f8b945fd26ec6594aaad",
  "zh": "總算滾了……"
 },
 {
  "id": 79,
  "src_sha256": "fc1565287910050fc020a5b0c93cff889a6d00cad3e874f9a614ea99cc1ad0ba",
  "zh": "幫忙（ help ）是「你們」要為「我」做的事！"
 },
 {
  "id": 87,
  "src_sha256": "1ce814ce52e42ce7b86113c93167aca8c416677abf65ebb73121f7b74505cf6d",
  "zh": "我要把 Yamir 的腦袋像氣球一樣捏爆。派我出這趟任務（ mission ），還配了一群沒用的、吸水的廢物……"
 },
 {
  "id": 88,
  "src_sha256": "65921be9a86cccee53168c4a19a3f1a98a5227ddaf4eba277e80a2ec37b7f342",
  "zh": "Yamir 到底在想什麼？！你們不能派小兵去做士官長的工作。"
 },
 {
  "id": 104,
  "src_sha256": "ca5c76bde7d042e33e03509429e64f1a18d8d936edb9de9be27a176bb14c01c8",
  "zh": "你們總算來了，小兵！你們知道我在這裡待多久了嗎？你們知道我經歷了什麼嗎？！我來告訴你們！那是 IUF 史上計畫最爛的任務（ mission ），就是這樣！我發誓 Yamir 的角已經開始刺進他的腦子了……我真不知道他在想什麼！"
 },
 {
  "id": 105,
  "src_sha256": "b7157834a498a5788d7fd9ea695cd5b55d099626b709122481e9db9a2940caa9",
  "zh": "他把我們派到這裡，我們被某種海裡的大怪物（ thing ）咬得半死，這還只是其中一部分！接著，我又被那些發了瘋、嗜殺、愛魚愛到不行的傢伙擄走當人質……"
 },
 {
  "id": 106,
  "src_sha256": "893cc24afa9aaa69bac0dba6ac49780c03532f07110570f63e20e1b118fbd79f",
  "zh": "你們以為我能指望 IUF 的支援嗎？門都沒有！該死，我知道你們來了，但你們花太久了。 Yamir 早該派你們來。護送我回 Mt. Gigas ，士兵們。這是命令。"
 },
 {
  "id": 107,
  "src_sha256": "87ecfb911cc0224ace8362ba996311770e706ce6fb37723bc33ffdb958efdbd7",
  "zh": "我的老天！先是被一群魚抓去當人質，現在又被 T'Rang 的走狗救出來！噢，天哪，這趟任務（ mission ）真是「太棒」了！"
 },
 {
  "id": 108,
  "src_sha256": "e1489e5b55b4049cee51c84c82e30a3c58fa1dea93c88501efd3b1085ff02b25",
  "zh": "我告訴你們……你們這些愛 T'Rang 的……放我回營地，你們最後會得到想要的。反正我回去就打算殺了 Yamir 將軍！我會落到這步田地全是他害的！現在給我讓開。這是命令！"
 },
 {
  "id": 109,
  "src_sha256": "03928305d91c95e892ca6441a966bf671662b6857e5fe3880eb1c078a19ec5f7",
  "zh": "動起來吧，小兵！我需要護送我回基地營！"
 },
 {
  "id": 110,
  "src_sha256": "378f8a9b17b52eb40f2541f52e8d51988f98b978bdece55a1a3bb7069431bdd6",
  "zh": "放我走就好……"
 },
 {
  "id": 111,
  "src_sha256": "cf1b814c6b0cadc121f7c044bdbcf74acdaecafbcff7c759b3ea58e493857abb",
  "zh": "終於有人來救我了！！你們知道我在這裡待多久了嗎？你們知道我經歷了什麼嗎？！我來告訴你們！那是 Imperial Umpani Federation 史上計畫最爛的任務（ mission ），就是這樣！"
 },
 {
  "id": 112,
  "src_sha256": "eac3c0c9616d95eb507021ff7dcf8bb99717e14a0628169dbb7281474e0020e6",
  "zh": "我們被派到這裡，被某種海裡的大怪物（ thing ）咬得半死，這還只是其中一部分！接著，我們又被那些發了瘋、嗜殺、愛魚愛到不行的傢伙擄走當人質……你們以為我能指望 IUF 的支援嗎？門都沒有！"
 },
 {
  "id": 113,
  "src_sha256": "18f3bdb4da846463a041d8db4e8ca3d7a104aedffba420cb0310003133410f99",
  "zh": "謝天謝地你們出現了！我真不知道該怎麼謝你們，不過我可以讓你們看看……"
 },
 {
  "id": 114,
  "src_sha256": "0f41472355392a9cc15b19429b85a135c47597c8de60753267fab851ad0e862e",
  "zh": "相信我，不會讓你們白忙一場的……"
 },
 {
  "id": 115,
  "src_sha256": "7e3a4265a4f03ab78287ae1f8048f53288cca6b1313bb22820c182dcce95d260",
  "zh": "我得回我的總部去。恕我直言，你我並不同一陣線。好了，失陪。"
 },
 {
  "id": 116,
  "src_sha256": "3f9c0c6e33116e1b2aa8bf985897927687a8c01572324ec628be9a6a6edba31c",
  "zh": "士兵們，我欠你們一句謝謝。你們把我平安帶回來了，這點那些別的沒用的，呃……那些不幸喪命的士兵就辦不到。我要去好好休息一陣子……回頭見。"
 },
 {
  "id": 117,
  "src_sha256": "98c89c10afcacadccb46e9b00f02206432c4ad4b0ccf3e34405211179b62c4b2",
  "zh": "我才不在乎，小兵！"
 },
 {
  "id": 118,
  "src_sha256": "44f581e588d7e4c82b7685dd48457b3eedf63f7085fc35b117cd3ebd3d16c584",
  "zh": "你們的任務（ mission ），小兵，而且你們「必須」接受，就是把我送回 Mt. Gigas 。"
 },
 {
  "id": 119,
  "src_sha256": "7c5f5f1508ee7f93b53048219f214f418b869c06a7838b165a95e55dd58c04d1",
  "zh": "你們聽到我說的了！"
 }
]

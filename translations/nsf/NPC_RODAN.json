[
 {
  "id": 2,
  "src_sha256": "bf885eb4ee4628ff38b3953a3ced765ed25b8bc34ee4d09071534a6f147b234a",
  "zh": "我受夠你們了！"
 },
 {
  "id": 3,
  "src_sha256": "8ffc0324f619c41c5006b4c244989b28d60ff504eb35a7551038f2b13ea2960f",
  "zh": "我要把你們那副笑臉打飛到軌道上去！"
 },
 {
  "id": 6,
  "src_sha256": "480c389b47cf427eb8d89638bf2fde6cadad46b8837b29d649b028d190085fef",
  "zh": "我要把你們的頭打進喉嚨裡，到時你們得拉開褲子拉鍊才能跟人打招呼！"
 },
 {
  "id": 7,
  "src_sha256": "10e2280e201cc79ebe2279ef530d82436e509ead60aa37e4aa2cd7b3bd68b3ee",
  "zh": "Rodan 可不是拿來賣的，老大！"
 },
 {
  "id": 8,
  "src_sha256": "67ee31d7152b52b9e1b81ad2b6d890777960d27c2484e311fa20d319345d01a2",
  "zh": "先幹掉他們！"
 },
 {
  "id": 9,
  "src_sha256": "ca7d8b7498434b9cda6fa71a21b6e84183f11b64ca1dfd086d325ca514d16440",
  "zh": "你打算（ plan ）連籠子一起帶走嗎，老大？！？我還關在裡面，沒辦法加入你們！"
 },
 {
  "id": 11,
  "src_sha256": "5c6d3d6d852901d5f61c5fa495556b1cd7473baf2ac83f2fd3e9b953dca30650",
  "zh": "我準備好出發了！"
 },
 {
  "id": 12,
  "src_sha256": "104410031bfd7eaebf97f026e903148e8226fc512d33f9c0e65da917d10eb83d",
  "zh": "謝了，老大！"
 },
 {
  "id": 13,
  "src_sha256": "a739c20e01b571419af875fed22d6fda1938a5c68f9d0cf81c1faf6a34d69332",
  "zh": "老大！！這裡不是市場。這是生死攸關的事（ LIFE and DEATH ）！"
 },
 {
  "id": 17,
  "src_sha256": "48395223d4e10e83a64398f65d90c18a7dd431b59a0d9b63c16b5ef731c7fae1",
  "zh": "我以前也有一個跟這個一模一樣的。"
 },
 {
  "id": 18,
  "src_sha256": "d7fd566f1a83228fd749b5c48e62c45a359277479c8963dece3f47b740eafc4b",
  "zh": "噢，別逼我殺了你們！"
 },
 {
  "id": 19,
  "src_sha256": "2cc8306d36d061856a246c6581980be7ec8da86d852a195e5c97ab1979bb2f14",
  "zh": "我不敢相信！你們剛剛是不是做了我想的那件事？！？等我回到大本營，我一定要舉報這件事！"
 },
 {
  "id": 20,
  "src_sha256": "da7528558cb83811e6b90d095f9cfcbe10ba0814667def56aa5254228591774a",
  "zh": "我要把你們的頭打進喉嚨裡，到時你們就能舔到自己的腳趾了！"
 },
 {
  "id": 21,
  "src_sha256": "5c0d1010f0704c2f93ba96ce7b922c806fe7f20ae067b95c28076940b391c9eb",
  "zh": "我不需要你們的錢！"
 },
 {
  "id": 22,
  "src_sha256": "16cf66c96aea78995df68c3d3f887c3176849ef6ba1ce5857213fd7f8579a1df",
  "zh": "我不想談那個！"
 },
 {
  "id": 23,
  "src_sha256": "f4b62fc630ef75b1112cce4b13c8cbb8ac8314d2de885a904e22fba61bf50d5f",
  "zh": "什麼？！？我們還有正事要做，該死！"
 },
 {
  "id": 24,
  "src_sha256": "9becc6a876ed5d218e183bfecea470826cade314432347b8b93730915e5fd1e8",
  "zh": "晚點再談……"
 },
 {
  "id": 25,
  "src_sha256": "f595780a0a6075536fc46b4b83eaafb6eb6ba0821b3164e72dfcfe5f193c7a65",
  "zh": "我的天啊，老大！我說過……"
 },
 {
  "id": 26,
  "src_sha256": "30e3ad5f6642a60fdcd71ca96144ce880051d83e0131c1091bb127c8a08737d3",
  "zh": "一件一件來……"
 },
 {
  "id": 27,
  "src_sha256": "b7f232d0fcf86ab4b7710e46e254049b3c5a0788ea55f9fdc8aca40b1bc5bd48",
  "zh": "還有……"
 },
 {
  "id": 28,
  "src_sha256": "4085a2b683c4404d6cb188b6cf3e318addf65647cf4764bd1b784502f45f1b1e",
  "zh": "隨便啦，老大。"
 },
 {
  "id": 29,
  "src_sha256": "1907f5f4f1b414da8867b15fc6a161059654935135b7ded76b1197fbf7d24bab",
  "zh": "我們得趕在 Rapax 到之前出發……"
 },
 {
  "id": 30,
  "src_sha256": "400f1c4d971f5fbe6688af332a043341fa9252ffbb0b1811a7335af7a445a6c1",
  "zh": "算了吧！我們離開這裡！"
 },
 {
  "id": 37,
  "src_sha256": "9fbedcbda2a88de718566d7d207a2850540c08a2229e12df7b804e46c244b5af",
  "zh": "那正是我想去的地方！"
 },
 {
  "id": 38,
  "src_sha256": "645e30297dbed94ffc19eab028bf41011f439e66cfca793c1d0c4f46aec9a39f",
  "zh": "我們會到的……"
 },
 {
  "id": 45,
  "src_sha256": "5361ea2bee08cabc25cd0ecb6b277401211c80bdf00bcd7b533b375edaee9ed8",
  "zh": "那些該死的 Hornhead！真是報應！既然他們現在跟 Dark Savant 合作，天曉得他們會幹出什麼事……或者我們會面對什麼。所以我們必須讓 Umpani 和 T'Rang 達成和平。沒有和平，我們就完了。"
 },
 {
  "id": 46,
  "src_sha256": "7494dee52a8f143e9478a1dade89553b867ce8dc64b9c22eefb37f6d47ced785",
  "zh": "士兵們，除非 T'Rang 與 Umpani 能結成同盟，否則 IUF 就有大麻煩了。"
 },
 {
  "id": 47,
  "src_sha256": "02221de6fb0d8d8f9232aa35245465b78bc0c49467ce55a0a0d09c2f9c056e12",
  "zh": "Drazic 會去對付他們。我們需要的是同盟……"
 },
 {
  "id": 54,
  "src_sha256": "45a46862d61d0f28fd0590d7def0011c04c3c6b528d358cfa88a672411bb65c0",
  "zh": "真希望我手上有槍……現在，他讓 Rapax 取得他的軍火、他的突擊兵……所有一切！他只是利用 Rapax 來得到他想要的，不過 Drazic 和我有個計畫（ plan ）可以阻止他……"
 },
 {
  "id": 60,
  "src_sha256": "f67e5fb089927d97ca8c58d5a47a4b8ea140ac4654d805da3abc6c1eea547915",
  "zh": "別擔心他。你們只管帶我們到那裡，其他讓我來說。"
 },
 {
  "id": 61,
  "src_sha256": "33d203cd8632527a6b294b868e566eb53a12fe6a3c57d9da0139d236cbe6c687",
  "zh": "那個帶頭的 Hornhead。等他的部下發現這個籠子空了，可有好戲看了！"
 },
 {
  "id": 63,
  "src_sha256": "ff962675efb3dcd933ff9fcf01128d392ed057f69baed03dba2ba26a8553f853",
  "zh": "我見過他。他跑到這裡來，講話的口氣活像已經是國王了。就像我說的，我真的好希望槍在我身上……"
 },
 {
  "id": 65,
  "src_sha256": "018e4f0fd54e34e8f67b593a7f5da0e22600e38d605099a4b4559a44cac20554",
  "zh": "Drazic 會去對付他。"
 },
 {
  "id": 72,
  "src_sha256": "26a84ba8e0fe983ec2246d8f8f9d095b4289f88266c36b83a943e3024fcba335",
  "zh": "聽說我對這些問題已經煩透了！"
 },
 {
  "id": 73,
  "src_sha256": "008c452b442d934cc9ebffa0fc99d907355ff93c0eed227e8d61d18c6bec0867",
  "zh": "我是誰？！？我可是整個 IUF 最優秀的追蹤手！"
 },
 {
  "id": 75,
  "src_sha256": "eae9b0c11607443f4c749b66b9017f4484d99b986af94a2a47def161922a0079",
  "zh": "要是你們不帶我們去該去的地方，你們就會變成那樣！"
 },
 {
  "id": 76,
  "src_sha256": "0b900eff6681dac4b2a215888cb297b73932a32f38c2dd6b5524e50012e7feca",
  "zh": "再待在這裡面，我就真的會了。"
 },
 {
  "id": 77,
  "src_sha256": "6d04806bc2c89cb45f879212d07a0a54af06fd1a0ac785ba800362b4ad535d31",
  "zh": "哈囉，老大！"
 },
 {
  "id": 78,
  "src_sha256": "4a4ad1ded0238a95db5d0e8490019e13000d49e774633ea9afd2262baa3e381f",
  "zh": "你們要去哪？！？我需要你們幫忙（ help ）！"
 },
 {
  "id": 79,
  "src_sha256": "eb326b3a61dec905e31335bf3ce831bd2ff15c8969e908f8eb6e4bc01a7bf609",
  "zh": "對，我們需要幫忙（ help ），老大！快帶我們離開這裡（ get us out ）！"
 },
 {
  "id": 81,
  "src_sha256": "cfe870d24fca4f305ba1c4aeb1411334860090cc5ca6ccf5505704ad79a1196e",
  "zh": "我很有信心，老大。"
 },
 {
  "id": 83,
  "src_sha256": "e373e6f237098afdd1875aa469a3b1f585f724b6f676477ed77c39059d0c9370",
  "zh": "只要我們有辦法避免（ help ），就不會……"
 },
 {
  "id": 87,
  "src_sha256": "baa4de403f60b80edff16a8662ee257a23a1a7bcf1c2156a28a9ba5fbcd78a5d",
  "zh": "我只希望 Yamir 能理解。我們兩邊的戰爭（ war ）已經拖得太久了。要是他不肯合作……我……我就自己來。"
 },
 {
  "id": 88,
  "src_sha256": "b0d222c24901b993ac922e013026e85616478f27c0d559c64460790d23fd0b6d",
  "zh": "這正是我擔心的。儘管我信任 Drazic ，我也不能把賭注押在 Z'Ant 身上。"
 },
 {
  "id": 89,
  "src_sha256": "6b6d69cbbb2e154eeef1c2b63eac4a91e92fa71885e98b45862a2f87a06ce0ae",
  "zh": "總有一天，我要把這顆星球上的每一個 Rapax 都殺光……"
 },
 {
  "id": 101,
  "src_sha256": "77c99076d6c1489a7b2731fd40c23f9e13d9ea0074c99878bcf8fc516104aa0a",
  "zh": "就在你們眼前！"
 },
 {
  "id": 102,
  "src_sha256": "3ad03cd10f53e841ea2098145cb5a3f43571c12c0fc27d2c0296712bbd057e50",
  "zh": "我完全不知道！"
 },
 {
  "id": 104,
  "src_sha256": "cbba1dbc5a54e2c549651ab3519392770741be31e333aa9636079dea58e058ad",
  "zh": "是你們幹的，對吧？！就是你們！你們炸了那艘船！我就「知道」會這樣。真是報應！我們本來有機會和平的，結果你們搞砸了！現在 T'Rang 和 Umpani 永遠不可能達成共識——永遠不會聯手對抗 Dark Savant ！而我們「明明」有機會的。"
 },
 {
  "id": 105,
  "src_sha256": "098b48e37a79491ad9186c42a31d0d8230d63627a27236b934ed4a06ab2b8498",
  "zh": "要不是被關在這個籠子裡，我早就把你們的腦袋摘下來了！"
 },
 {
  "id": 106,
  "src_sha256": "4ccf879f9d4a31b3c3764083783c0d4d7832d348b5c30049b0887b394374ab07",
  "zh": "去那邊跟 Drazic 談。我來盯著 Hornhead。"
 },
 {
  "id": 107,
  "src_sha256": "874c07bad888595790f0e9e4d7e7457605c1c225694b7aa40b6d01520d63cdf0",
  "zh": "哎呀呀呀……看看這是誰！我記得你們！把我丟在 New City 等死的人！幸好有人路過救了我。我當場發誓一定要報答你們……而且，真是報應，我「想」這麼做！不過只要你們帶我們出去（ get us out ）、「救」我一命，我們就當扯平。"
 },
 {
  "id": 108,
  "src_sha256": "48f7e1d24a377acae5a6b620ebd65da15a14fefe96a48d036dbf54e7614619ed",
  "zh": "考慮到我原本「打算」對你們做的事，這條件（ offer ）已經非常大方了。好，現在情況是這樣……"
 },
 {
  "id": 109,
  "src_sha256": "b1f645f1ea8fb827c07291588b952678834496b58f29bbbcba39b0124dc71ac6",
  "zh": "你們身後沒有 Hornhead 跟著吧，有嗎？你們知道的， Rapax ！"
 },
 {
  "id": 110,
  "src_sha256": "16bd244f06dadbd61d4c2b8e2683f693e92e00b282757d85aada2aaf003832e1",
  "zh": "快點，老大！你聽到 Drazic 說的了。現在帶我們出去（ get us out ）！"
 },
 {
  "id": 111,
  "src_sha256": "c34a9db8062ab01a8c85227f04dedfe67a53b5bc6e92be3739ed10549e302173",
  "zh": "我們動身吧，老大！"
 },
 {
  "id": 112,
  "src_sha256": "c5024b7ffc354b832c12ee6bd088a2d8230e4051f555e07d4dbfc25a748039a9",
  "zh": "快放我出去，該死！"
 },
 {
  "id": 113,
  "src_sha256": "c3ff9d99060ff7867b0fbb533ec85a9578b710d89f5a68b1140992833398ac61",
  "zh": "照 Drazic 說的做，帶我們出去（ get us out ），我保證不傷你們一根汗毛……或是別的任何地方。我以人格擔保。"
 },
 {
  "id": 114,
  "src_sha256": "a4620689746835de8496a683e64634547c2554e2ea9bf72428c52ba0f3be9277",
  "zh": "別來煩我就好……"
 },
 {
  "id": 115,
  "src_sha256": "eacd9a67c1d15d38a88d2e50ea15fd71cdfd45e8c04f46c02029e86d0e6b29c9",
  "zh": "哎呀呀呀……看看這是誰！我記得你們！把我丟在 New City 等死的人！幸好有人路過救了我。我當場發誓一定要報答你們。而現在又來這招……炸掉那艘船的竟然是「你們」，我怎麼一點也不意外？"
 },
 {
  "id": 116,
  "src_sha256": "dfe0b1fd121b0c1e30625b8cb1a8bc8da29101b65d8c71ae87fbc315de3cd8d9",
  "zh": "我們本來有機會和平的，結果你們搞砸了！現在 T'Rang 和 Umpani 永遠不可能達成共識——永遠不會聯手對抗 Dark Savant ！而我們「明明」有機會的。等我出去——你就等著瞧，老大——我會用餘生來毀掉你的人生！"
 },
 {
  "id": 117,
  "src_sha256": "00ec7be859410f3b3b3e153da21bbbe1afae1d75840ac0f0e0e61f18ad043de2",
  "zh": "被關起來讓我學到一些事……比如你們永遠不知道能信任誰、誰才是朋友。 Drazic 呢？他到最後都忠心耿耿。"
 },
 {
  "id": 118,
  "src_sha256": "6ee15954514417c234de8fe5d0c8e1ee5fd04fe0c77447b7eb48e6d86d6e09b2",
  "zh": "對，我們需要護送（ escort ）。"
 },
 {
  "id": 119,
  "src_sha256": "22a9a0fe4f469bd94b2d49ffe5cdea16ebe8cd2be0b370963b283a96b5a5b16d",
  "zh": "現在已經無所謂了，老大。"
 },
 {
  "id": 120,
  "src_sha256": "bcb07d5ff16cdad85572b1e80366c77176f6011fbb3d437f253b0c08001fbbb1",
  "zh": "那還真是個好條件（ offer ）！你們把我和 Drazic 救出去，我就不把你們的嘴唇打飛到軌道上！"
 },
 {
  "id": 121,
  "src_sha256": "8a8ed6d1c19adb1663a638fd135a982a72db8c2213ca7635e445da4ffc03a477",
  "zh": "我現在沒空談我自己的事，老大！"
 },
 {
  "id": 122,
  "src_sha256": "c2d8998142dbb3a8c394b2bbc3f128cbacf9f5b50e9f4dc53f64b79161fbc869",
  "zh": "他們是嗎？！？誰教你們怎麼指揮軍事行動的？函授課程嗎？！？好吧，我沒看到什麼迫在眉睫的威脅，而且反正我們也不能整天等你們把自己的事情搞定。所以，聽好了！"
 },
 {
  "id": 123,
  "src_sha256": "d657d57c308b3e72dfb5d921f2d0f331d16d33524fa410ce7bdd4f220cb72cd1",
  "zh": "很好！看得出來你們受過良好訓練。現在我需要你們仔細聽好！"
 },
 {
  "id": 124,
  "src_sha256": "f06023b8ca6789acba239e68b9ed906c862d02ed14b90ea22f66402d521b51fc",
  "zh": "我離開大本營時，本來要去偷 T'Rang 的科技，結果被 Rapax 抓了。一天後，他們抓到了 Drazic 。在我來得及照原本想的那樣殺了他之前，發生了大事—— Dark Savant 本人現身，來跟 Rapax King 談話！"
 },
 {
  "id": 125,
  "src_sha256": "6c779663ee55baf4a4d1e4205191d2e8e7c5101657022f33439ebd64f86d49e3",
  "zh": "他雇了 Rapax 去摧毀 Dominus 上的一切。除非 Umpani 和 T'Rang 聯手，否則沒人阻止得了他們……但是 Drazic 和我必須在 Savant 動手之前趕到我們的領袖那裡。這樣，我們才真的有機會。"
 },
 {
  "id": 126,
  "src_sha256": "95a875413f9764904e1ba0ea23daa9b854d12856f7f82f5d385ae7b4006ece8a",
  "zh": "老大？這可能是我們歷史上最偉大的時刻，但除非你們現在就把我們弄出去（ get us out ），否則什麼都不會發生！"
 },
 {
  "id": 127,
  "src_sha256": "da35d98bb23d24dc570f08b42dedd7177af39e302f96c1545214931b25307534",
  "zh": "T'Rang 與 Umpani 之間的和平，是我們唯一的希望。 Drazic 和我相信，聯合我們的實力，就能擊倒 Dark Savant ！"
 },
 {
  "id": 128,
  "src_sha256": "fe91e99b3a0d0b48ce98e45c2681473b7348539ac517864372db17b63edf8d73",
  "zh": "在那邊，老大！守衛身上有鑰匙。從他身上拿的時候小心點！"
 },
 {
  "id": 129,
  "src_sha256": "dd6a9263e916eae02ec8697207d555d626e08f19473349c89d1aa16d1914a8c3",
  "zh": "我們需要護送（ escort ）。要離開這個營地可不容易。"
 },
 {
  "id": 130,
  "src_sha256": "7873c222c2825592aa5b4df4a6b29f5a547bfee011ba69f68861527e66146185",
  "zh": "T'Rang 與 Umpani 結盟，是我們抵禦他們唯一的希望。"
 },
 {
  "id": 131,
  "src_sha256": "3040640f785849d027776a1f24f1f0c79358dc66667bf4dc6424f9db87619439",
  "zh": "我們的計畫（ plan ）？這裡不安全，不能談。哪裡都不安全。等我們見到領袖，到時再談……"
 },
 {
  "id": 132,
  "src_sha256": "142f7d6a5435d081c110cccbd368a06ef9f752e99bdf4621aac8da4f401c1214",
  "zh": "報應啊，各位女士！！也許你們沒注意到，我的麻煩已經夠我受接下來五年了！"
 },
 {
  "id": 133,
  "src_sha256": "3aeb1f45983f921aa740d164f0cdfeb5adf30280745d146d8b6243f1fa2d8a3b",
  "zh": "你沒聽錯，老大。"
 },
 {
  "id": 134,
  "src_sha256": "07c6fa6fa35b8e5f57a8b7fe314eaacba366909a4e91cf572e3fc3796d917c62",
  "zh": "我們得往北走……"
 },
 {
  "id": 135,
  "src_sha256": "a989751542e841f0fac4eb2f788b0991b6af331e1f8b3323e6f2a722e0d687cf",
  "zh": "我們往南走吧。"
 },
 {
  "id": 136,
  "src_sha256": "40e79dbb82c35990694313771bfe39b9a72f2d1c837bdf8720a345b994e5f1b6",
  "zh": "我們得往東走。"
 },
 {
  "id": 137,
  "src_sha256": "9b0857c0ea8a0b230b54f6579c4dfea260da53f82afe968a0235157ef6682ca7",
  "zh": "我們往西走吧。"
 }

[
 {
  "id": 0,
  "src_sha256": "034aeadd8474e6196f05a4d37f1a4d5bd3e71e85c5ef504aed62fefafad2d6e9",
  "zh": "自稱明智之人，懂得在強大的武力面前低頭！付上我的入場費，不然我就把你們全都壓扁！"
 },
 {
  "id": 2,
  "src_sha256": "dd2015c20f36dc20a7034f6c22279f9b14587f86dfc2557c873d19ca58ea484d",
  "zh": " Trynnie 不會讓你們進入 Ascension Peak ！"
 },
 {
  "id": 3,
  "src_sha256": "ea280a86e45445ffae3447b881a31222976a8de62bf657d1f3e888637a9dc27b",
  "zh": "哼！我知道你們「真正」是什麼貨色！"
 },
 {
  "id": 6,
  "src_sha256": "cba49e7db72e5f0a6a72ea4867e2d005f06689368abb9da4742cbf1115a31a01",
  "zh": "你們想見識一下真正的威脅嗎？"
 },
 {
  "id": 7,
  "src_sha256": "0215d3c40dd12cfb8c72854bd20a54a5c254622253c8dc82324d0affa9cd7617",
  "zh": "你們的屍體我會出更高價的。"
 },
 {
  "id": 8,
  "src_sha256": "7a9e524fa8c7850cba1c982126be0bca93d65ea63d287157b47e93e15ef95e34",
  "zh": "你們似乎另有要事在忙。"
 },
 {
  "id": 9,
  "src_sha256": "55dc3cd3a90d6be4b3504f730b258db16c7a55ba689ee282da4ccf0e6e17f26f",
  "zh": "休想。我在這裡有朋友。"
 },
 {
  "id": 14,
  "src_sha256": "31ea3eadfd62400e79fdf5b61f563f4cc752fb2f6508b254d773591fb5c0d555",
  "zh": "這筆費用，呃，很微不足道。"
 },
 {
  "id": 16,
  "src_sha256": "e8dce6ec6d904ec85a9434b1c1c73399fa8d754012411f14b30a310857a89ddb",
  "zh": "你們的財富可配不上你們的智慧！真可惜。 Pee Wee ，來料理這些賴帳的傢伙！"
 },
 {
  "id": 20,
  "src_sha256": "890b769ecb4a9bd907c351f23568a0639a02230a0d49bf92242c4fc8fb38418c",
  "zh": "他們在這裡， Pee Wee ！"
 },
 {
  "id": 104,
  "src_sha256": "81dcadafd198f5bd0718c412f33bfb27f1a6e0e6203d72a2e01fa2cf895f835d",
  "zh": "啊啊，你們真是明智。你們可以進入 Ascension Peak ，而我的助手 Pee Wee 會樂於踩扁任何擋你們路的人。你們跑去找他，麻煩就解決了！他就在轉角那邊。你們請過吧……"
 },
 {
  "id": 105,
  "src_sha256": "263ff8c4e92407fc95a86213e4a5b979fe3b400ad897d9557ec85f57c28dcccf",
  "zh": "你們可以通過了。"
 },
 {
  "id": 106,
  "src_sha256": "9e1ea2c6ae0a2addfb5781962c03b117e8fd08bdd705ec65673bc045bfc9837d",
  "zh": "很好。那是你們自己的葬禮。我會叫我的助手來處理你們。 Pee Wee ！有人來找你們了！"
 },
 {
  "id": 107,
  "src_sha256": "32af78d06569895a2e7fbf51551353f6ac7c84a3010a0c6ae1ab55bf7b316914",
  "zh": "你們聽到了！付入場費，不然就被壓扁！"
 }
]

[
 {
  "id": 2,
  "src_sha256": "c41e354261b00eb1abd149a87baa20a54bae5aa2a3c5a99ea8140ee8ad043760",
  "zh": "是的，我聽說過你們，真是個多樣化的團體。請繼續走你們指定的路線。"
 },
 {
  "id": 3,
  "src_sha256": "196df9748dc752f5205336f28eb6021ee37047902e8fcf21b5383985bcccca8d",
  "zh": "我記得你們正要去某個地方。我不會打擾你們的行程。"
 },
 {
  "id": 4,
  "src_sha256": "1a75c237190c7ed467e1f8a497d2ffa9ac78789bd805545402643ebcf5b82c15",
  "zh": "是的，你們好。"
 },
 {
  "id": 5,
  "src_sha256": "3b30f715b226f5e56d052129807d69365bf6771d71a4442c2799dd92ec8da6fd",
  "zh": "沒什麼需要你們擔心的。這一帶相當安全。"
 },
 {
  "id": 6,
  "src_sha256": "ee97f95a6a83b67602090ac1d879d382e0b5b44706a90632933e7fa3d294bdcc",
  "zh": "你們好啊，各位樣本。"
 },
 {
  "id": 7,
  "src_sha256": "bb263ac22c2d4d6c25050080f50f6ead228b6c20081ec0ffd5675a8534ce88a9",
  "zh": "請繼續前往你們的目的地。"
 },
 {
  "id": 8,
  "src_sha256": "11b09d3d7617d6d3a902a4ddb66611626be6c37d70c47322834030724539a4e6",
  "zh": "不好意思，園區內禁止打鬥。"
 },
 {
  "id": 9,
  "src_sha256": "3f05c476a8ff9f9283ae2f4f8c280d8fa51e912542e3c779d32b6d5f337dc12a",
  "zh": "你們的行為不可接受，應予以滅絕。"
 },
 {
  "id": 10,
  "src_sha256": "ebd76f48933e05ca6fe5fda2c48a5d1b8aa6fcc5a6c6181d8896816f1cddf457",
  "zh": "你們已經令人無法容忍。即刻強制驅逐。"
 },
 {
  "id": 11,
  "src_sha256": "9b814f1af72cdd661e4659028c4f60e7c7879a36c45ed0346aa38e3335d4c0bd",
  "zh": "根據你們的行為，我們判斷你們是以不實的理由來到這裡的。"
 }
]

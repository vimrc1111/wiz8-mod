[
 {
  "id": 0,
  "src_sha256": "21beed6bd3a1ae2e2919200b6a8db217312f7ef2fa02cd96598a3943022cae3d",
  "zh": "哎呀呀！這是哪來的啊？看你們這些小子年紀太小，還不能進酒吧吧！說吧，要不要我彈首搖籃曲給你們聽？嘿！"
 },
 {
  "id": 1,
  "src_sha256": "b682325b41ff399f382ddecc931fcf725fdd19e9030c85ba5f0d1c3f5a212df7",
  "zh": "哎呀，小子們！過得怎麼樣？"
 },
 {
  "id": 2,
  "src_sha256": "6df9788c4341d4b9a96155262a72cf8cbb6abc6b0c813306f31bec3ec9e09c8c",
  "zh": "別擠著才藝人，小子們。再擠我就要叫警衛了。"
 },
 {
  "id": 3,
  "src_sha256": "c74d4d3714d238bd5b75b0bf4a22e74268ca3efe61accd127a110a6627bef3a3",
  "zh": "算了吧，小子們。你們沒辦法用甜言蜜語打動樂手的。"
 },
 {
  "id": 6,
  "src_sha256": "2200ed88c5f756077068d4b644efc98c2d960a2f18dce80249f31bacbf22e0cc",
  "zh": "你彈錯音了，笨蛋！"
 },
 {
  "id": 7,
  "src_sha256": "2fb621daf7bd1065bb18a4fa3b1e3074515b8e3d76ee70d8d6cc4eb73be94c6e",
  "zh": "這連一晚的工錢都不到！"
 },
 {
  "id": 8,
  "src_sha256": "d9c6110d4cb9677155e55177ababb34ed9e31e4585fe6879bf88ebae24ed109f",
  "zh": "我的老天！先把這場架停下來！"
 },
 {
  "id": 9,
  "src_sha256": "479c897d85ee60592fef5a93f65156c2677ebc2132df3a3adeef58e04bdc02a2",
  "zh": "抱歉，小子們。我不行。我的演出檔期一路排滿了。"
 },
 {
  "id": 10,
  "src_sha256": "112a6872c07db58ec715ef1774dc10e8b9a03aeac2b0a3b513dd6fd7635f6059",
  "zh": "看來你們不需要我幫忙（ help ）。你們人手多得很啊。"
 },
 {
  "id": 11,
  "src_sha256": "171c77980d330fd9c237d1ee7030b3773f26fce1f0c60d6677b3d1050be523ef",
  "zh": "嗯，我接下來幾天沒有演出。給我一分鐘收拾東西。"
 },
 {
  "id": 12,
  "src_sha256": "ed3ab409aa086f964ca26e349bfa70480294e15cb43e465d251dace4511291ba",
  "zh": "哇——我的天！"
 },
 {
  "id": 13,
  "src_sha256": "db61b7c86b0cb1d5c751b5730e2a8178a195630d4dc5a56c4f5105c1cc91b800",
  "zh": "這我要拿來幹嘛？"
 },
 {
  "id": 14,
  "src_sha256": "e94b023e1ae1cc9a0f948e628a86ef72da87e6ccc7fe6872677a4449f4b63307",
  "zh": "當然啦，在我這行，有人拜託事情時給點小費是慣例……"
 },
 {
  "id": 15,
  "src_sha256": "60be4379a1d7ca26e0b5470406c973a0e0bf660a8a3260b2fabcf14772122e88",
  "zh": "我是個樂手，小子們，我口袋可沒那麼深！我買不起更多了。"
 },
 {
  "id": 16,
  "src_sha256": "51505343117b66125ed9d3040f0498f2ed765f62b482e8bd091aedbbb1efef40",
  "zh": "你們想侮辱老 Saxx 嗎？"
 },
 {
  "id": 17,
  "src_sha256": "1f9077a1b91680cc54f3f61e5247033c4fefc1534b920bf90906c700fe8a249f",
  "zh": "我正納悶我到底把它放哪去了。"
 },
 {
  "id": 18,
  "src_sha256": "0d39c8f67698c23da9624a7db4264eece6f5d56415c6a7e293495ddc17e2cdfe",
  "zh": "你們知道嗎，小子們，你們啟發我寫首歌了。我要叫它「我踢爆了他們的頭之後，把他們活埋了」。你們覺得怎麼樣？"
 },
 {
  "id": 19,
  "src_sha256": "f09df8907beb0f5a973c91f1798503fb50c8ee10d8b3db61b9f42435b6c68c00",
  "zh": "哇！那是你們的手伸進我口袋嗎？！你們這些小子到底在找什麼？"
 },
 {
  "id": 20,
  "src_sha256": "90c8a965d0a3d498bccd5a2f1e59f97b240a24d26b993745d23aa85ae13fdcf2",
  "zh": "我的老天！我要好好教訓你們！"
 },
 {
  "id": 21,
  "src_sha256": "42c87395d80b4b4d5c1f01833facdacdafd46543d742d4de3d72e3580af2d2a3",
  "zh": "謝謝你們的小費，小子們。"
 },
 {
  "id": 22,
  "src_sha256": "b7f0963657205f0249daeaf00320becb114cd9a9757c4a4b0385168f27e61176",
  "zh": "{{Music}}才是我真正的專長，小子們。"
 },
 {
  "id": 23,
  "src_sha256": "0517741b9c87d809fe339f5f39d2a45e68244424c4d589e0f1ac2919e61cb041",
  "zh": "小子們，我不過是個樂手……"
 },
 {
  "id": 24,
  "src_sha256": "ef317f95925964e24ec8fb5d363dd6b215fdea28c466de1ea58fd567e0a19162",
  "zh": "喂，小子們，我要是說那個可是會被開除的。"
 },
 {
  "id": 25,
  "src_sha256": "49cf5d411bc076bec1b92848a6389e2b0822da29b10fa857d1ca28ae3cae2240",
  "zh": "你們覺得這是副歌嗎，小子們？聽好……"
 },
 {
  "id": 26,
  "src_sha256": "c1abe35ce5ce7017a915660b3f0117f686ae96e0b873c6fdd15f2e1eb8a65cec",
  "zh": "好了好了，等一下。你們想先知道什麼……"
 },
 {
  "id": 27,
  "src_sha256": "499afb44a199890d68ed65cb7148abb20f4d104ff2e076fa346040448f811577",
  "zh": "而另一方面……"
 },
 {
  "id": 28,
  "src_sha256": "ebb672ee940c1c5dabcd8d135cb1b64fa3e97747a2bec60e4228bd755b7a6b42",
  "zh": "全是創作歌曲的素材，小子們。"
 },
 {
  "id": 29,
  "src_sha256": "5ca9814868d40154925a48770b838e36013a2e9010feea4f651165a0aaa3625f",
  "zh": "我有幾首曲子要琢磨……"
 },
 {
  "id": 30,
  "src_sha256": "42ea69903acf35134b3d1ca58fa79df912593a09bb26c46d95cab07d1f8433a3",
  "zh": "好吧，我不想耽誤你們……"
 },
 {
  "id": 31,
  "src_sha256": "f8ade70c95ea3d628fb7f3fcc79249fcfe9b6cc7fef0bd8095d8041786df9296",
  "zh": "嗯，我們就在這裡，小子們！這顆轉個不停的大球。大家都這麼叫它。"
 },
 {
  "id": 32,
  "src_sha256": "390b77a1d108f82f5f433218b8bb9276431fae06f9a2627ddfa4b2cea5d8e8b8",
  "zh": "從沒在那裡演出過，小子們。"
 },
 {
  "id": 37,
  "src_sha256": "7dca420e4ff110f900c5b4d2768f667057b9fccc08393851936eb4f4c0883831",
  "zh": "嗯，把眼睛睜大點，小子們！"
 },
 {
  "id": 38,
  "src_sha256": "609b6df7a39f6e78daf9f250d16177aefb64d004f4fd881fed5f8a59669091dd",
  "zh": "我可以告訴你們，那座 Bluff 擠滿了 T'Rang ！我們的斥候是這麼說的。"
 },
 {
  "id": 43,
  "src_sha256": "920afb00e58d424b981a092dc52a1fb036f4fd4b4179cf9f6d7c32502b5e37bf",
  "zh": "就我所聽說的，還算不錯。"
 },
 {
  "id": 44,
  "src_sha256": "1d33c5c500879b0663236dc3e5a5f0eabec9fcd631b049e4b1cc9c91fbed4629",
  "zh": "我們這裡有一個。大家叫她 Sparkle 。人是不錯啦，不過有時候他們，嗯，就是不太聰明，小子們。沒有冒犯的意思。"
 },
 {
  "id": 45,
  "src_sha256": "95d52d7b94a70cb6d493fdab0a1cbb3f1bcb1a996501b12196f9c10e00d560ac",
  "zh": "我只想說一句。要是我對著一群 Rapax 演奏？嗯，我可不會挑搖籃曲當他們的最愛……"
 },
 {
  "id": 46,
  "src_sha256": "3ace6e9c126c9a5e22440a2b8dac479aad1c65f690efcd1f62a972645c97108d",
  "zh": "你們眼前就有一個，小子們！我們是宇宙中最精銳的部隊。 IUF ！責任、威力、勝利，還有美妙的{{Music}}！當然啦，最後一個是我自己加的。不是官方的就是了。"
 },
 {
  "id": 47,
  "src_sha256": "0659203d7be0253c0ba3c0294b2acc5078eeb5993c09fa7b7fa7e150b68ac05d",
  "zh": "你們要那些黏答答的蟲子幹嘛，小子們？他們沒一個好東西。"
 },
 {
  "id": 53,
  "src_sha256": "94c161c40b3205843fceb73930423e77ac185b968330c89a77fc62937cb88ee9",
  "zh": "你們是在說 Guardia 嗎，小子們？最好讓它留在過去，那才是它該待的地方。"
 },
 {
  "id": 54,
  "src_sha256": "ddf004604c9c943521860965348876bb98efd2877eef0a3a215e0ee60b1a5333",
  "zh": "我的老天，小子們！你們怎麼會在這裡提到他？嗯，他可是我們來到這個地方（ place ）的一半原因，他跟那個蠢 Astral Dominae 玩意兒！"
 },
 {
  "id": 55,
  "src_sha256": "a20ba8df157aa01cd12c2e4b5203dacd5c6580b3eee280a4b76d4cd7b287cd02",
  "zh": "她是個美人，對吧？我可以為她寫上千首歌，只要她，呃，肯給我點靈感。"
 },
 {
  "id": 56,
  "src_sha256": "47e3ab6e89a06d59824e51c14b2e03c439f1565e309ddb4a9553cf16f445da98",
  "zh": "哎呀，小子們！這位小姐在場呢！而你們真的很漂亮。希望你們不介意我這麼說。"
 },
 {
  "id": 57,
  "src_sha256": "df21f1b5a54692f34ea9dcece3255fbb9d499f1b05a096467c6130a778308ac4",
  "zh": "當然，我們都聽過 Phoonzang 。不過他比較偏好福音，不是藍調。"
 },
 {
  "id": 60,
  "src_sha256": "9f0c3bd1939fdc1836c001b352a1412c786860dd25ae96396b024a3ab29321c3",
  "zh": "Yamir 將軍！我們優秀、優秀的領袖（ leader ）。"
 },
 {
  "id": 65,
  "src_sha256": "bbe5f5e5053d0e522032ae717f130bd8386a82e3120ae26db5f7b4d2bea6b4e0",
  "zh": "喔，小子們！你們幹嘛想著他還是她，還是不管那是什麼？那種景象？會扼殺你們的創造力。"
 },
 {
  "id": 67,
  "src_sha256": "e044f4ca3e7c6857c3c14fa2a81c3b1329e26fc164f832960b7ad408b3779b25",
  "zh": "哎呀，那可是上等的作品。它是我們來這裡的原因之一！那個老 Dark Savant 從我們手裡搶走了它。當然啦，有你們站在我們這邊，我敢說我們很快就能把她拿回來！"
 },
 {
  "id": 68,
  "src_sha256": "80b6c878e58c8a86a813c8dbd70f62fcbba74442a859564ab0b8f0c9c974c703",
  "zh": "這個 Destinae Dominus 玩意兒……嗯，似乎沒人知道它在哪。不過我偷聽到 Sparkle 說， Trynnies 是這條路的起點，而這條路長得很……從那裡到 Bluff ，再到某處的一些洞窟。我可以保證，絕不是這裡的洞窟！"
 },
 {
  "id": 71,
  "src_sha256": "a45e92356a860030546ab9254758ad93c5c284a179873e5f32c8751c18d5bd54",
  "zh": "Ascension ？哎呀，那會是個不錯的歌名，對吧。"
 },
 {
  "id": 72,
  "src_sha256": "e784922bb88424e6a89f9d4fbf6327c417cfd129d6a996a1953302cec6dc95bf",
  "zh": "我確實聽說過這個 Destinae Dominus 什麼玩意兒的事。"
 },
 {
  "id": 73,
  "src_sha256": "4c69721bfbd38f54f6f259cf932f2ea71943c3b4a89d210ffc09bd04f35d8d2f",
  "zh": "我吹起號角可不輸任何人。你們大概看過我的套裝專輯吧？"
 },
 {
  "id": 75,
  "src_sha256": "f14810c0da46b95c04f8fd973ea023221c868cb6b98b2b9e3f3d505b61ec6d23",
  "zh": "注意你們的嘴巴，小子們！"
 },
 {
  "id": 76,
  "src_sha256": "250352ce2dffac2b5fe23625fa671de038509fd2b656bd968fa3667e0f4293bf",
  "zh": "「你們」去死吧！"
 },
 {
  "id": 77,
  "src_sha256": "53662ef5e1ae4ec5bf54ea79fd90fd4e03508c3499cf1f58762c435adade2e19",
  "zh": "怎麼了，小子們。"
 },
 {
  "id": 78,
  "src_sha256": "41bb65a546d3f237d19f864f8af229aef7bd3fd4451db17e5a9c83a6d6845ff4",
  "zh": "心裡要永遠留著一首歌，小子們。下次見。"
 },
 {
  "id": 79,
  "src_sha256": "75094f26318aeae4740d2e7d36e02003435b4c3bc57ad5083d4a364c9985536a",
  "zh": "你們要我幫什麼忙（ help ）？"
 },
 {
  "id": 80,
  "src_sha256": "f322c1a75395189445d6124e3fc35ec8e36a5ac673fc057bc81b9d5f950e43ef",
  "zh": "這個營區裡有間商店。你們可以去那邊試試。要談買賣就找 Kunar 。"
 },
 {
  "id": 81,
  "src_sha256": "24d90d917e10267e103df17e7bdb6256b65c4b08dd7bfb9abecf324c4d60a2b6",
  "zh": "我嗎？我好得很，好得很。只是有點希望能休息一下，你們知道的，離開這裡一陣子。"
 },
 {
  "id": 82,
  "src_sha256": "43e29e14bceea86328687da6d7a57dc5475a9e8653464efaeb909af94e89fdc9",
  "zh": "我的{{Magic}}都在手指上，小子們。你們會驚訝我用這些樂器能做到什麼。"
 },
 {
  "id": 83,
  "src_sha256": "3701e8e2b2372b50bffac3925522cfce4c37a184682379176ea0839c73b35928",
  "zh": "戰爭（ war ）？當然！ Umpani 對 T'Rang ！我不記得有過別的樣子。"
 },
 {
  "id": 86,
  "src_sha256": "c38fbfec7b6b8a95ade0518d39bd7bba5c4a1b6b34c91bc6adb036d5297dc4bf",
  "zh": "好一艘船！這是 Umpani 艦隊中最棒的！"
 },
 {
  "id": 88,
  "src_sha256": "426cef92c7a1264b0c34f034dc0dfd3c9a8e49a82d9a39d2950f694009a09fc0",
  "zh": "好啦， Saxx 。沒必要為這種事發火。多半只是該死的醉話閒聊罷了！我是說， Kunar 才不會替 T'Rang 工作！那太瘋狂了。"
 },
 {
  "id": 89,
  "src_sha256": "25f91c9f6e49428f1154774d1fccaeb2dfcc9a7075c63be25c81dd7289a61460",
  "zh": "真希望我有帶點東西來抽……"
 },
 {
  "id": 90,
  "src_sha256": "378406e946e6634f982b0bbc41860bab458f7414af41564103635395535c0cfd",
  "zh": "我想是在 Arnika ，小子們。"
 },
 {
  "id": 91,
  "src_sha256": "12deecec735d251b3edf1e54d72d7d017eb70a530a82ec5c758c06820fa7192c",
  "zh": "你們試過去 Trynton 找找嗎？"
 },
 {
  "id": 92,
  "src_sha256": "25df62a2a6fcc104d3f14e7b4fb8277bf3e97198f3ed96f0ffe3e485ad67049c",
  "zh": "大概是那片老爛泥沼澤。"
 },
 {
  "id": 93,
  "src_sha256": "4f7afe443cddffbd76b12fb0bef099dd54435924c646df19d37e815207a1e412",
  "zh": "那就在鬼地方！ Marten's Bluff ！"
 },
 {
  "id": 95,
  "src_sha256": "4cba023fe695c29648c7ecd18e29fe64e0f3bebd256fe9f80d56823aa0d69616",
  "zh": "哎呀，那就是 Mt. Gigas ，小子們！"
 },
 {
  "id": 96,
  "src_sha256": "be5549339149c2d8b3e28183d8b520e3e6693268f8c862cc5c564fefe1a71831",
  "zh": "某種洞窟。靠近海邊。"
 },
 {
  "id": 97,
  "src_sha256": "61f2c40a57bbb60d919baf2a3da20d7daaa2b4f640084e57c626178495533edb",
  "zh": "我想我聽說那是 Rapax Rift 。"
 },
 {
  "id": 98,
  "src_sha256": "c2ddfa38820599fa580c11d85d8ad01389731aa44d4fafb76b6e8e3d718a13c7",
  "zh": "喔對，那是 Rapax Castle 。"
 },
 {
  "id": 99,
  "src_sha256": "0c89a4df5e6187a5711ccadbee4f95e73e2f66600d38c68a3e1162497d4c9392",
  "zh": "Ascension Peak ，對吧，小子們？"
 },
 {
  "id": 100,
  "src_sha256": "0485188afc76c585a3b1dea10ac87d1481673fc05ea59b1ea6314095362b5618",
  "zh": "在我頭頂上的某處，在 Cosmic Circle 裡。"
 },
 {
  "id": 101,
  "src_sha256": "a091ba7e0b1b43ab6b88600431fae26495764a777e055bb988aeddba99b6449e",
  "zh": "把眼睛睜大，小子們！天哪！"
 },
 {
  "id": 102,
  "src_sha256": "603d4b6220f2dad761c7ac87a1f43ca7820fedfb6f333e2b21938a37723c00ef",
  "zh": "小子們，我被你們考倒了！"
 },
 {
  "id": 103,
  "src_sha256": "e69047d64e08f5019a9f51dabf11c93027a6c8d145249739d512a4348ae4bfde",
  "zh": "小子們，那是 Bayjin 。"
 },
 {
  "id": 104,
  "src_sha256": "65c18256ec2ea9281a32ab4d2a7aecab5de96beac53bdec4d3914b02c024d621",
  "zh": "等一下，你們甚至不是入伍的士兵！"
 },
 {
  "id": 105,
  "src_sha256": "29320c48363b1f9f53f50f7033a0f64ee7e9e9011f2bb67dce7479b24aa22ddc",
  "zh": "悅耳吧，是不是？"
 },
 {
  "id": 106,
  "src_sha256": "605a3705c5e94f822c91b2552afb7a701e525db688fcb6395e3b6944bf185879",
  "zh": "別告訴我你們居然聽那種垃圾，小子們！會把你們的耳朵聽爛的！"
 },
 {
  "id": 107,
  "src_sha256": "67b2f9504e7e4284fead2abb1501237478f9f4cf604b265f13e92d026cf1196c",
  "zh": "我在休息，小子們。別催我。樂手也需要放鬆。"
 },
 {
  "id": 108,
  "src_sha256": "6784a26a82d0cf89651afdb41fc79a167f315c10369a40b2f5235a2b5e35474d",
  "zh": "小子們，拜託。像我這樣的老樂手能拿那個怎麼辦？你們要是想抱怨，就去對 Balbrak 唱你們的歌吧。"
 },
 {
  "id": 109,
  "src_sha256": "56daab2e05aa8f9f9870a25a4fbb8568a198f1d2a806e925607e8bae1145fc55",
  "zh": "我想他們就在這附近的某個地方。"
 },
 {
  "id": 110,
  "src_sha256": "69db6858fa8774127f2988e0859051f076e688e2e1e1c88272fd11637c7020e3",
  "zh": "哎呀，那就是你們啊！要是你們覺得這名字不合，抱歉啦。我喜歡它的韻味。"
 },
 {
  "id": 111,
  "src_sha256": "cbdb1fa70714715a13486ab09c248bbaf3acf1175cf9c4b8c1142f669c2d434d",
  "zh": "這個地方（ place ）不賴。這工作也不賴。我大部分時間都待在 Roadhouse 為我們的部隊表演。這對士氣有好處，小子們。"
 },
 {
  "id": 112,
  "src_sha256": "f76353ad09ceb16be28613d41e9846624a1fa8dcf8683efc22c2d1b26e323f0b",
  "zh": "就是我說的，小子們。"
 }
]

[
 {
  "id": 0,
  "src_sha256": "515de2a173558f27590258c9a78bcfee4d64dcc92facd70d67458d02026fdf1e",
  "zh": "好了，小兵！出發囉！"
 },
 {
  "id": 1,
  "src_sha256": "6a79622440d45ebfb2f786825a56f19ec25dee1659fa7a5a64742ce248e95edf",
  "zh": "就算被逼到絕境，我照樣升階！"
 },
 {
  "id": 2,
  "src_sha256": "b91974d325067d06b2983fd0b3c91f61e7adaf1d59fba965863f1ab3c83c9d10",
  "zh": "小兵！快幫我處理這些傷口！"
 },
 {
  "id": 3,
  "src_sha256": "9a141f9e1503dd9d869abab057084ef8277a2e7974e9dc38ba38fe80667d22f6",
  "zh": "我要死在這裡了，小兵！"
 },
 {
  "id": 4,
  "src_sha256": "2066fe94ae254527697a7c8536a7f86c7fe6d9505b4631e5e699c45c98eda136",
  "zh": "這趟下來我累癱了。紮營吧。"
 },
 {
  "id": 5,
  "src_sha256": "32107ebe5dc28d1f4f366cfa16b976e6b319c3abe3442475f98add3b2fabb922",
  "zh": "需要醫護兵！這是那種會慢慢要人命的病！"
 },
 {
  "id": 6,
  "src_sha256": "1bc687f594828164cf6c8d2b4f804af08f2b955585164c11284ff3d4450ee30f",
  "zh": "在這病要我命之前先治好它！"
 },
 {
  "id": 7,
  "src_sha256": "9dc081bfe916deadbf40dd8734910598c41ecc49146db15439a6bb180ff799b4",
  "zh": "瞎了！"
 },
 {
  "id": 8,
  "src_sha256": "661659c416e5911282f8248c964a6ac2b26d5ef6fe80cf5c7c59e48d0f327998",
  "zh": "我是你們的任務目標，不是你們的私人行李搬運工！聽懂了沒，小兵！"
 },
 {
  "id": 9,
  "src_sha256": "64ca77bb3cd51ecaede7218b698d8f381ca4722c28c305981213b3c32075ece9",
  "zh": "醫護兵！我動不了了！"
 },
 {
  "id": 10,
  "src_sha256": "84ba12412d9feda7e15237070755ec709f5d02921b7196a0b636f52b1ca9e3b3",
  "zh": "同意，小兵！"
 },
 {
  "id": 11,
  "src_sha256": "451463d5752f5fafc2986fbcb7e50f88c290b8707bf4d4c9d154d3b8e46e896a",
  "zh": "你們大概會以為，我都已經歷了這麼多，你們總該讓我免了這一遭吧！（ Yamir 死定了！）"
 },
 {
  "id": 12,
  "src_sha256": "d8341777f400c856e2f7d5f72c21527b87f48bb23b5a78d7733692268ddb0723",
  "zh": "你們是要救我，不是要殺我，小兵！"
 },
 {
  "id": 13,
  "src_sha256": "500666682f271f662499456ec1b972745ae3c756d07752b8f5cde2f590ff1797",
  "zh": "（不知怎的，我總覺得 Yamir 沒把他最精銳的小隊派來救我。）"
 },
 {
  "id": 14,
  "src_sha256": "f931ddfedd8a1d78db57af047f68f3f2486e2048440477553c613ea3ca41acfb",
  "zh": "（口令是勝利，個屁！我來給你們看什麼叫口令！就是一記「拳頭」打在 Yamir 臉上！）"
 },
 {
  "id": 15,
  "src_sha256": "994f2139d655e584fcdbd27a4c0c5151e85bb49fef5c9fec01adadd66ece1911",
  "zh": "（這到底是什麼任務啊？我是身經百戰的老手！大人物一出現，砰，人就全不見了！那我呢？我被逮了！就是這樣！這也叫團隊合作？！？）"
 },
 {
  "id": 16,
  "src_sha256": "e6dd2c8709220216ea0860646b9af9a52bfd77111d3162e457a9f516e59bc8fe",
  "zh": "可惡！是他逼我的！"
 },
 {
  "id": 17,
  "src_sha256": "1d6f387ed04442496c50d7af6b93d991a4f7c56243f2fb72c652d9a249a88ad8",
  "zh": "哎呦！！拜託，小兵！"
 },
 {
  "id": 18,
  "src_sha256": "75c4b466a62ef09da58ba662092200958ce4cbb3d6edd61df57a4f9ba6f87084",
  "zh": "人員流動率很高嘛，小兵？"
 },
 {
  "id": 19,
  "src_sha256": "0f6e73f03f025150592d87488eb1a673826221e1b5000861ebb79fee8a4119fe",
  "zh": "IUF 從來沒有弄丟過女兵！"
 },
 {
  "id": 20,
  "src_sha256": "0c8cffb9810ef875be3bdb84390df897c558994f5c799607b1fa243a629194ee",
  "zh": "我該把這次陣亡當成之後的預兆嗎，小兵！？（ Yamir 一定是瘋了，才會派這些菜鳥來找我！）"
 },
 {
  "id": 21,
  "src_sha256": "596314f7267e73584d7feee634692e84167fef7158414b9e1e34b3f1768f8410",
  "zh": "不錯嘛，小兵！看起來真不錯！"
 },
 {
  "id": 22,
  "src_sha256": "d03029db2b1a0fc4c992f6a9a85d2a58e063c9ca28d685c2296e140455c77211",
  "zh": "哎呀呀呀。這情況真是越來越糟。我都想把你們這群廢物救起來，好讓我自己親手宰了你們！"
 },
 {
  "id": 23,
  "src_sha256": "a613d73985190e947f7ffa4d3f0673df4682ab829568594cae5bc0900da79090",
  "zh": "找到一些破爛……"
 },
 {
  "id": 24,
  "src_sha256": "a54e6b5a066e9a3f3db59575db2b56e012b33b007a1dc4e66aad8e65db943442",
  "zh": "又看到一些破爛……"
 },
 {
  "id": 25,
  "src_sha256": "5771c0f7b26b3eba4145447e62c8db5a8c750945436e213e1f416921a817df19",
  "zh": "全面警戒！這裡有陷阱！"
 },
 {
  "id": 26,
  "src_sha256": "2ee183c3ef0d4bedb9025aff61772427d958ff0ac1e0a0c31183557db6708581",
  "zh": "這裡有東西藏著。"
 },
 {
  "id": 27,
  "src_sha256": "555112bcc8466f9a66c4f29f1373ce1714154db79d4d2b166bac300fe302da1d",
  "zh": "這裡全面警戒，小兵！我一點都不喜歡這地方的感覺！"
 },
 {
  "id": 28,
  "src_sha256": "487bb38384dd3eb62d0fb509f690b7cab44cda4bb3e6a6bc957c2a007e919c65",
  "zh": "要處理這些傷口嗎，小兵？！"
 },
 {
  "id": 29,
  "src_sha256": "e2f649788d34d83fc87f9a3111bdec80b0e6375af138ec0ee6e566f1128d8453",
  "zh": "開打了！上，小兵！"
 },
 {
  "id": 30,
  "src_sha256": "6b38c41bb03808dc71e4b986900581792744282d90fc7b530b03a9977b968298",
  "zh": "開打了！可能有點棘手！"
 },
 {
  "id": 31,
  "src_sha256": "f8e5e867641c36ff473f456db46a667bb9740d1f939e869eaf0ddc5a695163d5",
  "zh": "開打了！我們的援軍在哪！？"
 },
 {
  "id": 32,
  "src_sha256": "7551f6b87056bf878b8eb3c812cd162c9b8a6bffb6c369592c618c7bac765f9d",
  "zh": "需要目標！"
 },
 {
  "id": 33,
  "src_sha256": "23321ef83b5d93b8277ac6e3843f4a2305d17e30b4dc826a9951a358c9f11d65",
  "zh": "這比 Bayjin 還糟，小兵！我被包圍了！"
 },
 {
  "id": 34,
  "src_sha256": "19d73c9676d9ca739580b81df6c3e597b9ca2baa64ace2692fd63afc768edd23",
  "zh": "剛才太驚險了，小兵！"
 },
 {
  "id": 35,
  "src_sha256": "bb017fec93055b3d763297a783c9bde51e96ea26ceb2c4ebe4f0b0d57362ba76",
  "zh": "繼續前進吧。"
 },
 {
  "id": 37,
  "src_sha256": "81a2665bf93a2c5c5e1a66b6a6649ac91891fa8bfab11a6723f3762beb25a56f",
  "zh": "盯緊我，小兵，說不定你們能學到點東西。"
 },
 {
  "id": 38,
  "src_sha256": "617aebd252789dc9046f538cb4a52ede167f62a2e41afd99c069e33925326a10",
  "zh": "有入侵者……"
 },
 {
  "id": 39,
  "src_sha256": "408ea8e91e95f6c7b4d0fd0a79501d4289e6ad461dcb940180865e833b289229",
  "zh": "彈藥，士兵！"
 },
 {
  "id": 40,
  "src_sha256": "2adfce1dd79380f830f68597cf5bd12ef0070fa673effb56702592d02e890750",
  "zh": "我以前見過這種事！有人在收集屍體。"
 },
 {
  "id": 43,
  "src_sha256": "87ee465e55fc7df6e8aa0dc755b6eb2cf354985737ad8f801168c99bfaaf9df7",
  "zh": "你們腦袋壞了嗎，士兵！我是紀律嚴明的 Umpani ！我絕不會做那種事！現在帶我去 Mount Gigas ！"
 },
 {
  "id": 46,
  "src_sha256": "759cbcd5e67d5942ef56302997e2a88758f99e237f97ae29a1dacc94558606cc",
  "zh": "今天對 IUF 來說是個好日子！我不但會凱旋，而且還活著回去，手上還握著我們追查了將近二十年的神器！你們不會不讓我留著它吧，小兵？"
 },
 {
  "id": 47,
  "src_sha256": "b8883a0d1f0661d422c7fb54bcb90d713bc26be95e1fb75dafa9a005b7e7fc4a",
  "zh": "真是太棒了，小兵。拿著會把人逼瘋的東西，我心裡有點發毛，要是我現在不趕緊回 Mount Gigas ，我真的就會瘋了！"
 },
 {
  "id": 48,
  "src_sha256": "60b91d1f2b5dec6c86c6b3518fc56ec3caafdc5842c904590862989b4036b757",
  "zh": "我要為 IUF 認領 Callisto Device ……而且我現在就要見 Yamir ！"
 },
 {
  "id": 49,
  "src_sha256": "505440e93f950d1bcef84c7c6372e183c522aed376e6278d2fd424e613daeab5",
  "zh": "我要為 Umpani Federation 認領 Callisto Device ！你一定會讓我留著它，小兵。現在我只需要殺出一條路，穿過那些十呎高的毛怪……"
 },
 {
  "id": 53,
  "src_sha256": "8a2900f256ba72e9e8520a5d21bf6f781c2bed28e7695da47a1e990295aea023",
  "zh": "不可能，小兵！"
 },
 {
  "id": 54,
  "src_sha256": "46511c55ef8953d347fa97fc3b267cf9136f37a0732f4f289da1049096dd55ab",
  "zh": "你們管那叫尊重？當面對我們說謊！（跟 Yamir 一個德行。噢，你不會有事的啦，他說。噢，我要……）"
 },
 {
  "id": 55,
  "src_sha256": "5291a0da34fc8ac1f169500d69473b8ee05a8a1199a188d67d1f6f405462cf4e",
  "zh": "我要為 IUF 認領這個。"
 },
 {
  "id": 56,
  "src_sha256": "178417cf296cbf6998fe3acc8213f2b0b7a2ceb565f49e4ea46501f047cb2f94",
  "zh": "這才是真正的軍人該有的作法！"
 },
 {
  "id": 57,
  "src_sha256": "68a959c46556c966e100f3eaebb8d88dca9374a443645ec41bf1d231ac36018f",
  "zh": "Vi Domina 。"
 },
 {
  "id": 58,
  "src_sha256": "f7d542775bc4cc1ed720e8aca720a0623ba67d656f44af5f41d5a3d123ee0b07",
  "zh": "現在安全了，小兵。"
 },
 {
  "id": 60,
  "src_sha256": "1917dd93e0bb02c93ba5d70324d1490108609397cb3a5d384c566a6e674dd46d",
  "zh": "你們差點害我送命，小兵！你們知道那是誰嗎！"
 },
 {
  "id": 61,
  "src_sha256": "9591abfbd1acc788c5721515b944097a73c9c5b545bd39be684cf4d861610c91",
  "zh": "對他放尊重點，小兵！塊頭那麼大的，都是我的朋友（不管他們知不知道）。"
 },
 {
  "id": 65,
  "src_sha256": "2c3ae05c86267e7f14807a08658c2879194b249b1b5205c050f893b17502ee14",
  "zh": "這個任務到此收工，小兵。"
 },
 {
  "id": 66,
  "src_sha256": "185cc406fc3fcafeae102a0da32e0fa61734a5c873c75e55e3b27056a194787d",
  "zh": "我要為這個認領……小兵！給我過來看看這個！他想騙我！騙我？！這東西不是它看起來的樣子，我再說一次，不是！它其實是假的！算了。那你們就留著吧。"
 },
 {
  "id": 67,
  "src_sha256": "23c356d0b5240f697e71ad7821a09ee4c5e2cc6f2c3157f96b92184f4d484c5f",
  "zh": "已經瞄準他們了，小兵！"
 },
 {
  "id": 68,
  "src_sha256": "4344a996929f24e0e30eb42496f5adb32b113ace7305551834fa09c3a6149986",
  "zh": "正前方有個瘋子！"
 },
 {
  "id": 69,
  "src_sha256": "bd700117db705230b1a10f051a437d02de5300f54b91c4a41bef8a10de8ec2f6",
  "zh": "不好意思，小兵？我知道你們的命令非常明確。你們被指示要立刻把我送回 Yamir 將軍身邊。你們忘了你們的忠誠嗎，士兵！我哪裡都不去！"
 },
 {
  "id": 70,
  "src_sha256": "53f12fb3d7e4e13668265b9a9c00ec7c17a93b85b11d3fb3c38deacdbf9b886a",
  "zh": "我想我們只是路過 Arnika ，要前往 Mount Gigas 吧？（噢，等我回去。 Yamir 有得受了！）"
 },
 {
  "id": 71,
  "src_sha256": "7658559deae374ec00066971b8e3be45614097ab562f8d1d678c960605732ca2",
  "zh": "我想你們在 Trynton 停下來是有理由的，士兵！你們的命令白紙黑字寫著要立刻把我送回 Yamir 將軍身邊！（好讓我賞那個沒用的混蛋一巴掌！）"
 },
 {
  "id": 72,
  "src_sha256": "6dc4031c857be6ae326d4aeeba764b3ea52482dde641e53a278f33c376462790",
  "zh": "你們瘋了嗎，士兵！這是通往 Marten's Bluff 的路。我絕不進那個營區。如果你們執意違抗命令，那是拿我們的性命冒極大的風險！別以為我不會在報告裡寫上一筆。（等我先給 Yamir 他該得的教訓！）"
 },
 {
  "id": 73,
  "src_sha256": "18a3663aa421da55ff96b51d8dd2f7faa2a87519c5f8c97ce3be4370d8e94d35",
  "zh": "好吧，小兵，看來洞穴那部分你們倒是找對了，但這裡不是 IUF 的地盤！ Mt . Gigas 在那邊！我現在就要回去！（搞什麼鬼。我真不敢相信又被分到這種隊伍！）"
 },
 {
  "id": 74,
  "src_sha256": "379ea2e3e995bbe0c0b64eac2168e6b54420b505a098faf38269c366c497b61a",
  "zh": "好吧，小兵，我確實該謝謝你們！我還以為再也見不到這個地方了。你們為 IUF 爭光了！現在，麻煩護送我去見 Yamir 將軍。（好讓我親手教訓那個自命不凡的混帳。什麼將軍，個屁！）"
 },
 {
  "id": 75,
  "src_sha256": "d5aead86b1dac18009e04417016b27baf0e0f88e4480bd290902d89401e87ef4",
  "zh": "如果我說錯了請糾正我，小兵，但我不記得 Mount Gigas 有這麼熱！我們為什麼會在 Rapax Rift ，而且違抗命令，不在 Mount Gigas ？"
 },
 {
  "id": 76,
  "src_sha256": "9dbd8d491cbe653858b34bed93f6a177d9736491f892c08423447d2e0b57f7a4",
  "zh": "我已經受夠了，小兵！如果我有什麼像樣的錢，我就付錢請你們送我回去。發發慈悲吧！我已經經歷夠多了。我只想回家！可以帶我去 Mt . Gigas 嗎，拜託！"
 },
 {
  "id": 77,
  "src_sha256": "273f1ee10e6a70e065ad48c2e49c38503e2f0c1f0aa608c3703e02aeda72048b",
  "zh": "可惡！我還回得了 Mt . Gigas 嗎？"
 },
 {
  "id": 78,
  "src_sha256": "f5df7b5428cc734be9eb9591561501b7aec5cf20ce57755409571e0aef3133ba",
  "zh": "你們爬錯山了，士兵！這條路通往 Ascension Peak ，而且就我所知，你們的命令寫明要我回 Mount Gigas 找 Yamir 將軍！（我可是急著想跟他好好談談……）"
 },
 {
  "id": 80,
  "src_sha256": "cfb93427b4dc86d6e55c444ba32ec826bc588776e6df974423a62faa3005ebd9",
  "zh": "你們看這像 Mount Gigas 嗎，小兵！這是片沼澤！把眼睛睜大！我現在就要去 Mount Gigas ！"
 },
 {
  "id": 81,
  "src_sha256": "c7d9cf573d92f6cdc26fcb8e1847b5ea3813fcd9b54d15ec3dd07473803febe8",
  "zh": "等等！斥候（ Recon ）回報這一帶有 Rapax 。立刻把我們帶離這裡！"
 },
 {
  "id": 82,
  "src_sha256": "6dc4031c857be6ae326d4aeeba764b3ea52482dde641e53a278f33c376462790",
  "zh": "你們瘋了嗎，士兵！這是通往 Marten's Bluff 的路。我絕不進那個營區。如果你們執意違抗命令，那是拿我們的性命冒極大的風險！別以為我不會在報告裡寫上一筆。（等我先給 Yamir 他該得的教訓！）"
 },
 {
  "id": 83,
  "src_sha256": "514e723a6d5d4fdc882a0b8c20db2a08c93adb620f1ff2475d0d650850d2e2a6",
  "zh": "你們瘋了嗎，小兵？我絕不讓你們把我丟下，尤其是在這裡！你們可以肯定我會向 Yamir 報告這件事！"
 },
 {
  "id": 84,
  "src_sha256": "0310517c374247b128f10b3df4ca878b39d521883c8e8afdf832729a56cfcb96",
  "zh": "我沒有剛才那麼難受了，不過萬一你們沒注意到，我還是病著！"
 },
 {
  "id": 85,
  "src_sha256": "3d7e331b249d1dfdde46bb3926cc5e6c40f1b0b18b34b184c28785c4f7c2c1c7",
  "zh": "你們這群小鬼大概在等我死吧，不過我有壞消息要告訴你們！我現在好多了！"
 },
 {
  "id": 86,
  "src_sha256": "7f195132285e975d4cd00d47437823d83c585d3343c28849024d98fb149b860f",
  "zh": "我們到底在哪裡，小兵？我不認得這個地方。（大概是把我打昏好讓我跟著走。噢，我看穿你們了，小兵。）"
 },
 {
  "id": 87,
  "src_sha256": "066fc710553aa31b85ca9a88b618836effdc560754c1c2dcead7b1a6e3763b89",
  "zh": "我真不敢相信這種事會發生在我身上。"
 },
 {
  "id": 88,
  "src_sha256": "273f1ee10e6a70e065ad48c2e49c38503e2f0c1f0aa608c3703e02aeda72048b",
  "zh": "可惡！我還回得了 Mt . Gigas 嗎？"
 },
 {
  "id": 91,
  "src_sha256": "b3bd2e4a98cf76c90cff5f339e69eebc7394ee0bdd2dad7e8d97462a46bcffe4",
  "zh": "Yamir 將軍，我有幾句話要對你說！我經歷的這一切，其實都可以避免，只要……你……只要……你……只要，呃，他們肯聽你的命令，長官！呃，回來真好，將軍。（還有你們，小兵，我不想聽到你們吭半聲。懂了嗎？閉上你們的嘴。）"
 },
 {
  "id": 92,
  "src_sha256": "e64d883f9b495534307706bf2cdaf4de41244bf2974aa6eb848dd48850181f3c",
  "zh": "其他人呢？！？其他人在哪！他們都在海底！他們就在那裡！都是你和你那些愚蠢的任務， Balbrak ！現在我要見將軍，而且我現在就要見！"
 },
 {
  "id": 93,
  "src_sha256": "de3e603afb5a2852339a28851cbfaf3a0464accdcbd327dfddd4a17469ae8e56",
  "zh": "把你們的爪子從我的裝備上拿開，小兵！"
 },
 {
  "id": 94,
  "src_sha256": "a271e27e22e5c8b4f4dc9bfaa5be4320fa3300ec95e5ff570cd13581fd61c1ca",
  "zh": "我到底要說幾次，你那顆一哩厚的腦袋才聽得進去！我不去那裡！"
 },
 {
  "id": 97,
  "src_sha256": "238ed4ef212e4496f3aeaaedfd0c1900a3598456c6ad3de5ccb8ae97cbd6a74a",
  "zh": "我沒時間聽這些人囉嗦，尤其是那些聖職人員！我在 Bayjin 快淹死的時候，他和他那些 Cosmic 什麼鬼大人都在哪裡？！"
 },
 {
  "id": 103,
  "src_sha256": "41e29afbb5eb0db9c1a34a6e610e44437ca792db07f386de09e980d2c1d6f311",
  "zh": "他會是個好士兵。高大。寬肩。等我跟 Yamir 把話說清楚之後，也許我會回來加入他們！"
 },
 {
  "id": 104,
  "src_sha256": "b6cb1af9ea5859108640975ffc74e53f2b8859ad9a06d0d9ae5908350f8d9cf4",
  "zh": "這是什麼鬼東西？"
 },
 {
  "id": 106,
  "src_sha256": "5bb68152257f50c2e5f65ae88bd5d63601f6b517d63ea97205f32b74f4c15bbc",
  "zh": "我拿這個要幹嘛，小兵？！你們看我像是戴著花俏頭盔的小女生士兵嗎？！我可不這麼認為。"
 }
]

[
 {
  "id": 0,
  "src_sha256": "998cf475928b28a650264dab983ed5606a589d26649e79338c72117d9a57ae09",
  "zh": "嘿，老大（ boss ）！你們絕對不敢相信！猜猜誰在這裡？"
 },
 {
  "id": 2,
  "src_sha256": "17fd3c843845adc20b339bb66055567ec94bbfeadabcb4ae6ff51b362bda1591",
  "zh": "我才不想被人看到跟你們講話。你們會拉低我的格調！"
 },
 {
  "id": 3,
  "src_sha256": "46954966f5ee0dd767ddb58c854db21c950bcb77448ff96a18dc4e35b603420b",
  "zh": "你們還真是不死心啊，是吧！"
 },
 {
  "id": 6,
  "src_sha256": "1988dd7e4fbfd68089e12b2bd1039014551be06c98d6b91e69064feb917e3cbd",
  "zh": "想吃我一記老拳就繼續賴著！不然就給我滾遠點！你們這些小鬼……"
 },
 {
  "id": 7,
  "src_sha256": "2d4552358771f977731794d1dd59b627eb4bd66a975eff90af0bd61c7807de75",
  "zh": "這什麼意思？！兄弟（ pal ），你們說要付錢，就得真的拿得出現金！"
 },
 {
  "id": 8,
  "src_sha256": "2eee60d01951df71d61d96da773231d75e5d57059be1d1a635f5b379919b020b",
  "zh": "你們這裡根本在打一場該死（ freakin' ）的仗（ war ）！"
 },
 {
  "id": 9,
  "src_sha256": "0f7c9dce615bf9bf8513b943a156a278df77033a3d37961d0147bc21a8f28ee7",
  "zh": "我看沒戲。上次我們接外面的活（ job ），被燒得很慘！"
 },
 {
  "id": 12,
  "src_sha256": "42c3f1b1ad87a3918e435d7e028ce687ac45324bfd7eb45d88509e6d0ad557b2",
  "zh": "對我有利……"
 },
 {
  "id": 13,
  "src_sha256": "391f36f064337f5d53fbee256e03dece10f5afad7737cfdc932f278bf9c9d2ea",
  "zh": "你們從哪撿來這堆破爛……"
 },
 {
  "id": 14,
  "src_sha256": "800a6237a37c6a3d976ee4843d930170afe06db15e13b2904e03fa709bfdc0f1",
  "zh": "我猜這對你們來說還值點錢……"
 },
 {
  "id": 15,
  "src_sha256": "de874463099175b7c1aee141ea90d84ab28d60792b1f41dc5aa60bd8162f8095",
  "zh": "我看起來像什麼都收的（ sell ）跳蚤市場嗎？我買夠了……"
 },
 {
  "id": 16,
  "src_sha256": "a70d9c422fca6f8962c920abd33b4ba4b0c3657ef033886e921e355fa0fee859",
  "zh": "錢還是差一點……"
 },
 {
  "id": 17,
  "src_sha256": "8a8dbc214603abeb6fcab9d97068f10928c38c66c03202b82ae4207c6d90d13a",
  "zh": "什麼？！這是我的！我該把這玩意塞進你們喉嚨裡！事實上，我就要這麼幹！"
 },
 {
  "id": 18,
  "src_sha256": "fdad73c6db21d24ce8a5daa6856d37e190e610b99237764188c03feba9c29b33",
  "zh": "唉！真正需要的時候，偏偏就沒有水泥跟河……"
 },
 {
  "id": 19,
  "src_sha256": "9c883fb3dab12bacd8d59ebb0b755bbe8e7f64b86138609b41049a58ceb9221d",
  "zh": "給我聽好了，混蛋！你們不准偷小偷的東西！"
 },
 {
  "id": 20,
  "src_sha256": "ef52b97c5cce5eaf56902079a00f022d9a447a34fb4666ece9901f0fd7d15dc5",
  "zh": "你們……這些該死（ FREAKIN' ）的小混蛋！"
 },
 {
  "id": 21,
  "src_sha256": "4ca4282c075b0df4156b4c78595774390aba747b873be90caba57d9f1edf9b7a",
  "zh": "謝啦！要是我得揍你們，我就不會揍那麼重！"
 },
 {
  "id": 22,
  "src_sha256": "229142b79bb497723d27cf79d8cdbdf60b17006955db3a7696956c558f4c3cb3",
  "zh": "聽著，我在這裡待得跟你們一樣久！"
 },
 {
  "id": 23,
  "src_sha256": "e108464154df55bff9cf81974bade5e071a3e4ce45d94b57b4c957c8e8630831",
  "zh": "我不是適合問這個的人……"
 },
 {
  "id": 24,
  "src_sha256": "032e4e5cb2444069e81a840b374feb547d5026af96642c9c056b1586f362358c",
  "zh": "不，不，不，不。我不會洩漏的。"
 },
 {
  "id": 25,
  "src_sha256": "234c52ff8b80f0b8e7882aa922f3d7520df54547aea36a8167db6a5cabe7ac0d",
  "zh": "你們真遲鈍！我說了……"
 },
 {
  "id": 26,
  "src_sha256": "7af7ca261793587ec1efb9a86991f2cffea347ac2e90fd1eb89dc3cb9ab52021",
  "zh": "天啊！你們講話的樣子好像一個禮拜沒跟人說過話！慢慢來，兄弟（ pal ）！"
 },
 {
  "id": 27,
  "src_sha256": "e590dd195b352ef692b5b9295aac822198b2db4c8ba11e87194ad2fda653d078",
  "zh": "然後……"
 },
 {
  "id": 28,
  "src_sha256": "adb3616734e5cbd66ebd68cd00109568d241d4aa6e18db409983cf36ddc715ee",
  "zh": "我不在乎……"
 },
 {
  "id": 29,
  "src_sha256": "8a04d9714c9b1a6d1c52821ee581c4cf2a94e6f95141988353f217269005e431",
  "zh": "跟你們聊天真是痛快，不過呢，呃……"
 },
 {
  "id": 30,
  "src_sha256": "06ef854067876d40e55e92309e1ba8d28a03796674507e718615c37bdf6796a0",
  "zh": "你們在這裡有沒有別的朋友可以，呃，去聊一聊？"
 },
 {
  "id": 31,
  "src_sha256": "0896c9cc25307ebf940cebc34fc5687e0afe4b5544cc723dac1abcc40a9be354",
  "zh": "你們是說這坨打轉的爛泥巴？從空中看起來比較順眼……"
 },
 {
  "id": 32,
  "src_sha256": "35c1ba3f93c23b12e61faebdb70fee003ece02fe28b1ce680bf19dc0a8f84e23",
  "zh": "對，我聽說過。 Dark Savant 把自己安頓得真舒服，就在城市正中央。"
 },
 {
  "id": 34,
  "src_sha256": "05783f3227c95f54ce106662d4418186e9bc1e1ea9023d809995d52b133ffd8b",
  "zh": "你們是說 Calzone City 啦，兄弟（ pal ）！再過一個月左右，這棵樹（ tree ）就是我們的了。我們只是偷懶了。剛來的時候就該把那些毛球幹掉。"
 },
 {
  "id": 37,
  "src_sha256": "c308e714dab9064c4b40de3ddc126304595a99ca9ad118479c57062763b43827",
  "zh": "對，那裡就是那些，呃， Umpani 待的地方。我們有眼線，你們知道的。"
 },
 {
  "id": 38,
  "src_sha256": "496689cbf952517cd563e62f29e3905bffd5c6eaaa70757737f1534697accb01",
  "zh": "對，對，那些 T'Rang 。聽著，我們對他們或他們在哪都沒興趣。我們來這裡只有一個理由。 Dark Savant 。"
 },
 {
  "id": 41,
  "src_sha256": "305bf24fa6fce5ec2fd207d52cc6da4f1b8ee6d495247e930c087886ec5f6a23",
  "zh": "這算什麼新聞…… Cosmic Circle 。 Cosmic Lords。 Phoonzang 。隨便啦。"
 },
 {
  "id": 43,
  "src_sha256": "97127cee2aa61b5fd92b3e296ee55f577668e77f5f8fb1a6268e6bc5ed0db0ee",
  "zh": "對，我聽說過他們。大多是從 Helazoids 那邊聽來的，不過你們對那個大概也毫無頭緒，該死（ freakin' ）……"
 },
 {
  "id": 44,
  "src_sha256": "f32d2b95780e356dc8dd45af8077e33ef239378d232f96412cefe48b8042af41",
  "zh": "毛球。對他們沒用處。"
 },
 {
  "id": 47,
  "src_sha256": "7af6a0268fdf7564ec598bd4e17c4d20d3a26ffcc6564ab3fca51aff67e2455d",
  "zh": "只跟你們說，一開始把我們捲進這場該死（ freakin' ）爛攤子（ mess ）的就是他們！你們看，很久以前，在另一個星球，我們接了份合約，要盯著他們。結果委託人，一個叫 D. Savant 的傢伙，溜了！"
 },
 {
  "id": 48,
  "src_sha256": "6164e794ee9cb6827326f1d062033a23fd85136439396d88682ed7bb9a8c20f7",
  "zh": "當初就該讓他自己去盯那些玩意……那些東西長得可不好看。"
 },
 {
  "id": 49,
  "src_sha256": "590a254060f39b58f45f6ba316bfa309f0c9fc92e3b8c68b4e6014ef0d3ad3e4",
  "zh": "嗯，在老家 Guardia ，我們本來就是從那來的，有個長得很好看的種族自稱 Helazoids 。傳說他們是 Higardi 的後裔。事實上，我還以為他們現在早該到這了。我親眼看到他們的船（ ship ）離開！"
 },
 {
  "id": 51,
  "src_sha256": "2156bfea0665a6ed7e83d176b0925bed740392bdf0deb0bbd4490e9f5e19bc3d",
  "zh": "不只是 Rattkin ，是 RAZUKA ，兄弟（ pal ）！"
 },
 {
  "id": 53,
  "src_sha256": "9f40f7d82da824d4178272f32f07a066085f9fcce2183e1cc8c5100031414433",
  "zh": "Cosmic Lords，什麼 cosmic 不 cosmic 的。誰在乎……"
 },
 {
  "id": 54,
  "src_sha256": "8e82a9485ed3d7ffebaf6938cfe8a88a919958b4cea598645773cc745f960722",
  "zh": "Guardia ……對，甜蜜的家。離這裡挺遠的，不過有時候為了工作（ job ）你們就是得出遠門，你們知道的。"
 },
 {
  "id": 55,
  "src_sha256": "e3ad6e40a07222b1d3b539ee1603465371718f6a5be35fbd56ecf55806e17a1d",
  "zh": "往那邊大約一垓（ gazillion ）哩……"
 },
 {
  "id": 56,
  "src_sha256": "1d6daf296a3f804d14aa279e692dd6d58711da1b5496ab4211edafbf5bf307af",
  "zh": "對，那個沒種的孬種！幾年前他找我們接這個活（ job ）。說，「盯著那些 T'Rang 」，我們就盯！眼睛從沒離開過他們。我們幾乎把他們綁起來了。所以那個 Savant 呢？他要拿到他想要的東西——這個 Astral Dominae ——簡直輕而易舉。"
 },
 {
  "id": 57,
  "src_sha256": "d6676c430216246048fe135c4b072cbbcdf5c2b6905b202979e0f2cc7541d9a9",
  "zh": "但我們早該想到……他一拿到手，我們就被擺了一道！他把那顆小寶石握在手裡，沒付錢就跑了！給你們句忠告——永遠別對 Rattkin 食言！永遠別！他*欠*我們。而我們是來討債的！"
 },
 {
  "id": 58,
  "src_sha256": "a5568f1288c3fc7edb51e4683fa8f3b14402e124ee04f05affb183769fcd36f6",
  "zh": "啊，女人讓我分心……"
 },
 {
  "id": 59,
  "src_sha256": "be1f9f25ca8642ae7d531b5b9f165ac24f225ea051295ede3f7c865a224b0e02",
  "zh": "幹嘛不自己去問她。"
 },
 {
  "id": 69,
  "src_sha256": "9c770886ce7a3a2595f1ab63465996cb07333e02d07347fb1612d27d1cf50422",
  "zh": "Da Boss ？你們對他有問題，自己去問他。"
 },
 {
  "id": 70,
  "src_sha256": "42e7bc4569d20cd109b1760ba93c1a018db8b1719cd3da004edb1ad3905951d4",
  "zh": "痛處啊！那個蠢東西把 Guardia 整個翻了過來！好多年來我們都沒遇到問題。我是說，我們這些住在 Guardia 的人都知道它在那，但顯然那不是眾所周知的事，你們懂我意思吧。"
 },
 {
  "id": 71,
  "src_sha256": "63e110f25057df6b1b61e822863fa3989a51e1b2d7c17c259d5074e1f0f1df27",
  "zh": "後來消息走漏，它變成宇宙尋寶大賽的頭號目標。 Umpani 、 T'Rang ，大家都來了，整個星球擠滿外人……包括 Dark Savant 。他拿著獎品大搖大擺走人。"
 },
 {
  "id": 76,
  "src_sha256": "4185f8f9930d0e6503a37a54fee5b608b42e18ad9575125dc10c04ac991f3193",
  "zh": "我聽說有一群大概六個人，最近降落在這裡，完全搞不清楚狀況（ freakin' ）……到處問一堆蠢問題。"
 },
 {
  "id": 77,
  "src_sha256": "315c6428cc4b48ccf1dbe1034ff05af46a46857358372ca9f8fb568a05c00f4b",
  "zh": "Milano Calzone 。 Razuka 為你們效勞。嗯，其實也不真的。"
 },
 {
  "id": 79,
  "src_sha256": "10dcbe40f66b0f7ea3e984414a580c3940ee83d7fdaf90919df354bc43a26b3a",
  "zh": "吹你們自己的……你們懂的。"
 },
 {
  "id": 80,
  "src_sha256": "b74a786e8b5868e47fa6c393162fd0a6011fb1e18856a37990d857c3266ff1cc",
  "zh": "嘿嘿嘿嘿嘿嘿！那你們示範給我看啊。"
 },
 {
  "id": 81,
  "src_sha256": "c00f4c0082b5e7e4bedd04ef91463b3ca8f53085488ed43d1900eb093eb16bb0",
  "zh": "好啦，好啦。"
 },
 {
  "id": 82,
  "src_sha256": "93692ab2e2b2c606657345d2821025fe8ce8b905734acb5dc15a14b653b0545d",
  "zh": "記住，在這裡看到誰、在這裡聽到啥，你們離開以後，就讓它留在這裡。好了，走吧。"
 },
 {
  "id": 83,
  "src_sha256": "f5671c044ae4a62a4c4e4c835e1fb11b22068d5339b8dd625bf311713231c5ce",
  "zh": "我不是來幫忙（ help ）的，兄弟（ pal ）。"
 },
 {
  "id": 84,
  "src_sha256": "729b7dfa78c95f37a0460dd0f03bca331c15a5daa4e8114470e0e844209f8158",
  "zh": "看你們有什麼……或者你們在找什麼。"
 },
 {
  "id": 85,
  "src_sha256": "01955f52b60d56191ea0f9785c36a5b8c99afcbb06623e057be6a8d8851023e8",
  "zh": "我？我隨時都處於最佳狀態。"
 },
 {
  "id": 86,
  "src_sha256": "f40bcff78d87153a73f0e5b91e69e4a12e5304fbe0952717018de8af22dfdf74",
  "zh": "拜託！沒有什麼戲法，是一記老派的頭槌複製不出來的！"
 },
 {
  "id": 87,
  "src_sha256": "6124df0287a6787f93a530efa2275033e870447e6b3b894a47a6ed213fbe26b4",
  "zh": "我唯一在乎的戰爭（ war ），是那場要一拳打在 Dark Savant 頭上的。"
 },
 {
  "id": 91,
  "src_sha256": "fb57ebf469f36559442b3ac6c08b484f1db0262d85a196494d5090586470819f",
  "zh": "對，我親眼看過那艘船（ ship ）。不過再多的我就沒法告訴你們了。"
 },
 {
  "id": 92,
  "src_sha256": "e39403b19b8b06a61763af10fd74824f3d092c0a74f3ce4ffeb86fe4453dc5ee",
  "zh": "我估計再一兩天，仿製品（ replica ）就會準備好。然後也許我們可以把它賣（ sell ）給這些傢伙。對，我會跟 Don 提一下……彌補我們的損失。"
 },
 {
  "id": 93,
  "src_sha256": "4c027ff78f41c43c81a17345918922154f8c0cf933eb6fcdd9c72013c682ac61",
  "zh": "不過我得納悶，我是說那些小毛球好像比失去他們整棵該死（ freakin' ）的樹（ tree ）還在乎那頂蠢頭盔（ helmet ）！它肯定值點什麼。我得想辦法弄到手……"
 },
 {
  "id": 94,
  "src_sha256": "d9aaab9bae659e9fcec6c485fa5bd78339fca94d77d0f2d3c695e1e5e8067206",
  "zh": "我現在真想來塊披薩……"
 },
 {
  "id": 95,
  "src_sha256": "fdbb9b2028144bda0978eb26f9ee1b0e1e9fcd7169f970f507052bd3a083febf",
  "zh": "自己想！"
 },
 {
  "id": 106,
  "src_sha256": "8e213f3f84c5a0f9082c99d6e1cacedb0ad6f0c61325e1f0a00017a12049e952",
  "zh": "四處看看吧，兄弟（ pal ）。四處看看。"
 },
 {
  "id": 109,
  "src_sha256": "4baf59a60ed43aaa77cc6d279c7af85ca65d83c1269806edd6fc19726be0bedf",
  "zh": "哎呀，好啊！看看是誰來拜訪了……"
 },
 {
  "id": 110,
  "src_sha256": "415cd70abb84e55296a62e92aae259464327c27435e386b056d3bf6b5baadf80",
  "zh": "你們還記得老家那些小怪胎嗎？嘿！告訴我，你們這些小子在找誰——或者找什麼？"
 },
 {
  "id": 111,
  "src_sha256": "57478a1772b6aa91ef3b8e086cc7cdf71fe060f24e5a2d048c92f23385ebe185",
  "zh": "你們還記得我們在另一棵樹（ tree ）上看到的那些小怪胎嗎？是那些小毛球派你們來找我們的？嘿！嘿！嘿！嘿！告訴我，你們這些小子在找誰——或者找什麼？"
 },
 {
  "id": 112,
  "src_sha256": "3512f636294aac78965c302e2a21545697262aa0fe722bc45a29ac3708801090",
  "zh": "我知道你們在找什麼東西或什麼人……那麼，是什麼？"
 },
 {
  "id": 113,
  "src_sha256": "8c138b333be94b7e7123a49a4d28806061dfac6993d030cb64ebee137e0885ab",
  "zh": "我就在想你們什麼時候會出現！來吧！老大（ boss ）想見你們，而且他說很急。"
 },
 {
  "id": 114,
  "src_sha256": "e674686a053e017221fce864f8b85c399f26e8e62de95d55aeb9a9ad6254c15c",
  "zh": "喔是嗎？嗯，那我們沒興趣。"
 },
 {
  "id": 116,
  "src_sha256": "22a164e58fb7086d9b18dd728ec9e8dfda123081000c32f3a4e892571a0ba899",
  "zh": "你們說啥！你們也在找他，是吧？有什麼好線索嗎？老大（ Boss ）可能有興趣跟你們談談。來吧。別忘了表示一下該有的敬意……"
 },
 {
  "id": 117,
  "src_sha256": "fdcb900e86a63eea262e8db5d207d97b2b74fac4bc60e06338f1dc9190445184",
  "zh": "你們也在找 Savant ，是吧？告訴你們，現在沒什麼用了。我們已經找到他了！你們何不進來跟 Da Boss 說幾句話。他可以，呃，解釋一切。"
 },
 {
  "id": 118,
  "src_sha256": "2e0da317369edab7cff4b249444e100e50f6f11f375e0a46512fc5a100461f9c",
  "zh": "該死（ freakin' ）的 Astral Dominae 。上帝保佑它。等 Don 聽到這個。來吧。他在等你們。"
 },
 {
  "id": 119,
  "src_sha256": "62d5b64b399ca61a072e4571a71da2d068c31b50202f87fe091ed94061ddf2c9",
  "zh": "嗯，你們找到他們了，大人物，但他可不是在找你們！我想你們要找的是別的人或別的東西。"
 },
 {
  "id": 120,
  "src_sha256": "2aac0921c62bfc161f385165949665e5b9b1c62634591ab0e40aee7a8083c1db",
  "zh": "在別人不在場的時候談論他們，*一點也*不明智。"
 },
 {
  "id": 121,
  "src_sha256": "69921bc36c2a393b632ebeaf7a964d0faa765c56cb6cc7edd0513ccf16fab120",
  "zh": "對，Order of Taw 。你們可以把我們當作某種家人。"
 },
 {
  "id": 123,
  "src_sha256": "a725030e280d61d23a2c630b6d10277e149e79cb21acf24e26780bc6b3ac003e",
  "zh": "別這麼自作聰明。"
 },
 {
  "id": 124,
  "src_sha256": "7ef662b4db7f0c65e9b2988bcbde2126ab822d48babddc896640bec82b51861a",
  "zh": "你們運氣好！我們有，不過你們得跟 Don 談。"
 },
 {
  "id": 125,
  "src_sha256": "31c3694945472d4029c6ea9ee203f286ca9c121cc65703bdd26be4218af99acb",
  "zh": "你們別操心那個。"
 },
 {
  "id": 126,
  "src_sha256": "fcbb039290f6d1f66f558fcea7a6e247f0c3b0df075a88f0750a524066b2ae23",
  "zh": "大概離他的死期還有兩個鐘頭，如果我們說了算的話！"
 },
 {
  "id": 127,
  "src_sha256": "1666e0129378a0cda891cbabb3556aa074ad44630b7cc29f44b16e78a5142824",
  "zh": "對。這就是我們的行當，你們知道的。要是你們不知道，那就太可惜了。"
 },
 {
  "id": 128,
  "src_sha256": "e620f6fd2df53591a3a876a257f4a415b2eec45d6cda3c2ae981a2bc447a7096",
  "zh": "我只是想看看我對你們來說值不值錢。你們讓我心裡暖暖的。真的。"
 },
 {
  "id": 129,
  "src_sha256": "8a73fbd3b2adad6dc670d5d0595293acf1d240a14412fe8792112fae538a0781",
  "zh": "我不想談這個……"
 },
 {
  "id": 130,
  "src_sha256": "bfed68955690d2952d8e6ba6484eea959b77614b7d363201f04a37204c04cfce",
  "zh": "你們怎麼知道那個的？不覺得很怪嗎？我是說，那些毛球對那該死的東西執著得要命。還有件事要告訴你們，我想不出任何辦法弄到手。"
 },
 {
  "id": 131,
  "src_sha256": "017582e9bf7eb0dee2dcf373a8d9ddaa5a046f521e6f3c8248b4e5fbef716133",
  "zh": "如果你們在問我這個，那你們最清楚。"
 },
 {
  "id": 132,
  "src_sha256": "077b5a924bfc7e9092b6937725d5d43cf75b878a91c56dbeb10fcd89eb98c0b1",
  "zh": "你們沒聽說（ hear ）？ Rattus 在 Arnika 附近惹上了麻煩。我想我們好長好長一段時間都見不到他了。"
 },
 {
  "id": 135,
  "src_sha256": "31870c0822cb1ab1c261875986c03e1775026d4585b2b7678fdef550d9c992a1",
  "zh": "我才不是你們兄弟（ pal ）。"
 },
 {
  "id": 136,
  "src_sha256": "9df0e05ac150dcd83bff9d82434fe3c6d048f34f11a29148e3fa000f9f2888de",
  "zh": "沒錯，兄弟（ pal ）。"
 },
 {
  "id": 137,
  "src_sha256": "3314deb522985dcb3425de04d70218c46f8fb047564c8a7b177c67f9dd0dd01a",
  "zh": "在這裡的北邊。"
 },
 {
  "id": 138,
  "src_sha256": "4754476857d54422628e14d86a35f0da55c81bf46de12d464e566f2eb57e45ca",
  "zh": "你們得再往南走一點。"
 },
 {
  "id": 139,
  "src_sha256": "0a5608df8d0008b99982ca456ab5c30c90fd8d68132311a13608e1d2dd40de6f",
  "zh": "你們得往東走。"
 },
 {
  "id": 140,
  "src_sha256": "49d1d23d6316afb4e3a4bd4b6a93206735ca07efd357ea2e4ae7eea9040cd2aa",
  "zh": "你們往西走得還不夠遠。"
 }
]

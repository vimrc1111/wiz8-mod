[
 {
  "id": 2,
  "src_sha256": "1eb3af25fd8c9a8328fcab3b7fd1ce568ffbdf9ed9dfe27caa8aabaa9f947b95",
  "zh": "此處……禁止進入！"
 },
 {
  "id": 3,
  "src_sha256": "209e911650b2046c7bace5d3f2ce7e4c99b742f8086a1c1eae51c004ca6a577c",
  "zh": "立刻離開此處！"
 },
 {
  "id": 4,
  "src_sha256": "3c55b58b0a7a6e836612e787a044f055f920ff00b5a7b5da70c5482db3db9fb2",
  "zh": "奉 T'Rang 帝國之命，退後！"
 },
 {
  "id": 5,
  "src_sha256": "76336e5b9c17edd49e18e992c03154d5e88e585a44f2496605f8374303076553",
  "zh": "你們擅闖禁地！"
 },
 {
  "id": 6,
  "src_sha256": "31ae3518f9c5ba0b8e5331d60dc52626d5f4e9fec1ec9071395869964da54d9d",
  "zh": "監視者說得沒錯！你們闖進了我們的要塞！"
 },
 {
  "id": 7,
  "src_sha256": "a937da12397b3b1b795cbb1d95e012c75d209515d5baa2235473e04a72f3276e",
  "zh": "你們沒有許可，不得入內！竟敢挑釁帝國！"
 },
 {
  "id": 8,
  "src_sha256": "68c5fbf9c5d311efcc67236d6daeb6389dfefd14ddea58cb3721be9ca91758ad",
  "zh": "我不會替你們打仗。"
 },
 {
  "id": 9,
  "src_sha256": "896c32579c75d2b1865b77c910a54f0a61b25b712876dc490957e25d01c5f7fc",
  "zh": "這裡是艦長。我們在 Dominus 的基地確認，Savant 正在環繞這顆行星的軌道上。所有無人機準備降落。全體保安部隊，進入戰鬥位置！"
 },
 {
  "id": 10,
  "src_sha256": "4a9f5a1f7817b8c792de005426158939d084308d21560e347f569eae76082a3a",
  "zh": "哼，肉身生物，你們活下來了。我很……如你們所說的，高興。你們在 Guardia 對 T'Rang 帝國大有用處。"
 },
 {
  "id": 11,
  "src_sha256": "5210d3674ad1aab5ad62a2b1e8a3c89facaad1f16e13af2c5de12967d44df694",
  "zh": "如你們所見，我們的先遣小隊已在 Dominus 待了一段時間。我們把這座廢棄的建築當作基地。一確定 Savant 的去向，我們就先派了一艘船過來。"
 },
 {
  "id": 12,
  "src_sha256": "8e2543febc9074ccbd10ca0697360a3b4a9eda6f4ab0a01918640013bc3089c8",
  "zh": "你們想走就走，對我們的義務已經結束。不過，若你們想向 Savant 報仇，就該加入我們。我們已摸清 Savant 的計畫，很快就會對他動手。"
 },
 {
  "id": 13,
  "src_sha256": "c75beb78e0373e97e68d19af11c575d5b8dbc296f824813011eb27b200649ebb",
  "zh": "若你們願意再次為我們效力，我們將十分歡迎。我們的新領袖 Z'Ant 期待與你們見面。他聽過不少關於你們的事……"
 }
]
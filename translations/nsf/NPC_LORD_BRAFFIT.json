[
 {
  "id": 2,
  "src_sha256": "d4ac122e31b28e1d59c44fc64f1eb0b0b233092b341e02e295a13ef5642f58a4",
  "zh": "我叫你們滾你們沒聽到喔！"
 },
 {
  "id": 3,
  "src_sha256": "5c694ed04eca08e962fd8c4c1722c45f85fcef055a0c2488033392fbf532bac8",
  "zh": "你們少來這套甜言蜜語！"
 },
 {
  "id": 4,
  "src_sha256": "c21878424850d760eef76a57c9ccb285c7f5f69cf9f7fb7595054956b20665ad",
  "zh": "我有說「滾」嗎？我是說、呃，給、給、給你們道謝啦！謝謝你們特地來一趟。"
 },
 {
  "id": 5,
  "src_sha256": "c8743f85d6379bcf6582642bbf07faa7fded993210938f5b86bf8e93c150fb40",
  "zh": "我就是有點緊張嘛，你們也知道，那些 Tee-Rang 把 Marten 的老地方占得到處都是。"
 },
 {
  "id": 6,
  "src_sha256": "51023644c49a4ba17a276175184d470cf31738dea26a78ee503e056506096e4d",
  "zh": "聽好了！我要把你們的頭扭下來餵鱷魚！"
 },
 {
  "id": 7,
  "src_sha256": "15d1e3ad115aa79aa0652196f914cc2fca87e5efca3fdf7aa89dbc5a51efdabc",
  "zh": "我可知道我的價值遠不止這樣！"
 },
 {
  "id": 8,
  "src_sha256": "cb82da2b7bb049307958f2fe7accdc1d2f5ee723a07cf48f4e114f4430cb988f",
  "zh": "你們把他們全惹毛了啦！"
 },
 {
  "id": 9,
  "src_sha256": "66a0c9554f607bb862093666704203b8f4f72c99a5b4904622b42f21266f1d65",
  "zh": "你們腦袋壞掉啦？我不跟 Marten 混，更不可能跟你們混！"
 },
 {
  "id": 12,
  "src_sha256": "2f3a58c58ebcbc76d03523672be0215bf8c70c96a5867233186192603ac2151d",
  "zh": "真是太好了……"
 },
 {
  "id": 13,
  "src_sha256": "413af2974dab2c7cf23e5d6b19b6a9cadf89ed7e3e580868080ff31856ed7774",
  "zh": "我可沒你們想的那麼隨便……"
 },
 {
  "id": 14,
  "src_sha256": "7b6c756dab286ae019f0807ec69cd2e5c01c5039375f7a17f41b8dc3427eff7d",
  "zh": "欸，這對你們來說值多少？"
 },
 {
  "id": 15,
  "src_sha256": "ad7542cfd9685d5f0982e0b89c60655b15baafe5af4994fe82eeb3e765c4045c",
  "zh": "我買的比賣的多太多了……而且我不再買了。"
 },
 {
  "id": 16,
  "src_sha256": "69a59d4513ded8da71a35b03f7be26237d4c0d9f8f3d52baef55e3bd3a842d6e",
  "zh": "你們想少給我錢是不是？你們根本不夠付啦！"
 },
 {
  "id": 17,
  "src_sha256": "86db72c254c6d55da7ce39000eb4ecc06bcca6259073b5c3be512a4b37ca1601",
  "zh": "我還以為我們是朋友咧！"
 },
 {
  "id": 18,
  "src_sha256": "2fd06cca86296cac4f0dbf865ac71a37b7d3ed3c6c9a94913354631f6e5698b1",
  "zh": "你們這些偷東西的愛蜘蛛鬼！！"
 },
 {
  "id": 19,
  "src_sha256": "d01bdfe3052ffc5008d3baeaeacb6f4710d34416758d0e6e283ba965d312da43",
  "zh": "你們怎麼可以這樣！？"
 },
 {
  "id": 20,
  "src_sha256": "c4be710dfb795f514bde7d9dc0da0b4d8144294d703f22120d4eca6895c2477c",
  "zh": "我隨時都用得上……"
 },
 {
  "id": 21,
  "src_sha256": "66e12a8855671c4549db552c20f263f6b656435ea4f8d87a47a2242f1da9dacf",
  "zh": "我不太出門的，你們知道……"
 },
 {
  "id": 22,
  "src_sha256": "4afa37d3d71e03478f4afcca209a13e877dcce9a2dbd25245f05b426860a44c6",
  "zh": "呃……哎喲，我不知道啦。"
 },
 {
  "id": 23,
  "src_sha256": "cdbdb69b54664ab874190647d41b2b9faccf968924b416e88d225c25c7c0fe1b",
  "zh": "管好你們自己的事！"
 },
 {
  "id": 24,
  "src_sha256": "97fa2c2417ea1672b9568384dacc0b5d56a357e6774d3a7ef8a5131db1ee1ad2",
  "zh": "把你們耳朵裡的蠟掏乾淨啦！"
 },
 {
  "id": 25,
  "src_sha256": "d0dcdfef4d6877fd93f5c6f5ff19ed9eb50acb7edb3d8ac77d34226a4c49ead3",
  "zh": "你們一次最多問兩個問題。"
 },
 {
  "id": 26,
  "src_sha256": "e67eebca0a6ba6603b5311837f1ca82741363f300c359c57a72ccd9035ead56c",
  "zh": "還有，你們知道的……"
 },
 {
  "id": 27,
  "src_sha256": "9caa99721a0f7ac2ec4c9f3e7d057b5007429c75078b0a03e0975f36df7066c9",
  "zh": "這不是挺有意思的嘛。"
 },
 {
  "id": 28,
  "src_sha256": "a4949e2c96de26681c9519749e57bfb362bbac2a8f40c89b24c35d1de111336d",
  "zh": "啥？"
 },
 {
  "id": 29,
  "src_sha256": "55c3e5daec20a64dcc70fbed694d58b7b529e567f03b0c43f0d6ac23630f7c4e",
  "zh": "蛤？"
 },
 {
  "id": 32,
  "src_sha256": "efbac6bced511d0f34e9a9ab84e615aad50829efa5151c43f3cb1a871ac44cdc",
  "zh": "那是 Rynjin 住的島，一群野蠻人，要我說啦。他們拜某種海怪。當然啦，你們要去 Sea Caves 就得從那邊過。"
 },
 {
  "id": 33,
  "src_sha256": "1f2cc6c71648b5ace1ab43191a47a22efbfc15df58974d4e2466922ce3788d8b",
  "zh": "那是那些樹上小東西住的地方。一群小偷，要我說啦。"
 },
 {
  "id": 37,
  "src_sha256": "4da527c15299362a12b2dbe05029bcda5de8c7e3047de4839986f703ffb37662",
  "zh": "這下你們說到重點了！可以說是我的專長。那座老堡壘我知道得一清二楚， Marten 也一樣。可憐的堡壘經歷了地獄。以前是 HLL 的老堡壘，直到 Marten 和他的人接管。現在被那些 Tee-Rang 的玩意兒瞎占了！不過相信我，有些事他們還沒搞懂！那座老堡壘藏的祕密比神職人員還多！ Marten 在那座 Bluff 藏了東西，但可不是你們以為的那些！要是你們找的是 Marten 本人，嗯，他不在那裡！"
 },
 {
  "id": 38,
  "src_sha256": "7dad3e6f103a43caf19322c51f4c4dfac20d05aed7279ff8ee041b0c461f587b",
  "zh": "你們要找 Sea Caves 的話，我很不想跟你們講，但你們得穿過 Bayjin 才到得了。前提是那些 Rynjin 沒先把你們的頭扯下來。這裡北邊有一道階梯，直通海裡。你們要找的就是那個。"
 },
 {
  "id": 40,
  "src_sha256": "7ff5cea409282109454d60cabdf5021457ddecfdf3ce4ca9cacf130f72ca5804",
  "zh": "你們在煩惱那個老 Circle 啊？別操那個心啦。"
 },
 {
  "id": 42,
  "src_sha256": "bde25f3570ae5c874b7b6b2ff0308e5e72d3e145950032c2f06e5c753a9d0713",
  "zh": "他們就是自視太高，簡單講就這樣。"
 },
 {
  "id": 43,
  "src_sha256": "a9fa75c324c05dc92b27a5f73ae855d4d4a2464a5ffb5086b0424119f839a501",
  "zh": "好吃……"
 },
 {
  "id": 44,
  "src_sha256": "3211e886bb9174c43e12afee6bd591d3562179123a3e2af0673c52d5214d117f",
  "zh": "一群討人厭的傢伙，比那些蜘蛛什麼的還糟！這附近不太看得到，感謝造物主。不過這幾天我看到有一隻在沼澤（ swamp ）裡晃。"
 },
 {
  "id": 46,
  "src_sha256": "b130a15e63c9dd241977f7ff7ffd9469295687bd526f5af79b1efde51f14b6c5",
  "zh": "你們瞎了嗎！？這鬼地方到處都是他們。不知道他們打哪來的，但他們已經占了崖上那座老堡壘。"
 },
 {
  "id": 48,
  "src_sha256": "44dd7fb86fbd1138edbf0914e253e6db0bf3db366a4be9125af1f409a2a85989",
  "zh": "一群泡爛的野蠻人，就是這樣！"
 },
 {
  "id": 50,
  "src_sha256": "3053877c075198bc5ba6fd946d8079d2362db4790b10d906e0894110efae1168",
  "zh": "你們是說那些又高又多毛的傢伙。我是看過一兩個啦，不過我看他們不好吃。"
 },
 {
  "id": 53,
  "src_sha256": "abeb828734a5b6f192b593fb92d803634741ec9cd4bf8a49521c87c25f512633",
  "zh": "沒聽過他有什麼好事。"
 },
 {
  "id": 56,
  "src_sha256": "f0016d26cb87b502f6cfb5b3bf9fff1ed3d85ac33565a31293ef18231a7d983d",
  "zh": "誰都知道那是誰，不過你們想知道更多的話，我建議你們去問神職人員……別問我！"
 },
 {
  "id": 57,
  "src_sha256": "d12f64792646f659157b6eb9d7cbaad45df989fef9029f1fd419f9fac71b6c06",
  "zh": "噢，我認識 Marten 沒錯，不過你們晚了他大概一百年！他已經不在那座老 Bluff 了……我猜你們想知道他去哪了，對吧？好，我告訴你們。 Sea Caves ！ HLL 為了找那個 Destinae Dominus ，追著他跑遍天涯海角。我跟他說最好找個安全的地方躲，而沒有比那些老洞穴更安全的了。你們要找他的話，他就在那裡。"
 },
 {
  "id": 67,
  "src_sha256": "85060784040763d600db6d225c4dd12c675d04a59ee4c42834fc91d3305e3dee",
  "zh": "不在這裡。你們得去問 Marten 啦！"
 },
 {
  "id": 71,
  "src_sha256": "ba91fcf226bf7e4ac88ada70a4d13d8fcacb05b861a6ecb93ef88ef1c01c1dd9",
  "zh": "我賣（ sell ）的是二手貨。對二手故事沒興趣。"
 },
 {
  "id": 72,
  "src_sha256": "a9a002f17013520f57050aeca71de33f3f1b6908cf367f24b9b00e30b2f21de3",
  "zh": "我是 Crock 。你們居然不知道我是誰！？我在這世上混了至少一百年了……"
 },
 {
  "id": 74,
  "src_sha256": "990e15e3991057036ff11328f44332b5ebca3ca56908bb9c35cc53a5515df78e",
  "zh": "你們是想給自己留好印象喔？反正你們可沒打動我。"
 },
 {
  "id": 75,
  "src_sha256": "57f88ee821e1344995bec2329ef06947cbbbbe393e7201aa94d9acabd4c596c8",
  "zh": "這要是不算我聽過最蠢的提議，我就……"
 },
 {
  "id": 76,
  "src_sha256": "031914046f41213c351df5b034eb505998cc07042fbfdde96446bcd4f4322673",
  "zh": "和氣的傢伙們……"
 },
 {
  "id": 77,
  "src_sha256": "1df75cf9e2d6c36aa3394c35a5d6274c5722f386ed09bd062a0bd8e6a042584e",
  "zh": "等我有你們需要的東西再來……而我老是有。"
 },
 {
  "id": 78,
  "src_sha256": "10cbbfc0b6ffe64dcdbc61599f1bd14cf4b0e21870a0b994a83dbc75ea8539a6",
  "zh": "我這裡就有能幫（ help ）你們的東西……"
 },
 {
  "id": 79,
  "src_sha256": "6f40680d8cea78a62bcf53bb6b399df91b234e003065312a5ffc098c605c8d00",
  "zh": "我有些二手貨，不過是有幾個凹痕而已。"
 },
 {
  "id": 80,
  "src_sha256": "381bc9c22f08e2416fef31b9239d6097e3ecfd1cd02001d766c5e65155ad4343",
  "zh": "活到跟我一樣老，能呼吸就該偷笑了！"
 },
 {
  "id": 81,
  "src_sha256": "f21961a8c8e033fa854738a292981200eadfe60168f8e3fef28c9a503fa63fc1",
  "zh": "我有一些香水（ perfume ）……"
 },
 {
  "id": 86,
  "src_sha256": "6232cffc598622d3f49dd25c3a4ec5c308f1dcbb0e2db5f08c1eb7b85f730eb8",
  "zh": "我真想自己去收拾那隻該死的 Rapax 。我賭他聞到這香水（ perfume ）會發狂……不過我得想辦法弄死他！"
 },
 {
  "id": 87,
  "src_sha256": "1f302d8cb0c96aa4dc571bf61c84aeaf2811130a5a63bce4afc3bd4b64f404d7",
  "zh": "我在想……嗯，如果我賣他們一張地圖，就是他們想進去的那一帶的地圖。那些蠢蛋絕對不會知道入口就在那幅畫後面！"
 },
 {
  "id": 88,
  "src_sha256": "2f7518c0bed09d9a22693284d6c97ef0aee06c2d2b7509d3c9c48da3bec97cc1",
  "zh": "你們在裡面給我閉嘴！"
 },
 {
  "id": 89,
  "src_sha256": "148bb94150c1104f5b7169d0c29120a42b06a9288cbf35e52c31afc5d4f3ef83",
  "zh": "你們沒去過 Arnika 喔！？"
 },
 {
  "id": 90,
  "src_sha256": "31de5a432d1a8b19904548428d77351625847d9f4caa2c7576a4e5771fadf210",
  "zh": "我想是在某棵樹上吧。"
 },
 {
  "id": 91,
  "src_sha256": "0a4abd89f0fc6c420e46d262de90ccf769bbaa3c06a883760ca28e1f9027d76a",
  "zh": "我看就在這附近。"
 },
 {
  "id": 92,
  "src_sha256": "d783e21ab82cf1a883f17d5c0bb7c20490aae5298916dc3de6ab16da3108c9c8",
  "zh": "往這裡的南邊，在 Marten's Bluff 。"
 },
 {
  "id": 93,
  "src_sha256": "0d65475028f60823152f0f4840b935e79c89669412da3d10e0138b90faee8eac",
  "zh": "我聽說 Rapax 在這裡東邊有座營地。"
 },
 {
  "id": 94,
  "src_sha256": "00bdede5008d2db1bd923477618c3abc43b47753882e5683842ea322fdba2b1e",
  "zh": "你們要找的是 Mt. Gigas 。"
 },
 {
  "id": 95,
  "src_sha256": "00b7a7ace14b592762c1c0f0586c071501968d83ba1b2ddf6ae63c68538ca52e",
  "zh": "在這裡東邊的洞穴裡，當然啦，你們得穿過 Bayjin 才到得了。"
 },
 {
  "id": 96,
  "src_sha256": "0dc6033534d9b7dbbd82c94b722e9ad37482cef25567619d360fcb8798877f3d",
  "zh": "那是 Rapax 的地盤。"
 },
 {
  "id": 97,
  "src_sha256": "0dc6033534d9b7dbbd82c94b722e9ad37482cef25567619d360fcb8798877f3d",
  "zh": "那是 Rapax 的地盤。"
 },
 {
  "id": 98,
  "src_sha256": "96667da2d975d6b9c7c7218c84818e0b41e518f6e63a5461b07281bdcd4db00f",
  "zh": "你們怎麼不去試試 Ascension Peak ？"
 },
 {
  "id": 99,
  "src_sha256": "668ecb63d3164e5938e954cd9daec11c23161cc3e89e00707f1b0c82d336667e",
  "zh": "誰都知道那就是 Cosmic Circle 。"
 },
 {
  "id": 100,
  "src_sha256": "04a62f6b8e2080b4c3f6e4307ffe8283265dcbbbebfbb58eda9bac2fec5f06d2",
  "zh": "你們是不是腦袋受過傷啊？"
 },
 {
  "id": 101,
  "src_sha256": "c26c7f4acc31f7e0c0602637ee916fac559ff7a76e59571d4cf45c5a69d93fe3",
  "zh": "嗯，我哪會知道！？"
 },
 {
  "id": 102,
  "src_sha256": "177141d865f18eef01b6821d4a93cc13f03d527bb2c628593690f1bf9800a99d",
  "zh": "滾出去，你們這些黏糊糊的團塊……呃，哎呀，抱歉！我還以為你們是那些占了 Marten's Bluff 的蜘蛛什麼的。最近客人不多，都是他們害的！所以你們隨便挑吧。全是上等二手貨。我今天的特價品是，呃，香水（ perfume ）。"
 },
 {
  "id": 103,
  "src_sha256": "0c049f5c85a873c3fc68b0156de789953df266d1217c7dcbe4cf87041310d069",
  "zh": "原來是你們啊，你們這些愛蜘蛛鬼！我猜是來找走丟的人吧？嗯，這裡是危險的地方，尤其對那些跟 Tee-Rang 來往的人。不過，我或許能幫（ help ）上忙……只要你們幫我個小忙。有興趣嗎？"
 },
 {
  "id": 104,
  "src_sha256": "614a84a79afdb5f7f4ed2ad5208e638c7059afc4ddb3160d30ae5774a5565b64",
  "zh": "從沼澤（ swamp ）爬出來的是吧……"
 },
 {
  "id": 105,
  "src_sha256": "1a0088e74124435cfa117d0356f9102edb1338d37e124ded9b33dc3d9bcbee9e",
  "zh": "我看到你們那個小朋友還沒回來！你們願意幫（ help ）我了沒？"
 },
 {
  "id": 106,
  "src_sha256": "03811faf0f727bac2d54d65acd61e375a1f3b41d561ef6670e94efcf3da25775",
  "zh": "我就知道你們會答應！最近這裡麻煩事一堆，而現在更糟的是， Brekek 回到沼澤（ swamp ）了！他有房子那麼大，殺過的人比你們強上一百倍！所以我告訴你們怎麼做。去找到 Brekek 把他宰了……要是你們有那個膽的話。帶著證據回來，證明你們幹掉他了，我就、呃，看看能怎麼把你們的朋友弄回來。現在滾吧！他沒死之前別回來！"
 },
 {
  "id": 107,
  "src_sha256": "0749d096944bc096f4923d8567e32eda47ce1ea4fcd5afd89d0a394ecb8aeed2",
  "zh": "哼，我也沒興趣幫你們忙！你們會改變主意的……"
 },
 {
  "id": 108,
  "src_sha256": "9b0ca2dcafa998f30e8513bab73b004e78fd40ea16d26458a336cfb5731ed58e",
  "zh": "嗯，你們宰了 Brekek 沒？"
 },
 {
  "id": 110,
  "src_sha256": "9868aabf892ee88230bcc63426938a1928606e9127885e1a68cee790c63da872",
  "zh": "我才不會光聽你們的話。我要看到某種證據……"
 },
 {
  "id": 111,
  "src_sha256": "47c2192a177d5118d9cf1e9c3b731b72a2571b872449b90f1faaf493cdd01da6",
  "zh": "你們說謊！我就知道！你們靠不住。他沒死之前別回來，你們這些騙人的、三張臉的、沒用的、吸渣的螃蟹肚子！滾！"
 },
 {
  "id": 112,
  "src_sha256": "f70677e053dc7ed35890ab2aed8d11b9c9dcdbddc9a346fb3251e8288481a8b4",
  "zh": "那你們在這裡幹嘛？滾！"
 },
 {
  "id": 113,
  "src_sha256": "4767e601448d9c43c58b9ebc5e53cbb3a04af33d9e8d88cdff23aba064e6e3d2",
  "zh": "我的天！你們真的做到了……還帶回了上好的食材！說好的事就是說好的，當然。讓我、呃，去問問、呃，打聽一下。給我一分鐘……"
 },
 {
  "id": 114,
  "src_sha256": "c4dda847ffe399c68e1a2e52a58713252c7c5814d4abeb457ee0a5cc5718062f",
  "zh": "哎呀，看看我找到誰了！你們信嗎！？那些、呃， Tee-Rang 把他們鎖在我小屋後面這個房間裡。他們、呃，想把這綁架案賴在我頭上，我敢打賭。不過你們知道我絕不會幹那種事。對吧？啊，別這樣嘛，這不是挺開心的場面嗎？野獸死了，大家又團圓了！"
 },
 {
  "id": 115,
  "src_sha256": "44c8375f02f03ca8696c8eab842c6cd579a1da7590d10453eb4065ecc983b083",
  "zh": "對啦，香水（ perfume ）。其實是 Rapax 香水，貨真價實。瓶子上說，保證讓 Rapax 發狂。雖然我不懂誰會想這樣。他們本來就夠瘋了。"
 },
 {
  "id": 116,
  "src_sha256": "440d9ac58a38f555e139ca3698803ec5eb5c117dc4e34b457a17bb6462cc8fcf",
  "zh": "我看過他用那可怕的蹼趾把十個人夾扁！真的！"
 },
 {
  "id": 117,
  "src_sha256": "14bc89c4f3119b4095cf34d7431656459c7a8a04bf939d3d535e96c6e5a0b84c",
  "zh": "這裡東邊有座老礦坑（ mine ）。現在那邊沒什麼，就一堆黏答答的 Tee-Rang 。"
 },
 {
  "id": 118,
  "src_sha256": "beb95429ee06b5d7daa01db54791521af02d5353cc3dcc9de2b3c538bbdd91c9",
  "zh": "除了那些小動物、潮濕和沼澤（ swamp ）熱，這地方也沒那麼糟啦。"
 }
]

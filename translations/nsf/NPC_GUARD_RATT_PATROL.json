[
 {
  "id": 2,
  "src_sha256": "2527780a1e7ac20a99962ae50e4db56e09e9d6484a021ea48bcde4f0c451be51",
  "zh": "老大正盯著你們呢。"
 },
 {
  "id": 3,
  "src_sha256": "e2bd58260101c9b8bc6b65c1b5084a17df9a66d7df95f9f768fa6b4e3114bad4",
  "zh": "你們有啥問題是不是？"
 },
 {
  "id": 4,
  "src_sha256": "60460b096ddd128f88667956c852262d6217cc0dc87b7415b498244cf9f3290b",
  "zh": "別碰我！搞什麼鬼？"
 },
 {
  "id": 5,
  "src_sha256": "d49fa95760795533ae47f505796237f3b721b844913af41d7277ae11f731bbd6",
  "zh": "離遠一點。你們又不是 Razuka，這筆帳我們可不會忘。"
 },
 {
  "id": 6,
  "src_sha256": "7fd14b75fd6c4fbfeda133e2ca8f7017dd6766ab40dcfb930f94aa33b9ac1663",
  "zh": "少管閒事。而且我可「不是」你們的閒事……"
 },
 {
  "id": 7,
  "src_sha256": "b1f970f4c88f3243cb9ae6c7039b827d61af792410aee67505f0b88dad7c0f27",
  "zh": "欸！退後啦，老兄！"
 },
 {
  "id": 8,
  "src_sha256": "1e79269dadefccd591a7c6e696b1acf240d1d034a64d91bc29dfbcc48a91978a",
  "zh": "噢，不要。我寧願賭賭看誰會贏！"
 },
 {
  "id": 9,
  "src_sha256": "92939c988279681721e00a5e2d6fd5b35e56499d65c43eda9b84d88bbfeb5392",
  "zh": "欸你們！對啦，你們就要挨我一拳了！"
 },
 {
  "id": 10,
  "src_sha256": "b58e042a0d2307e55ff17800a1d2ea1d3723fb981ecb9de32cb14a91e3a00cca",
  "zh": "又是一天，又是一場架！"
 },
 {
  "id": 11,
  "src_sha256": "c83e84dd281f5b4cbdbca31b17c7a474cff028d22505229e8f8d59664c5febc1",
  "zh": "老大下令叫我們送你們去睡覺——永遠睡下去！"
 },
 {
  "id": 12,
  "src_sha256": "ed39910b4001c6fb0200aaf8d99fa60e555114f3016bf32761fe541c0bf379da",
  "zh": "沒人准下來這裡。給我滾回上面你們該待的地方！不然要你們好看！"
 }
]

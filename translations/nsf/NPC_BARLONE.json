[
 {
  "id": 1,
  "src_sha256": "4c3f44ee5a325f10635d5ae7c6059fcdf5148f542154855e7e618f4d2d1e04b0",
  "zh": "所以……又是你們……"
 },
 {
  "id": 2,
  "src_sha256": "9bb071abd2419732ff93931b9af7424ea7d04c9a0c98825652ac0a52ad73027f",
  "zh": "我沒話跟你們說。"
 },
 {
  "id": 3,
  "src_sha256": "499c8096b9629a4c25528d915970f328d67e04ed8e84703ff2895534e7cd877f",
  "zh": "跟我來這套拍馬屁沒用。滾出去。"
 },
 {
  "id": 6,
  "src_sha256": "ecc5ee16e92d3a2c60e72f585b8f465238edf244bc1970e69ad858ce67e6618b",
  "zh": "看在你們的份上，我就當作剛才什麼都沒發生。"
 },
 {
  "id": 7,
  "src_sha256": "ddaffcb3500abe50c7592b4f244d149ccf192e2f4017f427633eb4014a557e76",
  "zh": "這連我一筆贍養費都付不起……"
 },
 {
  "id": 8,
  "src_sha256": "3e0994e77adba1fdbde829b4195f6a3379f2d6d215473ab398ba617fdc3fa3e4",
  "zh": "先殺，再談。"
 },
 {
  "id": 9,
  "src_sha256": "4baec5e15eb302bf4cc534892d04fcf82cc56743dee7bd52c9dcd46e4c016a8c",
  "zh": "你是哪種白癡啊？我是 Razuka 的老大。我不替人做事！是人替我做事。"
 },
 {
  "id": 12,
  "src_sha256": "0596a200aa812a770e1d57c0c864534ed0d9c40ffe70e87cc6a01ce3d47e3e7e",
  "zh": "*咳*"
 },
 {
  "id": 13,
  "src_sha256": "a7d10edf598b5ada5fa0a627fd36840b5fefe0548a7e72f3fe0c45578fa9605e",
  "zh": "嗯嗯，不。看起來沒一樣是我要的。"
 },
 {
  "id": 14,
  "src_sha256": "d985840fe376473570628e6803fe2ff72184c760eb67d562498e8904b9b1ca5c",
  "zh": "要付代價……"
 },
 {
  "id": 15,
  "src_sha256": "4a61ddaa041e776ae23352a43594766ff4410c9696ff4ced8a8d330ee5a2dcc0",
  "zh": "我沒興趣買任何東西。"
 },
 {
  "id": 16,
  "src_sha256": "028253840a03e546ecfaa58d1fcad5f43e618343fff117a7b359c16e087d8ffa",
  "zh": "你們不夠，我說的可不是身高。"
 },
 {
  "id": 17,
  "src_sha256": "1a98d8177246fbfb860c3606bc1664397bcb15bfc8fba24059632a7470ab13fe",
  "zh": "你們以為我認不出這個？"
 },
 {
  "id": 18,
  "src_sha256": "77ad6595c7328a564c02cce9b82dead9eb2515d8b5d90307c957909528d6d243",
  "zh": "管好你們自己（ yourself ）！不然你們會發現脖子上頭剩個斷樁。"
 },
 {
  "id": 19,
  "src_sha256": "5e9305d81e88b1bfc56f355d733220ea9ea410c8304822dae16927593632d01e",
  "zh": "你們以為你們是誰啊！你們「絕對」不准跟 Razuka 搞鬼！"
 },
 {
  "id": 20,
  "src_sha256": "a323226ec013cb9136dc218ebef6560f8aa7e1eeb31da50cd64403e65524c8e0",
  "zh": "你們的人頭可是有價碼的！"
 },
 {
  "id": 21,
  "src_sha256": "0596a200aa812a770e1d57c0c864534ed0d9c40ffe70e87cc6a01ce3d47e3e7e",
  "zh": "*咳*"
 },
 {
  "id": 22,
  "src_sha256": "4c0c7ac9a55def1da106d839cc9176445229f7a731d2939f07168fef13a22ee1",
  "zh": "我花錢請人去操心那種事。"
 },
 {
  "id": 23,
  "src_sha256": "a70ebcc8f7d2e11c426f58723c199e14c4cb7414dc282bd0af8ba6ed9ae53845",
  "zh": "不。我不想。"
 },
 {
  "id": 24,
  "src_sha256": "ec5ecd98623a9b66cb93fccb9881a41a8cd2c2074e7e314b33fe15116ba8bd31",
  "zh": "我發過嚴格的靜默（ silence ）誓言。"
 },
 {
  "id": 25,
  "src_sha256": "95671248a5ec87f33eafbfc110edf676e80932fe69d59ffb3bb2341e406d8542",
  "zh": "我說……"
 },
 {
  "id": 26,
  "src_sha256": "34914a39f817546fa130a514a8d70b442c63c8a5d328998ae7dab6e44ec6561b",
  "zh": "慢點。你們想先知道什麼？"
 },
 {
  "id": 27,
  "src_sha256": "295dcc73d1c8148943781dd072ec50e7015716528c2518afaf07ed38487f6de4",
  "zh": "現在……"
 },
 {
  "id": 28,
  "src_sha256": "8ed6ce79e7d65232f697acb981bd6cae14bb228a1be060e634a510c623136a4e",
  "zh": "我會試著記住的。"
 },
 {
  "id": 29,
  "src_sha256": "0596a200aa812a770e1d57c0c864534ed0d9c40ffe70e87cc6a01ce3d47e3e7e",
  "zh": "*咳*"
 },
 {
  "id": 30,
  "src_sha256": "65d144261c413738fbb2522235c35a32d25b7a33ae12f92d42caefb5771a0452",
  "zh": "我可沒一整天的時間……"
 },
 {
  "id": 31,
  "src_sha256": "1110fdabdb365c10931ce790382a598cdfacd897eb5a31022b50b3c81ade5561",
  "zh": "不是 Guardia 。"
 },
 {
  "id": 32,
  "src_sha256": "90062ef57bc677b525094c97bc489933aef3ffeebf5690909806b472cadc659f",
  "zh": "我們最後見到 Savant 的地方。他把自己安頓得舒舒服服的。"
 },
 {
  "id": 34,
  "src_sha256": "e14075f6551117806237dc0eb9f8ebd24ca8236981da1f4286e2c8809e4fb7b9",
  "zh": "這地方很快就是我們的了（ owning ）……"
 },
 {
  "id": 43,
  "src_sha256": "ed5d18b3900ba3ebf51ee5d621aaafa304bc1447dac92834217680b805409313",
  "zh": "我們跟他們沒簽合約（ contract ）……"
 },
 {
  "id": 44,
  "src_sha256": "8e8ca119100c450b4654eb909654be1a519ce9c39839bf0fee8e3683fcf02931",
  "zh": "他們不惹我們，我們也不惹他們。"
 },
 {
  "id": 46,
  "src_sha256": "13ea8b379f48c21801937dab5c877a3e6df38c53714fb2f8c5e0325fc553fa14",
  "zh": "只是我個人的看法，不過你們要是想贏下 Umpani 和 T'Rang 之間的戰爭（ war ），這麼做吧……兩邊都玩，拿雙倍報酬。他們永遠不會知道。"
 },
 {
  "id": 47,
  "src_sha256": "e99c2284ba4c181b46d29f5f71a82290e345d1216f46d7b3912cb662e5dac179",
  "zh": "對，我很熟他們。我從小道消息聽說他們在這裡徵人。當然，我是不會替他們做事啦，不過你們要是缺現金，可以考慮考慮。頭頭叫 Z'Ant 。"
 },
 {
  "id": 48,
  "src_sha256": "0f153334277ee4f40d37f217ffb62538fa0544ec0e060a1aef4c8970deae5051",
  "zh": "噢，別提這個。 Calzone 迷他們迷得要命，一路來到這裡我耳朵都聽到長繭了。"
 },
 {
  "id": 50,
  "src_sha256": "f42df87c65462dced19eb0b22310aebafc15c30725dacb990a5d2b8711d4a0fd",
  "zh": "我們就是這樣。你們不是認識我們，就是不認識。"
 },
 {
  "id": 52,
  "src_sha256": "19c4e1c4d08957977ee355b1c259f372473134530f9ca03b0a3cd24a5918100d",
  "zh": "我不是來這裡談宗教的。"
 },
 {
  "id": 53,
  "src_sha256": "805048080bbc4c4dde24bc8aa8bb1826931b19ec232124582d67bea24e85f1d8",
  "zh": "你們認識 Guardia ，是吧？對，那是老地盤啊……"
 },
 {
  "id": 54,
  "src_sha256": "c7c5a105eb85311b86257f06e5235ea04deed400c81446d4eead154ea8287ad8",
  "zh": "他就是我們來這裡的原因。來討他留下的債。我們知道的是這樣……他在 Arnika 有個，*咳*，什麼堡壘（ stronghold ），我們還沒想出怎麼進去……要是我們想不出來，那就是根本沒辦法進去。可是等他出來的時候呢？砰。我們就收拾他。"
 },
 {
  "id": 55,
  "src_sha256": "f5316c8215092cb24416d4ae5814561dfeddb0dc688f5cefc8f5702d08c8de59",
  "zh": "噢對。那個女孩。不管哪方面，我都沒什麼好說的。"
 },
 {
  "id": 56,
  "src_sha256": "d0553b1e2dd6aa2eb4eb949961a4a94ce9963ea8be13b8c1af632bddff64a985",
  "zh": "你怎麼不去告訴他們啊，小姐？嗯。"
 },
 {
  "id": 57,
  "src_sha256": "bb91ee1ea41fa3847caf1611308701bc432821daa25a3ffa945bd4a980e04a29",
  "zh": "我不會告訴你們任何你們還不知道的事。"
 },
 {
  "id": 66,
  "src_sha256": "225ab684cee60e605ca76ec79be971a4f2a1cec3a085ea71c3d70acda9b9de04",
  "zh": "很響亮的名字，嗯？不過不。我不喜歡談自己（ myself ）。"
 },
 {
  "id": 67,
  "src_sha256": "0610e67931a167db7f2cb0da6f6b8f58d4c312c974a9b1d0802aef27669c1c50",
  "zh": "我該說的都已經說了。"
 },
 {
  "id": 72,
  "src_sha256": "5973c0aefd2a36e2cb389101269ec50a638877472e9a1c4a62dc929bac2deac1",
  "zh": "我不說閒話……"
 },
 {
  "id": 73,
  "src_sha256": "283bd4d147174d3b4a558e135823184f0bcb41e2e3b28c53f16c7ece6b9110a0",
  "zh": "Don Barlone 。我還以為 Milano 已經告訴過你們了。"
 },
 {
  "id": 75,
  "src_sha256": "6e26cbeefe89e26799451ea7bfde567474bed15227014b357ae6ba31896ff460",
  "zh": "你想不想讓我把你的頭扯下來，在你那肥脖子裡種幾朵雛菊啊？"
 },
 {
  "id": 76,
  "src_sha256": "9dea28d05ee5b2f431a284e97f4a176189badd90639e44a62fd65e94e460e396",
  "zh": "真是有夠原創。"
 },
 {
  "id": 77,
  "src_sha256": "30d4d180b87058a70db0dd5214c2c7c6794e6024e2d418226c57dcba9c90acd2",
  "zh": "對，哈囉。"
 },
 {
  "id": 78,
  "src_sha256": "5e53d538d250ed713c839edd29a808029d8951cd62d9f9f249bfd866502d43b1",
  "zh": "需要的話，就來找我們……"
 },
 {
  "id": 79,
  "src_sha256": "eb6335bb9fc40a88919de22c3f279956803827ff859cb0124b2049b703f3954d",
  "zh": "提供幫助（ help ）不是我的生意。"
 },
 {
  "id": 80,
  "src_sha256": "fa6ce4371b03db018d07cf96b0a29068b043f919ceadcc5de76f660f3285cada",
  "zh": "我不是商店，老兄。"
 },
 {
  "id": 81,
  "src_sha256": "8f59db066bd0d768e39bf02662dd85260cc7a2304989f33421db1c0e94f9d8f7",
  "zh": "少講那些膚淺的廢話，行不行？"
 },
 {
  "id": 87,
  "src_sha256": "9ffb496e1469966babec331fe8d60872db93e2c4ce03c5a0ae7d951e6018e0ba",
  "zh": "我得把這件事轉達給 Calzone 。我擔心的不是那些吵吵鬧鬧的 Trynnie 。是那個安靜的。就是 Shaman 。我覺得他知道一些我們不知道的事……像是那個頭盔（ helmet ）的事……"
 },
 {
  "id": 88,
  "src_sha256": "0f0293d3e56cc520a3ec4d9dcb78aed6d0d0b7f44381845f80a365ea369ce283",
  "zh": "這讓我想起……我得去問 Rattus ，看那個 Rapax 有沒有還在幫我做那件護甲。不過天曉得他要去哪弄一隻鱷魚。"
 },
 {
  "id": 89,
  "src_sha256": "1a2c865aa6e9311dc5f6fb8b8606a913f488d92f894b8aadf2d315923ac9bda7",
  "zh": "我得想辦法處理一下這個咳嗽。"
 },
 {
  "id": 90,
  "src_sha256": "804f42edd8f1e5ffc477c5335b14bd7bdf8c45cce833ab6599af04352a935e14",
  "zh": "就在這附近某處。"
 },
 {
  "id": 101,
  "src_sha256": "dc8ef63340ca5b85ede8cab632dea82429503534adcce75e226390c5d3deb916",
  "zh": "試著睜開你們的眼睛……"
 },
 {
  "id": 104,
  "src_sha256": "804b8fe8aaac5e6817bc69b1c4dba3f13e67f06d65025491373f43a9b072a28d",
  "zh": "Calzone 說你們跟我們對同一樣東西有興趣……說你們可能知道些關於 Dark Savant 的事。現在，我感興趣的是他手上那個東西。 Astral Dominae ……"
 },
 {
  "id": 105,
  "src_sha256": "9e6447ca177a80a4155fa9fdd81c40ed297d9be67aaa6e75d3481e9b48b16b54",
  "zh": "告訴你， Calzone 跟我說他認為你是誰，我還不信。哼。喏，看看你現在。你在 Guardia 以為自己挺好笑的，是吧？幹掉老大！對 Razuka 來說，老兄，死只是暫時的小麻煩！也許你可以補償我，你這個偷襲的小人……"
 },
 {
  "id": 106,
  "src_sha256": "41e86eed981246bf03ad4b442dc7ac78ed144a4303e5b95b4acc618ccdceeecd",
  "zh": "等我們把那些小毛球清掉，我打算幫這地方改名。叫 Ratton 或者 Barloneville 都行。*咳* 挺響亮的。"
 },
 {
  "id": 107,
  "src_sha256": "3c8147edd4521231f57fb69ae11d82c7b42fc42d5255dadcbc6ced9ce1831b05",
  "zh": "怎麼這麼久，嗯？你們知道把這顆寶石擺在這種地方有多危險嗎？我早就可以賣掉五次了。當然，你們還是有興趣買的吧……"
 },
 {
  "id": 108,
  "src_sha256": "d022fec5cdf436eb76553c751592d15ee29c6a63f5721cf2ea469e516f3ee220",
  "zh": "在 Arnika ……"
 },
 {
  "id": 109,
  "src_sha256": "c706bfa07e6ee86d362843e7be4a2648bf7469b7bd40dcabeb3890c24baf0dd9",
  "zh": "我聽說他們在 Marten's Bluff 。"
 },
 {
  "id": 110,
  "src_sha256": "9d3c512689a22a55c85f596a5f762f6c6bcdf3fbf1927452d801904053a9a7a2",
  "zh": "讓我給你們講點背景。幾年前，Savant 雇我們去跟蹤 T'Rang 。我們履行了我們那一半的約定，你們知道，可是他在付我們酬勞之前就溜出城了。所以，我們來這裡討債。不過，呃，他不會付的，而那不成問題。"
 },
 {
  "id": 111,
  "src_sha256": "ee29d72ec17adbe03fe3abeadbd3e8f861484616700a256f4d6e4543040d31e8",
  "zh": "我們會拿到我們的錢。你們看，他有個對他意義重大的裝置。而且傳言說……它對你們也意義重大。"
 },
 {
  "id": 112,
  "src_sha256": "c8ebf806171dd158dd7af69b9b74f521c8e896a9b5d19bd82e9baa7ea9a36cda",
  "zh": "所以，你們覺得這樣如何：由「我們」拿到 Astral Dominae ，然後「你們」付錢向我們買。我們拿到現金，你們拿到你們的獎品（ prize ），而 Dark Savant 被擺一道。你們過一陣子再來，看我們能不能談成這筆交易。我們得先把它弄到手。"
 },
 {
  "id": 113,
  "src_sha256": "7e93b6945bad47b15285e837d08d2136521a25bf70b41906bb86f5178c51d6e1",
  "zh": "這就是我猜你們來這裡的原因。所以，我告訴你們一個小祕密。 Dark Savant ？他已經沒有 Dominae 了。在我們手上。漂亮極了。你們可以說是專業的順手牽羊。所以現在，我們手上有這顆小寶石要出售（ sale ）……"
 },
 {
  "id": 114,
  "src_sha256": "61e1e5637b4d93d4bdf4b8b8edc99cc06f4aff0d0cb93613e7b1b353e6e8a42d",
  "zh": "我們還沒到手。"
 },
 {
  "id": 115,
  "src_sha256": "2158291a0d7adb74b93ee1f268126644f2675727ff4a67ccc9f9d85ac2a4a4c1",
  "zh": "當然。我們會保護（ protection ）你們。你們在好人手上了。"
 },
 {
  "id": 116,
  "src_sha256": "dc31b3273776f9db1f23adf382055e057c89f45e379481a76999270a2ba01b47",
  "zh": "我們在講誰啊？"
 },
 {
  "id": 117,
  "src_sha256": "dbe99c8c86f2cab5c3c95ee4d98f46678b2e503b7a1ad3b8f4690344fbf024cd",
  "zh": "當作辦好了。"
 },
 {
  "id": 118,
  "src_sha256": "d3146bedeae9db0584192b95f81186d7599d860792060aae4bc86efaeec434a2",
  "zh": "你剛剛浪費了你的錢，搞笑仔。"
 },
 {
  "id": 119,
  "src_sha256": "88974c28740241fc2872f2173839dc04fa8215d9ff0973a61f16e7a510d70560",
  "zh": "我不替任何人發言。"
 },
 {
  "id": 120,
  "src_sha256": "7eb269ef3b736a25d2bb4c8ef6fbddd7be860cbaceb4f0c6896386c089db2feb",
  "zh": "你們讓我們去操心那個……"
 },
 {
  "id": 121,
  "src_sha256": "78d204ed660a81ee4240dce28b2c50833be6cd2a45764e99e883b50652d84c30",
  "zh": "你們讓我去操心那個……"
 },
 {
  "id": 122,
  "src_sha256": "0aa2cb3f1924e8af6947c26a616d5610ca7f2271492d98c678c70993679ba554",
  "zh": "不用我告訴你們。去 Arnika 。"
 },
 {
  "id": 123,
  "src_sha256": "3533c8a36b4dc710971fdc9f63e0de467424d371085b1d1fa896886a3681955f",
  "zh": "你們怎麼知道那件事的？嗯。算了……我不想知道。"
 },
 {
  "id": 124,
  "src_sha256": "94e7d891f440719027f850a59099ca5e836b52a3e4fcd32ba73b797f773d87ba",
  "zh": "那是家族的姓。"
 },
 {
  "id": 125,
  "src_sha256": "f3e826737e4b149dd45879075e09f3c80c5f75a7e6fe8d9d6e455ceb56b4de1b",
  "zh": "我聽說他在 Arnika 那一帶挨了一槍。真慘。"
 },
 {
  "id": 127,
  "src_sha256": "901bb9b1e7008cc4c0ec3e84a274120020dbae2fd9520a4236d2403a81393867",
  "zh": "就像我說的。"
 },

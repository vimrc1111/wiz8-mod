[
 {
  "id": 2,
  "src_sha256": "e8ee34b5f77a53878b0865415f8d76f68da7829e1924a0b23fd616ce2b42217a",
  "zh": "你們拿什麼獻給我的雙手，入門者（ Initiate ）？"
 },
 {
  "id": 3,
  "src_sha256": "ead46e2c39a22e67a3aa1be955eb0878fa87812eefbc62a6750bbd9ab676a4fe",
  "zh": "你們拿什麼獻給我的飢渴？它渴望一切黑暗而深邃的事物。"
 },
 {
  "id": 4,
  "src_sha256": "e3198288905b40a7f78496050fd6e87113c2ac6308f26b3de827bcd49fdd9503",
  "zh": "當你們的心智與身體都屬於我，你們還剩下什麼可以給？"
 },
 {
  "id": 5,
  "src_sha256": "33b3d733b9bf892d4fec457e567393211503288ab07c0dd7b06cfabf6b2f9278",
  "zh": "如果這一切都屬實……你們是否要獻上一份祭品？"
 },
 {
  "id": 6,
  "src_sha256": "1258cfac2f9100222cc0e0feccbe77b1b0379058a88dabe3c451aee0f6b9e76a",
  "zh": "誰會是你們的祭品？"
 },
 {
  "id": 10,
  "src_sha256": "dc46eb08ea85a51537a43a135e5e33015f66dbcc879aa9e91af7ea296424045b",
  "zh": "她不適合我……"
 },
 {
  "id": 11,
  "src_sha256": "b9097d55b02b7e28e2daff79971718a28633714631ed84d9f6e527feb4565363",
  "zh": "啊，很美的選擇，但還不夠美！披上我所渴望的衣料，來到我面前吧……"
 },
 {
  "id": 12,
  "src_sha256": "bf451d9e1ecf50f76d2562a77cefaf67a464999f8989b0987962ceca672aea4e",
  "zh": "很美的選擇……"
 },
 {
  "id": 13,
  "src_sha256": "f5ecb4807ec85c4f6fa6536c1d4ba5e5708600a998b1b21070ffaaa1e38f37c5",
  "zh": "你們不必害怕，你們知道的。這會是你們相當享受的事……你們要不要重新考慮？"
 },
 {
  "id": 14,
  "src_sha256": "0e69d2e620900c15900e820abaa323e8a13fdec8ca3d4bcb37b070dbc0d1226e",
  "zh": "若你們改變心意，入門者（ Initiate ），你們知道該怎麼召喚我……"
 },
 {
  "id": 15,
  "src_sha256": "83ea767c984ecfbd78aeabea38f78a6ebda861a02bcd0d83d9c29a24dc6921ba",
  "zh": "這些都無法滿足我。給我帶個男人來！"
 },
 {
  "id": 16,
  "src_sha256": "72e880574eefe3c0297022ab8001465b257cc725af677a4930b796b85366b068",
  "zh": "這不是我想要的……而我是那麼想要你……"
 },
 {
  "id": 17,
  "src_sha256": "f266b53da3abdcc7cfd3c3cb88a96fabf5fe14f848a9244555cdce7411cf975d",
  "zh": "你們昏了過去……數個小時過去了……"
 },
 {
  "id": 18,
  "src_sha256": "73a24667a3cd06429fb70d0c6cbf467d775b9946ecdfcf21222ca94908a0961e",
  "zh": "你們沒有人發現少了一個人……你們的祭品。若是醒著，你們會擔心，會質疑自己的行為。但你們沉睡著……"
 },
 {
  "id": 19,
  "src_sha256": "c4c28ceb4a09a34e697e2a70506158464c4ca9805d8c48a7defc38463be7374a",
  "zh": "你們翻了個身。你們做著夢。你們聽見遠處身體蠕動的聲音，她誘人的笑聲充滿空氣。然後，一切結束了，你們的夢再度陷入黑暗……"
 },
 {
  "id": 20,
  "src_sha256": "9076afb1a57adc26ab4d17637d785047c2418136760c56265a2f2cd861bb3fed",
  "zh": "你們起身，發現自己再度完整。"
 },
 {
  "id": 21,
  "src_sha256": "5f1d0f69e9e18116806ec53ac8f7a5f7ea9f3fbd40874c34a66110c08177d9d2",
  "zh": "他不夠格勝任眼前的事！"
 }
]

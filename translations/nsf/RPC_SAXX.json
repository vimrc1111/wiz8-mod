[
 {
  "id": 0,
  "src_sha256": "5f65bd5351640e80452415dbed17fea26a4bf2203cdf34aefd48316bab309532",
  "zh": "好啦！上路囉！"
 },
 {
  "id": 1,
  "src_sha256": "693c43167fff4ffa44ae98e89da7115bbec06d86b38bd068912cffa8d4e900c4",
  "zh": "我的天！我越來越上手啦！"
 },
 {
  "id": 2,
  "src_sha256": "d5fe451a37492ca2310c844887285f015b3bf133580ecb0373f2d92980049cc2",
  "zh": "哇！你們要幫我治療嗎？"
 },
 {
  "id": 3,
  "src_sha256": "411183cb0150e06312c633fc23f76fec0c9b370fb02ac18321706ad5043a2897",
  "zh": "各位老弟？我真的好痛啊，是吧！？？"
 },
 {
  "id": 4,
  "src_sha256": "646dda4117e32e1a0d0cfb77c9e985c8a068115b3506d2ac103ab302330ffaba",
  "zh": "你們這些小子走太遠都不睡覺。讓老人家在這歇一歇。"
 },
 {
  "id": 5,
  "src_sha256": "8c5672dfc03bc0b56b0a39928f97b624b99765b1b64a27bcb2ed596f1e0667d2",
  "zh": "哇！我覺得難受極了！"
 },
 {
  "id": 6,
  "src_sha256": "85e76bf33b1bef48ad10d47031de3974de5db0c37f6345415e4724f7594cd2ab",
  "zh": "救命啊！我生病了！"
 },
 {
  "id": 7,
  "src_sha256": "8c7b7e53f591de4db9b0cf85999a53512441137ce6e1977edfda17835efbd9ab",
  "zh": "我的眼睛啊，老弟們！"
 },
 {
  "id": 8,
  "src_sha256": "b405ea3227322670afe212ff4a745820530b032a88a8b27288c980b6fdce10b9",
  "zh": "我要怎麼一邊彈奏樂器、一邊扛那一大堆東西，傻瓜？"
 },
 {
  "id": 9,
  "src_sha256": "c39cf4ceec918243deae9e8c62d5663646c61bdd5e847083783c34639d712111",
  "zh": "老弟們！我動不了啦！"
 },
 {
  "id": 10,
  "src_sha256": "c8eeaac559f39b8188cc9b272904472c5a25ad9a6372ff361cd82e6ea24901f1",
  "zh": "這段你們可以再來一次！"
 },
 {
  "id": 11,
  "src_sha256": "108831f450a2df5ce1d75a1db02906124607e678376d57b3cb582f47a496d543",
  "zh": "剛剛那一下讓我想起我寫過的一首歌，叫「漫長痛苦的死亡之路」。我真不需要再被啟發一次。"
 },
 {
  "id": 12,
  "src_sha256": "ece2c6a57a58b078c3da2a7508ce911d7aa24da4c0063422f2ddb191328334b1",
  "zh": "噢，我聽到天堂的甜美歌聲了！我想，還沒到我的時辰。"
 },
 {
  "id": 13,
  "src_sha256": "b947095de6452ec53955b6dccc30bfe0d02fa78cb195d86edc374e5e485ef90f",
  "zh": "我的老天，這讓我想起我寫的一首歌，叫「壞壞的蠢招」。"
 },
 {
  "id": 14,
  "src_sha256": "0ae148fba6e85a8473ed25075e10336d81272e39ce8c23986aa615133d111d87",
  "zh": "出來走走對我有好處，開開眼界。欸，有人有酒嗎？"
 },
 {
  "id": 15,
  "src_sha256": "9c74f7688b7e0e1dc4e7f43a59cd6829a7e86b0935a30e666e04e40c4e523ee2",
  "zh": "我來唱首歌給大夥聽，如何啊，老弟們？"
 },
 {
  "id": 16,
  "src_sha256": "d16cbf0bf2e5ac0552164d646cac9970a848f87a3b1f8bc1cc39a9283831f506",
  "zh": "我的老天！我弄痛你了嗎？噢！"
 },
 {
  "id": 17,
  "src_sha256": "608cffd767b6d6b59f17dd992d3d9d30731d90c0dd8018d5b4c4bd9d6298ab91",
  "zh": "小心點！我可沒看起來那麼耐打！"
 },
 {
  "id": 18,
  "src_sha256": "9cb181a4a06739eb2b4bfecffade0c98c4a238e45d98f8f949e2cb4dc091e8b4",
  "zh": "奇異恩典。他走了。"
 },
 {
  "id": 19,
  "src_sha256": "4661121651d8720c3c677e959c877bc4a991a27d4f504d3c43db92eece16f7cc",
  "zh": "噢，我的老天，她已經死了。"
 },
 {
  "id": 20,
  "src_sha256": "c30dc745f94554dd2222eb6aa3ed23f87f715cdff1e540389ffba3cf9d06b508",
  "zh": "這場死亡讓我想起我寫的一首歌，叫「把朋友害死可不太好」。那首從來沒紅過……"
 },
 {
  "id": 21,
  "src_sha256": "8ca42033f57eaef41affc8bd6814daefb0b065382449088171510aa0c7abf0a9",
  "zh": "我們快死了！噢，甜美的喬治亞棕女郎啊！救救我們！"
 },
 {
  "id": 22,
  "src_sha256": "b06fbf23a9a32b00d703d59d0953741c2a5f2fe3a559f769bcba5c139c9305e3",
  "zh": "啊，怪物？對，對，我只是這些死人老兄的娛樂節目。你們不妨乾脆讓我走我的路。我無害的，真的。"
 },
 {
  "id": 23,
  "src_sha256": "8f4101a7b97cf374391645cbf35e5bb00682a3010b51d53cbee8c9ee7ac541f9",
  "zh": "我看上了什麼東西……"
 },
 {
  "id": 24,
  "src_sha256": "73960a96f974a31eccfbdef226c268a62ddf4b1fa1579eb4c043744e6efa01d0",
  "zh": "把那些東西拿來……"
 },
 {
  "id": 25,
  "src_sha256": "cc28f4d54ff199e00d14cee39f90854c94f35f1283d804ea961720998f9fda60",
  "zh": "老弟們？這裡有陷阱。"
 },
 {
  "id": 26,
  "src_sha256": "53979835ac19aac6a63c36a958bc645bbc97e87c87ead3439e7882f2c4f59c88",
  "zh": "有人想藏東西，老弟們。"
 },
 {
  "id": 27,
  "src_sha256": "5fdaf201fcb2d7a8e1553b8cb37e1985b793faea6e7808951f977c1a10cbdf7c",
  "zh": "這地方的感覺像一架走音的鋼琴——酸澀、痛苦，每個音都彈錯。"
 },
 {
  "id": 28,
  "src_sha256": "507d338269978095f9e3b2b71dcf01b38ab0bcc489ca289c423238e52ee31db3",
  "zh": "老弟們？傷口需要照顧一下。"
 },
 {
  "id": 29,
  "src_sha256": "89c4ca392fc2a3960a5e08b8c2c2ebe03ec96493f9ddea19dc991b71458ffe87",
  "zh": "我的曲子準備好要對付他們了！"
 },
 {
  "id": 30,
  "src_sha256": "71389ee1c20892e6dd382acc85d57f163d8bfbfee3ffc95342fac532ca3ca0de",
  "zh": "我來替他們飆個高音！"
 },
 {
  "id": 31,
  "src_sha256": "7dff036e9e42a8e886ec5751826677d1a3c790b17aede512c6d1231b7c84a649",
  "zh": "跟那個打？！我得來杯酒！"
 },
 {
  "id": 32,
  "src_sha256": "b3ffaf3962238ec1a584befdcb2e046919bc83ab020a2a263427f566f5f02e40",
  "zh": "我該拿這個打誰啊？"
 },
 {
  "id": 33,
  "src_sha256": "de9c385803eda2ca9de817db530e9912930ddc2e0770b274ab0a126e233236c2",
  "zh": "噢，我的老天！我在 Roadhouse 從來沒有過這麼多觀眾！"
 },
 {
  "id": 34,
  "src_sha256": "0f8f51db1fba7223b0afe58122f834d55d848a8e9bf73bd8759392d1a830f77a",
  "zh": "哇，老弟們！好險！"
 },
 {
  "id": 35,
  "src_sha256": "979dfffaca69f96ff5cb9b3c8ac163057fefaf500ac3c5fdfb0d530356d11614",
  "zh": "那啟發了我，老弟們！"
 },
 {
  "id": 36,
  "src_sha256": "11c602f8f02bc43d2345cdb788f65399be35e45389a661814fb2351604a7d97f",
  "zh": "噢，我的老天！看他死了真好，嗯哼。我沒法告訴你們他給我們惹了多少麻煩。好多好多年。今天，Imperial Umpani Federation 歡欣鼓舞！沒錯，先生！"
 },
 {
  "id": 37,
  "src_sha256": "0392dda8d220e86ff062b5251ced29fd9d0095fd2a548d48bbe785b799b934ee",
  "zh": "剛才飆到高音了，老弟們！"
 },
 {
  "id": 38,
  "src_sha256": "c60ae4d5190fd7fd6b9a6de6c713720a2c36962f777138c601e6437d3c155f34",
  "zh": "有人要進來了……"
 },
 {
  "id": 39,
  "src_sha256": "d58db0138d627e388b5dbba3651442d19d88e7647cf3d07d235ebbb423162a0a",
  "zh": "給我一把樂器！"
 },
 {
  "id": 40,
  "src_sha256": "ca07edb872d5f72cfed495b75d73186e0e337c91f2c5d7a2330d7504cf16a2f5",
  "zh": "哇，老弟們。我想我們有麻煩了！讓我想起我寫的一首歌，叫「他們拿了我的錢就走了」。"
 },
 {
  "id": 41,
  "src_sha256": "e997ed6ebbc3b341ca647015d248c3961345765305d8c37870c40621fa678d6c",
  "zh": "好啦，老弟們！這是我的大秀，所有演出的老大哥。只有今晚，僅此一晚！該為 Dark Savant 演奏了！"
 },
 {
  "id": 42,
  "src_sha256": "96c8c835c9ee14fb750d6447deb51e2a23c227ce7ba433779439838df91779b3",
  "zh": "嗯，我得說，我真高興能在這裡。嶄新的命運曙光，嗯哼。我說咱們就用甜美的樂聲開場！我心裡正好有首歌。"
 },
 {
  "id": 43,
  "src_sha256": "f7d83c2a8bf28e11054b71bbafd37bcdcd400caaeed9be0f3e5d254db0a4ee5f",
  "zh": "我的老天，老弟們！我受到啟發要寫首歌了！我要叫它「 Al-Sedexus ，她讓我們心煩！」說也好笑，她還真的這樣！她說她不想讓我走……呵……不過女人對樂手老是這麼說。不知道為什麼，老弟們。我們就是有那個魅力。"
 },
 {
  "id": 44,
  "src_sha256": "04d1fd9d6fcd48c8a1d4de0fa47c8abcc57e15722aa14ff4f9c7b7b264d4aae3",
  "zh": "等等，老弟們！我的老天，這裡不對勁。你們還記得我剛才跟 Al-Sedexus 那個，呃，大合唱嗎？嗯，我想我那首歌可能唱得一點也沒錯。只是她的魅惑比我預料的還厲害。我走不了，活著走不了。也許你們可以幫我回去把事情了結。"
 },
 {
  "id": 45,
  "src_sha256": "b58de844249f44dbf46532eaf49abb541fc5f68fca72643cfa173b5a7f6ef210",
  "zh": "我的老天，那甜美的香水味又來了。她很近了，老弟們！非常近！這次，我是在為我的命演奏！"
 },
 {
  "id": 46,
  "src_sha256": "4f17914019e7bf7fbb21975e45cdffad1d8ff5ee5e581bda71489d3c69a83342",
  "zh": "這個 Astral Dominae ？你們知道嗎，老弟們，好多年前，Umpani 差點就得到它了。我很驕傲它回到了 I.U.F. 安全的手中！"
 },
 {
  "id": 47,
  "src_sha256": "1f4790cb6f8e7919e186d650fff2008ced86a649b8c3bc83a54c7da9fb83f483",
  "zh": "你們知道，我們聽說這東西，大概是我們到這裡一個禮拜之後。看來它在 Dominus 惹出了各種麻煩。而且，哇， Marten 付出了多大的代價！讓我想起我寫的一首歌，叫「把朋友關起來殺掉」。啊，那是我很難熬的時期，老弟們。"
 },
 {
  "id": 48,
  "src_sha256": "042ee6164541a6b8cb059cd81498dc9d65618598ef360f4345c207ae165cdaed",
  "zh": "我的老天，老弟們！我拿到了！現在咱們趕快開溜，趁 Mook 還沒發現我這小小的序曲……"
 },
 {
  "id": 49,
  "src_sha256": "f123214b005108a4671f78263f0f9c80bcc482554279549e85a3f8627dbe93f2",
  "zh": "好啦，老弟們！我拿到了！現在只要殺出一條路回去！那些 Mook 不會輕易放過的。讓我想起我寫的一首歌，叫「他們沒得選，嗯哼！」"
 },
 {
  "id": 53,
  "src_sha256": "51fa0993bb3bb415c8527b5798ecf0b70e231fcc8fff28570e0b4807ad258cdc",
  "zh": "不行啦，傻瓜！"
 },
 {
  "id": 54,
  "src_sha256": "dcf83137e2e5af26c787e21457b942f822e5f774ffb81cb0796d693d43d984e9",
  "zh": "說謊的狗……"
 },
 {
  "id": 55,
  "src_sha256": "498d12fc07f7afc2da12616c25cc99e92352ba5dc82d48ea97baef97dd167a78",
  "zh": "哇，老弟們，快瞧瞧這漂亮玩意！"
 },
 {
  "id": 56,
  "src_sha256": "3d461c3d60f71b70d5b174ba0a0f4310a01758b511b040d06a5928c196a21ce0",
  "zh": "人家叫我 Saxx 可不是沒原因的！！"
 },
 {
  "id": 57,
  "src_sha256": "b0e79616f81223792f41a10ed0ff2b7bad2560188f6a61bf46772ba97c423063",
  "zh": "哎呀呀， Vi 。"
 },
 {
  "id": 58,
  "src_sha256": "c318455769d773a54f6637a11ef132c66bdbe8df43bea2e0b73ee5c9031a1793",
  "zh": "呼！我們在這裡相當安全，老弟們。"
 },
 {
  "id": 60,
  "src_sha256": "1eb6983c106d6629be1ea80aa6dea013040bf2c72d3cf6f9bfb48c0ba0d0a82f",
  "zh": "聽好了，老弟們！剛剛那就是 Dark Savant 。就我所知，他不會留任何東西活著，除非對他有用。你們要小心。他對你們有所圖謀！"
 },
 {
  "id": 61,
  "src_sha256": "593f81e714924d3cc67016c91fe805b14204637583fcd2e37c575459028282e6",
  "zh": "嘿，老弟們，你們在他面前好像很緊張似的！你們從沒見過長翅膀的大龍嗎？"
 },
 {
  "id": 62,
  "src_sha256": "22306f80169fda2b37daf9ff225225cead9019f561a33ab82814b8c9d0b6de84",
  "zh": "哎呀，這真是悅耳的樂聲！那美妙的低音轟鳴……這種爆炸可不是天天聽得到！沒錯，不是天天！"
 },
 {
  "id": 64,
  "src_sha256": "bb212fce285669565ba2765d6ae5134a68c42b543621f71ca18bff2c885ffafd",
  "zh": "我的老天，老弟們。那是我自己人啊！而且還是個 T'Rang 。該死。這很傷人，老弟們，真傷人。我們都走了這麼遠，誰會做這種事。天哪……這是悲傷、悲傷的一天。我想我需要來杯酒。"
 },
 {
  "id": 65,
  "src_sha256": "173633d5cfc99a3088e492a025522d02486b55807cd035966122d2ee45ffb6ee",
  "zh": "這任務演完了！"
 },
 {
  "id": 66,
  "src_sha256": "e4ea60a12f78ca01841d997c5da56c900b45b794febc6b6940851dcf226e4fff",
  "zh": "我的天！這裡這個裝置不是看起來那樣。看起來像是，但它不是 Astral Dominae ！"
 },
 {
  "id": 67,
  "src_sha256": "43dbf9a97d89f87d7e0b01f9c62ba1f1ba1751f140e2f2e348001a806e1b3ca8",
  "zh": "討厭的傢伙進來了！"
 },
 {
  "id": 68,
  "src_sha256": "aabc7c3b3a80cf8479fac32804e369949629c8fa69a84b5535b7822bb52bc49f",
  "zh": "我這裡有麻煩了，老弟們！"
 },
 {
  "id": 69,
  "src_sha256": "edc4b0aeedc0c1f7ee7cf304a21ca8ff04fb82cbf8125762c0ff5c5f9f79c2a5",
  "zh": "你們決定，老弟們。我要回 Roadhouse 去了。有空來坐坐，老 Saxx 會為你們彈一曲。"
 },
 {
  "id": 70,
  "src_sha256": "e9e8b03f18be997bf5c6b709b6c02b68200df0ab2cff9621615419410b64403f",
  "zh": "嗯，特務們管這座城叫 Arnika 。我自己從沒來過，不過我當然聽到不少。現在，這地方我知道兩件事。第一， Mook 在這裡開了間鋪子。第二， Dark Savant 也有某種勢力在這。"
 },
 {
  "id": 71,
  "src_sha256": "f6f6fedbc83a247ee33b0388361e522a0cdefa119ab4d0a84f5aee17f14b6ce4",
  "zh": "對啊，老弟們，我來過一下子。這裡是 Trynton ， Pvt. Sparkle 的地盤。在那些樹上，有一整座小人兒的村子。我說，挺友善的。"
 },
 {
  "id": 72,
  "src_sha256": "c943ccef67082b6f93a0279cedb5bd3b3d702c662af959f6e1b85e90da1465c3",
  "zh": "你們知道嗎，老弟們？這地方讓我想起我寫的一首歌，叫「我才不去那裡，說什麼都不去」。前面所有的路都通往 Marten's Bluff 。"
 },
 {
  "id": 73,
  "src_sha256": "fa5cfa4f728672ddbfac7a3dbe4631f0d8921233a7d00765da66d27619072029",
  "zh": "呼，我的老天！這地方讓我想起我寫的一首歌，叫「潮濕、黑暗又發臭」。我不敢說知道多少。在 Roadhouse 那邊，我聽他們講到一些洞窟，說有個老傢伙可能把自己關在裡頭，不過我不確定這些是不是那些洞窟。"
 },
 {
  "id": 74,
  "src_sha256": "91140df3bf9d5837070ad943f7f364e0d19da9918398bad9f678deea06578c23",
  "zh": "回到家，這樂聲真甜美啊！"
 },
 {
  "id": 75,
  "src_sha256": "09d724dea43e291973f1b8233b62133017af615218a96221288306774435f5cb",
  "zh": "你們聽過那首老歌「熱到我跑不動」嗎？嗯，這地方一定就是靈感來源！比凌晨兩點擠滿醉漢的 Roadhouse 還熱！要是我們要進去，最好小心點。"
 },
 {
  "id": 76,
  "src_sha256": "56ae690e2a42f7593d98366454341e1cd69c3a5960fef1c40275ea4caa1ccbb9",
  "zh": "好啦，老弟們。我想我走得夠遠了。我老啦！走太遠我的骨頭就唱起藍調。你們有空就來聽聽我的曲子，好嗎？"
 },
 {
  "id": 77,
  "src_sha256": "56ae690e2a42f7593d98366454341e1cd69c3a5960fef1c40275ea4caa1ccbb9",
  "zh": "好啦，老弟們。我想我走得夠遠了。我老啦！走太遠我的骨頭就唱起藍調。你們有空就來聽聽我的曲子，好嗎？"
 },
 {
  "id": 78,
  "src_sha256": "b3e4a83e62ed3a37dcc2e3473e1a3dde60a9411062f11cab0a67e8bc72cf215f",
  "zh": "對，我聽說過不少關於 Ascension Peak 的事。好像是當地人嘴邊的歌。老 Sparkle 呢？她講個沒完，說 Ascension 就在這裡，是他們繼承這顆星球的大日子。"
 },
 {
  "id": 79,
  "src_sha256": "71790d4a5b8031cbbca4ef091b6070712e7352550696bd56a749fd0fab37f2f9",
  "zh": "就我所知，這只是咱們之間說說，有三件物品應該要以某種方式嵌在這裡。然後，嗯，你們就會升上 Cosmic Circle ！別那樣看我，傻瓜！我跟你們說，我就是這麼聽來的！"
 },
 {
  "id": 80,
  "src_sha256": "9a52f2e83e650066bcc4cf348ebd8e7eab8cab49d0cc0b2f9ed2f7a80e4997eb",
  "zh": "好啦，老弟們！這是我的大秀，所有演出的老大哥。只有今晚，僅此一晚！該為 Dark Savant 演奏了！"
 },
 {
  "id": 81,
  "src_sha256": "9805d84df56407662c46a4543939a0fe387111355c029898966299f1b3258b3b",
  "zh": "我的天，我的天！這地方根本就是一首等著被寫出來的老藍調。我是說，看看四周，老弟們！一片沼澤。陰暗、自憐，而且滿是不該存在的生命。"
 },
 {
  "id": 82,
  "src_sha256": "d92549c2c989cc990367a73c277d64acd4b928ac3478c6830c330669b1169ea8",
  "zh": "不，不，老弟們。我知道前面是什麼。就在我們出發前，我風聞斥候（ Recon ）在這一帶發現了 Rapax ，而且不是隨便哪個 Rapax ，是頭頭本人！我是說，我現在是休假中啊，老弟們。"
 },
 {
  "id": 83,
  "src_sha256": "29bb7d5fb1e8c5abfca97b228afa921dc3e6c566d973ed467a95f392450292e4",
  "zh": "打鬥偶爾是好玩，但那個我可不去對上。你們先走，我晚點再追上你們。"
 },
 {
  "id": 84,
  "src_sha256": "56ae690e2a42f7593d98366454341e1cd69c3a5960fef1c40275ea4caa1ccbb9",
  "zh": "好啦，老弟們。我想我走得夠遠了。我老啦！走太遠我的骨頭就唱起藍調。你們有空就來聽聽我的曲子，好嗎？"
 },
 {
  "id": 85,
  "src_sha256": "b4a005fa658d5affec598a0bacadf3a1e2a30540bca332df3a854caf7ce866d1",
  "zh": "這是怎麼回事？老弟們，你們不能把我一個人丟在這外頭。你們算什麼朋友？先帶我去個安全的地方！"
 },
 {
  "id": 86,
  "src_sha256": "58fa4612c40d6992117fcd520dc3555f724e7cefafdf93f1955dbe13cf014f3b",
  "zh": "嗯，看來我在好轉了，不過還是有些痠痛。"
 },
 {
  "id": 87,
  "src_sha256": "b2b60d28e25e4771a973d63410a8296e56d5a8a4dccd08456ca0f436bae0d41d",
  "zh": "老弟們？我染上的那隻討厭病蟲終於離開鎮上了。"
 },
 {
  "id": 88,
  "src_sha256": "5ee6df6c085f2fe470ffa10b62e9d16d7f11a6b340d34dba6d8f40cfe98fe3f8",
  "zh": "哇，老弟們，我的頭還在痛。我們現在在哪？嗯。這地方讓我想起我寫的一首歌，叫「在壞事發生之前快帶我離開這鬼地方」。我是在還沒掌握好歌名訣竅之前寫的，你們懂的。"
 },
 {
  "id": 89,
  "src_sha256": "6161ef2174e99fdef231250222e9c96a52c3e71f2f2322e6e009f6441aa9e508",
  "zh": "這地方讓我一點靈感也沒有。"
 },
 {
  "id": 90,
  "src_sha256": "62e87c3ee3225de56e1b5dcf13058bde25b7a6908a942816c3075b4138b96df7",
  "zh": "這可不是適合樂手的場子，老弟們。"
 },
 {
  "id": 93,
  "src_sha256": "104ce8dd3701769758add9fdca7b604e9894c088e280d5706c541d3a04261ab4",
  "zh": "老弟們，這對我意義重大。我想留著它。"
 },
 {
  "id": 94,
  "src_sha256": "ae8099d51e4f6127d8ea7eaa03ecade89fcab08f26fac317f0d939d3a3d6c59d",
  "zh": "我沒改變主意！我不去那裡，老弟們。"
 },
 {
  "id": 95,
  "src_sha256": "a43e8da1520790d73d76b5016f590e66dafde639d86ba57cd491a07638737ab4",
  "zh": "將軍很有格調。你們得佩服他，老弟們。"
 },
 {
  "id": 97,
  "src_sha256": "ea4c5e952f3cd4f84b201586fff0fbe8806474f607b5076ef5f853800d7be57a",
  "zh": "我感覺他對這個 Ascension 的事知道很多……"
 },
 {
  "id": 98,
  "src_sha256": "547f9ade3855ae33010d569466a66939fe93afc39a84aab5c98afc7fea0ce0fa",
  "zh": "我想我見過的鬼已經夠我用一輩子了。"
 },
 {
  "id": 100,
  "src_sha256": "f89666e7f954c9f618f7ea91f2cdccff712f98fe8c70bb2ef64d8110f37c1ef2",
  "zh": "他讓我想起我寫的一首歌。我管它叫「小紙條」。"
 },
 {
  "id": 102,
  "src_sha256": "116e89fcbe9d1ab67d955b19fb5cbe62a6c137da1d50409bd0db6c16b5a3780c",
  "zh": "聽我的，老弟們，永遠別信老鼠。不是說不能跟他們做生意。只是要小心地做。"
 },
 {
  "id": 103,
  "src_sha256": "dfba734bac8deb7e3c2a5160fb636eac9647737c29e28e7d18a6772aba841ad0",
  "zh": "他是個毛茸茸的傢伙，是吧？"
 },
 {
  "id": 104,
  "src_sha256": "01efc7ba7a2e8707cbced0ee4dfa5e38bb329647ba209a8a15fdb057d4d697e3",
  "zh": "老弟們？來看看這玩意。不知道它是幹嘛的。"
 },
 {
  "id": 105,
  "src_sha256": "f139a67c4d13fc93cc03d5275474b7d020bc7f2543997da5f2c077b70dddd90b",
  "zh": "終於！看來我可以離開這個老地方了——我是說活著離開！唉。我真希望結果不是這樣。我本來還想約她再約會一次，嗯，直到她想殺我為止。那就全毀了。"
 },
 {
  "id": 106,
  "src_sha256": "c0bd40a4e05b6ba43712ea0697ab4719b290ce6d49e64ba85a0eaf2587577ecc",
  "zh": "看起來很氣派的頭盔……"
 }
]

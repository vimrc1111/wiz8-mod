[
 {
  "id": 0,
  "src_sha256": "04ffd1dd9fd93ff278ba931976a9214c2fe35747b9b2085a966e8d1a9ba745d9",
  "zh": "幹嘛……你們在幹嘛……這房間有人了。"
 },
 {
  "id": 1,
  "src_sha256": "ca1b6b8179fe6973aa0541fa5ad7cb62ac4d2bae67c0af67c76ad997572abda5",
  "zh": "別來煩我……"
 },
 {
  "id": 2,
  "src_sha256": "ff534d39375f659604920e03c26b3b7409f1020d19645eb0fe4a1273369576db",
  "zh": "呃嗯……"
 },
 {
  "id": 3,
  "src_sha256": "913eac0c58ebf3b2421e00bf269736325ce395f31eab3862276a72588e5086f9",
  "zh": "呼……呼呼……"
 },
 {
  "id": 7,
  "src_sha256": "4256fec0022bb3218a0d58d7ab3a312e6f6aa418dab257e28e4c77bf5ad7715a",
  "zh": "那個喝不到啤酒啦！"
 },
 {
  "id": 8,
  "src_sha256": "528c1c83e5f30bb88b1f62696cb09b9d3b7387c3ca08c052f5efa5d63eb884d1",
  "zh": "要打架？別撞翻我的啤酒就好。"
 },
 {
  "id": 9,
  "src_sha256": "941c369297da36b3ceb808c92f59873974ae97aa3f05b29087e93c5632c12ed3",
  "zh": "我站都快站不穩了。哪裡也不去……"
 },
 {
  "id": 12,
  "src_sha256": "95d5f371fc806ff3ed595f62b9dd9b2a9320f1cd0b60cbe873b919a9e791fc95",
  "zh": "我可以……喝這個嗎？呃……"
 },
 {
  "id": 13,
  "src_sha256": "2f0b9882efd9ed95cd80c123190e4414b679e0f4112da908742ba9db8360e9b3",
  "zh": "把那東西拿開。"
 },
 {
  "id": 15,
  "src_sha256": "ce70570da7692b82f5edd9abbe6d2bbde3defc528a784f0817fb514a1a004c02",
  "zh": "我什麼都不想要了。"
 },
 {
  "id": 16,
  "src_sha256": "cd38f3a4b3140ec43f8cfa05148cfa5d362a3c567af5ff25110385a3cbda12d4",
  "zh": "小氣鬼！"
 },
 {
  "id": 17,
  "src_sha256": "e34978689d4dfb322f4c521bd6b9b0514c33808b726fc89342475473e153d5c4",
  "zh": "喂！！！喂！！！你們以為我醉到什麼程度啊？！"
 },
 {
  "id": 18,
  "src_sha256": "c78eed542df8ecffb4370484554a82b04e2c2f711cc8d138293649f11d27b50c",
  "zh": "你們還真懂得怎麼糟蹋一杯好酒。"
 },
 {
  "id": 19,
  "src_sha256": "039b1180675f24cd7603983014f39cd00e5eec1cd0e0f99e8ddc15bad4215b45",
  "zh": "喂！你們在幹啥啦！"
 },
 {
  "id": 20,
  "src_sha256": "70cc708500a10766a61781eb9617a47a3ee8f020420a690ea73b86ab0ec43bb4",
  "zh": "你們十六個我一個人就能收拾！來啊！"
 },
 {
  "id": 21,
  "src_sha256": "ab0a7e29c7e41b82a09c1817b5aea7dca8edd0abca2570739a9789209f1c44c3",
  "zh": "呃嗯……"
 },
 {
  "id": 22,
  "src_sha256": "2b311821ad790809febec7fb84ef23b64e14c4b47efb8f1207cb120183088dfa",
  "zh": "啥？？嗯？呃嗯……"
 },
 {
  "id": 23,
  "src_sha256": "ccedf9d9e84286d5fc511dc9b2e4d8720773951603c22bd5b6d8ff856109eba5",
  "zh": "聽、聽我說……這就是在喝還是 *HIC* 不喝的問題……"
 },
 {
  "id": 24,
  "src_sha256": "3531229b5abf981311ecde65b0702ddb28b010ea3beaca21ddd3f3c375662fe9",
  "zh": "*HIC*"
 },
 {
  "id": 25,
  "src_sha256": "43e5e6af97c37c647ae73a00a6ba587e10ece5ae2e6300b782b2f495da02789c",
  "zh": "我剛剛不是說過了嗎？"
 },
 {
  "id": 26,
  "src_sha256": "e39eeb1a10ee3952f479f009dc876df46c4336395a0c9453affe04f8eaea00c7",
  "zh": "然後呃……"
 },
 {
  "id": 27,
  "src_sha256": "caa6053c4d0441ffb4e44495645ec7a64002cce773f42bd459e75007b48d78bd",
  "zh": "然後 *HIC*……"
 },
 {
  "id": 28,
  "src_sha256": "3531229b5abf981311ecde65b0702ddb28b010ea3beaca21ddd3f3c375662fe9",
  "zh": "*HIC*"
 },
 {
  "id": 45,
  "src_sha256": "8a6940a6c611592b8940500c1b640cc82071d03fb3ea407394c43f553f6fc550",
  "zh": "好像 *HIC* 有點印象……"
 },
 {
  "id": 61,
  "src_sha256": "404efa5593bb0cd1aecedf9fe43f3f4bd971124624ab077f51cce52b2d40c89d",
  "zh": "他在、在那邊不遠……"
 },
 {
  "id": 73,
  "src_sha256": "e828a5f6af76f5f5795f2af1ef4fcbcccbeb0f197a0b19d0f04335b215518b21",
  "zh": "我不記得啦！*HIC*"
 },
 {
  "id": 75,
  "src_sha256": "47dee1b7eaa24b89309084d0eedf9a17c0c420c1cc30ee6dc19d114f09d20784",
  "zh": "我太醉了……"
 },
 {
  "id": 77,
  "src_sha256": "08a70054f59e703ae5ee2bb185ba6951a0ee7e3798cd17e527fbf15e8bc6a586",
  "zh": "嗯……"
 },
 {
  "id": 78,
  "src_sha256": "52c8b305dbb867c1dcaf87f48223ccaa565ff9ad7ea9804b2fcfd54f043c25b4",
  "zh": "回頭見……"
 },
 {
  "id": 81,
  "src_sha256": "d4dc45591a03279cda944d19224c73b7044873e2ba56406f85ca12caacdd8203",
  "zh": "醉了。*HIC*"
 },
 {
  "id": 87,
  "src_sha256": "b562cb5b84db4008ced4dd8337ebf754769bb42a547538148d6b0d4ac640c1ea",
  "zh": "那邊少說有二、三十個……除非我是看到重影、三重影，或更多……"
 },
 {
  "id": 88,
  "src_sha256": "c3c4fa5859608d4b279fecc3ef61289fbad913160f24d73bbb4b365874d5620c",
  "zh": "我想我再來一杯……"
 },
 {
  "id": 89,
  "src_sha256": "9e8d2cad83c235b9122f95b75e61401f2bdff7b44ac4b22196a813ff9f7ef115",
  "zh": "我可能要吐了……"
 },
 {
  "id": 90,
  "src_sha256": "dacb31a8de566a4a8ae3b0aa386aff733df72020a11f1dbefae9f24b6c34beed",
  "zh": "就在這附近……"
 },
 {
  "id": 101,
  "src_sha256": "8a77e3315dc09088e6d8ccd03bed7cc999527ce21b109c489eb580cc17e67c3c",
  "zh": "就在這！你們也醉了嗎？！"
 },
 {
  "id": 102,
  "src_sha256": "4d7dd3b29bb65fad8265c411212d064eecff2e5e19b7707db7525289ee9a8bff",
  "zh": "我不知道，我也不在乎！！！"
 },
 {
  "id": 104,
  "src_sha256": "94bb54fb8174a6aeafc765f69d13b34013949ac23a9bd28e2cb63eaf789f02fc",
  "zh": "我就是那個？"
 },
 {
  "id": 105,
  "src_sha256": "665d792ab94c33383b2cafe0627bad7335e4d29f7b0c6841857980da9fe79fb1",
  "zh": "我想我 *HIC* 喝多了點……"
 },
 {
  "id": 106,
  "src_sha256": "01ee9ae1a9b8b1617d985971365d5b4b275445b08d8cac93de12d1290b81c8f1",
  "zh": "嗚嗚……"
 },
 {
  "id": 107,
  "src_sha256": "0661f535f722470552f83516b04a25379b5c9db14fe174933380e698962c3c3f",
  "zh": "我就是這麼說的。"
 }
]

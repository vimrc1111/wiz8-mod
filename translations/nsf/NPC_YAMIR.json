[
 {
  "id": 1,
  "src_sha256": "fb793da51db8794a9f3478d96fd78093865c30456fa2e32f3a32f4aabca34fc0",
  "zh": "士兵們……"
 },
 {
  "id": 2,
  "src_sha256": "f7ed140cf2fc49c76f4046f5f0a41ed82b97231a51dd160c46709ae483387d49",
  "zh": "現在沒什麼好談的。"
 },
 {
  "id": 3,
  "src_sha256": "9a95665e9c5f080b4c9a2ee7227d1142d30c52fe77c662ebd4abaaadf5ff5c92",
  "zh": "你們說什麼都改變不了我的心意。"
 },
 {
  "id": 6,
  "src_sha256": "bc19eabed5d2b7a464350256ee065c2177920d4392b432b4a439b77f15d27edc",
  "zh": "你們犯了大錯！"
 },
 {
  "id": 7,
  "src_sha256": "593a04564bbc26ed0fc22678451e8a94ea845c874ca5a034b255938580e555c5",
  "zh": "賄賂違反 IUF 軍方的規定。"
 },
 {
  "id": 8,
  "src_sha256": "c83c8b4429da992dc0c796605cc61b219bb19fc750b33f2a5c9819a57e3900e7",
  "zh": "衛兵！我的辦公室裡怎麼會鬧成這樣！？這場亂子不平息，我什麼都不談！"
 },
 {
  "id": 9,
  "src_sha256": "540d58fcf7f932f683bb7b216929d10e8d135193bec8238e97feb41910e8c024",
  "zh": "這話聽了很受用，但我不能接受。我在這裡是有任務的。"
 },
 {
  "id": 12,
  "src_sha256": "6ca98a875bf54b88cfb48eb0df846dd619c64a16df2332e4156ca33fccf2abd6",
  "zh": "哎呀，真是驚喜！"
 },
 {
  "id": 13,
  "src_sha256": "6945796836f036185c581542b293ddb318930b59d465dae3ff891b6efd7e8de6",
  "zh": "噢，我可不想拿你們的東西。"
 },
 {
  "id": 15,
  "src_sha256": "48824edd6cbe79b438eec589f42ef4878bb837678f40a6dd000958373da50910",
  "zh": "聽著，士兵們，我身上沒帶那麼多現金。我真的再也付不起了。"
 },
 {
  "id": 16,
  "src_sha256": "5136d921f04a9c4d8b0b69b6b722e71066f51155a5329bbb6f1df707a6f6a07c",
  "zh": "你們的錢不夠。看來我該想辦法給你們這些士兵加薪了……"
 },
 {
  "id": 17,
  "src_sha256": "38934abc0182021933bcf2c4812aecb25cf30e7bcef3e1ac50ea35665477a4ca",
  "zh": "當然，我一直想再來一個這種東西……"
 },
 {
  "id": 18,
  "src_sha256": "4c53a0bdc773aab691deaa33c78795456cad938fc256d3db3415bbd1144b4755",
  "zh": "也許我該發你們一張休假（ R&R ）許可……"
 },
 {
  "id": 19,
  "src_sha256": "18ebbf410c88fc61b47677e123599ed8d0ca483c57ac2f23e34c3050ae641d2e",
  "zh": "以後要是想要什麼東西，我建議你們直接開口！"
 },
 {
  "id": 20,
  "src_sha256": "ca958c78727709641890a439edb63d7178425b1dbedab3a74a75afe2335ff75e",
  "zh": "噢，我真不想這麼做！"
 },
 {
  "id": 21,
  "src_sha256": "dc1d1427c18e75dccb468232796fa096ef3805a2f71bcfc0ac512e5bf026546d",
  "zh": "噢，不。我不能收，不過謝謝你們的好意。"
 },
 {
  "id": 22,
  "src_sha256": "fc5e6297ad17fc4fc787fcaa25cc524b35801b8da690a1c66adb5a94764e62c2",
  "zh": "也許我們可以晚點再談……"
 },
 {
  "id": 23,
  "src_sha256": "55fbabc94315b34c3da52895017cca34fa0b71b2a7f5ae70b2c721f7bfd4b817",
  "zh": "這點我不太確定……"
 },
 {
  "id": 24,
  "src_sha256": "4e4aecef22523723bf0520950ec97477062ba52036d6aa0e45fd69df6fd9b020",
  "zh": "我要是告訴你們，你們就成了安全風險……"
 },
 {
  "id": 25,
  "src_sha256": "7a97b971e9fc21c0b714db258a490ac093331da69ffe9b37af48107355fc712f",
  "zh": "我會大聲說的……"
 },
 {
  "id": 26,
  "src_sha256": "433f3792618f967c35dbcfd489f1b32dc87d7c40d44dcd6742c9f5559659b9e6",
  "zh": "士兵，最重要的是哪一件？"
 },
 {
  "id": 27,
  "src_sha256": "b7f232d0fcf86ab4b7710e46e254049b3c5a0788ea55f9fdc8aca40b1bc5bd48",
  "zh": "還有……"
 },
 {
  "id": 28,
  "src_sha256": "57a7e85151062bb06015267e621bebe3ef7f461d66053dc10dae62fd76f72915",
  "zh": "我從沒想過這一點……"
 },
 {
  "id": 29,
  "src_sha256": "e4d32a67d14e97d6af4f820da60df9f0737e7cc8a714866881c5ab8a1b0013ce",
  "zh": "我希望少說一點，多做一點。"
 },
 {
  "id": 30,
  "src_sha256": "6a8e3842f182799c7ad34f9d6667f29cba0896ea6d9a0a1a4deb5e009f5c875f",
  "zh": "時間不等人啊！"
 },
 {
  "id": 31,
  "src_sha256": "7d9bc54b2f7ccf84800f4c787ff982dd4e9f8ee6a992949d859301d81402c57b",
  "zh": "這是顆美麗的星球，但就安全而言，我待在裡面比較明智，尤其是有你們這種人在外頭替我守住陣線的時候。"
 },
 {
  "id": 32,
  "src_sha256": "3f2b085a957b80fdb6b4aa03c39e533528c2617aa162008c4c44d230cf77fd8e",
  "zh": "美好的城市……曾經是。 Dark Savant 似乎在那裡建了基地。而且根本進不去！我們試過了——連 T'Rang 也試過了！毫無結果。這依然是個謎，各位。"
 },
 {
  "id": 33,
  "src_sha256": "5602041afd9a101b3caadb45c69ac70fe869322e228654e24c275d57240c592d",
  "zh": "悲傷的故事。我希望我們能查個水落石出。 Sgt. Glumph 當時負責帶領那次行動。"
 },
 {
  "id": 34,
  "src_sha256": "78bc150bed3788b3d66ae5def42ef085390d3f802eb090d44d8f68ae7fd9dbae",
  "zh": "我自己沒去過那裡。"
 },
 {
  "id": 35,
  "src_sha256": "2048ddff382e44ca7d9c146afd0f666cb1050e34f2c21d510b0bc5fcea5134f0",
  "zh": "你們說的是 Rapax 。"
 },
 {
  "id": 37,
  "src_sha256": "aa78d7d0ae49cd77ed11e617b6853c3e5d0e7d6c018a1b1aabafeb7c29ee9d6e",
  "zh": "我們有過最棒的堡壘！"
 },
 {
  "id": 38,
  "src_sha256": "3a2c0145998277d2c3252c51452ec9d1d3140f2a7874e8e2eb4a76697b1fb6a5",
  "zh": "要找 T'Rang 的話，那裡就是他們的所在。"
 },
 {
  "id": 40,
  "src_sha256": "cc12dce031f1b4f4a71622488ccc0f0d8be7a0d140f64fd861a1e463f8f817dc",
  "zh": "Ascension Peak 啊？我們離那裡不遠。我有種預感，整件事會在那裡做個了結。傳聞那裡是通往 Cosmic Circle 的入口。"
 },
 {
  "id": 41,
  "src_sha256": "7fb135f3c8c5698ac1700e700c844c3ff3f940f9d81539a8c4f5c11c1f0271fd",
  "zh": "就是 Cosmic Lords 所在之處。宇宙的將軍們！傳聞誰先到那裡，誰就會成為新的 Lords 。而我有個不祥的感覺（ feeling ），那就是 Dark Savant 的目標。"
 },
 {
  "id": 43,
  "src_sha256": "7ce6168cab80f3961d8c56bf9cb93f0f6a5c4c396fe8d2b6a054c672f2c10b64",
  "zh": "嗯，好人。"
 },
 {
  "id": 44,
  "src_sha256": "9fc2457e453476d13dd880490065548483232c9bd5575d460324418cd48502a6",
  "zh": "你們見過 Sparkle 了吧？她是 Trynnie 。非常好客的種族。"
 },
 {
  "id": 45,
  "src_sha256": "dc69b954c998393a631d3ad55ba7c6bb7b0e8536dd6f27b5729bde1c97db1c37",
  "zh": "跟你們說，要是我們能想辦法讓他們沒那麼有敵意，他們會是 IUF 裡很棒的士兵！"
 },
 {
  "id": 46,
  "src_sha256": "a57b5b94a883055bf66f4d772e7c123c58a662bd46560d5494818faadb919ef6",
  "zh": "我的人生！"
 },
 {
  "id": 47,
  "src_sha256": "9e1d9ae71f6777db82c8a2e1a199383108932f01f5b26e7a249bcfa03d9d2f9d",
  "zh": "你們聽我這麼說可能會很意外，但我對 T'Rang 真的沒意見。他們跟任何人一樣有權活著，只是他們破壞我們的計畫、我們的殖民地實在太久了，久到大多數 IUF 的人什麼都記不得了。真可惜，說實在的。"
 },
 {
  "id": 49,
  "src_sha256": "055d68c3e9e03281f81e5d67b5b7668b0e3976771dc759c6d45f24aa45a2ed50",
  "zh": "看來他們對現狀相當滿意……"
 },
 {
  "id": 50,
  "src_sha256": "1dbaf9cef1c49b7215d2328c0b7dbf06ecf123120e61299db721d8fb44d820e4",
  "zh": "噢，Rattkin 。連 Yamo 都拿那些多管閒事的小害蟲沒轍。"
 },
 {
  "id": 51,
  "src_sha256": "aff719e94b2c25bd51bc6814f26940195af0237984d1f6c5ece51ad4f7d4bc65",
  "zh": "在 Arnika 那邊對吧？嗯，他們很友善。畢竟我們跟他們簽了同盟。"
 },
 {
  "id": 52,
  "src_sha256": "7ab63a9ed12194f325aa56bdd7a6c6f947dfc8938a479de264278a086c567c6e",
  "zh": "Lords 、神、眾神、 Uhrinna 。都是同一回事……"
 },
 {
  "id": 53,
  "src_sha256": "c738a8fafc54359c9324da6d2556f69e2427711d71d70ce225cfcc428c33cf2d",
  "zh": "舊戰役了，士兵們。舊戰役了。"
 },
 {
  "id": 54,
  "src_sha256": "f208d07df44103019e307e26596129e452f6403bf15eaeeafa45479fc34a3c9c",
  "zh": "Dark Savant ……哼哼哼。他很難纏，我不會跟你們說我們已經掌控了他，因為根本沒有。士兵們，我猜不透他，相信我，我試過了！他完全無法預測，只有一點例外：他打算掌控 Cosmic Circle 。"
 },
 {
  "id": 55,
  "src_sha256": "036c257c837b8a1db83753c8a32e0b094dc07af37ddbdc45cc0a38d3916a3807",
  "zh": "*那裡*就是我們得打擊他的地方……你「知道」他一定會去的地方。我個人認為 Dominus 人民遭遇的一切都該算在他頭上，尤其是 Arnika 的人。"
 },
 {
  "id": 57,
  "src_sha256": "702bf9ee4b792dc80934ed3389d0d196e82ff44f40c6fa1bf2c451fe9f36e6bb",
  "zh": "我相信你們可以直接問她，士兵們。"
 },
 {
  "id": 58,
  "src_sha256": "f144e427733d65612a512e2d35aea085ecd7ea6584d412e661139fa43eb65810",
  "zh": "嗯，我聽過這名字。"
 },
 {
  "id": 59,
  "src_sha256": "eb4c466d22ea5349d97b1fdbb07e0b7877e1fd70d8b57532f52153ec6d326af6",
  "zh": "我知道的 Marten 只有 Marten's Bluff ……"
 },
 {
  "id": 60,
  "src_sha256": "12cd30b25d963a7e63383ac3fac24fbe60f047559c04c02efaca5f5ac4b67c95",
  "zh": "我只是順帶聽過他的名字，而且是很久以前的事了。"
 },
 {
  "id": 61,
  "src_sha256": "1e9a3151b35fcce039f180247b6a09ae88652b712ab3ad42e8905a3be94f3334",
  "zh": "是的， Yamir 將軍。"
 },
 {
  "id": 62,
  "src_sha256": "15e79e9ab34795421eede850621a23cd4577669885a15b04d72131ffc76a093c",
  "zh": "我建議你們離 Rapax 遠一點……"
 },
 {
  "id": 66,
  "src_sha256": "cf7f34871c167d76abc99248d9772d849463cd4fe58c738c88ff4704ce14fc74",
  "zh": "那是整個 T'Rang 這齣戲的首腦！我們得好好管教這傢伙。他的狠勁比大多數海洋還寬。"
 },
 {
  "id": 68,
  "src_sha256": "86d346f92dabcf66c5104704e6f6a99dd3348321fe46ba6d55d60f39670968d5",
  "zh": "為了那東西打過好幾場戰爭！"
 },
 {
  "id": 69,
  "src_sha256": "992406f65621f212331092c7c8378d6de256271a973972068073518007b3613f",
  "zh": "我們知道它……"
 },
 {
  "id": 70,
  "src_sha256": "992406f65621f212331092c7c8378d6de256271a973972068073518007b3613f",
  "zh": "我們知道它……"
 },
 {
  "id": 71,
  "src_sha256": "bde667fa42ebae7005385f47a76909c5557ef942a87730b60098ad888d6a1857",
  "zh": "你們居然知道這個，有意思。嗯，我的記憶不一定準，不過我的理解是那是 Cosmic Lords 用過的東西。我猜他們用它寫下什麼，那件事就會成真，一模一樣。我真想擁有一個！"
 },
 {
  "id": 72,
  "src_sha256": "573e6fe6070ee353ae23c675a04939aa740fa88580b87419f390e92709f8f771",
  "zh": "Ascension …… Ascension Peak 。那是通往 Cosmic Circle 的路。"
 },
 {
  "id": 73,
  "src_sha256": "995026f66dcfbb9c50458eaf431bc2cc362d84a3c1b8b08934c1cc39a15d58e0",
  "zh": "士兵們，你們只能相信兩樣東西：事實，還有 IUF 。就連事實也不是每次都靠得住。它們會變來變去，你們懂吧？"
 },
 {
  "id": 74,
  "src_sha256": "53035555cd7b2328f34f8e71d447f5d018cda3772e375d6b7c07c61e1470e317",
  "zh": "當然是 Yamir 將軍。你們只是在考我，對吧……"
 },
 {
  "id": 76,
  "src_sha256": "ae53f0035966d0644cada704ccd701feaad3142c590e7dccb546b51ff0583d2b",
  "zh": "好了，好了，好了……"
 },
 {
  "id": 77,
  "src_sha256": "01acac6d970ad5c3cec172c5a8f0b783111a298cc5998770fe8f6cea512df6c2",
  "zh": "今天不順嗎？"
 },
 {
  "id": 78,
  "src_sha256": "2fd53f1c4741346593ad2a043a087b0fef6a94385846ec13e32a93c4ccc77b23",
  "zh": "很高興你們來了，士兵們。"
 },
 {
  "id": 79,
  "src_sha256": "dbad01b94cba1070fde68a6fab1748cdf090f9306f9443dedba1a5bb5f903dfe",
  "zh": "我會為你們祈禱……"
 },
 {
  "id": 80,
  "src_sha256": "9445e8dbae5a7c9a7addcf35ab97acb0d808eb383b247e3ce6171d665f217214",
  "zh": "我隨時聽候差遣。你們需要什麼都行。"
 },
 {
  "id": 81,
  "src_sha256": "39ce9199ce9f674ef14110525aff5525f6952bfbfe09bdd55ebfdb7f94e2fc27",
  "zh": "去 Commissary 那邊，會有人照顧你們。"
 },
 {
  "id": 82,
  "src_sha256": "3f8b6b77411d32245695f0221e4a293ea03864075083bd4dc89c66b12d0d6ed5",
  "zh": "太好了……"
 },
 {
  "id": 83,
  "src_sha256": "9ee302de259ac2979c33fe6ab4140bc1314315df5a771509d918dfa6b768d861",
  "zh": "我從來不太迷那個。我比較喜歡會 BOOM 一聲的東西！嘿嘿。"
 },
 {
  "id": 84,
  "src_sha256": "67bafa734e58047e08b798dbac471fee9f65aaa8b92d166e98538592774b72f9",
  "zh": "只有為了正當的理由……否則，戰爭（ war ）不過是浪費生命。"
 },
 {
  "id": 85,
  "src_sha256": "7eb930c14e1f114d48942648894db7cc4b4f4e9f20e26c4a7a18398474bdeeeb",
  "zh": "T'Rang 的船……就在上面某處。該死。"
 },
 {
  "id": 86,
  "src_sha256": "8fa4ba809402e40f308e91080b055173f5669029b339644bb7f6393b4df459f9",
  "zh": "我想現在可能在任何地方了。"
 },
 {
  "id": 87,
  "src_sha256": "02d734a70f9f14bd0ea28d3e633bc6f858241253d3515c37c1fc20a697722253",
  "zh": "我們的船？我們艦隊裡最棒的船……我是想讓你們開出去兜一圈，可是你們得具備資格（ qualified ）……那可是另一回事。"
 },
 {
  "id": 88,
  "src_sha256": "39bfdd62ae404c0687f4a2e5f084038c6fa45ffe47afb4d7490010d36bac3e54",
  "zh": "也許下一次戰役，我們能讓你們取得飛行資格（ qualified ）。現在不是談這個的時候，不過我會幫你們說句話。"
 },
 {
  "id": 89,
  "src_sha256": "0c6d06aeb0888b43192ce7871e24d8aafaafb136dd334de7c5c7089ed190bab4",
  "zh": "沒錯，我想這幾位說不定就是能帶我們走向勝利的人……不過我得先考驗考驗他們。"
 },
 {
  "id": 90,
  "src_sha256": "e50b282400d762fb057e32cfd0771468793d572842466c7c51ef0f5767211fbb",
  "zh": "我就是不敢相信 Kunar 的事是真的……"
 },
 {
  "id": 91,
  "src_sha256": "e1f714a673f6e7fe51e89ba290788824d567378980ece895110f2024315fa75f",
  "zh": "Yamo ……願 Uhrinna 安息他的靈魂……"
 },
 {
  "id": 92,
  "src_sha256": "9080cd2eab9ff87f137938b3b5e617d3b0f4af4b00eef6f07dc9a40e8b2b813b",
  "zh": "是 Arnika 。"
 },
 {
  "id": 93,
  "src_sha256": "2bbe6b811709c19afd6832f883cecac38887a826c635a058a0c55bcb3a45e9bd",
  "zh": "那個你們得去 Trynton 。"
 },
 {
  "id": 94,
  "src_sha256": "d86b8f2ea84399fd5dde6a79f715131d59573f4ec2ce30aea740ccc7dade3b95",
  "zh": "就在 Marten's Bluff 正前方，不會錯過的。"
 },
 {
  "id": 95,
  "src_sha256": "efc49d413440b54ea5a949680264880ef9ff372f1b8db8241f1dcddcf58edd3e",
  "zh": "從這裡往南，先穿過 Trynton ，再過沼澤。 Marten's Bluff ，你們要找的就是那裡。"
 },
 {
  "id": 96,
  "src_sha256": "4a4335a34f05a7f7b44a61d3235ad8e91dcd8604a8461df450bdf3dd5429358b",
  "zh": "我想應該是 Rapax Away Camp 。"
 },
 {
  "id": 97,
  "src_sha256": "b2fd8628a58bc8a3db14d1b1a7dbb52b96fe6c9e59ab2e7922c52ec6299f689a",
  "zh": "當然就在這裡。"
 },
 {
  "id": 98,
  "src_sha256": "b4b585ac73bf4db43dff9a715186fed9fe91aa75686d37968116aa693b220d47",
  "zh": "我猜是往 Sea Caves 的方向。"
 },
 {
  "id": 99,
  "src_sha256": "005c6b3d1ceadd42ca797512bf4688ee6ec35bd7dc1a303d8e01b64b8d6a1f7c",
  "zh": "試試 Rapax Rift ，不過要小心！"
 },
 {
  "id": 100,
  "src_sha256": "c112f4368644186d02d220f5b8c60e403e5945ace735d03dd34324fe811cc108",
  "zh": "那是 Rapax Castle ，不過我實在不願要我的部下去那裡……"
 },
 {
  "id": 101,
  "src_sha256": "7705c2933361334589711724b2bdd6bccd2d2b6555734ef77e148e00cce1727d",
  "zh": "肯定是 Ascension Peak 。"
 },
 {
  "id": 102,
  "src_sha256": "798b369fb05f7d71b871f55ad87343bd728f78b920b64c02ff32d65739b9790f",
  "zh": "Cosmic Circle 。沒有別處了。"
 },
 {
  "id": 103,
  "src_sha256": "9068043c600c6905623eeebb49cf6495534bdf9aef2d4ffccc325d2d8e792bab",
  "zh": "嘿嘿！就在這裡！"
 },
 {
  "id": 104,
  "src_sha256": "08c09238dab9a2b2015e7e1bdf0ce4fea8accc63ab7d307508243b35116d3d1e",
  "zh": "我不確定，士兵們。"
 },
 {
  "id": 105,
  "src_sha256": "bc8793f0d9ef515a9e7991b628d3230849ba51ab918dbe8993e62ddd54df4994",
  "zh": "那是 Bayjin 。"
 },
 {
  "id": 106,
  "src_sha256": "9ede12349171136892c676a1ff976d5e483535db1444e72fa5a1b03658508d52",
  "zh": "這值得再說一次……"
 },
 {
  "id": 107,
  "src_sha256": "3d9e2fd7590a75e193c0faeb302fe00254c3668369bc91be507f83960f83d6a2",
  "zh": "仔細想想，士兵們，照你們被交代的去做就對了！我們沒時間搞這些！"
 },
 {
  "id": 108,
  "src_sha256": "7b1205e6d8ee09d2ba064332487d9747691eba815e123655a04336406f42ec59",
  "zh": "我還以為這是你們的主意！你們的任務是促成 Umpani 與 T'Rang 之間的和平！"
 },
 {
  "id": 109,
  "src_sha256": "0cdc8f970f13a022e85539b99c5a25387f749af38d87763e10b2ce860ced1d8b",
  "zh": "照著標示走就是了，士兵們。"
 },
 {
  "id": 110,
  "src_sha256": "afa2360f12b1ab223b38263ed0dac59e4d858b140e55f44b24d7a415746888b7",
  "zh": "我不會監視我的部下，士兵們。"
 },
 {
  "id": 111,
  "src_sha256": "cbae3d2ee1ae1575fc376d5538d5a7981302e09b46326afcd531b27a90f7720c",
  "zh": "願他安息，那位老將軍。要我談起這件事還是很難受。他死在 Guardia 。"
 },
 {
  "id": 113,
  "src_sha256": "d252d7cdb891fa99a68a46078155718e1bcc2cdd897ba5d6510feeb7d833baa7",
  "zh": "我們其實不太清楚。說實話，它的存在到現在還只是理論！算了。它最好真的在那裡！"
 },
 {
  "id": 114,
  "src_sha256": "a353e2b6d3c86b299435ad95bff052dbae96a12edc99b00be324509ee513dbeb",
  "zh": "我寧可連*想像*它長什麼樣子都不要……"
 },
 {
  "id": 115,
  "src_sha256": "324e052ff9831a3cce0d36b25de7e318b7498c84f737bb6e518ce18fe3c2435b",
  "zh": "哎呀，終於見到你們這支隊伍了，真是太好了！傳到樓上的讚美之詞多到我說不完。這就是我指名要你們的原因。"
 },
 {
  "id": 116,
  "src_sha256": "083fc86f0cfeeb7cff785413082455186e65e32f90d59504ffc7a0eef95add1f",
  "zh": "哎呀，終於見到你們這支隊伍了，真是太好了！傳到樓上的讚美之詞多到我說不完。這就是我指名要你們的原因。我們有個重要的任務，而且很棘手。地點在 Bayjin 。幾週前，我們派了一支部隊過去，但他們沒回來。音訊全無。"
 },
 {
  "id": 117,
  "src_sha256": "106fa62630138c555d5c6d083b7f55134afd2d4302863290a3793812d7fd34b6",
  "zh": "我要你們去 Bayjin 找到我的人，把他們帶出來。還有，我知道你們很躍躍欲試，但這*不是*探索任務，懂嗎？進去，出來。你們去找 U.T.U. 訓練場的 Rubble 做你們需要的準備。"
 },
 {
  "id": 118,
  "src_sha256": "b9e6d70e4f612484282c04c3414b789564b0ceae724918dfde4ac74524ce88d3",
  "zh": "還有，士兵們？把我的孩子們帶回家。"
 },
 {
  "id": 119,
  "src_sha256": "6641c972571e1728b36c58ceb4989b33f7e0a5510b53d2c23d0d970233a27f2b",
  "zh": "我的天啊……我的天啊……Glumph 。我就擔心會發生這種事。各位？照顧他一下好嗎？唉。這種時刻，我真的會懷疑（ question ）自己這份工作。"
 },
 {
  "id": 120,
  "src_sha256": "728aacff40e15e79f0de2629beb9301c9b83aaa8a1aaa7f5de0b8bc118ac9d6b",
  "zh": "很抱歉我們得在這種情況下見面，士兵們。我可聽說了不少你們的事。你們做得很出色，消息也傳開了。其實我原本要派你們去找 Glumph 的！這就說明了你們是怎樣的士兵——你們自己就辦到了。"
 },
 {
  "id": 121,
  "src_sha256": "ae31c293bab76f773967e42a55cd87025276fd0c435204ba17de158d70393f0c",
  "zh": "我只是很遺憾失去了這麼多人。這是會累積代價的，你們知道嗎？但這阻止不了我……也阻止不了你們，而我心裡正好有個任務。"
 },
 {
  "id": 122,
  "src_sha256": "0961ca58930e7b9762b2455206226fd990384bb68880880d3f9cfa6790f3166d",
  "zh": "Glumph ！我、我不敢相信！我們都以為你……以為你……失蹤了！那這幾位是誰？你們就是 Balbrak 簽下的那支隊伍吧？好，好。 Glumph ，你先去休個假（ R&R ）吧，等你好好休息過，我們再來聽取報告。"
 },
 {
  "id": 123,
  "src_sha256": "e326c8006405adbce5862fa28f9a5f0eec8d87231a1baa864b88af02ca1385df",
  "zh": "Glumph ！我、我不敢相信！我們都以為你……以為你……失蹤了！我得說，士兵們，你們把我的孩子帶回家，得到 IUF 永遠的感謝。你看起來累了， Glumph 。聽取報告前，先去休息一下吧？"
 },
 {
  "id": 124,
  "src_sha256": "aa50bf42daff55b7c13c652b8d58375d67f603869631723577857758735f13a5",
  "zh": "但我不質疑（ question ）你們……幹得好。這說明了你們是怎樣的士兵。我只是很遺憾失去了這麼多人。這是會累積代價的，你們知道嗎？但這阻止不了我……也阻止不了你們，而我心裡正好有個任務。"
 },
 {
  "id": 125,
  "src_sha256": "6e553c7cad5832f4f94b5f9b3f4a748f5b84864c234b560125fa5a4341f1bd50",
  "zh": "哈囉，士兵們。我還以為你們會繼續待在 Bayjin 呢，不是嗎？"
 },
 {
  "id": 126,
  "src_sha256": "b06797680f5de822d1b2dedb906c849a1f5e905ce28b57909283b9c0f1891341",
  "zh": "Glumph 的識別牌？噢，天啊。他死了嗎，士兵們？唔。對 IUF 來說，這是悲傷、悲傷的一天。我敬佩你們把這些帶回來給我們。至少他的家人能得到一點安慰。我知道這之後要繼續下去可能很難，各位，但戰爭（ war ）就是戰爭，我們浪費不起時間。我已經準備好你們的下一個任務……"
 },
 {
  "id": 127,
  "src_sha256": "03fcee0e46e1b3c5e399e0547acaed0a7db65915bcc6cf8cd3a8b7fbdd30a429",
  "zh": "這件事我怎麼講都不嫌清楚——這是所有任務中的任務。你們要直接殺進 Marten's Bluff 的 T'Rang 巢穴，而且這個任務極度機密！現在聽好了！ T'Rang 正在逼近我們，各位。我不想這麼說，但這是事實。我需要「你們」去處理。"
 },
 {
  "id": 128,
  "src_sha256": "4eecfdb99acfd419331cc85f65a0b84895739f29b812235363001f15ce839410",
  "zh": "他們之所以能逼近我們，純粹是人力的問題。我們每多一個新兵，他們就繁殖（ breed ）二十個！我們知道繁殖發生在他們的船 Nargisst 上。我們得阻止繁殖，不然……唉，我連想都不想去想。問題是這樣的……"
 },
 {
  "id": 129,
  "src_sha256": "60ff8b1a62fdc5c8b76223502cadd0559dc65de2fa22e7c1c9b169c54b8096d4",
  "zh": "我們不能摧毀那艘船。那鬼東西隱形了！不過……也許我們能在他們降落的地方打擊他們。他們有某種傳送器（ transporter ），要是我們能把它關掉，就有機會了！他們會被困在那艘該死的船上，我覺得再好不過！"
 },
 {
  "id": 130,
  "src_sha256": "213b4d7032e20c69c856ca93b45c18e5434f2b2d1bbd9e5cdcb081c1377a48cc",
  "zh": "斥候（ Recon ）在穿越那邊的保全時遇到一些麻煩，不過我想這個 EMP 也許能讓你們進去。去找到那個傳送器（ transporter ），各位。你們一定要辦到！"
 },
 {
  "id": 131,
  "src_sha256": "7b58389f577e8fc5a4f3d57dbd17e016b26343dadc25ea55d019171fb483586f",
  "zh": "Rodan ！我真說不出看到你有多高……什麼鬼？！？我還以為他們說你們帶著一個 T'Rang 是開玩笑！士兵！你離軍法審判只差一英寸！"
 },
 {
  "id": 132,
  "src_sha256": "bc17a97e6d0e4cf49086c53731087a399d9e54ad84574182ae2f164fad7c989a",
  "zh": "你們不能指望我相信這種事！這一定是 T'Rang 的某種詭計。我不知道你們是怎麼把 Rodan 扯進來的，但我不會容忍！我……"
 },
 {
  "id": 133,
  "src_sha256": "f7eaee2ffdc393611bdb311303ea98abe6315049ff7200a4639bf796d1c55755",
  "zh": "不，還沒……我在說什麼啊？！？ Rodan ，那是機密資訊！現在，我已經……"
 },
 {
  "id": 134,
  "src_sha256": "effeb9f1b58a12ffa2433a1147b4265bdc3e7ee3792849a518d6ed0a680073fa",
  "zh": "嗯。這個提議很有意思，而我……如果 T'Rang「也」接受，我就接受。我們之間這場戰爭（ war ）可以追溯到很久很久以前。 Yamo ，願他安息，曾說同盟要花好幾年才能締結，敵人只要幾分鐘就能造成。也許該是改變這一點的時候了。我抱持懷疑，但我願意試試。"
 },
 {
  "id": 135,
  "src_sha256": "8f6737cf204dc17fd92ec8a77faa26405093152eb11bb757dddb07a4e8711eb6",
  "zh": "我當然希望不會， Rodan 。要讓你們的領袖接受，就看你了， Drazic 。我會派這些士兵與你同行作為護衛。同盟若被接受，如果被接受的話，就回來找我。你們上路吧。我有很多事要想。"
 },
 {
  "id": 136,
  "src_sha256": "c91cabb36354e1d906f9882987636c830739ec636ef296258cc078140ba2be23",
  "zh": "T'Rang ，那個 T'RANG ，同意了？你們有證據嗎？"
 },
 {
  "id": 137,
  "src_sha256": "7464c06f438145ec938ca275e06583339fda74077ac15bf4a850ff707802babf",
  "zh": "嗯。我想相信這件事，但我怎麼能相信？我怎麼知道這不是 T'Rang 的某種詭計？"
 },
 {
  "id": 138,
  "src_sha256": "b12c2778ba42ff0e8d262d0f9dbfcd68604f9c5bac95c8f18455e3e9104f405a",
  "zh": "連 Z'Ant 都同意了……嗯，奇蹟真是層出不窮！好吧， Rodan ，我信任你……我「信任」 T'Rang 。這場戰爭（ war ）可以追溯到很久很久以前。 Yamo ，願他安息，曾說同盟要花好幾年才能締結，敵人只要幾分鐘就能造成。也許該是改變這一點的時候了。"
 },
 {
  "id": 139,
  "src_sha256": "7e2cc1314f586eda237571684e51eb66fa768bd36b714f1f8525bfd1114faa01",
  "zh": "我們的砲位在 Mt. Gigas 山頂，你們需要這個才能到達那裡。如果一切順利，我們就在 Ascension Peak 會合。祝你們好運，士兵們。未來就靠你們了。而你最好別讓我失望， Rodan ……"
 },
 {
  "id": 140,
  "src_sha256": "3d9a9ee82e36bc7c4c67998d1902e4993afb2f73e4f255564a97d5ac15858193",
  "zh": "Rodan 、 Drazic ……還有你們所有人。你們真的辦到了！我本來有所懷疑，但時代正在改變。敵人攜手合作，而 Dark Savant 終於消失了！！我們有證據證明他在那艘船上，對吧？"
 },
 {
  "id": 141,
  "src_sha256": "d84b194f76a5d33df21fef9288ccc1b868a6a7d6b775cfd56bdc86feafb6a873",
  "zh": "我相信你說得對， Drazic 。 Dark Savant 的行動無法預測，只有他想推翻 Cosmic Lords 的欲望例外。而那就是我們得打擊他的地方…… Ascension Peak ，通往 Cosmic Circle 的入口。"
 },
 {
  "id": 142,
  "src_sha256": "5ee649b12ddb4e3cf75d5d4e2ad0bf8535721d4654adf892e54404338bac54f1",
  "zh": "要做到這點，斥候（ Recon ）告訴我們需要三件裝置： Astral Dominae 、 Destinae Dominus 和 Chaos Moliri 。 IUF 已經要求你們太多了，但還有最後一個任務必須完成。"
 },
 {
  "id": 143,
  "src_sha256": "98b66806a4acd53d6891efd0c9836e625b80f57c3a1359e868f07f8bfe765a0f",
  "zh": "把那些裝置帶到 Ascension Peak ，我們會在那裡與你們會合。 Z'Ant 已經在路上了。 Rodan 、 Drazic ？你們留在這裡幫（ help ）我集結我們的部隊。出發吧，各位！我們時間不多了！"
 },
 {
  "id": 144,
  "src_sha256": "624f73b20763b5e61c74b7d0479970273244434498837fe25fe651237d7ecd74",
  "zh": "你們還在等什麼？！？那是直接命令！動起來！"
 },
 {
  "id": 145,
  "src_sha256": "89333c11ba9441433ddf29a06f3ef56c6b6be61517a3a725390f2369b6081164",
  "zh": "幹得好，幹得漂亮，各位！這對 IUF 是偉大的一天，對 T'Rang 則是糟糕的一天。嘿嘿！ T'Rang 再也不是我們戰役的威脅了。但我們還沒結束，差得遠呢！噢，沒有。這次？我要派你們去追 Dark Savant 。是時候讓他去死（ die ）了。"
 },
 {
  "id": 146,
  "src_sha256": "1b2736cbef4c055e1a48738ba637536d3d1b3697c5c85e13a9e14cdf463e4288",
  "zh": "他的行動無法預測，*只有*他想推翻 Cosmic Lords 的欲望例外。而那就是我們得打擊他的地方： Ascension Peak ，通往 Cosmic Circle 的入口。"
 },
 {
  "id": 147,
  "src_sha256": "5ee649b12ddb4e3cf75d5d4e2ad0bf8535721d4654adf892e54404338bac54f1",
  "zh": "要做到這點，斥候（ Recon ）告訴我們需要三件裝置： Astral Dominae 、 Destinae Dominus 和 Chaos Moliri 。 IUF 已經要求你們太多了，但還有最後一個任務必須完成。"
 },
 {
  "id": 148,
  "src_sha256": "c48aafe5bc7fa8e035d4ce23ed203d8573ac386bedb3112befa6e3c8d23ce48e",
  "zh": "把那些裝置帶到 Ascension Peak ，我會在那裡與你們會合。出發吧，各位！我們時間不多了！"
 },
 {
  "id": 149,
  "src_sha256": "be83b54cd38b749f1aa2f0aacc9d6e2165da241fdc95d35a88b6ed403ea4bb53",
  "zh": "拿到了嗎？ T'Rang 同意了嗎？"
 },
 {
  "id": 150,
  "src_sha256": "940d62789dc99d7a2fe8d0ec0313cd7106726a5a1eadaf7c4e9033e84ef9c70f",
  "zh": "滾出去，等拿到他的同意再回來！"
 },
 {
  "id": 151,
  "src_sha256": "56bae0cf2614c502a98a89d41801f2deebed9cfa3cc33fdbc9a259c7576906bd",
  "zh": "我不敢相信……他同意了！奇蹟真是層出不窮！讓我一下，把這東西讀完。嗯。上面說他把我們需要的追蹤裝置給了你們，而且我們得到他們的全力支持。我簡直不敢相信自己的眼睛！好吧……"
 },
 {
  "id": 152,
  "src_sha256": "8effd97ecade39351bb67150f4dfb8242ddfa10bfb28803734533e98bec23643",
  "zh": "我們的砲位在 Mt. Gigas 山頂，你們需要通行證才能到達那裡。如果一切順利，我們就在 Ascension Peak 會合。祝你們好運，士兵們。未來就靠你們了。而你最好別讓我失望， Rodan ……"
 },
 {
  "id": 153,
  "src_sha256": "0a0104f600c32aceb9d5771d25987515ea47f1b5c764ddc0197bdb23a9f92533",
  "zh": "各位，我欣賞你們的忠誠，但我不能容許你們辱罵其他士兵。現在，所有與 IUF 人員有關的申訴，都必須先向 Balbrak 提出，再由他進行完整調查。我建議你們依程序行事，以保持在我們這裡的良好身分。"
 },
 {
  "id": 154,
  "src_sha256": "d35c03ae7b17b8f74619880258cbf7bd43c6a9fdaf085f9fe68837e496c7025f",
  "zh": "Underwater Tactical Unit 。 IUF 裡受訓最精實的部隊。就在這，呃，一層樓。出門後跟著標示走。"
 },
 {
  "id": 155,
  "src_sha256": "f930e7231e24a8b1017d78008396c94024620c721742c14270330cf97bb2ba36",
  "zh": "好士兵……"
 },
 {
  "id": 156,
  "src_sha256": "2e32702e71f23da3f2900c9f56983b77fc9477df939bc6ffe32caa831f1f022f",
  "zh": "士兵們？以防你們搞混了，我給你們點提示（ help ）。你們的任務不在*這裡面*！可別讓我失望啊。"
 },
 {
  "id": 157,
  "src_sha256": "f1854b9afd7855f20594047fe2a89f9fc038818c811ab1d4ee0bca5e0ac75af2",
  "zh": "衛兵！！！！！"
 },
 {
  "id": 158,
  "src_sha256": "e91883ff142335ded45d47e401b4a4f065dc188f8a031760face1e0248bdcc61",
  "zh": "電磁脈衝裝置（ Electro-Magnetic Pulse Device ）。這些年我們蒐集了各式各樣的 T'Rang 裝備，我讓一名士兵把這玩意兒組起來。我估計它能讓他們的任何力場失效。"
 },
 {
  "id": 162,
  "src_sha256": "59c9c399f838d2e25a0df172db92ab196f3d42c02e4707060f2ad70e44bdfa15",
  "zh": "我就是這麼說的。"
 },
 {
  "id": 163,
  "src_sha256": "0cee142f17f0229d1ce9ab7530c7c5ee958806a309cc2a8f0d7b70238911b6ec",
  "zh": "在這裡的北邊。"
 },
 {
  "id": 164,
  "src_sha256": "76b748a20858aa15dcbf22e25e5873972e3a777c9dd61af272f78b404eac0fb6",
  "zh": "斥候（ Recon ）建議在南邊。"
 },
 {
  "id": 165,
  "src_sha256": "0a87248feae99621b708fb9e6de2140bca2054097ebc5a410d81461f6579ed57",
  "zh": "往東走，士兵們。"
 },
 {
  "id": 166,
  "src_sha256": "be8f095db91a35855ff8ac7c8e69dbf952f12dbdebd81be86fb336bdb0bdf535",
  "zh": "你們得往西走。"
 }
]

[
 {
  "id": 0,
  "src_sha256": "eaafb500de439a38d212219cd04699c4fa40a5fec5aed07ca19c1886e5e6ce82",
  "zh": "歡迎，各位 Templar 同袍。恭喜你們！你們現在是我們的一份子，一名 Templar Rapax 。所有的門都為你們敞開，我們的一切也是你們的。此盟約已成。"
 },
 {
  "id": 1,
  "src_sha256": "1b5d46179d18e0ecca3f2f771e3034122389cde4e593c32bd5f80538c2d0236c",
  "zh": "這裡已經沒有你們要做的事了， Templar 。"
 },
 {
  "id": 2,
  "src_sha256": "ac5839fdab948860e90ad562f0a19179c40ed85157ac964376c7e53b7b7b07e6",
  "zh": "這裡不是紛爭之地。立刻停止這場戰鬥！"
 },
 {
  "id": 3,
  "src_sha256": "4b373ec6be203dedeacb9fa2cc67086c1fb86243bdd1256393322e4ca52d3195",
  "zh": "你們以為你們是誰？！？"
 },
 {
  "id": 4,
  "src_sha256": "a7e4e7539fca1eeed83442fd77e6eb287ed0f8edcb235b7532a93bc081ad08a3",
  "zh": "你們本該聽話的， Templar ！"
 },
 {
  "id": 5,
  "src_sha256": "a9bf2b2f8bde480f43728deea6d4412b04bc59a5130e4c4a1aed06603c642477",
  "zh": "有三件事你們必須記住。第一，絕不可背叛同為 Rapax 的人。背叛我們，你們將被毀滅。第二？記住你們現在屬於我們……屬於她， Al-Sedexus 。任何時候你們有需要，都能在 Rift 找到她。"
 },
 {
  "id": 6,
  "src_sha256": "68845daee27f58cef0732b2725f284f0e815d9d73675d00808937d4e0e7ec4da",
  "zh": "待在她的城牆之內， Templar ，就不會有任何傷害降臨在你們身上。我無須多言……"
 }
]

[
 {
  "id": 1,
  "src_sha256": "9f6a2470974267e3f0f6a77502b8e22f324f4c9d910ea4e4d0a20dae9390889d",
  "zh": "我想你們最好對我客氣一點……"
 },
 {
  "id": 2,
  "src_sha256": "eec74f04e85d6c79dd73ef5458a0e95283ac41697b9bfd2522964a10649c8c83",
  "zh": "哎呀。我這裡在流血欸。"
 },
 {
  "id": 3,
  "src_sha256": "804dd7b2eae2535adeafe26989dc02a337878c34a1fffa8cc5460671f56ed6b9",
  "zh": "你們要是讓我死了，我就「再也」不幫你們做事了！"
 },
 {
  "id": 4,
  "src_sha256": "322c327b4249dc4efe5f6de9b53f72f47ab5386b1a0ec2fb3e3783b3fde8c7c4",
  "zh": "我累到連腦袋都轉不動了！"
 },
 {
  "id": 5,
  "src_sha256": "3b1fb4d19b025fda998bb3f893425c7d58ab795ec9ae72d4866eeaeb5293955a",
  "zh": "我好像染上什麼不得了的東西。"
 },
 {
  "id": 6,
  "src_sha256": "d14befe9f3b60559f8311440948f3438e1356ec71febcd73cb716ff966dd490d",
  "zh": "我現在狀況不太好……"
 },
 {
  "id": 7,
  "src_sha256": "099c1adb9e5d5e7785fcd9309d6a2603e65d25037ef16b2b113c401f584a8816",
  "zh": "瞎眼的小偷？我的職業生涯啊！"
 },
 {
  "id": 8,
  "src_sha256": "cdfa10705c191e840a0a779a2670428d6c013b1a9372b729cc3d39073f0ec0c1",
  "zh": "我身上帶的東西要是都歸我，儘管往我身上堆。"
 },
 {
  "id": 9,
  "src_sha256": "bfd9d3cd44e978929c4ba5c9d333a5140452cd8d03d6183e4af57c092c2a3e10",
  "zh": "我的手！我的腿！誰把我搬走啊！"
 },
 {
  "id": 10,
  "src_sha256": "e603cdf69ed4eb84adb71bd306c5400d64c0deb2468e318a9202465243682d11",
  "zh": "我正要說這句！"
 },
 {
  "id": 11,
  "src_sha256": "83cddb26e60fa6e15fa3a20318e91a128361a3261a6dee90146123c875a650f0",
  "zh": "其實也沒什麼啦。你們多塞我一點錢，我們就當它是危險津貼。"
 },
 {
  "id": 12,
  "src_sha256": "db58ca1d960abd864b83decf9c73ab9098ee92a003a3bdcabc785e629b39bfa9",
  "zh": "我想搞懂一件事。你們讓我死了！你們幹嘛這樣？！"
 },
 {
  "id": 13,
  "src_sha256": "65e40d6096490a7a6132588f48b5ef67515a481cd11f1b6358d5a38dbff7b4b4",
  "zh": "噢……這題難！要說安慰的話，我還沒遇過騙不過去的難題。"
 },
 {
  "id": 14,
  "src_sha256": "1532350792a44f22871922219087fef9d4610e30c35ea2a2eaeb1ff80ace43e8",
  "zh": "你們知道嗎，Dominus 上埋了一大堆寶藏。我最清楚了，有一半是我埋的！"
 },
 {
  "id": 15,
  "src_sha256": "8bb85828b2961fff2fc5b957574046d31adf24bec53756beb9d6fccac2039991",
  "zh": "我記得有一次我走進 Arnika 的銀行……"
 },
 {
  "id": 16,
  "src_sha256": "6237e82164671a74438d81352c05d80574cf0eb6d56aae6a359480f1331faf65",
  "zh": "噢！抱歉啦。沒有冒犯的意思，對吧？"
 },
 {
  "id": 17,
  "src_sha256": "481ee7d6391ef2a891ac57ff57a5dc78c83b051b4284adee71bbaa540e103955",
  "zh": "喂！你們差點用那個把我弄死！"
 },
 {
  "id": 18,
  "src_sha256": "6370c461a867b38f8fe53bdde3a4775c648c6dba01008a3082a1e502157b5509",
  "zh": "希望他有買意外肢解險。"
 },
 {
  "id": 19,
  "src_sha256": "964c0f4d9a9caf89329dc7bb17cd582a7edb5f1e66455990f627cf4ffce89722",
  "zh": "她交代過，萬一她死了，東西就由我保管。多貼心的女孩啊。"
 },
 {
  "id": 20,
  "src_sha256": "4c33e0db5d3f8003f2ef1c624034b121d7d6376e99e5d49f6c61e656f2a0b128",
  "zh": "噢，那真可惜。幸好我認識她的親戚。我會、呃，把遺物送回給他們。這是我最起碼該做的。"
 },
 {
  "id": 21,
  "src_sha256": "1cdf3ddb718876b8d774c44c7b1c46d916daac2e4b6c880546e0bc714a019fef",
  "zh": "看來我是跟了一群貨真價實的外行人。"
 },
 {
  "id": 22,
  "src_sha256": "a67b5398523a13602806cb499d7674d7534f04ddc36d6b92904bfec7f47bd180",
  "zh": "不知道我有沒有足夠的空間裝他們所有的東西。真是大豐收！"
 },
 {
  "id": 23,
  "src_sha256": "98fa84a836edc323cc7cafdd1bdad447f6210c7156da602d995b346e5e4935ed",
  "zh": "喂！這裡有東西。"
 },
 {
  "id": 24,
  "src_sha256": "6d1ceab7e260dee58f2a941d1f81b001ff3d6922d9fed03ca0fe8149e3aa798b",
  "zh": "撿到就是我的！"
 },
 {
  "id": 25,
  "src_sha256": "f791502e15ee739c8aa3d41bd674a647b17e36a92e064f57e826b79187f97288",
  "zh": "這裡有陷阱。"
 },
 {
  "id": 26,
  "src_sha256": "3c65bc18fd51663964cb99d315066813737865e6b8a2c14f2c23f4e670c678c0",
  "zh": "這裡藏了東西。"
 },
 {
  "id": 27,
  "src_sha256": "cbe76c917c9727ffe47bfb14011ea4d1be1d89b41aaf6d5fc25630288fdb9573",
  "zh": "我們「非」來這裡不可嗎？這地方讓我很緊張。"
 },
 {
  "id": 28,
  "src_sha256": "003b011fc0b945222a884a5ffd2551b57f2419c307fb0ef28c4f77dcf3f49183",
  "zh": "我得想辦法處理一下這些傷……"
 },
 {
  "id": 29,
  "src_sha256": "7e35a52a5798fa66e68e321e2616feac036b9dc38be14347430738a12a229466",
  "zh": "我已經準備好對付這些傢伙了！"
 },
 {
  "id": 30,
  "src_sha256": "87b65fd8f3075da8be859ea04accf8c579a896a38dd500753eb115eb8e059efb",
  "zh": "開打了！我跟你們一起！"
 },
 {
  "id": 31,
  "src_sha256": "4744a2f1af8253ce2c4b22ce6f6fa5dd0c09a6972edd39f87b867b5b62825f5d",
  "zh": "好大一場架。我會、呃，在後面支援你們，好吧？"
 },
 {
  "id": 32,
  "src_sha256": "d47948588c9f3fc37affb49e0fb5a2c4b3c69591a801e82f39f88f3f571481d5",
  "zh": "我該打誰？"
 },
 {
  "id": 33,
  "src_sha256": "c6618b98896e6246a8e9fbcee8f30a76eb1264a8870af5d021a1ec22618360cd",
  "zh": "我從沒見過這麼多這種東西！"
 },
 {
  "id": 34,
  "src_sha256": "f38ca15570caa057a2fc83079102d1332228a25fa94a1fd595f0082a6665223c",
  "zh": "擦到我了！"
 },
 {
  "id": 35,
  "src_sha256": "867db2bbbc37f3920f95b9724a4555ae642e942ebcbc473c50c897dc4b897a61",
  "zh": "我去看看他們有沒有掉什麼東西。"
 },
 {
  "id": 37,
  "src_sha256": "6bc04969365477be029faac9753219ac7bb42492b5cc9c15d8c83d479cb4c315",
  "zh": "你們看到了嗎！？這應該值點錢吧！是我殺的！"
 },
 {
  "id": 38,
  "src_sha256": "e000eead5c7313b0a775f73054c9290efb4959da9c945b809de552ae64cb1237",
  "zh": "我好像認得他們……"
 },
 {
  "id": 39,
  "src_sha256": "5cbbde3428c4c1cb90a6a4dfb37f5d2c53e5ff960340f0f2df7db078d39d1730",
  "zh": "喂！把彈藥遞過來！"
 },
 {
  "id": 40,
  "src_sha256": "03f15f8bf2da69ae8e8d86efc072c2c9ea39272593e3ca640a2d5dd5d9394749",
  "zh": "聽好，我要你們知道這事跟我完全沒關係，不過，呃，有人不見了！"
 },
 {
  "id": 43,
  "src_sha256": "3380863b7a5d8fa5e94c63c70c48d7a4c5602c62ca846b18158a77af245cd950",
  "zh": "這麼說吧，這比我在牢裡拿到的好多了！可以再來一次嗎？"
 },
 {
  "id": 44,
  "src_sha256": "7f250a2a075ad66e695c0d6cb6fec6c07abb384d505008746327edfd4efb8552",
  "zh": "喂，我得跟你們談一下。你們看，我忘了講那個 Rapax 女人在我離開時對我說的話。好像是說我絕對活不著離開 Rift？我覺得她說得對。我走得越遠就越難受，我想它會要我的命……除非你們幫我殺了她。你們說呢？"
 },
 {
  "id": 45,
  "src_sha256": "664dcd62a60c766ed0b628f0684017bdaccb24417ed385f79071bd4a8cacceba",
  "zh": "好！她就在這附近某處！我們會找到她，而且我「發誓」再也不會害我們惹上麻煩了。"
 },
 {
  "id": 46,
  "src_sha256": "d2a21d4534c87b59c61d978e50be83ee27dbc17d4524541bc01f3274b6e764f8",
  "zh": "這是什麼？看起來挺有意思的。要是把它熔掉，大概能換我們 10 個金幣。"
 },
 {
  "id": 47,
  "src_sha256": "1d67fdb8d053dc43aa191082f60c4880bc731497942357b968df6c6beb39fa4b",
  "zh": "Destinae Dominus？！你們知道這東西值多少嗎？半個星球的人都在找它！聽著，交易讓我來談。我能幫我們談到「高價」。你們確實是想賣掉它，對吧？"
 },
 {
  "id": 48,
  "src_sha256": "24c506e20f93918b622708fb9345c5636837d09838b669f5f821f1402aa7af35",
  "zh": "東西幫你們弄到手了，但別指望我殺出一條血路逃出去。要是 Mook 發現是我順手牽羊拿走的，我就慘了。"
 },
 {
  "id": 49,
  "src_sha256": "8d88a9d90e98da68d941dcaa7b63c72a7d422ee8a40362b1092a39b94fea5da6",
  "zh": "這看起來超像 Destinae Dominus。我敢說會有人有興趣買……"
 },
 {
  "id": 53,
  "src_sha256": "49d277ec83b68c518a0e4256d24b210cfde8e07af6f39e8a3a09d809592d0e99",
  "zh": "那根本不可能。"
 },
 {
  "id": 54,
  "src_sha256": "3a06787e748c4f61a75072ba8259956ac09a0f1cbfd7b91d9133194ae9b27bc6",
  "zh": "別告訴我你們真的相信了！"
 },
 {
  "id": 55,
  "src_sha256": "a0308deb848d291cee993494fedb18f73d621a8bb0fcf25d4c22e74d5958edf0",
  "zh": "它是「我的」！我光明正大弄到手的，我要留著！"
 },
 {
  "id": 56,
  "src_sha256": "4c2af911a123fa1b2ed1c2119c10e51d9c63d0bc40a907c8aabac25dbbf948a3",
  "zh": "我就愛這樣！"
 },
 {
  "id": 57,
  "src_sha256": "a76dc4d6918013efd6b000bce3a7b918f9b9fe58f901e4a336e1adf7b2ff3850",
  "zh": "喂。那不是 Vi 嗎？"
 },
 {
  "id": 58,
  "src_sha256": "b1f104b812037620b644ae62bf7bd660c9f7af4096099d4a7f397b8c7c75210a",
  "zh": "我覺得現在沒人了。"
 },
 {
  "id": 60,
  "src_sha256": "011073236eee78b160fca9bb5e3b897ed36bbbb7ae8b9b20115c437a3119b17b",
  "zh": "希望別再碰到他！等一下……他好像掉了什麼東西。"
 },
 {
  "id": 61,
  "src_sha256": "091fb5835f716909cdad532b6a2402045771422839f752d6aabfbdf7a6a00c00",
  "zh": "依我的經驗，對方越大隻，我就越需要把他拉到我這邊。"
 },
 {
  "id": 62,
  "src_sha256": "65f5202c7018b38275fc9522d90617c3e156b456c885a22a2d08ad13922b48a8",
  "zh": "喂！完美一擊！那個鐵皮腦袋這會兒應該正好好欣賞這顆星球的風景吧，嗯？"
 },
 {
  "id": 65,
  "src_sha256": "27cc47e3d9989e08bfdbebb6ec4c202af9147f91ffa3294e3036e7e8bf83cbe8",
  "zh": "我們辦到了！我最好能分到一份報酬……"
 },
 {
  "id": 66,
  "src_sha256": "c22ffacf6eb90c5a34aab55fcae05889dff1409daf5e1c127028932782492d6e",
  "zh": "我在想這是什麼東西？跟我看過的 Destinae Dominus 圖片簡直一模一樣。說真的，我敢說你們可以拿這東西騙到人。"
 },
 {
  "id": 67,
  "src_sha256": "8b67ae036cbed2f38f2cb7b4b46b7995066ff7ed32ca709165bfff780a25d62f",
  "zh": "喂！這邊有東西跑出來了。"
 },
 {
  "id": 68,
  "src_sha256": "4d495293216cddc1d4d7fe5583a8c14254b532311cd493d559e008eb9fb02618",
  "zh": "前面有壞消息！"
 },
 {
  "id": 69,
  "src_sha256": "f70408c30e3e7a3dfb6dc95ed3362631a76ae539ab685943a831fb15eb923a2b",
  "zh": "嗯，大致上來說，滿愉快的。以後再來找我啊，好嗎？我手上總有活兒，說不定可以讓你們分一杯羹。"
 },
 {
  "id": 70,
  "src_sha256": "856a07713509caeea4e2c8aaf6fe4dc7a699ff792a0783c5882656b38c028683",
  "zh": "你們大概對 Arnika 瞭若指掌，不過讓我補充幾個細節。拿那座塔來說吧。進不去……這是我的專業意見。不過自從那座塔出現後，我大部分的 Higardi 同胞都跑了，而且他們留下了「一大堆」東西！"
 },
 {
  "id": 71,
  "src_sha256": "769d56658374292eb481c66565cc609813a356f214b6bd7d02189bd970cfc5a0",
  "zh": "你們知道這地方嗎？Trynton。Trynnie 住在這裡。順手牽羊的功夫不算差，不過腦袋嘛……他們上面有點不太靈光，你們懂我意思吧。不過我跟你們說，聽說這些小傢伙對 Marten 略知一二。"
 },
 {
  "id": 72,
  "src_sha256": "320e41d16c1b204edb378ae29b04691b0d98f0fd70b0f552f450f0c0822492ee",
  "zh": "你們當然知道，這條路通往 Marten's Bluff 。我不去。不。不要。絕對不要。嘿！關於那地方我聽得太多了，不敢拿「我的」命去冒險。你們去吧。我們晚點再會合。"
 },
 {
  "id": 73,
  "src_sha256": "3639ef259c66c8619ee1cda18d74a602953b8555022522eeeaeb9d151e745f17",
  "zh": "Sea Caves……如果傳聞說 Marten 在裡面是真的，那麼傳聞說這裡有一堆鬼魂，可能「也」是真的。"
 },
 {
  "id": 74,
  "src_sha256": "947b3df9e381db96928b1fc5c83baa624c3d7d2c72a58468c1fa6dd6aae6f5d2",
  "zh": "嘿，聽著各位。我剛想起來，我有個、呃，跟幾個夥伴的生意會議。我得晚點再跟上你們，好嗎？"
 },
 {
  "id": 75,
  "src_sha256": "b6469a0edff8231cba2927351f843696cae63ddb612c1e4a8b0a8fb6eec9da1f",
  "zh": "我不覺得我們該進來這裡。我剛出道做生意的時候，有人告訴我，送進 Rift 的東西都會死在 Rift，所以我才會這麼久都盡量離 Rapax 遠遠的。所以，在這裡面做什麼都小心點。"
 },
 {
  "id": 76,
  "src_sha256": "146862ec849297cef49bd8752740611268d127513e5300f30b84496ed4d89b90",
  "zh": "既然都來了，不妨順手撈……呃，我是說，四處看看。"
 },
 {
  "id": 77,
  "src_sha256": "947b3df9e381db96928b1fc5c83baa624c3d7d2c72a58468c1fa6dd6aae6f5d2",
  "zh": "嘿，聽著各位。我剛想起來，我有個、呃，跟幾個夥伴的生意會議。我得晚點再跟上你們，好嗎？"
 },
 {
  "id": 78,
  "src_sha256": "9f022711583f74c979ffccd81f1116c3b11c1879f7be6462749193f7ca69dc3d",
  "zh": "Ascension Peak 啊？你們先走。沒有針對誰。我已經看過一千遍了。你們知道的，去過了，做過了，連紀念胸甲都拿了。"
 },
 {
  "id": 80,
  "src_sha256": "9adf787fabcacfaa5c2b259ff40e42a2170a92f10cccc6cf1a553c931019d183",
  "zh": "你們有聽說 Crock 的消息嗎？他大概有一千歲了。以前他三不五時會發工作給我這種人。不知道他還有沒有在做這行，不過我們可以試試看。"
 },
 {
  "id": 81,
  "src_sha256": "4b6fc254d757c4d4420f7525d5c83be2f7b8369427225b52b8a2af1c80d526bf",
  "zh": "等一下！我對這地方有種不好的預感。我不是針對你們，但前面你們自己去探索吧！我回 Arnika 等你們。"
 },
 {
  "id": 82,
  "src_sha256": "947b3df9e381db96928b1fc5c83baa624c3d7d2c72a58468c1fa6dd6aae6f5d2",
  "zh": "嘿，聽著各位。我剛想起來，我有個、呃，跟幾個夥伴的生意會議。我得晚點再跟上你們，好嗎？"
 },
 {
  "id": 83,
  "src_sha256": "cdddfad048748fbeeed9cb5eb8801cb4ade1cd7a9a828154bafc964066e8a300",
  "zh": "我才不要！是你們帶我來的。你們帶我出去！"
 },
 {
  "id": 84,
  "src_sha256": "63caa711964a122c55e5b0f4e2a168df1495d311a28aa013507b55898d20ffb8",
  "zh": "我在康復中，不過還是覺得整個人病懨懨的，差不多像在地下十呎。"
 },
 {
  "id": 85,
  "src_sha256": "47606f4061f908253ee93583843dc267eeb1f8d9ffeac80bc93cdf189f7122ae",
  "zh": "我想我撐過去了。感覺好多了。"
 },
 {
  "id": 86,
  "src_sha256": "4c0f8ebb7fa5da9663d24591fd626f29cd7abc2073499c27e2bbf00f616ae540",
  "zh": "我在哪？我一點都不喜歡這地方。我現在就要離開這裡！"
 },
 {
  "id": 87,
  "src_sha256": "1025a086903ec0a42782c03e7b880750a65d1917fc599065339d6bfa84e8fea2",
  "zh": "我當初為什麼會答應跟你們這群人走？"
 },
 {
  "id": 88,
  "src_sha256": "bd8601a42ebe791b9d5be389f1076ebb0ca62170b53c56b6bc9d197d072c5d31",
  "zh": "我要警告我所有的朋友離你們遠一點……"
 },
 {
  "id": 91,
  "src_sha256": "5ca5906ae4233790173457e3c8abfe9af4d8876b02627bf94bede3a5fd1db5d3",
  "zh": "那我們出發吧！"
 },
 {
  "id": 92,
  "src_sha256": "5bdea6bb34e08addc90f003d9eec60f517df28c07b66d99298466b12a482dfc8",
  "zh": "就像我說的，我猜他們就在墜毀地點附近。我們去抓她吧！"
 },
 {
  "id": 93,
  "src_sha256": "12555ab9e685c5cacbffd05f497916f2bb6e18064e9dbdc946d5b37eeeab7f5a",
  "zh": "我就知道你們會找我一起去。他們是我以前的同事。我是說，他們偷走鑽石我沒意見，但他們不打算分贓我就有意見了！我們去把它拿回來！"
 },
 {
  "id": 94,
  "src_sha256": "94c5e748aa4e131abebfaf79c23f665a965a0f561b56ddb08f7c85c65cc3c41a",
  "zh": "我們還等什麼！離開這裡吧！"
 },
 {
  "id": 95,
  "src_sha256": "eec6f1bac8457c23c187b3f21962b8c644a28b03c18393dabb07a0811bec712f",
  "zh": "好吧，那我們去監獄看看能不能找到那條地道……"
 },
 {
  "id": 98,
  "src_sha256": "2ff67a36b42ef91ab4b283bc20a8e08d80e661df72940c3f2c43a7f29b5e3e38",
  "zh": "我還以為這趟會有更多好處。嗯。就帶她去她想去的地方吧。有時候你們得等報酬上門，你們懂我的意思。"
 },
 {
  "id": 109,
  "src_sha256": "7b4667beb86d490f734e8f7f238c626b7d0a12fd4a976194a26cce79f43c671f",
  "zh": "喂！手拿開！"
 },
 {
  "id": 114,
  "src_sha256": "7fc57394b73036938864ff6246c46489a22df9f1458bc79c435c4e5e73c373a8",
  "zh": "聽著，我已經說過我不去那裡。"
 },
 {
  "id": 115,
  "src_sha256": "cfa9d099279ad3a06529f5b9bbad687c4c1260a128279ac8cfc85e37b47a2272",
  "zh": "等等，He'li！我可以解釋一切。其實不是我。只是……"
 },
 {
  "id": 116,
  "src_sha256": "7fceec8daddb377d589024085a738cf6299ea1e50a1fee0c00ea23b6ee47b465",
  "zh": "He'li，我的愛人。"
 },
 {
  "id": 117,
  "src_sha256": "df76e0a460bcf2402bfc6a3aa800ada517273d44958e6305097313d4b0ac566b",
  "zh": "矮得可以，不是嗎？"
 },
 {
  "id": 118,
  "src_sha256": "60e411dd7a4081b460a1a06d7b498a64ebab039de0af8a736575bdd0dbaf28a9",
  "zh": "你們知道嗎，他身上有種東西讓我直覺地產生共鳴。"
 },
 {
  "id": 119,
  "src_sha256": "3c71f344ea6a01df4d6b03979cbfb2330f029e6ce515fa2a444c9bc006dfab5f",
  "zh": "他老家那邊都長得很高，對吧？"
 },
 {
  "id": 120,
  "src_sha256": "aeba8eb9d04b43617c63559d04a4d98cb530e7f7a2dea7759e8cfd975a6bf15a",
  "zh": "不知道動這個會發生什麼事……"
 },
 {
  "id": 121,
  "src_sha256": "b5e798934a5e61fd4b210fb2c42e9c8b449f9d22c86804d660966febc22caad3",
  "zh": "看來老 Al-Sedexus 和我不會有第二次約會了！謝天謝地！"
 },
 {
  "id": 122,
  "src_sha256": "7b80407c8c8c393132f6d6aa793385afba8e66ffd604194e4ffa302549039432",
  "zh": "你們知道嗎？我以前聽說過這個頭盔的事。我來拿著，確保它不會有事。等我們、呃，賣掉它什麼的時候。"
 }
]

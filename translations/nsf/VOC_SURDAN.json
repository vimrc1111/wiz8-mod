[
 {
  "id": 0,
  "src_sha256": "92c16ce02f92e8c25174d22400d5384a439d9079975c324434c9d432987c374e",
  "zh": "我認得你們……我追蹤過你們一次。在 Arnika 附近！我穿過樹林跟著你們，當然，你們沒看見我。真奇怪，會在這裡再見到你們，偏偏是 Al-Sedexus 的神殿（ Temple ）。你們很勇敢，確實勇敢。"
 },
 {
  "id": 2,
  "src_sha256": "8f07e59bf26c20d68952eb2147eb30973a38dcd91b8c354a113d129bab042355",
  "zh": "不容許在神殿裡打鬥！"
 },
 {
  "id": 3,
  "src_sha256": "f126444f0706587d17a9ffb1b648a6bf480ea15936d185ccad205f625cdb311d",
  "zh": "我第一次見到你們時就該殺了你們！"
 },
 {
  "id": 4,
  "src_sha256": "ed1aac689fcae64ef2e5974f25c8128d88d698f77067934aa5fc2e39ee1e9415",
  "zh": "你們真是愚蠢！我要屠殺你們！"
 },
 {
  "id": 5,
  "src_sha256": "663ebd5aea78788ab8e9766a431f2d4587e91e90d1ceabecf76d73c4adcae56f",
  "zh": "你們是來成為入門者（ Initiates ）的嗎？"
 },
 {
  "id": 6,
  "src_sha256": "d81fc9262e36014e508696aaa5d6a7101d3031c236de830c5e322d35cf66de5e",
  "zh": "那麼，進來吧。 Al-Adryian 會接見你們，並說明入門儀式。他就在神殿裡面。"
 },
 {
  "id": 7,
  "src_sha256": "5b6875fa6e75e40f9d9056da03cdc6c8d1c4f89896d1e569fcc14e89c8856421",
  "zh": "那麼你們在我們的 Castle 裡肯定會覺得相當難熬……如果你們還能活下來的話。"
 },
 {
  "id": 8,
  "src_sha256": "567bc06dcf6bd8f097586fcc33bb78ab2ad55634bcf7f61b9316dfbd8910b82c",
  "zh": "照你們被吩咐的去做，入門者們（ Initiates ）。"
 }
]
[
 {
  "id": 0,
  "src_sha256": "652fd213cc405ca2b7c569f84b400a4d2fbc72951b8598c6d7602e636f1d3370",
  "zh": "不過有件事得先處理，老大，就是 Rapax King 和 Prince！不幹掉他們，他們就會追著我們跑，我們的任務就毀了。走，去找他們。我拳頭正癢，要替他們做點腦部手術。"
 },
 {
  "id": 1,
  "src_sha256": "f157dbc2b37dd74c7a379d251170e2fad82ca843e6e488309f78f18d80e9fbdf",
  "zh": "偉大的 Urrhina 神對 Rodan 微笑！"
 },
 {
  "id": 2,
  "src_sha256": "5c22e56321de4894ef7839f1b94141e2ba4c5f988cf0c2495ab70105deccd508",
  "zh": "給我治療！這是命令！"
 },
 {
  "id": 3,
  "src_sha256": "f11308462bed2559c3b6b0204474c9566b57069710a8d364afd59fde6aaaa070",
  "zh": "老大！別讓我死！"
 },
 {
  "id": 4,
  "src_sha256": "46a995b0741ec0ae8e72d4fbf96473af86148077684ac374afbf166f6006b80b",
  "zh": "好吧，我們休息一下。不是每個人都像我這麼耐操。"
 },
 {
  "id": 5,
  "src_sha256": "54600ef3dd99483f180e8ee99e51f6dfad67da2bfeea0a04490865e2eb98a038",
  "zh": "天哪，老大，這下我傷得不輕！"
 },
 {
  "id": 6,
  "src_sha256": "7cddb3305b1dedb7099516b51f6017bb582895e16da530024e2a0ecebeaac3b4",
  "zh": "糟了。我看這下可能會要命。"
 },
 {
  "id": 7,
  "src_sha256": "2d989c90c1af8b993e152cdf16dd82c8536c8f014c7c7eeec15d26ef7c66be0a",
  "zh": "我看不見了！"
 },
 {
  "id": 8,
  "src_sha256": "30b9b58522da22051a2c18c63c64f803eabca5c94b8c1a2f3125557fa02aca86",
  "zh": "你們有看到我胸口寫著「貨物」嗎？嘖！我只能二選一：好好打仗，或是扛這堆破爛！你們選哪個，老大？！"
 },
 {
  "id": 9,
  "src_sha256": "c0b6be8b6e947f253dde14fa443b41b1794b8f24a809e01810c8865364514a2a",
  "zh": "你們把我弄麻痺了！"
 },
 {
  "id": 10,
  "src_sha256": "3fff0152baeef1e5c9e7dac1d2ecee4e7a821a1b517532467278026acbdad2b8",
  "zh": "等等，我也是！"
 },
 {
  "id": 11,
  "src_sha256": "1f9ae460360bffe60c5aac1f24664d85baafefea0cbbdc91a25f31997d7a37ae",
  "zh": "最好是意外！要不是我一心要完成這項任務，我早把你們全踩進地裡了！"
 },
 {
  "id": 12,
  "src_sha256": "fee9bea8039b61446585aca39d0fd35826234e61ee7d5141e6bfbbdf8a6e7c45",
  "zh": "你們這些蠢、小、只會在星球上亂跑的廢物！你們該謝天謝地我還活著！"
 },
 {
  "id": 13,
  "src_sha256": "8b263652a3b854d107e9e3cb1718148d93c1c7fe66174695e33f65b0664e1982",
  "zh": "公道何在！你們搞行動還真是一團亂！"
 },
 {
  "id": 14,
  "src_sha256": "260ed2f8f59bb8a317324aa293b60e3a11bb2d00a4b75be223fee5e258fd7e02",
  "zh": "走啦，老大！我下過直接命令了，你們卻站在這裡嘰嘰喳喳，好像在開什麼派對！"
 },
 {
  "id": 15,
  "src_sha256": "7451cbf3313ac917695343854ba583c665d86d6da7f0ba723681d89c5b0f64f3",
  "zh": "動起來！這是直接命令！"
 },
 {
  "id": 16,
  "src_sha256": "bbad022e2d25ede1331e1bca412d38b57e94050989ec58391eed4dfa0f2b3703",
  "zh": "噢！我發誓這種事不常發生，老大。"
 },
 {
  "id": 17,
  "src_sha256": "22d292797a2b927c5ab8554d6541be9a2569aa71a9182c1855760f03ade3af1f",
  "zh": "哇！你們想在這裡殺了我嗎？！"
 },
 {
  "id": 18,
  "src_sha256": "f7bef6a0d77f314de8dbbb015dd544bd421720d990567d3fcbc6b3314c67f012",
  "zh": "看著朋友死去很難受。我們盡全力救他！"
 },
 {
  "id": 19,
  "src_sha256": "081fa45c6e4cbcd08a063d8a265a5e16044a41c36c17ecafef114d145de6fbb6",
  "zh": "能救就別讓她走。"
 },
 {
  "id": 20,
  "src_sha256": "c4dec9f17ab321330f23f96708051dd528effe48f5f7f8d170c3610c8c3dbf1a",
  "zh": "你們在幹什麼，老大！？！你們讓 Drazic 死了！！！我要是想讓他死，早就動手殺了他！噢，公道何在，你們這些蠢貨！現在立刻給我想辦法補救！！！"
 },
 {
  "id": 21,
  "src_sha256": "eca884e2e7ef786182538f2cbd49a90e5065e4a9463d528389db65889eef26a5",
  "zh": "你們真該長厚一點的皮，老大……"
 },
 {
  "id": 22,
  "src_sha256": "9c1c7728c84f33ed2db1bf2f428263d3e706c4f9a02127c4b86a8dbe6962f0bb",
  "zh": "看看這個！噢，偉大的 Urrhina 神！乾脆殺了我吧。現在就殺了我！！我怎麼會以為這能成功，真是想不通……"
 },
 {
  "id": 23,
  "src_sha256": "6ee1d005e867da97839fdddb5833aeab64fbce73532ba57a11ff4ac37c264ba2",
  "zh": "把那些裝備撿起來！"
 },
 {
  "id": 24,
  "src_sha256": "43ce75cac13c14f27be46c7a1231521f7a68c6bac71c73cda4e6c6637003ed0d",
  "zh": "發現裝備！"
 },
 {
  "id": 25,
  "src_sha256": "505141018a0929a3fa2c728657ad1eadaf6594bb283b8c1dc3eac9dd2f7d7654",
  "zh": "我看到有陷阱，一碰就炸！"
 },
 {
  "id": 26,
  "src_sha256": "64486c2b5c5fdddbd33e40b4902ed7eab5c3ca2286227fa4a008259532e0a986",
  "zh": "這裡有東西躲著！"
 },
 {
  "id": 27,
  "src_sha256": "5fc1aad76a9ac2e294f90019ba9126c930eac0cc482dbcfa591c6a142fe2706c",
  "zh": "我的直覺可是最準的，我感覺到這裡有危險。"
 },
 {
  "id": 28,
  "src_sha256": "37dc7455b55c01b2b15bd0999646b0716ecd8849d232a412c8bc01ab7fd8a67b",
  "zh": "我狀況不太好，老大！"
 },
 {
  "id": 29,
  "src_sha256": "59f82ea8fa446dff8a040aee3479b402fea18c86fb7d8a13393c55103aebb742",
  "zh": "這場仗馬上就要結束了！"
 },
 {
  "id": 30,
  "src_sha256": "18a9783554a1bb051a69d517ff33e2422a56ca57f435046fd0d57e8d21564e47",
  "zh": "開打了！他們沒有半點機會！"
 },
 {
  "id": 31,
  "src_sha256": "84dabb1f68bd664f349423a1f7386b3f45e44e8046cc42f6c5ac277aa77e0150",
  "zh": "最好繃緊神經，老大！這些傢伙很難纏！"
 },
 {
  "id": 32,
  "src_sha256": "31f21ec8b24e129aad018262b111554f1b4dd69953bab015ccceb70e4e82502c",
  "zh": "沒有目標，老大！"
 },
 {
  "id": 33,
  "src_sha256": "c475023f65db212a7167f2b2dff6e3ffe6d26e8a555684ef0dde3386289c2904",
  "zh": "我們被入侵了，老大！情況不妙！"
 },
 {
  "id": 34,
  "src_sha256": "6367e9e18408f230642afbdc5f16a4f2f2ab868a5772caaa26956737cd599227",
  "zh": "沒人可以靠 Rodan 那麼近！"
 },
 {
  "id": 35,
  "src_sha256": "cdc6b8d582d6a5d29797972a2e086393782068d837f812a21254ff54147543fd",
  "zh": "幹得好，士兵們！"
 },
 {
  "id": 37,
  "src_sha256": "08d89343e9efe8e17f62551ac368cecde740cc10f3695d8ee2cf453d7bf83acb",
  "zh": "哇，老大！感謝 Uhrinna，我們終於擺脫那堆骨頭了！"
 },
 {
  "id": 38,
  "src_sha256": "e839c82255a3267b8ee73ba513ebbbfbe504fc37bedbc59d7bc72551012859f7",
  "zh": "讓我來說話就好……"
 },
 {
  "id": 39,
  "src_sha256": "fe248a7ada7ef793682bb28d455bec2a0f3943de94d3d1625ba0112d3c783e76",
  "zh": "給我補滿彈藥！"
 },
 {
  "id": 40,
  "src_sha256": "0a907fe6e079b2ffa649b553578d94dcf590b6704bded5488f9750cb9e9b8dfc",
  "zh": "讓我來處理！如果有人不見了，不管你們怎麼想，我都不在乎……這可能是間諜幹的！偉大的 Urrhina 神，別讓我們的任務失敗！"
 },
 {
  "id": 43,
  "src_sha256": "94aa248e87ab44518deb93936f7f108c241168136c7fe039731ca3a22bb92a79",
  "zh": "你們腦袋壞了嗎！我們有重要的任務要完成！先是你們把我們拖進這裡，現在還要我們幫你們？你們一定是瘋了！任務結束後你們愛怎樣就怎樣！這是命令！"
 },
 {
  "id": 46,
  "src_sha256": "4c1305d6c1a5a337a8c95439c8f3fa4bc9a49dd62363f52803f062211136788b",
  "zh": "沒錯，這就是 Astral Dominae，士兵們！幹得好！很高興看到是你們拿到了它！"
 },
 {
  "id": 47,
  "src_sha256": "45e70ce2c3f72039e760d7a1f34733fcd5c2538809ca1181f078e91b95d03de5",
  "zh": "你們管這東西叫什麼？Destinae 什麼玩意兒？收好就是了。我只知道，看起來重要的東西，你們最好拿去給 Yamir 過目，如果你們還沒這麼做的話！這是命令！"
 },
 {
  "id": 48,
  "src_sha256": "9c580f0d370f696fd8af945c2ac0ceec52027c0849ce8976eb7ac2b219952cf5",
  "zh": "公道何在！這下可是一團混亂，老大！你們知道這玩意兒有多危險嗎，知道嗎？我們持有它屬於 A-1 級機密！"
 },
 {
  "id": 49,
  "src_sha256": "6a292c76033554110da8790aafd0605d816c3c555574df76fdbd540cac7f2ef6",
  "zh": "公道何在！這下可是一團混亂，老大！你們知道這玩意兒有多危險嗎，知道嗎？我們持有它屬於 A-1 級機密！現在只剩殺出一條路穿過 Mook 了……"
 },
 {
  "id": 53,
  "src_sha256": "73aba57274978691d54a30456adbda4487a8c3a226486b8e5c20af6dbdb49091",
  "zh": "你們腦袋秀逗了？我辦不到！"
 },
 {
  "id": 54,
  "src_sha256": "8513324a0d7c1ce59a622ac2a4dc8a5ba14fad981849795d5e4ac2f582ef791c",
  "zh": "間諜和騙子！全都是！"
 },
 {
  "id": 55,
  "src_sha256": "6c4c78a4b4ebbe71f1ade3ac978098c1557521981d08274a425a7f3cd633a0cf",
  "zh": "這個我們該留著！"
 },
 {
  "id": 56,
  "src_sha256": "274a34494c543de856689c96b326aa660662f940f9507f4fff64814b12be1020",
  "zh": "血債血償！"
 },
 {
  "id": 57,
  "src_sha256": "c414f7a0ae3d7890997d031757cc829216238688aafec6dea8c7b775beef5009",
  "zh": "我認得她……"
 },
 {
  "id": 58,
  "src_sha256": "e6cba662e1ff01ca4d872745652ab13e89c571a9df227c4c33f8e3ada4e1650e",
  "zh": "他們從這裡打不到我們。"
 },
 {
  "id": 60,
  "src_sha256": "7ab03bf3cb434b047463238c2e06e88c367e0cf7a51e8ff32dddc4fb1712b3a0",
  "zh": "偉大的 Urrhina 神眷顧了我們。我們還好好地站在這裡，活著！我知道你們控制不了那個黑衣鐵皮罐頭什麼時候在哪出現，但我希望你們現在明白我們的任務有多重要了！"
 },
 {
  "id": 61,
  "src_sha256": "8d8a6e76fcf39d1f9f52061bf816cb9037993e994d8bee96460436da54239e04",
  "zh": "趁他還沒回來把我們的腦袋當盤中菜，我們快走吧！"
 },
 {
  "id": 62,
  "src_sha256": "9c7bfa02aa6166632bde0dabf37be9d745165fad6dfb3ce058cf878e17833f0d",
  "zh": "他是帝國 Umpani 聯邦的偉大朋友！"
 },
 {
  "id": 63,
  "src_sha256": "6fb876d66abf5c6fe332a4f2a6e0bfd1c538fb827c1f9fceb0dcad455fed6f62",
  "zh": "耶！公道得到伸張。這下肯定有一堆勳章，老大，我保證讓你們排第一個領。"
 },
 {
  "id": 67,
  "src_sha256": "3d25c8859ffe2e58c1bb29fd25b31114ff2cf323cf6010438ea597d44e8d8d03",
  "zh": "這是什麼玩意兒？看起來像是 Astral Dominae 的拙劣仿品！這是黑市貨，老大！"
 },
 {
  "id": 68,
  "src_sha256": "f7f7cdbb3955e776b4a9a261137fe80f283c6e878894126f1a798c937e5f08b7",
  "zh": "把槍都拿過來，士兵們！"
 },
 {
  "id": 69,
  "src_sha256": "b2a8fce7502e9a6c1c8a495d3ac77b74cc6e5cfb15be280fdba2de1d5d9a0f3b",
  "zh": "他們包抄我們了，老大！"
 },
 {
  "id": 70,
  "src_sha256": "7a74842e079b071836e17453788fdac35221377f45b37842b42e996c3411fc29",
  "zh": "我就當作沒聽到我剛才好像聽到的話。你們該不會是在叫我們離開吧？！醒醒吧，老大！你們奉有直接命令，要護送我們去見你們的長官，好讓我們執行重要任務。我要是不參與這項任務，你們就沒有任務可言，老大！！！"
 },
 {
  "id": 71,
  "src_sha256": "3461bb8b912fd8e5cbd3085d7cdb5d222715c9364931f01dc9c71bf6fd7035ff",
  "zh": "我們來這裡幹嘛？你們只是路過，對吧？我們最好小心點，老大。有人看到 Dark Savant 在這一帶出沒。"
 },
 {
  "id": 72,
  "src_sha256": "3869428a4a4b9ac31b02c39b3ca1d7fc0f27fc356d56ce6fb3522e3ab8f5b200",
  "zh": "這裡的小毛球對這項任務沒什麼好貢獻的！走啦！"
 },
 {
  "id": 73,
  "src_sha256": "7fdb08fa6796b35defbedc3e0d6f97c5472612a041eb167d63c01d3c6cd56fd0",
  "zh": "Marten's Bluff！太棒了！帶路吧，Drazic！"
 },
 {
  "id": 74,
  "src_sha256": "464d1e419001f8dfc9be19239cef04ad757fd1ebbbb41bc888674aab904bec8a",
  "zh": "士兵們！也許你們沒聽清楚。我說的是「我們要見我們的長官！」據我所知，我們的長官可不住在海邊的洞穴裡！你們給我掉頭，走正確的方向！這是命令！"
 },
 {
  "id": 75,
  "src_sha256": "1edace738fcdd1b7481a2410119e32871496e823b82d960aabdeb491b2e11170",
  "zh": "Mount Gigas！終於到了！沒錯，Drazic，我們到了！多虧這些士兵帶我們過來！"
 },
 {
  "id": 76,
  "src_sha256": "cb412117bb2d2ba97f8ab40224ca97d6ea5feb8df5495b17ac4605c07215ae1b",
  "zh": "哈囉？你們腦袋裡有人在嗎？！我們來 Rapax Rift 幹嘛？"
 },
 {
  "id": 77,
  "src_sha256": "e08aa62d2dad09d7b5188bcf06a192fd0a9aad9c939c8c374508ca75091e33d4",
  "zh": "你們想參觀這座城堡，等以後愛逛多久就逛多久！現在你們是在斷送我們的機會！我們沒有時間！"
 },
 {
  "id": 78,
  "src_sha256": "8d77e629673f13be4cdb8e2c5ec102f7577f8972a9ffdd78afbdbc17871d78b1",
  "zh": "我們到底要去哪裡啊，Uhrinna 在上？！這是通往 Bayjin 的路！據我所知，這一帶已經由 I.U.F.U.T.U. 在調查了。我們不會干涉那項任務，尤其是我自己還有一項任務在身！"
 },
 {
  "id": 79,
  "src_sha256": "365e734ae8503ee009912f1d3952d4e17ae42afb786a0080a219b04f88963de9",
  "zh": "聽好了，老大！你們給我把這場戲轉回正軌，帶我們去該去的地方，不然和平任務就取消。我不去 Bayjin！"
 },
 {
  "id": 80,
  "src_sha256": "00c66223bc5f329f2481d3134b454979d337dff5fcd4f6c9a5a930f56e0f8332",
  "zh": "我們要去哪裡，老大！這不是 Mt. Gigas。這是通往 Ascension Peak 的路！我們現在晃上去，和平的機會就是零！"
 },
 {
  "id": 82,
  "src_sha256": "06c1f2ce122edff980124602b2fc5fc902e5cb1bfe852a8a56c6cac181bc52d9",
  "zh": "Drazic 熟悉這片跳蚤滿地的沼澤。我們的斥候以前在這裡發現過 T'Rang！"
 },
 {
  "id": 83,
  "src_sha256": "0384395680df31f2e1925df54ebe0e0c133e9e2353c040401c5e73f282bacd92",
  "zh": "你們瘋了嗎，混蛋？你們又把我們帶回火坑！你們要是繼續往那邊走——順帶一提，這是違抗命令——你們就自己去。這項任務你們可以當它完蛋了！"
 },
 {
  "id": 84,
  "src_sha256": "39f022cd0bc98be50dac51a1ef38053ec9a9e29f42f2d57853facc06ed02bb21",
  "zh": "好啊，老大！你們自己看著辦吧！我要回基地營了！"
 },
 {
  "id": 85,
  "src_sha256": "31f1d2168b7820aac9104f0497817fefd2a5f4495777e7c35b395443b16e4471",
  "zh": "你在開玩笑吧，臭小子？不像你，我是真正的軍人，不會把隊友丟在危險的地方。在離開這鬼地方以前，我們要一起行動。"
 },
 {
  "id": 86,
  "src_sha256": "62ef5f3545a1e2a772d39dfa7dc1c4c3aa3715c0d62397070b12fafdafb29bfa",
  "zh": "好了一個，但我還有別的毛病，老大！你們最好想辦法處理！"
 },
 {
  "id": 87,
  "src_sha256": "0a729866c3d82aa8d83f3d9cf2f22aba466037f415394e2f277801bca977ae77",
  "zh": "我們可以加快腳步了，老大。那個討厭的病已經好了。"
 },
 {
  "id": 88,
  "src_sha256": "ffd30f5277ce2f45a94331d1c57d701c321c7ff2a7b5127a836a96c3bac69cf0",
  "zh": "我在哪，老大？這看起來不像 Mt. Gigas 也不像 Marten's Bluff！你們馬上給我回到正軌！還有別再想把我打昏了。"
 },
 {
  "id": 89,
  "src_sha256": "311ae0cc45741dcd20660732096dbd1f74e4fc3d48ed1a289e0ff50bea71213a",
  "zh": "老大！噢，我們要去哪裡？"
 },
 {
  "id": 90,
  "src_sha256": "43f507bed635560d805c5249a38d5fd3a4765c66741e9dba5fbe45dcc035cbd0",
  "zh": "噢……這對士氣是個打擊。"
 },
 {
  "id": 91,
  "src_sha256": "a0859e8dff554e43d9267d74077a1554dbd44a05db54ee5ab804c7f2888a9b01",
  "zh": "算了算了！我當了這麼多年兵，從沒見過這麼亂來的行動。現在肯定沒戲了。看看你們對 Drazic 做了什麼！都是你們害的，T'Rang 和 Umpani 永遠不會有和平了。"
 },
 {
  "id": 93,
  "src_sha256": "4fbff77d90af1fa2858edefceb73841999ccc19055d1233697b21ec30f0e963a",
  "zh": "等一下，將軍！我知道這看起來不合規矩，但請聽我們說完。我被 Rapax 關過，Drazic 一直跟我在一起。當然，我本來打算殺了他，但後來我偷聽到 Rapax King……"
 },
 {
  "id": 94,
  "src_sha256": "e6b18246c913de1cb0209027df0c6d21bb35b714277c267508039187e59da58b",
  "zh": "看來 Rapax 和 Dark Savant 聯手了。他們打算毀掉我們所有人，Umpani 和 T'Rang 一個不留。你我都清楚，將軍，他們有這個能力……除非我們團結起來對抗他們。"
 },
 {
  "id": 95,
  "src_sha256": "88e96f10c4e8011467ccbf3b4442447fe79d23667862920cfe9f6c45d3558a00",
  "zh": "Drazic 相信他能跟 Z'Ant 談，讓他認同我們的看法。我們聯手就能消滅他，將軍。我們知道怎麼做！"
 },
 {
  "id": 96,
  "src_sha256": "3a026f42958d1734a807bc9c43d3002d8896a15d4c7107aa95c29b9ec4ae1f51",
  "zh": "我們也知道怎麼打敗 Savant，將軍。如您所知，IUF 已研發出能穿透 Black Ship 護盾的槍。不過據我所知，我們一直無法追蹤 Savant 的飛船。這點有改變嗎，將軍？"
 },
 {
  "id": 97,
  "src_sha256": "ed842d6dc511ee71e62ba67566dfe786131a44acafe189df1d1ac4834d92120f",
  "zh": "T'Rang 辦得到，他們能追蹤他的飛船，將軍！我們聯手就能成功！您一定要聽我們說……"
 },
 {
  "id": 98,
  "src_sha256": "36ff620c3b40d557416682b2f04e5cf306570d97c8f90f34eb4f458275d54233",
  "zh": "謝謝您，將軍。您不會後悔的。"
 },
 {
  "id": 99,
  "src_sha256": "110f63cbcb0e35b3c5db48de9975979c0beb4666d062a1f94da9545511c41ff0",
  "zh": "等一下，將軍。我知道這看起來不合規矩，但請聽我們說完。我被 Rapax 關過，Drazic 一直跟我在一起。當然，我本來打算殺了他，但後來我偷聽到 Rapax King……"
 },
 {
  "id": 100,
  "src_sha256": "e4cdd937f6939a442123d0d444e43284341dd207687559eb696aa18e1a25b595",
  "zh": "Rapax 和 Dark Savant 聯手了。他們打算毀掉我們所有人，Umpani 和 T'Rang 一個不留。將軍，您和我一樣清楚，他們有這個能力，除非我們團結起來對抗他們。我們聯手就能消滅他，將軍。而且 T'Rang 已經同意了……"
 },
 {
  "id": 101,
  "src_sha256": "15ab3d4ff955865df6e5a4318b81be53710b725a32b972deddf324d66f76072f",
  "zh": "不，將軍。很遺憾，我們沒有證據。我們只知道他的 Troopers 是從那艘船裡出來的。至少，那個威脅已經結束。沒有了船和部隊，Savant 不再是當年那個威脅。但他可能還活著，如果是這樣，我想我知道他要去哪……"
 },
 {
  "id": 102,
  "src_sha256": "e46664c252ebf3c6987bf6d97aeda7403a626a706092cbb96e897e544411171a",
  "zh": "不會的，將軍。走吧，弟兄們。"
 },
 {
  "id": 103,
  "src_sha256": "49c94bcb9e8949821c863e92822321180422ca3c4cc89d81c5372dc8ebf4df6c",
  "zh": "我不會的，將軍。走吧，弟兄們！"
 },
 {
  "id": 104,
  "src_sha256": "d58acdc11f310b4b4fdee4f236bf7543d5a386de9b93d30c2dd57d3fc4f24609",
  "zh": "不，將軍，我們沒有——因為這些白痴決定去兜風！說真的，我連我們回到這裡幹嘛都不知道！我們得去那個該死的 T'Rang 營地！"
 },
 {
  "id": 105,
  "src_sha256": "19051b2336b002b4013fb7f66b9d65960cc8f615a18445ef5950430c2ddd3521",
  "zh": "是的，將軍，我們確實拿到了。"
 },
 {
  "id": 106,
  "src_sha256": "e7af662e42f10e7c05d8ba6968f79336a73afa2cea44429e813a88cb92e673c6",
  "zh": "我現在總算明白我為什麼從來就不喜歡 T'Rang！該死，沒錯，我們有槍。如果你跟我一樣想活命，就同意跟我們並肩作戰，別跟我們作對！你真以為我是閒著沒事才闖進敵人地盤的嗎？！？"
 },
 {
  "id": 107,
  "src_sha256": "6dcfd3bccefcb1a7b42c95b5d606fff203b60994f65b97094d2acf2702d0b5ab",
  "zh": "我要是有別的選擇，才不會在這裡！但我沒有！Drazic 和我已經把一切都談開了——我們當時就在現場。我們唯一的活路，就是放下過去，為了未來並肩作戰！我們沒有理由各自去死！"
 },
 {
  "id": 108,
  "src_sha256": "004ad2fa947d5b0b8e82a82b2df1ebf852e10a85f210541626efd12404ff7ba5",
  "zh": "除非你也給我你的承諾。而且我要白紙黑字……"
 },
 {
  "id": 109,
  "src_sha256": "847cea1019fbbd3e545ee1d67d6e8acb195f1bb899c74f32536139de37a4bbea",
  "zh": "走吧，老大、Drazic，我們得趁出事前趕到將軍那裡……還有別擔心，Z'Ant，我不會忘記的。"
 },
 {
  "id": 110,
  "src_sha256": "73c0225d5541d3903882dca95219e12ecd59549e0e0d2d2e2190132b059dba69",
  "zh": "我有一個，沒錯，Balbrak，但我沒時間給你。你現在去通知將軍，說我們正在上來的路上……我知道我在做什麼，這對 Umpani 最有利。"
 },
 {
  "id": 111,
  "src_sha256": "ec42683019c393b55c033e6dd379b96ebf8a447e4de212c45d1c15a57aa5c09f",
  "zh": "需要做什麼就做什麼。"
 },
 {
  "id": 112,
  "src_sha256": "5f2bbe0798581aabc9ffc34def8b5c1f7efa9a13eac2459b8183e15122d5e33e",
  "zh": "我絕對不敢相信。偉大的 Urrhina 神！請告訴我這不是真的。我終於跟 T'Rang 談和了。我終於想出辦法結束這場愚蠢、巨大的宇宙戰爭，結果被某個來自跳蚤腦袋總部的爛白痴毀了一切！"
 },
 {
  "id": 113,
  "src_sha256": "d42b086c05af876bd8ca1dd838da4e5eeebd20d90e41a470d2f91657be32b4b9",
  "zh": "算了吧，白痴們！我不知道還能怎麼講得更清楚了。要是 Drazic 不一起走，我就不走。我要回去找他。你們自生自滅吧！"
 },
 {
  "id": 114,
  "src_sha256": "d67f708382a613005c1a8d1c0e30dbb12af6d57ffde1ab7e0eac56ba6f8662c9",
  "zh": "把你的手從那上面拿開，老大！"
 },
 {
  "id": 115,
  "src_sha256": "7b30aaf8da208d72780ba33a31e1824a6d550a9f368d8853676aa3500ce50f04",
  "zh": "Drazic 要是出局，我也一起！再見不送！"
 },
 {
  "id": 117,
  "src_sha256": "5e123de167192802c22d9e9be54a05cde230868a5fb15b02529086b4dd1a19ea",
  "zh": "你們把船毀了！你們這些白痴！一切都完了！T'Rang 和 Umpani 永遠不會有和平了，全都是因為你們！"
 },
 {
  "id": 119,
  "src_sha256": "0d67179a97f3fd767f003b3b830922f288f03f8e5348105ea3fdd01291270a07",
  "zh": "我說過了，我*不*去這裡！"
 },
 {
  "id": 120,
  "src_sha256": "e36c69b54b4455dcdc30e434790e6d3cd77d44cd58c5810dc844a3c95390ef71",
  "zh": "好了，老大，我們去接 Drazic，然後離開這裡吧！"
 },
 {
  "id": 126,
  "src_sha256": "74f8a2e0d41e7f9cbf596936d0e618f53c495070d87c043bad5dd4934f45f4c4",
  "zh": "聽著，老大，我們有地方要去。我們沒辦法跟每個遇到的可愛小東西都聊上幾句，好嗎？就算他是 Trynnie 的首領也一樣！"
 },
 {
  "id": 127,
  "src_sha256": "fe89dab6a6b839b38272ecf92f3bf7f122dfc7d27d4b2828ac70042ac6b272c1",
  "zh": "唯一好的 Rapax 就是死掉的 Rapax。"
 },
 {
  "id": 130,
  "src_sha256": "b9549aeeccde78f71835ba4bb2fb9a5045affc5cfe56b6f9fe3b7bb91cdb7588",
  "zh": "老大，這東西看起來好像會有什麼作用……"
 },
 {
  "id": 131,
  "src_sha256": "c1ca74cd3bcfa773da81ad8e5d7aa331f93f5da9ea9d0c277bd40999a08dd15d",
  "zh": "女人啊。我從來就沒走過什麼桃花運。"
 },
 {
  "id": 132,
  "src_sha256": "6208b540e42a319ff9c015aace90c0d19bb13c31a79514a13229e85ea70043df",
  "zh": "Helm of Serenity？私下說，這是 A-1 級機密物品。收好它，士兵們。我只能說到這裡。"
 }
]

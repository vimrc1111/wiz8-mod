[
 {
  "id": 2,
  "src_sha256": "0cd62a364e5ea7cdb032ad8aaaa1a828600de27861409eaf4527d882932bc64f",
  "zh": "離我遠一點。"
 },
 {
  "id": 3,
  "src_sha256": "b0446bdd486397e151b9900cc29420338d2bb92e979da50d3185083d51121903",
  "zh": "別管我。"
 },
 {
  "id": 4,
  "src_sha256": "b221ec9d1dad0038f1d1791d3c9ffc5996c7a99300b3dd9cd8f2349157a41482",
  "zh": "我對你們的話不太感興趣……"
 },
 {
  "id": 5,
  "src_sha256": "c3fe2f4fa515b966cd4d1ddc8c04d59b9775c595cae9ef7fd742ec216e8b6aac",
  "zh": "只是這裡那裡死幾個人而已， Templar 。沒別的好說了。"
 },
 {
  "id": 6,
  "src_sha256": "64466545bd1e7eadd4d2961cdd85e5daa8e1925b8e63bf6e30b0a1808a722ceb",

[
 {
  "id": 2,
  "src_sha256": "7db6f4cee678da58501a0baa8d45ad8e0609529714c3f152635b8430a87ccf1b",
  "zh": "我本來想鎖前門的……"
 },
 {
  "id": 3,
  "src_sha256": "3356356425f11a3955bcf6d07913d59a4fd1259723d1e87b5d5da9dd40565edf",
  "zh": "算了吧。"
 },
 {
  "id": 6,
  "src_sha256": "57d2387b481178268c5458642f6171713a25814eb1c057bad3e53fa41788c72f",
  "zh": "上一個威脅我的混帳，離開這裡的時候全身骨頭都被我重新排列過了！"
 },
 {
  "id": 7,
  "src_sha256": "3fa541fd720558d19e890fd5890b48718fd30029a22a5645b92ed35000348ad3",
  "zh": "這種開價根本是在侮辱人。"
 },
 {
  "id": 8,
  "src_sha256": "9de8df6bc36fcf020c1987ad028b7f62a1ff09d1e7bb22adf2883668f5369df4",
  "zh": "等塵埃落定再說！這裡老是在打架！"
 },
 {
  "id": 9,
  "src_sha256": "16914aaabe2302100e7037e7535196565e98cd3674225d9531348305d38e003b",
  "zh": "你們開玩笑吧？我還有酒吧要顧。"
 },
 {
  "id": 12,
  "src_sha256": "74d51b963a3a8a648f77bab56a66a0ce23ed1188dee88aac79f5e5ca2b127160",
  "zh": "謝謝惠顧。"
 },
 {
  "id": 13,
  "src_sha256": "53733f209db9d198dc2171e2ce44b011898862adaaecfdf446ad8b137e39928b",
  "zh": "不太是我的風格……"
 },
 {
  "id": 14,
  "src_sha256": "09c4206b1fe22ad54918d2291bdb39d5b76a478425ca8506b8dcd2136b459744",
  "zh": "這可是要花錢的……"
 },
 {
  "id": 15,
  "src_sha256": "7bb25f02dbaeed55268976e8c36e080863659d2b7a6f9e4e148dbbca0e89c7e3",
  "zh": "最近生意不太好。我再也付不起了。"
 },
 {
  "id": 16,
  "src_sha256": "96ad27691efe120886fd72b34cb8979b256015c2d35d98b6cf9a7a07a3da324d",
  "zh": "你們是想坑我嗎？"
 },
 {
  "id": 18,
  "src_sha256": "74d72894a7aec44ae077f9b73a68ce8f8fb0411dbf217d9548e013985c4ea6f3",
  "zh": "你們現在馬上給我住手，不然我就把你們的腦袋送上軌道……"
 },
 {
  "id": 19,
  "src_sha256": "35aee21819d6553048160ef695b43d6b253f6cd26f7a77075a9ef68b4c5172aa",
  "zh": "什麼？！？小偷！"
 },
 {
  "id": 20,
  "src_sha256": "247ab345f19b1a9dbb8a7443f068309ed3d3e623aab426c6852cdec8d20a7644",
  "zh": "等你們死了，我要把你們的屍體做成標本，掛在吧台上方！"
 },
 {
  "id": 21,
  "src_sha256": "abb2197c1e66b3857f487a54f4f4248a76a1ae346905b25993d3cec01f72f474",
  "zh": "小費啊……太棒了。"
 },
 {
  "id": 22,
  "src_sha256": "27e16d11e2c62aea3fba845875569513f3bafb28df4214c7f3fd294b9a3b1025",
  "zh": "最近沒什麼消息……"
 },
 {
  "id": 23,
  "src_sha256": "6b3a21f31ce2a26d3ca54470782e179c51823ce67e23be8ecc3f4a7658520747",
  "zh": "什麼都沒聽說……"
 },
 {
  "id": 24,
  "src_sha256": "8b0c8b39c38ab12ddfe9f7c2265f6fb885483d6110135682d9966bb003703b49",
  "zh": "這不是我該說的。"
 },
 {
  "id": 25,
  "src_sha256": "1a5052dd7c9d16afda3f8c69fdaef3aab572a92a21b51e51bf7dc6d992d1b9a1",
  "zh": "你們腦袋進水了嗎？我說的是……"
 },
 {
  "id": 26,
  "src_sha256": "ade4fef11d262485e99334065c9ef58497342631e1c589de8ecabb37e0a13657",
  "zh": "嗯，我該從哪開始講呢？"
 },
 {
  "id": 27,
  "src_sha256": "329e241ecb64aa938a8f811407814a38d76c999f6dd83b76a4e0e9c296248221",
  "zh": "還有另外那件事……"
 },
 {
  "id": 28,
  "src_sha256": "661f27a61d8cbd2502a8c5d837ada7aa6c4b767aa7df57747fe8e22401755c66",
  "zh": "失陪了，我還有工作要做。"
 },
 {
  "id": 29,
  "src_sha256": "82a4d2b32323d263d9fb51a45e1407f0b8ae8fb6543cf330394422c0ee82d095",
  "zh": "嗯，我不想耽誤你們。"
 },
 {
  "id": 30,
  "src_sha256": "42b88a55a29fd9be821c3f987a3a3ce6f3a87dd3f34e606fd67c481bcf4912ee",
  "zh": "我想我該回去工作了。"
 },
 {
  "id": 31,
  "src_sha256": "c1178c24599d812daba395e84beea3c775e02723b1650e344ea898bb822a67a7",
  "zh": "這星球可大得很。你們有什麼比較具體的目標嗎？"
 },
 {
  "id": 32,
  "src_sha256": "8870f3755ef7b33a02702270b453fdcfabc0d897424ef91b63f6de2e62239346",
  "zh": "就是這樣了，嗯，剩下的也就這些。"
 },
 {
  "id": 34,
  "src_sha256": "0af16095fb40e188c0122da308ac991f1b0f185a76d0fd869da8979ae607fc0b",
  "zh": "Trynton 是個好地方。說真的，我大部分的酒（ drinks ）都是從那裡進的。你們要是去的話，記得順道去 Fuzzfas Potion Palace ，跟他說 He'Li 問好。"
 },
 {
  "id": 35,
  "src_sha256": "2ecb1de06ae62ba87e4346a4c91c85c49d9483b2cc7811a0e8d297b8a82babb6",
  "zh": "這對健康可是有風險的，這點可以肯定。"
 },
 {
  "id": 36,
  "src_sha256": "2ecb1de06ae62ba87e4346a4c91c85c49d9483b2cc7811a0e8d297b8a82babb6",
  "zh": "這對健康可是有風險的，這點可以肯定。"
 },
 {
  "id": 37,
  "src_sha256": "72f5a21adba41733394683fc919ee4f1d10fba7e1c0197eac7a1cd25ee0158c4",
  "zh": "它在 Arnika 北邊很遠的地方，不過值得跑一趟。那座老山裡大多是洞穴，但我聽說現在有一批 Umpani 駐在那裡。不是 Dominus 來的，這點可以肯定。"
 },
 {
  "id": 38,
  "src_sha256": "c0b8f0fd76346db995a1887b4190f3d82f271ffb28fd41a5eceb8362d32e3e47",
  "zh": "這地方去問 Tramain 吧。他在 HLL 那邊。不過自從那些 T'Rang 玩意兒搬進去之後，那裡已經有些變了。"
 },
 {
  "id": 40,
  "src_sha256": "3898fca2f1c5f51189dd34dc52308483c5493d1335e4df6119203c75a6e52339",
  "zh": "你們跑到酒吧來問這個？去神殿找找吧。"
 },
 {
  "id": 42,
  "src_sha256": "c8dd4ca5aecf8983dfd65c7127e6f67bc05bd81e2160e6196cc0aadde49ed14e",
  "zh": "一大堆水……"
 },
 {
  "id": 43,
  "src_sha256": "35c8ab457b0ab5b0a2005b093421e92b69557736322c3062aec32e8237021bd3",
  "zh": "好好看看吧。你們眼前就有一個。"
 },
 {
  "id": 44,
  "src_sha256": "f52b351a01a37c6d13eb275d58f4f78a1f8089db483f6fd2edaf9cba77c36d29",
  "zh": "只跟你們說，別外傳喔？我很多最棒的酒（ drinks ）都是 Trynnies 釀的。他們真的很懂得怎麼調製液體{{Magic}}。"
 },
 {
  "id": 45,
  "src_sha256": "acee25f7249487c7e2a92f69b8c5d8e0da5d0087a2e7126ff3760785b133acb0",
  "zh": "他們是 Dominus 上最危險的生物，這點絕對沒錯。我們跟他們算是相安無事，但相信我，我們從沒忘記他們可以、也可能殺了我們。你們跟他們往來時要是記得這點，就很明智了。"
 },
 {
  "id": 46,
  "src_sha256": "0ecd14270485e43a60506b6b2409a7051fbcfed5b99c876a296ea75414a2c348",
  "zh": "大塊頭。這裡有整整一支軍隊。從他們說話的樣子聽來，我猜他們是跟著 Dark Savant 來到 Dominus 的。他們在 Mt. Gigas 那邊有座基地。"
 },
 {
  "id": 47,
  "src_sha256": "2c03d255c390f410583df6eedcd1bfe614bfb47950ff98a286addd21cdf763a6",
  "zh": "長得古怪的生物，不過只要你們能忍受那副長相，其實還行。反正幾杯（ drinks ）下肚，什麼都不是問題。他們在舊的 Marten's Bluff 開了據點。"
 },
 {
  "id": 49,
  "src_sha256": "15e05494d2b23ec201f3153cb82ce7dc8935bec66f26dcaf4d8b2bcb512d874a",
  "zh": "喔，就在沼澤那頭再往下走，你們就找得到他們，不過你們得有尋死的覺悟才行。我是說，當初把港口封起來就是因為他們啊！"
 },
 {
  "id": 54,
  "src_sha256": "8ef4a5b725d9597860d03fd2abb5edbcca9825b601f03fd93df8f108b0ba7a62",
  "zh": "跟你們說實話，我從沒見過他本人，只見過他的 Troopers ，不過聽過不少。說真的，與其跟我聊，你們何不親自去問 Lord Braffit ？我就是跟他談的。"
 },
 {
  "id": 55,
  "src_sha256": "bbe4fa720e93f10b10207683a33b30f86fbd482a07d3fe2e2f4e8a8c3452e51c",
  "zh": "是啊，我跟她很熟……"
 },
 {
  "id": 56,
  "src_sha256": "7ef4e56906acf9b2f6e88933ed04f2479c953cb3096d843826921201defbe06e",
  "zh": "我們彼此很熟了，不是嗎？"
 },
 {
  "id": 58,
  "src_sha256": "a4a4df13e31d6aa1aa683c4b7a7b7d93f0c032bb45f7f2f3b10419cdc031b672",
  "zh": "我聽過這名字，但不清楚來歷。你們可以去 HLL 問問 Tramain 。"
 },
 {
  "id": 60,
  "src_sha256": "95435c295666447f809a427383620d1eb6ccbe0018e5c8d86ee19a293e6798cb",
  "zh": "喔，我相信遲早會聽到些什麼的。"
 },
 {
  "id": 68,
  "src_sha256": "89736fbb942f691ad93cc4fbb9d5c124b56ec385717e45d55093693a76f00145",
  "zh": "Braffit 會知道得更多。我建議你們去問他。"
 },
 {
  "id": 73,
  "src_sha256": "8a91138d29670f7abf63acf5b26c644d67021aae373f92459096bad04ec12a5c",
  "zh": "沒錯，我叫 He'Li 。當然，也有人用別的名字叫我，不過通常都會動手動腳。"
 },
 {
  "id": 75,
  "src_sha256": "23de4a9bc13f9e69886d79d7ad4b1d0de550b4915bae84d721f9c5c300a43925",
  "zh": "何不帶著你那副瀟灑樣子滾到外面，拿你那張漂亮小臉去撞牆……也許這樣你才學得會一點禮貌。"
 },
 {
  "id": 76,
  "src_sha256": "9464822e0f9200311fd700d84daa8bf61ff98b6d242f0cebf853b21eed47307c",
  "zh": "我為了更小的事把人扔出去過，你們知道的。"
 },
 {
  "id": 77,
  "src_sha256": "12a109e734fbf8fc1c9cf532fb043b68b9512626771502823e81d5534c6c9f1a",
  "zh": "有什麼我能為你們效勞的？"
 },
 {
  "id": 78,
  "src_sha256": "41da2a30f93bfb29cb6cf0a5209608747868e1a143f75f78d82af8a4e594d4e2",
  "zh": "你們回來的時候再見。"
 },
 {
  "id": 79,
  "src_sha256": "8d906d87c769dc36eafd8c60f0ca04171964d6efccb0fbf186cc7ce6ab065d36",
  "zh": "我這裡的幫忙（ help ）有兩種：酒瓶（ bottles ）或打架（ battles ）。而打架這種我已經沒了。"
 },
 {
  "id": 80,
  "src_sha256": "1f5366140306968132faaac341480b331a60df60c3a13da0c11de89273945bf7",
  "zh": "那就來交易吧。"
 },
 {
  "id": 81,
  "src_sha256": "de0e8c47b66e3b8ea817e29dcdf13fc3be7d4f0604aa45dd703ed884bbc438ac",
  "zh": "喔，我一向都很好。"
 },
 {
  "id": 82,
  "src_sha256": "9b378a3528bb2b77f48c4a0e7db4dfdb356746351c19e6115e8a55811837b97c",
  "zh": "你們需要的我這裡都有。"
 },
 {
  "id": 87,
  "src_sha256": "e03ce7f380fa0f88d4f6fb935a9743dfcc6054d8159e0b40ecc0b8aceac5c700",
  "zh": "不知道是不是真的。我是說，如果 Mook 真有像 Destinae Dominus 那樣的東西在手上，你們想他們不會更……呃……充滿敵意嗎？"
 },
 {
  "id": 88,
  "src_sha256": "6d0182b88d88c9765af7eca087d5481f78034184ed10b139ab61ea04682d3c49",
  "zh": "所以她真的當上了 Templar ？我是說，一個 Higardi 怎麼可能變成 Rapax Templar ！？這不可能啊，至少我一直這麼以為。如果我們真能成為 Templar ，哎呀，他們就不會攻擊我們了！"
 },
 {
  "id": 89,
  "src_sha256": "fa7c1f9a00030e2f62641248ffafda0783e56be779d569de8bb5dcd17f472747",
  "zh": "我想我今晚提早打烊。"
 },
 {
  "id": 90,
  "src_sha256": "6f96e784e38e401d76f86e34c674071f53d1b6a2f112848de05c4490d8a96edc",
  "zh": "就在 Arnika 這裡。"
 },
 {
  "id": 91,
  "src_sha256": "39e671107f233cd36227e70570fd45f3ee3ab470fbc2e44fd9f6284cb0a1c541",
  "zh": "我會去 Trynton 找找。"
 },
 {
  "id": 92,
  "src_sha256": "f6e47f0b05590b1c7a5555b4635a1b0592f25f4e50f9f782280f2cb5f8578f74",
  "zh": "這裡南邊的沼澤是個不錯的找尋地點。"
 },
 {
  "id": 93,
  "src_sha256": "74c5536e03c5393b394a2181782d7d329d72f4e4d39e7e6c36e18983f5e98f7a",
  "zh": "大概是 Marten's Bluff ，不過我不保證。"
 },
 {
  "id": 94,
  "src_sha256": "42904f10d6ea61709107b753607e0224328196509d536035e35d520136055572",
  "zh": "我聽說 Rapax 有座營地……"
 },
 {
  "id": 95,
  "src_sha256": "fcd7d61a09ee63c2f0e4aa804238f7047ce556c69ece691bc964ec5a057f8147",
  "zh": "我建議去 Mt. Gigas 。"
 },
 {
  "id": 96,
  "src_sha256": "d9107d7c4e2002cd5147deeec7d3856821e5f001f9c829134428d211ad29f929",
  "zh": "Sea Caves 。"
 },
 {
  "id": 97,
  "src_sha256": "eeb032713ae5094ddc8f1e13d6ee578964ae2e5c63e65a32b431c8d2cbe51448",
  "zh": "Rapax Rift 。"
 },
 {
  "id": 98,
  "src_sha256": "a6dbd8f6a09e25c9f756bfdd4a34db734cd880f87f98dde6c10a3534a1bcaa88",
  "zh": "Rapax Castle 。"
 },
 {
  "id": 99,
  "src_sha256": "d0313d4cf39e2f02b95ba44880c411ea86ba78b91ce1975823031fe45e196093",
  "zh": "在 Arnika 北邊的 Ascension Peak 。"
 },
 {
  "id": 100,
  "src_sha256": "e8bccba5d6354f0e69fb85ee8ea6bb55718fb03458f5009ec0f8246a368dcae0",
  "zh": "在 Cosmic Circle ！"
 },
 {
  "id": 101,
  "src_sha256": "fd77ae1261d43caee8592e7a5e3fe01f8b1cd6cd06e14bcddba4e7a2f7ae98fd",
  "zh": "你們喝太多了。"
 },
 {
  "id": 102,
  "src_sha256": "ede07ea1bd0dc5978281e45758114d5a8a1be4b8a184d6d8fb01f269675c41e9",
  "zh": "我沒辦法什麼都記得住，你們知道的。"
 },
 {
  "id": 103,
  "src_sha256": "aea78978d6b115851851f88a661182b4df9fc3c0dedffd187c13580969d31bc1",
  "zh": "在 Bayjin ，如果你們真的想去那裡的話。"
 },
 {
  "id": 105,
  "src_sha256": "90fd2965edeaacf16e62c90b9ad37bf582bdce1b456a55a2024531a45ccb1b9b",
  "zh": "任何 Vi 的朋友都是我的朋友。"
 },
 {
  "id": 106,
  "src_sha256": "a762a9c4a5bc8331c54181b720f414515889992b2b440ee4bf3da7790cd4f7ad",
  "zh": "這不是 Myles 的朋友們嗎……"
 },
 {
  "id": 107,
  "src_sha256": "f4a8c9c73cc827db8d83b722be756ca5a731e4e87f2af05a5ed7ee1ba0180dce",
  "zh": "Myles 。"
 },
 {
  "id": 108,
  "src_sha256": "19dfcb1afe4d818ccc12dc7582bf39d678491c05055bbb8d1ef4960c2a717234",
  "zh": "見到你真好， Vi 。"
 },
 {
  "id": 109,
  "src_sha256": "03678ba5a67a57c81b87b632d438f4b0bed2252599d04fa911a8bd250458f685",
  "zh": "各位要來點什麼？"
 },
 {
  "id": 110,
  "src_sha256": "f7e48a90d5d76cfc49d378535781243d1f222928f2b3636c798b3278130cc41b",
  "zh": "需要我幫（ help ）什麼忙嗎？"
 },
 {
  "id": 111,
  "src_sha256": "db4a0310984a94bd09789a0f8089e5fcaa243ca7b8ec2b35a68f357f8425d19c",
  "zh": "哎呀，看來我不用關門了。進來，進來！我還在想什麼時候才有機會親眼見到你們呢。"
 },
 {
  "id": 112,
  "src_sha256": "764e4d17f4549d870964b67de6b154137040adbc32cfe05cc1b1afc082689e82",
  "zh": "我的禮貌跑哪去了？一激動，我就忘了……"
 },
 {
  "id": 113,
  "src_sha256": "bc26ab8c12dd78f1105e3b1f51f71137f7be478346d41819c5d5a70d10c7133e",
  "zh": "請容我歡迎各位來到 He'Li's ！我們三個 R 全集中在同一個屋簷下： Rumors （傳聞）、 Rooms （房間）和 Rum （蘭姆酒）！醉了再試著說說看啊。各位要來點什麼？"
 },
 {
  "id": 116,
  "src_sha256": "3b65ebeaec731533e7a145123b83e82123dfc92ce9810aae42277abf2ecc468e",
  "zh": "還有你， Myles ！ Vi 竟然會跟你這種人在一起，我真驚訝……不過……"
 },
 {
  "id": 117,
  "src_sha256": "7819d520fe9bd502c07df55dee27fd5dfa9c29ab31456cfd7b506cca660724a7",
  "zh": "你們正是我想見的人！你的帳早就逾期了！有趣的是，每次逾期你就剛好不見人影，嗯？有「酒客」， Myles ，還有「超級酒客」。我什麼人都見過，但從沒見過像這樣的！"
 },
 {
  "id": 118,
  "src_sha256": "e7240c494394cc9386c898b0a9dbfdfc83930d992be08f2a8857e44a0923640a",
  "zh": "你欠我錢， Myles ！要是不還？你和你的朋友就再也別想在這裡喝到酒！這包括跟你在一起的每一個人！"
 },
 {
  "id": 119,
  "src_sha256": "f1d8d12222be27e4ceb721812ae955f4a5646ea17e0711d246a6f93a521e3288",
  "zh": "不行不行， Myles ，這次你甜言蜜語也休想脫身。現在你欠我錢。你和你那群夥伴到底付不付？"
 },
 {
  "id": 120,
  "src_sha256": "ea06d4f93c32467d5f20426eb5b7a960f9def5e3cc9e84844b5f0717ed83eadb",
  "zh": "想得好， Myles ，想得好。那麼……"
 },
 {
  "id": 121,
  "src_sha256": "7eaf59ea566003f81fbe616cdf4fec405b312c3a0532287151d70806f2913ea4",
  "zh": "我要我的錢！你們到底付不付？"
 },
 {
  "id": 122,
  "src_sha256": "70bf5a1cd99d5787e0defac63833aa9a6de06a8e129fb96be48fbfa0dc014a57",
  "zh": "把 Myles 甩了，是吧？演得不錯！你們當我是什麼白痴啊？！他在幹嘛？在外面等著？依我看，要是你們是 Myles 的朋友？那筆債就跟算在你們頭上沒兩樣。我剛才說了……"
 },
 {
  "id": 123,
  "src_sha256": "edf722e1fb94611dd83e28014023b4ea156059fbdb68fa0f5e34b5efd8a9c8e0",
  "zh": "你們沒付清欠我的錢之前，我不想跟「你們」說話！"
 },
 {
  "id": 124,
  "src_sha256": "b7e422735f0c63b482abd00e93c27e7a38e90224d9add9b5691a6d4e4f122ff0",
  "zh": "哎呀，我不敢相信我的眼睛！ Vi ！ Vi Domina ！我的天啊！"
 },
 {
  "id": 125,
  "src_sha256": "449f947529ad51834156b39c3b505e50eb70aa97a7c4aa8a854f10fc7449fc95",
  "zh": "很久？我當然要這麼說！你們說你們只離開一個星期！結果過了多久？"
 },
 {
  "id": 126,
  "src_sha256": "a0fa99e4f1b675c8ebf6ffc3a45d6f9df8ce246cb92f08beab18a8942e42f3c2",
  "zh": "到底發生了什麼事， Vi ？我是說，七「天」和七「年」之間差很多耶……"
 },
 {
  "id": 127,
  "src_sha256": "76d2f9680afd03e35df965bed20f5ad0527f663e324e84ab86b3dce6bccf31c4",
  "zh": "跟那個……你知道的……有關嗎……"
 },
 {
  "id": 128,
  "src_sha256": "6047952b0479ce8ccceaa9bfa41457340e63e3bfcaecb8746d1bfb1917b16f0a",
  "zh": "他在這裡， Vi ，就在 Dominus 上，至少我在這裡聽到的消息是這樣。你知道嗎？"
 },
 {
  "id": 129,
  "src_sha256": "43cf58a30f6fe0f5950d63840e9d4fd7bbb5a129fd329d263ef668da28d7ba6f",
  "zh": "這杯我請客， Vi 。"
 },
 {
  "id": 130,
  "src_sha256": "ad0c8273bdd5899675d918eb55d6e777d71e6ac0ba9d4a3e47840755a22e9c68",
  "zh": "沒問題……"
 },
 {
  "id": 131,
  "src_sha256": "7f69749d1ce601c611581ae243aca8d266742fb8560077fdebef9887a67e57cc",
  "zh": "還有 Myles ，我可沒忘記你那點小小的錢問題。喝完你的酒就給我滾出去。我要我的錢！抱歉， Vi ，但他之前在這裡就惹過麻煩。"
 },
 {
  "id": 133,
  "src_sha256": "607fd4d3ae1c4127b30437c8d576ee8f8f0514894486fb175f5f494704966627",
  "zh": "還有 Vi ？這不是針對你。我這裡有生意要做。"
 },
 {
  "id": 134,
  "src_sha256": "1119a85a2a9a51e0e855d1502e596bffa72112e86cbc9be7c341afc65827ff2c",
  "zh": "對了，不知道你們有沒有聽說，據說 T'Rang 和 Umpani 都在找傭兵……或者劍客，或者你們有的什麼本事。也許該去深入打聽一下。我知道的都告訴你們了。"
 },
 {
  "id": 135,
  "src_sha256": "c2dde9aa83d1caf1f61c9d35ce95e6c89c324d6872134da3d7d3e21da0acdcea",
  "zh": "喔，對了，順便一提，我聽說你們現在在替 Umpani 做事。"
 },
 {
  "id": 136,
  "src_sha256": "370b379ec6d1e36ba36c4e367bc9f6a3986751b74466387c627f363257bd8afa",
  "zh": "聽我一個客人（ patron ）提過，呃，你們現在在替 T'Rang 做事。"
 },
 {
  "id": 137,
  "src_sha256": "168401a81953192438286a4f28387a16e423a23dd8234b952af54db55194ecbf",
  "zh": "你們知道嗎，前幾天我聽到一件最有趣的事。有個 IUF 來的傢伙到我這裡來。我想不起他的名字，但他聲稱你們是替他做事的。然後一兩個小時後，一隻 T'Rang 的玩意兒就黏糊糊地從門口滑進來了。"
 },
 {
  "id": 138,
  "src_sha256": "3b444c5be08d49483d426795a399ea2adef7cdef64a42e2846f14bac236866c7",
  "zh": "他說你們是替「他們」做事！我猜你們是兩邊討好。我得說這真是高招……而且我很樂意替你們保守這個小祕密，不過……"
 },
 {
  "id": 139,
  "src_sha256": "f7c4b586cbac78af6dd5f213c030f65ab4868d2b72291767f0f3a7978e5dcf06",
  "zh": "謝謝你們喔！"
 },
 {
  "id": 140,
  "src_sha256": "0161ec1fd26008bc6937e9af578dc93c7df9f7e05986c7d3cccb899a2f313400",
  "zh": "想再提醒一次。 T'Rang 和 Umpani 並「不需要」知道你們同時替「兩邊」賺錢。這是最「後」一次機會，當然啦……"
 },
 {
  "id": 141,
  "src_sha256": "350fac7d631175b5a2e311bf1f43a22d76193a89739167549dee6454ddd0a489",
  "zh": "我一直等著恭喜你們呢！聽說你們拿到了 Astral Dominae ！我希望你們打算小心對待那玩意兒。有很多人願意為了它殺人。記住這點。酒水（ drinks ）算我的……"
 },
 {
  "id": 142,
  "src_sha256": "b4b34c1af6932560e6fa092588fad3300c1c413b983ce217f703bff558a91df7",
  "zh": "很好。我一直在等你們這群傢伙進來！你們以為自己在做什麼？！你們偷了 Mook 的東西，對不對？聽好，據我所知， Mook 並不懷疑是你們幹的，但 HLL 絕對知道。你們最好暫時低調點。這個應該幫得上忙（ help ）。"
 },
 {
  "id": 143,
  "src_sha256": "9c3ec03c44cd8d637f7af365e113dae1a5485cf8aa067cfb91e3570905969366",
  "zh": "是真的，對吧？你們真的找到了 Destinae Dominus ！我真不敢相信，有個 Trynnie 路過這裡告訴我，不過，呃，我當時不相信他。你們太了不起了！酒水（ drinks ）算我的！我再額外送你們一樣東西，當作添頭。"
 },
 {
  "id": 144,
  "src_sha256": "1696a59b07a08d2a095edf8b3fd29a2eb337898bf1a56bab98d1e59a7f38400b",
  "zh": "很高興見到你們……坐下，喝一杯（ drink ）吧。接下來的話不太好說。"
 },
 {
  "id": 145,
  "src_sha256": "358f5b04c8b1270d80817d249c9274a8dec6e91d7b1a39d79a02bee6974f28eb",
  "zh": "我剛才有個 Rapax 進來。他們不常來，坦白說我也不想招待他們，但面對那麼大一隻你們也沒法跟他爭。他開心得不得了，各位。 Rapax 和 Dark Savant 已經結盟了。我真希望知道更多。我想你們需要知道這件事。願 Phoonzang 幫助（ help ）我們所有人……"
 },
 {
  "id": 146,
  "src_sha256": "2f9199a27a0d7c9cd73e1f645c97d4f51569ecf37292f5852486df67d82d1ac5",
  "zh": "哎呀，你們真是史上最了不起的外交官！我聽說 Umpani 和 T'Rang 達成和平了。而且私下跟你們說， Dark Savant 很擔心。不管你們做了什麼，整個 Arnika 都鬧翻天了。"
 },
 {
  "id": 147,
  "src_sha256": "fd272b2447218ee6f2213d91270241e6cb0ca50c41fc880b31c250267393759e",
  "zh": "他的 Troopers 緊張到快自己絆倒自己了，拼命守著那座塔（ tower ）。我猜他們以為你們下一個就會攻擊（ strike ）那裡。"
 },
 {
  "id": 148,
  "src_sha256": "572d325b016f4cc624a3de5dd11eb95e4bbe869c242640bcb4719c7f29bd8003",
  "zh": "喔，我聽到的可多了。這畢竟是間酒吧，人一喝起酒來？嘿，什麼話都說得出口。我現在沒聽到什麼值得轉告的，不過你們常來，我保證會有些傳聞給你們。"
 },
 {
  "id": 149,
  "src_sha256": "68e69c97de1955844d27aabfec9c481e928310937061d6bcbd2167e4e0140cd3",
  "zh": "嗯，可能有點奇怪，不過聽說 Trynnies 有一棵樹被某種巨鼠佔據了。有趣的是， Dominus 上根本沒有巨鼠。我真好奇牠們是從哪來的。"
 },
 {
  "id": 150,
  "src_sha256": "7197904cf4b9060fafae0d2ccfdf91e8b95f4ece1c9b144688d4d23f4c0aae6f",
  "zh": "我偷聽到一位客人在聊 Trynnies 藏在那裡的某頂頭盔。現在，關於那頂頭盔我什麼都不知道，但他們似乎覺得那非常重要。"
 },
 {
  "id": 151,
  "src_sha256": "ebb983765b235d2589a770fcb843a75b2ca357d76ed97a3e60da46f7a38b7805",
  "zh": "好，我聽到的是這樣。 Mook 窩在我們以前的市政廳裡。不過消息還不只這樣。傳聞說他們有某種裝置，跟 Destinae Dominus 一模一樣。當然啦，這只是傳聞。就這樣而已。"
 },
 {
  "id": 152,
  "src_sha256": "9e046e8537b2df62b0a539e6d9efd15dacae909078fb2b39b17cbdb5e11f5b85",
  "zh": "你們在找軍械庫……而你們找錯地方了。它就在廣場對面。"
 },
 {
  "id": 153,
  "src_sha256": "360bf98a3d0d860d584454be1c9b809154307f98ff109962f2fc7b4e2a96ce09",
  "zh": "沒錯，我幾乎什麼都有庫存。"
 },
 {
  "id": 154,
  "src_sha256": "00d5aac96f079acf226d7496afd87bed13a578b955252dfa7fe99e92db4935b6",
  "zh": "我自己也不太懂。那座塔（ tower ）前一天還不在，隔天就冒出來了！我可沒喝酒，要是你們在想這個的話。要是聽到什麼關於它的傳聞，我會告訴你們。"
 },
 {
  "id": 155,
  "src_sha256": "49fc0053ab7fff1e3556ee213e268c4ae738174045571b3cd20ec8ae0b4282e1",
  "zh": "出了門，往南一點就到了。不可能錯過的。"
 },
 {
  "id": 156,
  "src_sha256": "cf3371ea31f42d8367060f13f456a21326ee1a4726af0c2940363e981f4be17b",
  "zh": "當然， Higardi Lunar Legion ，保安部隊。"
 },
 {
  "id": 157,
  "src_sha256": "84f162bf131a92c9a831670a085ee8dc4b81bb9c37864edc3d3d01aaaef21e4d",
  "zh": "神殿就在庭院對面。"
 },
 {
  "id": 158,
  "src_sha256": "638d50a72da262084face4b2eb399ab837d3d0286cfe6bf29686bf058b76c3bd",
  "zh": "我不談我的其他客人。"
 },
 {
  "id": 159,
  "src_sha256": "602f485b98eef18f2a76fb1b72bc04abacd75a96ccaaf56256adab77739a40b1",
  "zh": "看看我的貨吧。我這裡什麼東西都有，你們說不定會有興趣。"
 },
 {
  "id": 160,
  "src_sha256": "95978d451d5c4a5cd87d6e3dfd8c6af288db104c0cbe4113af4c7b69f665a304",
  "zh": "沒錯。這玩意兒讓世界轉動。"
 },
 {
  "id": 161,
  "src_sha256": "a0a2cf4fd2f019c830dffbc6cc3662bdfd303cd2fccd9920247fece82f9e51b9",
  "zh": "你有興趣還錢了嗎， Myles ？"
 },
 {
  "id": 162,
  "src_sha256": "c08db9820e5b8b5e7ee5140b2b8fb40ffdbb877b67a963c2a8e4f5faffc2fca2",
  "zh": "跟你們說吧，要是你們能把樓上那群流氓趕走，我就「免費」租房間給你們！他們至少一個月沒付帳了。你們把他們解決掉，房間就是你們的！"
 },
 {
  "id": 163,
  "src_sha256": "3f66959f21baaccee7d7791092881d85576e02e9db1723d82b99bc087fe318be",
  "zh": "Lord Braffit 在神殿裡。你們該不會真以為他會在這裡吧！嗯……"
 },
 {
  "id": 164,
  "src_sha256": "dfccc20a58b84e3fa8ae5abd11d23208543788944a5e98372bd4a45ee04c6e41",
  "zh": "哼，要是你們到現在還不知道那是什麼，我也不會告訴你們！"
 },
 {
  "id": 165,
  "src_sha256": "772345c63b61d09a4d79f4d11bd5aee97338ee3d7c92a3808598dbc93e005094",
  "zh": "我認識他們……"
 },
 {
  "id": 166,
  "src_sha256": "7570516ffbd4437b11573bc869f71209c8c33773ba10bc9a85df75bf0b816526",
  "zh": "我說過了！樓上！"
 },
 {
  "id": 167,
  "src_sha256": "6b2dadfdeafed481856c91b2d374cb0b48bdcef3befa96c37e4e04ae55034b68",
  "zh": "當然啦，大家的藥水都是跟 Fuzzfas 買的！"
 },
 {
  "id": 169,
  "src_sha256": "f48bb460d0bdf989836354932013449f3eb4ef44e5f845a3424388d6dd1fe427",
  "zh": "我知道的都告訴你們了。"
 },
 {
  "id": 170,
  "src_sha256": "38f2726fdb0caef39fe41670216af3134506df55f09a7a87bf0c4994181c3087",
  "zh": "一字不差。"
 },
 {
  "id": 171,
  "src_sha256": "1211a15f56ae78f66da622e49b0867b5cf16be6c6f501084e4d3acc8dc9af227",
  "zh": "出了這裡，往北走。"
 },
 {
  "id": 172,
  "src_sha256": "feed9b203e5f72bdf5fb6a4b5a73af1cc298dbc5a0d1c5ac300bbdcce531c086",
  "zh": "在南邊一段路。"
 },
 {
  "id": 173,
  "src_sha256": "1544c6db6cf99b1a84fc6c77ad9b13711a93e08911825308cff6144ab5cf5a88",
  "zh": "一路向東。"
 },
 {
  "id": 174,
  "src_sha256": "6673f7437e7d8dd96a6e4a7b7b2cf884ec89d9dad60b4fd6957e070051eaed70",
  "zh": "出門往西。"
 }
]
